diff --git a/src/registry.cpp b/src/registry.cpp
index 91a6c79..dd1922b 100644
--- a/src/registry.cpp
+++ b/src/registry.cpp
@@ -112,7 +112,25 @@ void CRegistry::Init(void)
 	DWORD dwDisposition;
 
 	char szModelKey[1024];
-	wsprintf(szModelKey, "Software\\Valve\\%s\\Settings\\", GetPlatformName());
+	char profile[33] = { 0 };
+	DWORD profileLength = GetEnvironmentVariableA("GOLDCRAFT_PROFILE_ID", profile, sizeof(profile));
+	if (profileLength)
+	{
+		// Each isolated GoldCraft instance has its own launcher settings.
+		if (profileLength != 32)
+			return;
+		for (DWORD i = 0; i < profileLength; ++i)
+		{
+			const char c = profile[i];
+			if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')))
+				return;
+		}
+		wsprintfA(szModelKey, "Software\\GoldCraft\\Sandbox\\%s\\Settings\\", profile);
+	}
+	else
+	{
+		wsprintf(szModelKey, "Software\\Valve\\%s\\Settings\\", GetPlatformName());
+	}
 	lResult = RegCreateKeyEx(HKEY_CURRENT_USER, szModelKey, 0, NULL, REG_OPTION_NON_VOLATILE, KEY_ALL_ACCESS, NULL, &m_hKey, &dwDisposition);
 
 	if (lResult != ERROR_SUCCESS)
@@ -131,4 +149,4 @@ void CRegistry::Shutdown(void)
 
