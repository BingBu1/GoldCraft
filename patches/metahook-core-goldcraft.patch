+	{
+		return false;
+	}
+	out_eax = static_cast<unsigned long>(registers[0]);
+	out_ebx = static_cast<unsigned long>(registers[1]);
+	out_ecx = static_cast<unsigned long>(registers[2]);
+	out_edx = static_cast<unsigned long>(registers[3]);
+	return true;
