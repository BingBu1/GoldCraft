 // Randomly shuffle the speakable order
 void BotPhrase::Randomize()
 {
+	// C++20 removed random_shuffle. Retain the original C RNG source while
+	// supplying the uniform-generator contract required by std::shuffle.
+	struct PhraseRandom {
+		using result_type = unsigned;
+		static constexpr result_type min() { return 0; }
+		static constexpr result_type max() { return RAND_MAX; }
+		result_type operator()() { return static_cast<unsigned>(rand()); }
+	} random;
 	for (size_t i = 0; i < m_voiceBank.size(); i++)
 	{
-		std::random_shuffle(m_voiceBank[i]->begin(), m_voiceBank[i]->end());
+		std::shuffle(m_voiceBank[i]->begin(), m_voiceBank[i]->end(), random);
 	}
 }
 
