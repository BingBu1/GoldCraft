+HRESULT RenderToBitmap(const std::wstring& path, UINT width, UINT height, HBITMAP* out)
+{
+	if (path.empty() || !width || !height) return E_INVALIDARG;
+	StudioModel source;
+	source.LoadFromFile(path);
+	if (!source.GetStudioHeader()) return E_UNEXPECTED;
+
+	// Parsing is independent across apartments. Only the shared immediate context is serialized.
+	std::lock_guard lock(rendererMutex);
+	std::unique_ptr<Renderer> renderer(std::exchange(cachedRenderer, nullptr));
+	if (!renderer) renderer = std::make_unique<Renderer>();
+	const HRESULT hr = renderer->Render(source, width, height, out);
+	if (SUCCEEDED(hr)) cachedRenderer = renderer.release();
+	return hr;
 }
