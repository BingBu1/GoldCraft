+#pragma once
+#include <interface.h>
+#include <stdint.h>
+
+// Optional scene extension. The existing MetaRenderer_API_002 ABI is unchanged.
+enum MetaRendererSceneFlags : uint32_t
+{
+    META_SCENE_GBUFFER      = 1u << 0,
+    META_SCENE_SHADOW       = 1u << 1,
+    META_SCENE_MULTIVIEW    = 1u << 2,
+    META_SCENE_LINEAR_DEPTH = 1u << 3,
+    META_SCENE_GAMMA_BLEND  = 1u << 4
+};
+
+class IMetaRendererSceneCallbacks : public IBaseInterface
+{
+public:
+    // Called after host opaque geometry and before deferred lighting, also in
+    // dynamic shadow passes. CameraUBO/SceneUBO and the target FBO are bound.
+    // Restore all changed GL state before returning; do not recurse RenderScene.
+    virtual void DrawOpaqueScene(uint32_t flags) = 0;
+};
+
+class IMetaRendererScene : public IBaseInterface
+{
+public:
+    virtual void RegisterSceneCallbacks(IMetaRendererSceneCallbacks* callbacks)   = 0;
+    virtual void UnregisterSceneCallbacks(IMetaRendererSceneCallbacks* callbacks) = 0;
+    // Opt in by the public CL_AllocDlight key. 0 removes the override; otherwise
+    // use 128, 256 or 512. Geometry changes require dynamic, not static, shadows.
+    virtual void SetDynamicLightShadowSize(int key, unsigned size) = 0;
+};
+
+#define METARENDERER_SCENE_INTERFACE_VERSION "MetaRendererScene_API_001"
