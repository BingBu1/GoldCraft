+                                             (WSURF_SHADOW_CASTER_ENABLED | WSURF_ALPHA_SOLID_ENABLED | WSURF_DIFFUSE_ENABLED));
+        entity.curstate.rendermode = kRenderNormal;
+        shadow                     = false;
+
+        // A real driver rejection cannot publish a partial leaf or replace the
+        // already valid generation. Test data is not an allocation-success mock.
+        const auto failed = R_PrepareWorldSurfaceLeafModel(carved, &scene.model, 0);
+        failUpload        = true;
+        Finish(failed);
+        assert(failed->GetLeafByIndex(0)->m_LoadError && !failed->GetLeafByIndex(0)->m_bIsReady);
+        assert(!failed->GetLeafByIndex(0)->hABO && !glIsBuffer(failedBuffer) && glIsBuffer(oldBuffer));
