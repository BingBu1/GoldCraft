+++ b/tests/shadow_cull_tests.cpp
@@ -0,0 +1,65 @@
+// Execute the production light-volume rejection and scope restoration.
+#include "../src/gl_shadow_cull.cpp"
+#include <cassert>
+#include <limits>
+
+cl_enginefunc_t gEngfuncs{};
+cvar_t          enabled{};
+bool            shadow{};
+bool            R_IsRenderingShadowView() { return shadow; }
+void            R_ProfileShadowCull(bool) {}
+
+int main()
+{
+    gEngfuncs.pfnRegisterVariable = [](const char*, const char*, int) {
+        return &enabled;
+    };
+    R_InitShadowCulling();
+    enabled.value = 1;
+    shadow        = true;
+    const float origin[]{0, 0, 0};
+    const float farMin[]{300, -10, -10}, farMax[]{320, 10, 10};
+    assert(!R_CullPointShadowBox(farMin, farMax));
+    {
+        RPointShadowCullScope light(origin, 100);
+        assert(R_CullPointShadowBox(farMin, farMax));
+        const float insideMin[]{-10, -10, -10}, insideMax[]{10, 10, 10};
+        assert(!R_CullPointShadowBox(insideMin, insideMax));
+        const float enclosingMin[]{-200, -200, -200}, enclosingMax[]{200, 200, 200};
+        assert(!R_CullPointShadowBox(enclosingMin, enclosingMax));
+        for (int axis = 0; axis < 3; ++axis)
+            for (int sign : {-1, 1})
+            {
+                float low[]{-1, -1, -1}, high[]{1, 1, 1};
+                low[axis]  = sign > 0 ? 100 : -110;
+                high[axis] = sign > 0 ? 110 : -100;
+                assert(!R_CullPointShadowBox(low, high)); // tangent retained
+                low[axis] += sign * 2;
+                high[axis] += sign * 2;
+                assert(R_CullPointShadowBox(low, high));
+            }
+        // Outside the sphere although inside its enclosing cube.
+        const float diagonalMin[]{75, 75, -1}, diagonalMax[]{80, 80, 1};
+        assert(R_CullPointShadowBox(diagonalMin, diagonalMax));
+        shadow = false;
+        assert(!R_CullPointShadowBox(farMin, farMax)); // main/reflection untouched
+        shadow        = true;
+        enabled.value = 0;
+        assert(!R_CullPointShadowBox(farMin, farMax));
+        enabled.value = 1;
+        const float other[]{310, 0, 0};
+        {
+            RPointShadowCullScope nested(other, 30);
+            assert(!R_CullPointShadowBox(farMin, farMax));
+        }
+        assert(R_CullPointShadowBox(farMin, farMax));
+        float invalid[]{std::numeric_limits<float>::quiet_NaN(), 0, 0};
+        assert(!R_CullPointShadowBox(invalid, farMax));
+        assert(!R_CullPointShadowBox(farMax, farMin));
+    }
+    assert(!R_CullPointShadowBox(farMin, farMax));
+    {
+        RPointShadowCullScope invalid(origin, 0);
+        assert(!R_CullPointShadowBox(farMin, farMax));
+    }
+}
diff --git a/src/studio_bone_cache.cpp b/src/studio_bone_cache.cpp
new file mode 100644
index 0000000..a0edb5e
--- /dev/null
+++ b/src/studio_bone_cache.cpp
@@ -0,0 +1,58 @@
+#include "gl_local.h"
+
+namespace
+{
+std::unordered_map<CStudioBoneCacheHandle, CStudioBoneCache*, CStudioBoneCacheHasher> caches;
+CStudioBoneCache                                                                      storage[MAX_STUDIO_BONE_CACHES];
+unsigned                                                                              used{};
+bool                                                                                  overflowReported{};
+} // namespace
+
+void R_StudioClearAllBoneCaches()
+{
+    caches.clear();
+    used             = 0;
+    overflowReported = false;
+}
+
+void R_StudioSaveBoneCache(studiohdr_t*, int modelindex, int sequence, int gaitsequence, float frame, const float* origin, const float* angles)
+{
+    const CStudioBoneCacheHandle handle(modelindex, sequence, gaitsequence, frame, origin, angles);
+    const auto                   existing = caches.find(handle);
+    CStudioBoneCache*            cache    = nullptr;
+    if (existing != caches.end())
+    {
+        // Repeated shadow/main passes save the same pose. Reuse its slot while
+        // preserving the existing last-save-wins transform semantics.
+        cache = existing->second;
+        R_ProfileBoneCacheStore(true, false);
+    }
+    else
+    {
+        if (used == MAX_STUDIO_BONE_CACHES)
+        {
+            R_ProfileBoneCacheStore(false, true);
+            if (!overflowReported)
+            {
+                gEngfuncs.Con_DPrintf("R_StudioSaveBoneCache: unique pose capacity reached; uncached poses use native bones.\n");
+                overflowReported = true;
+            }
+            return;
+        }
+        cache = &storage[used++];
+        caches.emplace(handle, cache);
+        R_ProfileBoneCacheStore(false, false);
+    }
+    memcpy(cache->m_bonetransform, (*pbonetransform), sizeof(cache->m_bonetransform));
+    memcpy(cache->m_lighttransform, (*plighttransform), sizeof(cache->m_lighttransform));
+}
+
+bool R_StudioLoadBoneCache(studiohdr_t*, int modelindex, int sequence, int gaitsequence, float frame, const float* origin, const float* angles)
+{
+    const CStudioBoneCacheHandle handle(modelindex, sequence, gaitsequence, frame, origin, angles);
+    const auto                   existing = caches.find(handle);
+    if (existing == caches.end()) return false;
+    memcpy((*pbonetransform), existing->second->m_bonetransform, sizeof(existing->second->m_bonetransform));
+    memcpy((*plighttransform), existing->second->m_lighttransform, sizeof(existing->second->m_lighttransform));
+    return true;
+}
diff --git a/tests/studio_bone_cache_tests.cpp b/tests/studio_bone_cache_tests.cpp
new file mode 100644
index 0000000..96871bd
--- /dev/null
+++ b/tests/studio_bone_cache_tests.cpp
@@ -0,0 +1,130 @@
+// Exercise the actual per-frame cache under repeated point-shadow passes.
+#include "../src/studio_bone_cache.cpp"
+#include <cassert>
+#include <cmath>
+#include <cstdio>
+
+cl_enginefunc_t gEngfuncs{};
+static float    bones[MAXSTUDIOBONES][3][4]{}, lights[MAXSTUDIOBONES][3][4]{};
+float (*pbonetransform)[MAXSTUDIOBONES][3][4]  = &bones;
+float (*plighttransform)[MAXSTUDIOBONES][3][4] = &lights;
+static unsigned allocations{}, reuses{}, overflows{}, warnings{};
+
+void R_ProfileBoneCacheStore(bool reused, bool overflow)
+{
+    if (overflow) ++overflows;
+    else if (reused)
+        ++reuses;
+    else
+        ++allocations;
+}
+
+static void Warning(const char*, ...) { ++warnings; }
+
+static void Transforms(float value)
+{
+    for (int bone = 0; bone < MAXSTUDIOBONES; ++bone)
+        for (int row = 0; row < 3; ++row)
+            for (int col = 0; col < 4; ++col)
+            {
+                bones[bone][row][col]  = value + bone * 12 + row * 4 + col;
+                lights[bone][row][col] = -bones[bone][row][col] - 1.f;
+            }
+}
+
+static void VerifyTransforms(float value)
+{
+    for (int bone = 0; bone < MAXSTUDIOBONES; ++bone)
+        for (int row = 0; row < 3; ++row)
+            for (int col = 0; col < 4; ++col)
+            {
+                const float expected = value + bone * 12 + row * 4 + col;
+                assert(bones[bone][row][col] == expected);
+                assert(lights[bone][row][col] == -expected - 1.f);
+            }
+}
+
+int main()
+{
+    _set_error_mode(_OUT_TO_STDERR);
+    _set_abort_behavior(0, _WRITE_ABORT_MSG | _CALL_REPORTFAULT);
+    gEngfuncs.Con_DPrintf = Warning;
+    const float origin[]{-2527.5f, 1989.f, 66.f}, angles[]{0.f, 356.f, 0.f};
+    R_StudioClearAllBoneCaches();
+    // 24 point lights, six cube faces, 24 players: 3,456 saves but 24 poses.
+    for (int pass = 0; pass < 144; ++pass)
+        for (int player = 0; player < 24; ++player)
+        {
+            Transforms(static_cast<float>(pass * 100 + player));
+            R_StudioSaveBoneCache(nullptr, player + 1, 2, 3, 4.f, origin, angles);
+        }
+    assert(allocations == 24 && reuses == 3432 && overflows == 0 && warnings == 0);
+    for (int player = 0; player < 24; ++player)
+    {
+        Transforms(-10000.f);
+        assert(R_StudioLoadBoneCache(nullptr, player + 1, 2, 3, 4.f, origin, angles));
+        VerifyTransforms(static_cast<float>(14300 + player));
+    }
+    // Every pose component remains part of the lookup. A miss leaves the
+    // native transform buffers intact for the caller's uncached path.
+    float otherOrigin[]{origin[0] + 1, origin[1], origin[2]};
+    float otherAngles[]{angles[0], angles[1] + 1, angles[2]};
+    Transforms(-123.f);
+    assert(!R_StudioLoadBoneCache(nullptr, 1, 20, 3, 4.f, origin, angles));
+    assert(!R_StudioLoadBoneCache(nullptr, 1, 2, 30, 4.f, origin, angles));
+    assert(!R_StudioLoadBoneCache(nullptr, 1, 2, 3, 4.5f, origin, angles));
+    assert(!R_StudioLoadBoneCache(nullptr, 1, 2, 3, 4.f, otherOrigin, angles));
+    assert(!R_StudioLoadBoneCache(nullptr, 1, 2, 3, 4.f, origin, otherAngles));
+    VerifyTransforms(-123.f);
+    R_StudioClearAllBoneCaches();
+    assert(!R_StudioLoadBoneCache(nullptr, 1, 2, 3, 4.f, origin, angles));
+    allocations = reuses = overflows = 0;
+    for (int pose = 0; pose < MAX_STUDIO_BONE_CACHES; ++pose)
+    {
+        Transforms(static_cast<float>(pose));
+        R_StudioSaveBoneCache(nullptr, pose + 1, 0, 0, 0.f, origin, angles);
+    }
+    assert(allocations == MAX_STUDIO_BONE_CACHES && overflows == 0);
+    // A genuine full frame must preserve existing entries, allow their
+    // refresh and report only once rather than flood every shadow pass.
+    for (int pass = 0; pass < 100; ++pass)
+        R_StudioSaveBoneCache(nullptr, MAX_STUDIO_BONE_CACHES + 1, 0, 0, 0.f, origin, angles);
+    assert(overflows == 100 && warnings == 1);
+    assert(!R_StudioLoadBoneCache(nullptr, MAX_STUDIO_BONE_CACHES + 1, 0, 0, 0.f, origin, angles));
+    for (int pose = 0; pose < MAX_STUDIO_BONE_CACHES; ++pose)
+    {
+        assert(R_StudioLoadBoneCache(nullptr, pose + 1, 0, 0, 0.f, origin, angles));
+        VerifyTransforms(static_cast<float>(pose));
+    }
+    Transforms(7777.f);
+    R_StudioSaveBoneCache(nullptr, 1, 0, 0, 0.f, origin, angles);
+    assert(reuses == 1 && overflows == 100);
+    Transforms(0.f);
+    assert(R_StudioLoadBoneCache(nullptr, 1, 0, 0, 0.f, origin, angles));
+    VerifyTransforms(7777.f);
+    R_StudioClearAllBoneCaches();
+    assert(!R_StudioLoadBoneCache(nullptr, 1, 0, 0, 0.f, origin, angles));
+    Transforms(8888.f);
+    R_StudioSaveBoneCache(nullptr, MAX_STUDIO_BONE_CACHES + 1, 0, 0, 0.f, origin, angles);
+    Transforms(0.f);
+    assert(R_StudioLoadBoneCache(nullptr, MAX_STUDIO_BONE_CACHES + 1, 0, 0, 0.f, origin, angles));
+    VerifyTransforms(8888.f);
+    assert(warnings == 1);
+    // Equal signed-zero keys must hash identically. Different representable
+    // coordinates must never receive another pose's transforms.
+    R_StudioClearAllBoneCaches();
+    const float zeros[]{0.f, 0.f, 0.f}, negativeZeros[]{-0.f, -0.f, -0.f};
+    Transforms(333.f);
+    R_StudioSaveBoneCache(nullptr, 65536, 0, 0, -0.f, negativeZeros, negativeZeros);
+    Transforms(0.f);
+    assert(R_StudioLoadBoneCache(nullptr, 65536, 0, 0, 0.f, zeros, zeros));
+    VerifyTransforms(333.f);
+    const float closeOrigin[]{std::nextafter(0.f, 1.f), 0.f, 0.f};
+    assert(!R_StudioLoadBoneCache(nullptr, 65536, 0, 0, 0.f, closeOrigin, zeros));
+    // Warning suppression resets per frame, while retained entries never do.
+    for (int pose = 1; pose < MAX_STUDIO_BONE_CACHES; ++pose)
+        R_StudioSaveBoneCache(nullptr, pose, 0, 0, 0.f, zeros, zeros);
+    R_StudioSaveBoneCache(nullptr, MAX_STUDIO_BONE_CACHES, 0, 0, 0.f, zeros, zeros);
+    assert(warnings == 2);
+    std::puts("PASS: 3,456 multipass saves use 24 slots; last-save transforms, pose isolation, full-capacity fallback and frame reset.");
+}
diff --git a/src/gl_surface_edit.cpp b/src/gl_surface_edit.cpp
new file mode 100644
index 0000000..82c5f28
--- /dev/null
+++ b/src/gl_surface_edit.cpp
@@ -0,0 +1,252 @@
+#include "gl_local.h"
+#include <limits>
+#include <stdexcept>
+
+namespace
+{
+void CheckSurfaceGL()
+{
+    if (glGetError() != GL_NO_ERROR)
+        throw std::runtime_error("World surface GPU preparation failed");
+}
+struct SurfaceBindings
+{
+    GLint vao{}, array{}, indirect{};
+    SurfaceBindings()
+    {
+        glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &vao);
+        glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &array);
+        glGetIntegerv(GL_DRAW_INDIRECT_BUFFER_BINDING, &indirect);
+        CheckSurfaceGL();
+    }
+    ~SurfaceBindings()
+    {
+        glBindVertexArray(vao);
+        glBindBuffer(GL_ARRAY_BUFFER, array);
+        glBindBuffer(GL_DRAW_INDIRECT_BUFFER, indirect);
+    }
+};
+template <class T> void UploadSurfaceBuffer(GLuint& name, GLenum target, const std::vector<T>& values)
+{
+    if (values.size() > std::size_t((std::numeric_limits<GLsizeiptr>::max)()) / sizeof(T))
+        throw std::length_error("World surface GPU buffer size");
+    glGenBuffers(1, &name);
+    CheckSurfaceGL();
+    if (!name) throw std::runtime_error("World surface GPU buffer allocation failed");
+    glBindBuffer(target, name);
+    const auto bytes = static_cast<GLsizeiptr>(values.size() * sizeof(T));
+    if (bytes && glBufferStorage)
+        glBufferStorage(target, bytes, values.data(), 0);
+    else
+        glBufferData(target, bytes, values.data(), GL_STATIC_DRAW);
+    CheckSurfaceGL();
+}
+void FloatSurfaceAttribute(GLuint location, GLint components, GLsizei stride, const void* offset)
+{
+    glEnableVertexAttribArray(location);
+    glVertexAttribPointer(location, components, GL_FLOAT, GL_FALSE, stride, offset);
+}
+void DrawCavityBuffer(const CWorldSurfaceWorldModel& model, GLuint buffer, uint32_t first, uint32_t count)
+{
+    glBindVertexArray(model.hVAO);
+    glBindBuffer(GL_DRAW_INDIRECT_BUFFER, buffer);
+    if (model.m_hCavityLightValues)
+        glBindBufferBase(GL_SHADER_STORAGE_BUFFER, BINDING_POINT_CAVITY_LIGHT_SSBO, model.m_hCavityLightValues);
+    glMultiDrawElementsIndirect(GL_TRIANGLES, GL_UNSIGNED_INT,
+        reinterpret_cast<void*>(std::size_t(first) * sizeof(CDrawIndexAttrib)), count, 0);
+}
+} // namespace
+
+CWorldSurfaceWorldModel::~CWorldSurfaceWorldModel()
+{
+    if (hEBO) glDeleteBuffers(1, &hEBO);
+    glDeleteBuffers(WSURF_VBO_MAX, hVBO);
+    if (hVAO) glDeleteVertexArrays(1, &hVAO);
+    if (m_hCavityABO) glDeleteBuffers(1, &m_hCavityABO);
+    if (m_hCavityLightRanges) glDeleteBuffers(1, &m_hCavityLightRanges);
+    if (m_hCavityLightValues) glDeleteBuffers(1, &m_hCavityLightValues);
+}
+
+void R_UploadWorldSurfaceGeometry(CWorldSurfaceWorldModel& model)
+{
+    if (!model.m_pSurfaceMesh || model.hVAO || model.hEBO || model.m_hCavityABO ||
+        model.m_hCavityLightRanges || model.m_hCavityLightValues ||
+        model.hVBO[0] || model.hVBO[1] || model.hVBO[2])
+        throw std::invalid_argument("World surface upload requires a fresh candidate");
+    const SurfaceBindings restore;
+    const auto&           mesh = *model.m_pSurfaceMesh;
+    glGenVertexArrays(1, &model.hVAO);
+    CheckSurfaceGL();
+    if (!model.hVAO) throw std::runtime_error("World surface GPU VAO allocation failed");
+    glBindVertexArray(model.hVAO);
+    UploadSurfaceBuffer(model.hEBO, GL_ELEMENT_ARRAY_BUFFER, mesh.indices);
+    UploadSurfaceBuffer(model.hVBO[WSURF_VBO_VERTEX], GL_ARRAY_BUFFER, mesh.vertices);
+    FloatSurfaceAttribute(WSURF_VA_POSITION, 3, sizeof(brushvertex_t), OFFSET(brushvertex_t, pos));
+    FloatSurfaceAttribute(WSURF_VA_TEXCOORD, 2, sizeof(brushvertex_t), OFFSET(brushvertex_t, texcoord));
+    FloatSurfaceAttribute(WSURF_VA_LIGHTMAP_TEXCOORD, 2, sizeof(brushvertex_t), OFFSET(brushvertex_t, lightmaptexcoord));
+    UploadSurfaceBuffer(model.hVBO[WSURF_VBO_VERTEXTBN], GL_ARRAY_BUFFER, mesh.frames);
+    FloatSurfaceAttribute(WSURF_VA_NORMAL, 3, sizeof(brushvertextbn_t), OFFSET(brushvertextbn_t, normal));
+    FloatSurfaceAttribute(WSURF_VA_S_TANGENT, 3, sizeof(brushvertextbn_t), OFFSET(brushvertextbn_t, s_tangent));
+    FloatSurfaceAttribute(WSURF_VA_T_TANGENT, 3, sizeof(brushvertextbn_t), OFFSET(brushvertextbn_t, t_tangent));
+    FloatSurfaceAttribute(WSURF_VA_SMOOTHNORMAL, 3, sizeof(brushvertextbn_t), OFFSET(brushvertextbn_t, smoothnormal));
+    UploadSurfaceBuffer(model.hVBO[WSURF_VBO_INSTANCE], GL_ARRAY_BUFFER, mesh.instances);
+    glEnableVertexAttribArray(WSURF_VA_PACKED_MATID);
+    glVertexAttribIPointer(WSURF_VA_PACKED_MATID, 1, GL_UNSIGNED_INT, sizeof(brushinstancedata_t), OFFSET(brushinstancedata_t, packed_matId));
+    glEnableVertexAttribArray(WSURF_VA_STYLES);
+    glVertexAttribIPointer(WSURF_VA_STYLES, 4, GL_UNSIGNED_BYTE, sizeof(brushinstancedata_t), OFFSET(brushinstancedata_t, styles));
+    FloatSurfaceAttribute(WSURF_VA_DIFFUSESCALE, 1, sizeof(brushinstancedata_t), OFFSET(brushinstancedata_t, diffusescale));
+    glVertexAttribDivisor(WSURF_VA_PACKED_MATID, 1);
+    glVertexAttribDivisor(WSURF_VA_STYLES, 1);
+    glVertexAttribDivisor(WSURF_VA_DIFFUSESCALE, 1);
+    CheckSurfaceGL();
+    if (!model.m_vCavityDraws.empty())
+    {
+        static_assert(sizeof(CDrawIndexAttrib) == 5 * sizeof(uint32_t));
+        std::vector<CDrawIndexAttrib> commands;
+        commands.reserve(model.m_vCavityDraws.size());
+        for (const auto& draw : model.m_vCavityDraws)
+            commands.push_back({draw.indices.count, draw.instances.count, draw.indices.first, 0, draw.instances.first});
+        UploadSurfaceBuffer(model.m_hCavityABO, GL_DRAW_INDIRECT_BUFFER, commands);
+    }
+    if (model.m_pCavityLighting)
+    {
+        const auto& lighting = *model.m_pCavityLighting;
+        if (lighting.mesh != model.m_pSurfaceMesh || lighting.vertices.size() != mesh.vertices.size())
+            throw std::invalid_argument("Cavity lighting does not match candidate geometry");
+        UploadSurfaceBuffer(model.m_hCavityLightRanges, GL_ARRAY_BUFFER, lighting.vertices);
+        glEnableVertexAttribArray(WSURF_VA_CAVITY_LIGHT);
+        glVertexAttribIPointer(WSURF_VA_CAVITY_LIGHT, 2, GL_UNSIGNED_INT, sizeof(goldcraft::surface::Range), nullptr);
+        // A truly black bake still needs a valid SSBO object, but every range
+        // has count zero and the shader never reads the single padding record.
+        const std::vector<goldcraft::lighting::Value> black(1);
+        UploadSurfaceBuffer(model.m_hCavityLightValues, GL_ARRAY_BUFFER, lighting.values.empty() ? black : lighting.values);
+        CheckSurfaceGL();
+    }
+}
+
+void R_DrawCavityGeometry(const CWorldSurfaceWorldModel& model, uint32_t first, uint32_t count)
+{
+    if (!count) return;
+    if (!model.m_hCavityABO || first > model.m_vCavityDraws.size() ||
+        count > model.m_vCavityDraws.size() - first || count > uint32_t((std::numeric_limits<GLsizei>::max)()))
+        throw std::out_of_range("Cavity indirect draw range");
+    DrawCavityBuffer(model, model.m_hCavityABO, first, count);
+}
+
+CWorldSurfaceCavityView::~CWorldSurfaceCavityView()
+{
+    if (m_hABO) glDeleteBuffers(1, &m_hABO);
+}
+
+std::shared_ptr<const CWorldSurfaceCavityView> R_PrepareVisibleCavityGeometry(
+    std::shared_ptr<const CWorldSurfaceWorldModel> model,
+    const goldcraft::visibility::Prepared& visibility, uint32_t key)
+{
+    if (!model || !model->hVAO || model->m_vCavityDraws.size() > 65'536)
+        throw std::invalid_argument("Missing cavity geometry or excessive draw count");
+    const auto selected = visibility.view(key);
+    auto candidate = std::make_shared<CWorldSurfaceCavityView>();
+    candidate->m_pWorldModel = std::move(model);
+    std::vector<CDrawIndexAttrib> commands;
+    const auto& draws = candidate->m_pWorldModel->m_vCavityDraws;
+    for (std::size_t i = 0; i < draws.size(); ++i)
+    {
+        const auto& draw = draws[i];
+        if (!visibility.sees_bounds(selected, draw.bounds)) continue;
+        candidate->m_vDrawIndices.push_back(static_cast<uint32_t>(i));
+        commands.push_back({draw.indices.count, draw.instances.count, draw.indices.first, 0, draw.instances.first});
+    }
+    if (!commands.empty())
+    {
+        const SurfaceBindings restore;
+        UploadSurfaceBuffer(candidate->m_hABO, GL_DRAW_INDIRECT_BUFFER, commands);
+    }
+    return candidate;
+}
+
+void R_DrawVisibleCavityGeometry(const CWorldSurfaceCavityView& view, uint32_t first, uint32_t count)
+{
+    if (!count) return;
+    if (!view.m_pWorldModel || !view.m_hABO || first > view.m_vDrawIndices.size() ||
+        count > view.m_vDrawIndices.size() - first || count > uint32_t((std::numeric_limits<GLsizei>::max)()))
+        throw std::out_of_range("Visible cavity indirect draw range");
+    DrawCavityBuffer(*view.m_pWorldModel, view.m_hABO, first, count);
+}
+
+namespace
+{
+std::shared_ptr<CWorldSurfaceWorldModel> PrepareSurfaceCandidate(
+    const std::shared_ptr<CWorldSurfaceWorldModel>& original,
+    std::shared_ptr<const goldcraft::surface::Mesh> mesh,
+    std::vector<goldcraft::cavity::Draw> draws,
+    std::shared_ptr<const goldcraft::lighting::Prepared> lighting = {})
+{
+    if (!original || !original->m_pOriginalMesh ||
+        original->m_vFaceBuffer.size() != original->m_pOriginalMesh->faces.size())
+        throw std::invalid_argument("Missing original world surface geometry");
+    if (mesh == original->m_pSurfaceMesh && draws.empty() && original->m_vCavityDraws.empty()) return original;
+    auto candidate             = std::make_shared<CWorldSurfaceWorldModel>(original->m_model);
+    candidate->m_pOriginalMesh = original->m_pOriginalMesh;
+    candidate->m_pSurfaceMesh  = std::move(mesh);
+    candidate->m_vCavityDraws  = std::move(draws);
+    candidate->m_pCavityLighting = std::move(lighting);
+    candidate->m_vFaceBuffer   = original->m_vFaceBuffer;
+    for (std::size_t i = 0; i < candidate->m_vFaceBuffer.size(); ++i)
+    {
+        auto&       target         = candidate->m_vFaceBuffer[i];
+        const auto& face           = candidate->m_pSurfaceMesh->faces[i];
+        target.start_index         = face.forward.first;
+        target.index_count         = face.forward.count;
+        target.reverse_start_index = face.reverse.first;
+        target.reverse_index_count = face.reverse.count;
+        target.instance_index      = face.instances.first;
+        target.instance_count      = face.instances.count;
+        target.poly_count          = face.polygons;
+    }
+    R_UploadWorldSurfaceGeometry(*candidate);
+    return candidate;
+}
+} // namespace
+
+std::shared_ptr<CWorldSurfaceWorldModel> R_PrepareWorldSurfaceGeometry(
+    const std::shared_ptr<CWorldSurfaceWorldModel>& original,
+    std::span<const goldcraft::surface::Selection> cuts,
+    goldcraft::surface::Limits limits)
+{
+    if (!original) throw std::invalid_argument("Missing original world surface geometry");
+    const auto prepared = goldcraft::surface::prepare(original->m_pOriginalMesh, cuts, limits);
+    return PrepareSurfaceCandidate(original, prepared.mesh, {});
+}
+
+std::shared_ptr<CWorldSurfaceWorldModel> R_PrepareCarvedWorldGeometry(
+    const std::shared_ptr<CWorldSurfaceWorldModel>& original,
+    std::span<const goldcraft::cavity::Model> models,
+    goldcraft::cavity::Limits limits)
+{
+    if (!original) throw std::invalid_argument("Missing original world surface geometry");
+    auto prepared = goldcraft::cavity::prepare(original->m_pOriginalMesh, models, limits);
+    return PrepareSurfaceCandidate(original, std::move(prepared.mesh), std::move(prepared.draws));
+}
+
+std::shared_ptr<CWorldSurfaceWorldModel> R_PrepareLitCarvedWorldGeometry(
+    const std::shared_ptr<CWorldSurfaceWorldModel>& original,
+    std::span<const goldcraft::cavity::Model> models,
+    goldcraft::cavity::Limits limits, goldcraft::lighting::Settings settings)
+{
+    if (!original) throw std::invalid_argument("Missing original world surface geometry");
+    const auto geometry = goldcraft::cavity::prepare(original->m_pOriginalMesh, models, limits);
+    if (geometry.draws.empty()) return PrepareSurfaceCandidate(original, geometry.mesh, {});
+    std::vector<CWorldLightProbes> storage;
+    std::vector<goldcraft::lighting::Model> lightingModels;
+    storage.reserve(models.size());
+    lightingModels.reserve(models.size());
+    for (const auto& model : models)
+    {
+        if (model.boxes.empty()) continue;
+        storage.push_back(R_CollectCavityLightProbes(*original, model, settings));
+        const auto& probes = storage.back();
+        lightingModels.push_back({model.first_face, model.face_count, model.hull, model.boxes, probes.probes, probes.values});
+    }
+    auto lighting = std::make_shared<goldcraft::lighting::Prepared>(goldcraft::lighting::prepare(geometry, lightingModels, settings));
+    return PrepareSurfaceCandidate(original, lighting->mesh, lighting->draws, lighting);
+}
