diff --git a/src/gl_gbuffer.cpp b/src/gl_gbuffer.cpp
new file mode 100644
index 0000000..02861bd
--- /dev/null
+++ b/src/gl_gbuffer.cpp
@@ -0,0 +1,57 @@
+#include "gl_local.h"
+
+namespace
+{
+int gbuffer_mask = -1;
+GLuint gbuffer_attachments[GBUFFER_INDEX_MAX] = { 0 };
+int gbuffer_attachment_count = 0;
+}
+
+int R_GetGBufferMask()
+{
+	return gbuffer_mask;
+}
+
+void R_ResetGBufferMask()
+{
+	gbuffer_mask = -1;
+}
+
+void R_SetGBufferBlend(int blendsrc, int blenddst)
+{
+	if (!R_IsRenderingGBuffer())
+		return;
+
+	for (int i = 0; i < gbuffer_attachment_count; ++i)
+	{
+		if (gbuffer_attachments[i] == GL_COLOR_ATTACHMENT0 + GBUFFER_INDEX_DIFFUSE)
+			glBlendFunci(i, blendsrc, blenddst);
+
+		if (gbuffer_attachments[i] == GL_COLOR_ATTACHMENT0 + GBUFFER_INDEX_LIGHTMAP)
+			glBlendFunci(i, blendsrc, blenddst);
+
+		if (gbuffer_attachments[i] == GL_COLOR_ATTACHMENT0 + GBUFFER_INDEX_WORLDNORM)
+			glBlendFunci(i, GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+
+		if (gbuffer_attachments[i] == GL_COLOR_ATTACHMENT0 + GBUFFER_INDEX_SPECULAR)
+			glBlendFunci(i, GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+	}
+}
+
+void R_SetGBufferMask(int mask)
+{
+	if (!R_IsRenderingGBuffer() || gbuffer_mask == mask)
+		return;
+
+	gbuffer_mask = mask;
+	gbuffer_attachment_count = 0;
+	for (int i = 0; i < GBUFFER_INDEX_MAX; ++i)
+	{
+		if (mask & (1 << i))
+		{
+			gbuffer_attachments[gbuffer_attachment_count] = GL_COLOR_ATTACHMENT0 + i;
+			gbuffer_attachment_count++;
+		}
+	}
+	glDrawBuffers(gbuffer_attachment_count, gbuffer_attachments);
+}
diff --git a/src/gl_studio_shadow.cpp b/src/gl_studio_shadow.cpp
new file mode 100644
index 0000000..9c9c777
--- /dev/null
+++ b/src/gl_studio_shadow.cpp
@@ -0,0 +1,29 @@
+#include "gl_local.h"
+
+void studioapi_StudioRenderShadow(int sprite, float* p1, float* p2, float* p3, float* p4)
+{
+	// The legacy contact shadow is an alpha-blended sprite on the receiving
+	// floor. It must never become geometry in a light's shadow/depth pass.
+	if (R_IsRenderingShadowView() || r_draw_lineardepth)
+		return;
+
+	if (!R_IsRenderingGBuffer())
+	{
+		gPrivateFuncs.studioapi_StudioRenderShadow(sprite, p1, p2, p3, p4);
+		return;
+	}
+
+	const int mask = R_GetGBufferMask();
+	if (!(mask & GBUFFER_MASK_DIFFUSE))
+		return;
+
+	// TriAPI writes only fragment output 0. Other MRT outputs are undefined;
+	// letting them overwrite the floor lightmap/normal produces a black quad.
+	struct RestoreMask
+	{
+		int value;
+		~RestoreMask() { R_SetGBufferMask(value); }
+	} restore{ mask };
+	R_SetGBufferMask(GBUFFER_MASK_DIFFUSE);
+	gPrivateFuncs.studioapi_StudioRenderShadow(sprite, p1, p2, p3, p4);
+}
diff --git a/tests/studio_shadow_gl_tests.cpp b/tests/studio_shadow_gl_tests.cpp
new file mode 100644
index 0000000..e3dd649
--- /dev/null
+++ b/tests/studio_shadow_gl_tests.cpp
@@ -0,0 +1,197 @@
+// Real MRT readback through the production StudioRenderShadow wrapper and
+// GBuffer routing. A hidden test context never takes focus or operates CS.
+#include "../src/gl_local.h"
+#include <GLFW/glfw3.h>
+#include <array>
+#include <cassert>
+#include <cmath>
+#include <cstdio>
+#include <fstream>
+#include <sstream>
+#include <stdexcept>
+#include "../src/gl_gbuffer.cpp"
+#include "../src/gl_studio_shadow.cpp"
+
+private_funcs_t gPrivateFuncs{};
+bool r_draw_lineardepth = false;
+static bool deferred = true, shadow = false;
+bool R_IsRenderingGBuffer() { return deferred; }
+bool R_IsRenderingShadowView() { return shadow; }
+
+constexpr int kSize = 64;
+using Pixels = std::array<float, kSize * kSize * 4>;
+static GLuint program{}, vao{};
+static int calls{};
+static float vertices[4][3]{};
+
+static GLuint Compile(GLenum type, const std::string& source)
+{
+	GLuint shader = glCreateShader(type);
+	const char* text = source.c_str();
+	glShaderSource(shader, 1, &text, nullptr);
+	glCompileShader(shader);
+	GLint ok{};
+	glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+	if (!ok) { char log[4096]{}; glGetShaderInfoLog(shader, sizeof(log), nullptr, log); std::fprintf(stderr, "%s\n", log); }
+	assert(ok);
+	return shader;
+}
+
+static GLuint MakeProgram(const std::string& fragment)
+{
+	const auto vs = Compile(GL_VERTEX_SHADER, R"(#version 430
+out vec3 v_worldpos; out vec2 v_diffusetexcoord; out vec4 v_color; out vec4 v_projpos;
+void main() {
+    vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
+    v_diffusetexcoord = p; v_color = vec4(1); v_worldpos = vec3(p,0);
+    gl_Position = vec4(p * 2 - 1, 0, 1); v_projpos = gl_Position;
+})");
+	const auto fs = Compile(GL_FRAGMENT_SHADER, fragment);
+	GLuint result = glCreateProgram();
+	glAttachShader(result, vs); glAttachShader(result, fs); glLinkProgram(result);
+	GLint ok{}; glGetProgramiv(result, GL_LINK_STATUS, &ok); assert(ok);
+	glDeleteShader(vs); glDeleteShader(fs);
+	return result;
+}
+
+static void EngineShadow(int sprite, float* p1, float* p2, float* p3, float* p4)
+{
+	assert(sprite == 65536 && p1 == vertices[0] && p2 == vertices[1] && p3 == vertices[2] && p4 == vertices[3]);
+	++calls;
+	glUseProgram(program); glBindVertexArray(vao);
+	glEnable(GL_BLEND); glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+	R_SetGBufferBlend(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+	glDepthMask(GL_FALSE);
+	glDrawArrays(GL_TRIANGLES, 0, 3);
+	glDepthMask(GL_TRUE); glDisable(GL_BLEND); glUseProgram(0);
+}
+
+static void DrawShadow() { studioapi_StudioRenderShadow(65536, vertices[0], vertices[1], vertices[2], vertices[3]); }
+
+static Pixels ReadColor(int attachment)
+{
+	Pixels pixels{};
+	glReadBuffer(GL_COLOR_ATTACHMENT0 + attachment);
+	glReadPixels(0, 0, kSize, kSize, GL_RGBA, GL_FLOAT, pixels.data());
+	return pixels;
+}
+
+static void ClearFloor()
+{
+	R_SetGBufferMask(GBUFFER_MASK_ALL);
+	for (int i = 0; i < 4; ++i)
+	{
+		const float value[] = { .2f + i * .1f, .8f - i * .1f, .3f, 1.f };
+		glClearBufferfv(GL_COLOR, i, value);
+	}
+	const float depth = .8f;
+	glClearBufferfv(GL_DEPTH, 0, &depth);
+}
+
+int main()
+{
+	if (!glfwInit()) return 2;
+	glfwWindowHint(GLFW_VISIBLE, GLFW_FALSE);
+	glfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 4);
+	glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 3);
+	auto* window = glfwCreateWindow(kSize, kSize, "studio shadow regression", nullptr, nullptr);
+	if (!window) { glfwTerminate(); return 2; }
+	glfwMakeContextCurrent(window);
+	glewExperimental = GL_TRUE;
+	if (glewInit() != GLEW_OK) { glfwDestroyWindow(window); glfwTerminate(); return 2; }
+	while (glGetError() != GL_NO_ERROR) {}
+	std::printf("Driver: %s / %s\n", glGetString(GL_RENDERER), glGetString(GL_VERSION));
+
+	GLuint fbo{}, textures[5]{}, circle{};
+	glGenFramebuffers(1, &fbo); glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+	glGenTextures(5, textures);
+	for (int i = 0; i < 5; ++i)
+	{
+		glBindTexture(GL_TEXTURE_2D, textures[i]);
+		glTexImage2D(GL_TEXTURE_2D, 0, i == 4 ? GL_DEPTH_COMPONENT32F : GL_RGBA32F,
+			kSize, kSize, 0, i == 4 ? GL_DEPTH_COMPONENT : GL_RGBA, GL_FLOAT, nullptr);
+		glFramebufferTexture2D(GL_FRAMEBUFFER, i == 4 ? GL_DEPTH_ATTACHMENT : GL_COLOR_ATTACHMENT0 + i,
+			GL_TEXTURE_2D, textures[i], 0);
+	}
+	R_SetGBufferMask(GBUFFER_MASK_ALL);
+	assert(glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE);
+	glViewport(0, 0, kSize, kSize); glEnable(GL_DEPTH_TEST); glDepthFunc(GL_LESS);
+	glGenVertexArrays(1, &vao);
+
+	Pixels pixels{};
+	for (int y = 0; y < kSize; ++y) for (int x = 0; x < kSize; ++x)
+	{
+		const float dx = (x + .5f - kSize / 2.f) / (kSize * .4f);
+		const float dy = (y + .5f - kSize / 2.f) / (kSize * .4f);
+		pixels[(y * kSize + x) * 4 + 3] = .75f * (std::max)(0.f, 1.f - std::sqrt(dx * dx + dy * dy));
+	}
+	glGenTextures(1, &circle); glBindTexture(GL_TEXTURE_2D, circle);
+	glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA32F, kSize, kSize, 0, GL_RGBA, GL_FLOAT, pixels.data());
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+
+	// Compile the actual TriAPI color shader's simple branch. Its single MRT
+	// output and texture alpha are the same contract as the world-space branch.
+	std::ifstream input(TRIAPI_FRAGMENT_PATH);
+	assert(input.good());
+	std::ostringstream buffer; buffer << input.rdbuf();
+	std::string fragment = buffer.str();
+	const auto include = fragment.find("#include \"common.h\""); assert(include != std::string::npos);
+	fragment.replace(include, std::strlen("#include \"common.h\""), "#define TRIAPI_HUD_SPACE_ENABLED");
+	const auto realProgram = MakeProgram(fragment);
+	program = realProgram;
+	gPrivateFuncs.studioapi_StudioRenderShadow = EngineShadow;
+	ClearFloor(); const auto lightBefore = ReadColor(1);
+	EngineShadow(65536, vertices[0], vertices[1], vertices[2], vertices[3]);
+	const auto lightLegacy = ReadColor(1);
+	int changed{};
+	for (size_t i = 0; i < lightBefore.size(); ++i) if (lightBefore[i] != lightLegacy[i]) ++changed;
+	std::printf("Unprotected single-output TriAPI changed %d lightmap components (driver-dependent undefined outputs).\n", changed);
+
+	// Also use explicit poison outputs: preservation must not depend on a
+	// particular driver's choice for unspecified shader outputs.
+	const auto poisonProgram = MakeProgram(R"(#version 430
+layout(binding=0) uniform sampler2D diffuseTex; in vec2 v_diffusetexcoord;
+layout(location=0) out vec4 diffuse; layout(location=1) out vec4 lightmap;
+layout(location=2) out vec4 normal; layout(location=3) out vec4 specular;
+void main() { diffuse=texture(diffuseTex,v_diffusetexcoord); lightmap=normal=specular=vec4(0,0,0,1); }
+)");
+	for (const auto selected : {realProgram, poisonProgram})
+	{
+		program = selected;
+		ClearFloor();
+		const auto diffuseBefore = ReadColor(0), light = ReadColor(1), normal = ReadColor(2), specular = ReadColor(3);
+		DrawShadow();
+		assert(ReadColor(1) == light && ReadColor(2) == normal && ReadColor(3) == specular);
+		const auto diffuse = ReadColor(0);
+		for (int i = 0; i < 4; ++i) assert(diffuse[i] == diffuseBefore[i]);
+		const int center = ((kSize / 2) * kSize + kSize / 2) * 4;
+		assert(diffuse[center + 1] < diffuseBefore[center + 1] * .5f);
+		std::array<float, kSize * kSize> depth{};
+		glReadPixels(0, 0, kSize, kSize, GL_DEPTH_COMPONENT, GL_FLOAT, depth.data());
+		for (auto value : depth) assert(value == .8f);
+		assert(R_GetGBufferMask() == GBUFFER_MASK_ALL);
+		for (int i = 0; i < 4; ++i) { GLint target{}; glGetIntegerv(GL_DRAW_BUFFER0 + i, &target); assert(target == GL_COLOR_ATTACHMENT0 + i); }
+	}
+	R_SetGBufferMask(GBUFFER_MASK_DIFFUSE | GBUFFER_MASK_WORLDNORM);
+	DrawShadow();
+	GLint target{}; glGetIntegerv(GL_DRAW_BUFFER1, &target); assert(target == GL_COLOR_ATTACHMENT0 + GBUFFER_INDEX_WORLDNORM);
+	const int beforeSkip = calls;
+	shadow = true; DrawShadow(); shadow = false;
+	r_draw_lineardepth = true; DrawShadow(); r_draw_lineardepth = false;
+	R_SetGBufferMask(GBUFFER_MASK_LIGHTMAP); DrawShadow();
+	assert(calls == beforeSkip);
+	R_SetGBufferMask(GBUFFER_MASK_DIFFUSE);
+	deferred = false; DrawShadow(); deferred = true;
+	assert(calls == beforeSkip + 1);
+	gPrivateFuncs.studioapi_StudioRenderShadow = [](int, float*, float*, float*, float*) { throw std::runtime_error("probe"); };
+	R_SetGBufferMask(GBUFFER_MASK_ALL);
+	try { DrawShadow(); assert(false); } catch (const std::runtime_error&) {}
+	assert(R_GetGBufferMask() == GBUFFER_MASK_ALL);
+	assert(glGetError() == GL_NO_ERROR);
+	std::puts("PASS: transparent corners, shaded center, lightmap/normal/specular/depth preservation, full/partial mask restoration, shadow/depth exclusion, forward path and unwind.");
+	glDeleteProgram(realProgram); glDeleteProgram(poisonProgram);
+	glDeleteVertexArrays(1, &vao); glDeleteTextures(1, &circle); glDeleteTextures(5, textures); glDeleteFramebuffers(1, &fbo);
+	glfwDestroyWindow(window); glfwTerminate();
+	return 0;
+}
