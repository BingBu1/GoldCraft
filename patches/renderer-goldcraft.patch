+        for (int a = 0; a < 4; ++a) for (int c = 0; c < 4; ++c)
+        {
+            assert(left_pixels[a][pixel + c] == (is_left ? all_pixels : base_pixels)[a][pixel + c]);
+            assert(right_pixels[a][pixel + c] == (is_right ? all_pixels : base_pixels)[a][pixel + c]);
+        }
+    }
