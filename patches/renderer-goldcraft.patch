+            red += pixels[i] > 250;
+            green += pixels[i + 1] > 250;
+        }
+        assert(red == 256 && green == 3840);
+        const auto stateCheck = [&] {
+            for (auto state : usedStates)
+            {
+                assert(bool(state & WSURF_GBUFFER_ENABLED) == gbuffer);
+                assert(bool(state & WSURF_FULLBRIGHT_ENABLED) == (fullbright.value != 0));
+                assert(bool(state & WSURF_LEGACY_DLIGHT_ENABLED) == !gbuffer);
+                if (state & WSURF_CAVITY_LIGHT_ENABLED)
+                    assert(!(state & (WSURF_LIGHTMAP_ENABLED | WSURF_LIGHTMAP_INDEX_0_ENABLED | WSURF_LIGHTMAP_INDEX_1_ENABLED | WSURF_LIGHTMAP_INDEX_2_ENABLED | WSURF_LIGHTMAP_INDEX_3_ENABLED)));
