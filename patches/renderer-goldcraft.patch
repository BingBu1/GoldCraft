+{
+std::string Read(const char* filename)
+{
+    std::ifstream file(std::string(RENDERER_SHADER_DIRECTORY) + "/" + filename, std::ios::binary);
+    assert(file.good()); std::ostringstream text; text << file.rdbuf(); return text.str();
+}
+std::string Function(const std::string& source, const char* signature)
+{
+    const auto start = source.find(signature); assert(start != std::string::npos);
+    auto end = source.find('{', start) + 1; int depth = 1;
+    while (depth) { depth += (source[end] == '{') - (source[end] == '}'); ++end; }
+    return source.substr(start, end - start);
+}
+GLuint Compile(GLenum stage, std::string source)
+{
+    const auto include = source.find("#include \"common.h\"");
+    if (include != std::string::npos) source.replace(include, 19, Read("common.h"));
+    source.insert(source.find('\n') + 1, stage == GL_FRAGMENT_SHADER ? "#define IS_FRAGMENT_SHADER\n#define LEGACY_DLIGHT_ENABLED\n" : "#define IS_VERTEX_SHADER\n#define LEGACY_DLIGHT_ENABLED\n");
+    const GLuint shader = glCreateShader(stage); const char* text = source.c_str();
