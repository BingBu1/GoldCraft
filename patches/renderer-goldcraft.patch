diff --git a/src/gl_gbuffer.cpp b/src/gl_gbuffer.cpp
new file mode 100644
index 0000000..d67177f
--- /dev/null
+++ b/src/gl_gbuffer.cpp
@@ -0,0 +1,57 @@
+#include "gl_local.h"
+
+namespace
+{
+int    gbuffer_mask                           = -1;
+GLuint gbuffer_attachments[GBUFFER_INDEX_MAX] = {0};
+int    gbuffer_attachment_count               = 0;
+} // namespace
+
+int R_GetGBufferMask()
+{
+    return gbuffer_mask;
+}
+
+void R_ResetGBufferMask()
+{
+    gbuffer_mask = -1;
+}
+
+void R_SetGBufferBlend(int blendsrc, int blenddst)
+{
+    if (!R_IsRenderingGBuffer())
+        return;
+
+    for (int i = 0; i < gbuffer_attachment_count; ++i)
+    {
+        if (gbuffer_attachments[i] == GL_COLOR_ATTACHMENT0 + GBUFFER_INDEX_DIFFUSE)
+            glBlendFunci(i, blendsrc, blenddst);
+
+        if (gbuffer_attachments[i] == GL_COLOR_ATTACHMENT0 + GBUFFER_INDEX_LIGHTMAP)
+            glBlendFunci(i, blendsrc, blenddst);
+
+        if (gbuffer_attachments[i] == GL_COLOR_ATTACHMENT0 + GBUFFER_INDEX_WORLDNORM)
+            glBlendFunci(i, GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+
+        if (gbuffer_attachments[i] == GL_COLOR_ATTACHMENT0 + GBUFFER_INDEX_SPECULAR)
+            glBlendFunci(i, GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+    }
+}
+
+void R_SetGBufferMask(int mask)
+{
+    if (!R_IsRenderingGBuffer() || gbuffer_mask == mask)
+        return;
+
+    gbuffer_mask             = mask;
+    gbuffer_attachment_count = 0;
+    for (int i = 0; i < GBUFFER_INDEX_MAX; ++i)
+    {
+        if (mask & (1 << i))
+        {
+            gbuffer_attachments[gbuffer_attachment_count] = GL_COLOR_ATTACHMENT0 + i;
+            gbuffer_attachment_count++;
+        }
+    }
+    glDrawBuffers(gbuffer_attachment_count, gbuffer_attachments);
+}
diff --git a/src/gl_studio_shadow.cpp b/src/gl_studio_shadow.cpp
new file mode 100644
index 0000000..83424cc
--- /dev/null
+++ b/src/gl_studio_shadow.cpp
@@ -0,0 +1,39 @@
+#include "gl_local.h"
+
+void studioapi_StudioRenderShadow(int sprite, float* p1, float* p2, float* p3, float* p4)
+{
+    // The legacy contact shadow is an alpha-blended sprite on the receiving
+    // floor. It must never become geometry in a light's shadow/depth pass.
+    if (R_IsRenderingShadowView() || r_draw_lineardepth)
+    {
+        R_StudioDiagnosticsShadow(sprite, true);
+        return;
+    }
+    R_StudioDiagnosticsShadow(sprite, false);
+    struct RestoreShadowContext
+    {
+        bool saved = g_bDrawingStudioShadow;
+        RestoreShadowContext() { g_bDrawingStudioShadow = true; }
+        ~RestoreShadowContext() { g_bDrawingStudioShadow = saved; }
+    } context;
+
+    if (!R_IsRenderingGBuffer())
+    {
+        gPrivateFuncs.studioapi_StudioRenderShadow(sprite, p1, p2, p3, p4);
+        return;
+    }
+
+    const int mask = R_GetGBufferMask();
+    if (!(mask & GBUFFER_MASK_DIFFUSE))
+        return;
+
+    // TriAPI writes only fragment output 0. Other MRT outputs are undefined;
+    // letting them overwrite the floor lightmap/normal produces a black quad.
+    struct RestoreMask
+    {
+        int value;
+        ~RestoreMask() { R_SetGBufferMask(value); }
+    } restore{mask};
+    R_SetGBufferMask(GBUFFER_MASK_DIFFUSE);
+    gPrivateFuncs.studioapi_StudioRenderShadow(sprite, p1, p2, p3, p4);
+}
diff --git a/tests/studio_shadow_gl_tests.cpp b/tests/studio_shadow_gl_tests.cpp
new file mode 100644
index 0000000..0564c4d
--- /dev/null
+++ b/tests/studio_shadow_gl_tests.cpp
@@ -0,0 +1,258 @@
+// Real MRT readback through the production StudioRenderShadow wrapper and
+// GBuffer routing. A hidden test context never takes focus or operates CS.
+#include "../src/gl_local.h"
+#include <GLFW/glfw3.h>
+#include <array>
+#include <cassert>
+#include <cmath>
+#include <cstdio>
+#include <fstream>
+#include <sstream>
+#include <stdexcept>
+#include "../src/gl_gbuffer.cpp"
+#include "../src/gl_studio_shadow.cpp"
+
+private_funcs_t gPrivateFuncs{};
+bool            r_draw_lineardepth = false;
+static bool     deferred = true, shadow = false;
+bool            R_IsRenderingGBuffer() { return deferred; }
+bool            R_IsRenderingShadowView() { return shadow; }
+bool            g_bDrawingStudioShadow{};
+void            R_StudioDiagnosticsShadow(int, bool) {}
+
+constexpr int kSize = 64;
+using Pixels        = std::array<float, kSize * kSize * 4>;
+static GLuint program{}, vao{};
+static int    calls{};
+static float  vertices[4][3]{};
+
+static GLuint Compile(GLenum type, const std::string& source)
+{
+    GLuint      shader = glCreateShader(type);
+    const char* text   = source.c_str();
+    glShaderSource(shader, 1, &text, nullptr);
+    glCompileShader(shader);
+    GLint ok{};
+    glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+    if (!ok)
+    {
+        char log[4096]{};
+        glGetShaderInfoLog(shader, sizeof(log), nullptr, log);
+        std::fprintf(stderr, "%s\n", log);
+    }
+    assert(ok);
+    return shader;
+}
+
+static GLuint MakeProgram(const std::string& fragment)
+{
+    const auto vs     = Compile(GL_VERTEX_SHADER, R"(#version 430
+out vec3 v_worldpos; out vec2 v_diffusetexcoord; out vec4 v_color; out vec4 v_projpos;
+void main() {
+    vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
+    v_diffusetexcoord = p; v_color = vec4(1); v_worldpos = vec3(p,0);
+    gl_Position = vec4(p * 2 - 1, 0, 1); v_projpos = gl_Position;
+})");
+    const auto fs     = Compile(GL_FRAGMENT_SHADER, fragment);
+    GLuint     result = glCreateProgram();
+    glAttachShader(result, vs);
+    glAttachShader(result, fs);
+    glLinkProgram(result);
+    GLint ok{};
+    glGetProgramiv(result, GL_LINK_STATUS, &ok);
+    assert(ok);
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+    return result;
+}
+
+static void EngineShadow(int sprite, float* p1, float* p2, float* p3, float* p4)
+{
+    assert(sprite == 65536 && p1 == vertices[0] && p2 == vertices[1] && p3 == vertices[2] && p4 == vertices[3]);
+    ++calls;
+    glUseProgram(program);
+    glBindVertexArray(vao);
+    glEnable(GL_BLEND);
+    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+    R_SetGBufferBlend(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+    glDepthMask(GL_FALSE);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    glDepthMask(GL_TRUE);
+    glDisable(GL_BLEND);
+    glUseProgram(0);
+}
+
+static void DrawShadow() { studioapi_StudioRenderShadow(65536, vertices[0], vertices[1], vertices[2], vertices[3]); }
+
+static Pixels ReadColor(int attachment)
+{
+    Pixels pixels{};
+    glReadBuffer(GL_COLOR_ATTACHMENT0 + attachment);
+    glReadPixels(0, 0, kSize, kSize, GL_RGBA, GL_FLOAT, pixels.data());
+    return pixels;
+}
+
+static void ClearFloor()
+{
+    R_SetGBufferMask(GBUFFER_MASK_ALL);
+    for (int i = 0; i < 4; ++i)
+    {
+        const float value[] = {.2f + i * .1f, .8f - i * .1f, .3f, 1.f};
+        glClearBufferfv(GL_COLOR, i, value);
+    }
+    const float depth = .8f;
+    glClearBufferfv(GL_DEPTH, 0, &depth);
+}
+
+int main()
+{
+    if (!glfwInit()) return 2;
+    glfwWindowHint(GLFW_VISIBLE, GLFW_FALSE);
+    glfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 4);
+    glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 3);
+    auto* window = glfwCreateWindow(kSize, kSize, "studio shadow regression", nullptr, nullptr);
+    if (!window)
+    {
+        glfwTerminate();
+        return 2;
+    }
+    glfwMakeContextCurrent(window);
+    glewExperimental = GL_TRUE;
+    if (glewInit() != GLEW_OK)
+    {
+        glfwDestroyWindow(window);
+        glfwTerminate();
+        return 2;
+    }
+    while (glGetError() != GL_NO_ERROR) {}
+    std::printf("Driver: %s / %s\n", glGetString(GL_RENDERER), glGetString(GL_VERSION));
+
+    GLuint fbo{}, textures[5]{}, circle{};
+    glGenFramebuffers(1, &fbo);
+    glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+    glGenTextures(5, textures);
+    for (int i = 0; i < 5; ++i)
+    {
+        glBindTexture(GL_TEXTURE_2D, textures[i]);
+        glTexImage2D(GL_TEXTURE_2D, 0, i == 4 ? GL_DEPTH_COMPONENT32F : GL_RGBA32F,
+                     kSize, kSize, 0, i == 4 ? GL_DEPTH_COMPONENT : GL_RGBA, GL_FLOAT, nullptr);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, i == 4 ? GL_DEPTH_ATTACHMENT : GL_COLOR_ATTACHMENT0 + i,
+                               GL_TEXTURE_2D, textures[i], 0);
+    }
+    R_SetGBufferMask(GBUFFER_MASK_ALL);
+    assert(glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE);
+    glViewport(0, 0, kSize, kSize);
+    glEnable(GL_DEPTH_TEST);
+    glDepthFunc(GL_LESS);
+    glGenVertexArrays(1, &vao);
+
+    Pixels pixels{};
+    for (int y = 0; y < kSize; ++y)
+        for (int x = 0; x < kSize; ++x)
+        {
+            const float dx                  = (x + .5f - kSize / 2.f) / (kSize * .4f);
+            const float dy                  = (y + .5f - kSize / 2.f) / (kSize * .4f);
+            pixels[(y * kSize + x) * 4 + 3] = .75f * (std::max)(0.f, 1.f - std::sqrt(dx * dx + dy * dy));
+        }
+    glGenTextures(1, &circle);
+    glBindTexture(GL_TEXTURE_2D, circle);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA32F, kSize, kSize, 0, GL_RGBA, GL_FLOAT, pixels.data());
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+
+    // Compile the actual TriAPI color shader's simple branch. Its single MRT
+    // output and texture alpha are the same contract as the world-space branch.
+    std::ifstream input(TRIAPI_FRAGMENT_PATH);
+    assert(input.good());
+    std::ostringstream buffer;
+    buffer << input.rdbuf();
+    std::string fragment = buffer.str();
+    const auto  include  = fragment.find("#include \"common.h\"");
+    assert(include != std::string::npos);
+    fragment.replace(include, std::strlen("#include \"common.h\""), "#define TRIAPI_HUD_SPACE_ENABLED");
+    const auto realProgram                     = MakeProgram(fragment);
+    program                                    = realProgram;
+    gPrivateFuncs.studioapi_StudioRenderShadow = EngineShadow;
+    ClearFloor();
+    const auto lightBefore = ReadColor(1);
+    EngineShadow(65536, vertices[0], vertices[1], vertices[2], vertices[3]);
+    const auto lightLegacy = ReadColor(1);
+    int        changed{};
+    for (size_t i = 0; i < lightBefore.size(); ++i)
+        if (lightBefore[i] != lightLegacy[i]) ++changed;
+    std::printf("Unprotected single-output TriAPI changed %d lightmap components (driver-dependent undefined outputs).\n", changed);
+
+    // Also use explicit poison outputs: preservation must not depend on a
+    // particular driver's choice for unspecified shader outputs.
+    const auto poisonProgram = MakeProgram(R"(#version 430
+layout(binding=0) uniform sampler2D diffuseTex; in vec2 v_diffusetexcoord;
+layout(location=0) out vec4 diffuse; layout(location=1) out vec4 lightmap;
+layout(location=2) out vec4 normal; layout(location=3) out vec4 specular;
+void main() { diffuse=texture(diffuseTex,v_diffusetexcoord); lightmap=normal=specular=vec4(0,0,0,1); }
+)");
+    for (const auto selected : {realProgram, poisonProgram})
+    {
+        program = selected;
+        ClearFloor();
+        const auto diffuseBefore = ReadColor(0), light = ReadColor(1), normal = ReadColor(2), specular = ReadColor(3);
+        DrawShadow();
+        assert(ReadColor(1) == light && ReadColor(2) == normal && ReadColor(3) == specular);
+        const auto diffuse = ReadColor(0);
+        for (int i = 0; i < 4; ++i) assert(diffuse[i] == diffuseBefore[i]);
+        const int center = ((kSize / 2) * kSize + kSize / 2) * 4;
+        assert(diffuse[center + 1] < diffuseBefore[center + 1] * .5f);
+        std::array<float, kSize * kSize> depth{};
+        glReadPixels(0, 0, kSize, kSize, GL_DEPTH_COMPONENT, GL_FLOAT, depth.data());
+        for (auto value : depth) assert(value == .8f);
+        assert(R_GetGBufferMask() == GBUFFER_MASK_ALL);
+        for (int i = 0; i < 4; ++i)
+        {
+            GLint target{};
+            glGetIntegerv(GL_DRAW_BUFFER0 + i, &target);
+            assert(target == GL_COLOR_ATTACHMENT0 + i);
+        }
+    }
+    R_SetGBufferMask(GBUFFER_MASK_DIFFUSE | GBUFFER_MASK_WORLDNORM);
+    DrawShadow();
+    GLint target{};
+    glGetIntegerv(GL_DRAW_BUFFER1, &target);
+    assert(target == GL_COLOR_ATTACHMENT0 + GBUFFER_INDEX_WORLDNORM);
+    const int beforeSkip = calls;
+    shadow               = true;
+    DrawShadow();
+    shadow             = false;
+    r_draw_lineardepth = true;
+    DrawShadow();
+    r_draw_lineardepth = false;
+    R_SetGBufferMask(GBUFFER_MASK_LIGHTMAP);
+    DrawShadow();
+    assert(calls == beforeSkip);
+    R_SetGBufferMask(GBUFFER_MASK_DIFFUSE);
+    deferred = false;
+    DrawShadow();
+    deferred = true;
+    assert(calls == beforeSkip + 1);
+    gPrivateFuncs.studioapi_StudioRenderShadow = [](int, float*, float*, float*, float*) {
+        throw std::runtime_error("probe");
+    };
+    R_SetGBufferMask(GBUFFER_MASK_ALL);
+    try
+    {
+        DrawShadow();
+        assert(false);
+    }
+    catch (const std::runtime_error&)
+    {}
+    assert(R_GetGBufferMask() == GBUFFER_MASK_ALL);
+    assert(glGetError() == GL_NO_ERROR);
+    std::puts("PASS: transparent corners, shaded center, lightmap/normal/specular/depth preservation, full/partial mask restoration, shadow/depth exclusion, forward path and unwind.");
+    glDeleteProgram(realProgram);
+    glDeleteProgram(poisonProgram);
+    glDeleteVertexArrays(1, &vao);
+    glDeleteTextures(1, &circle);
+    glDeleteTextures(5, textures);
+    glDeleteFramebuffers(1, &fbo);
+    glfwDestroyWindow(window);
+    glfwTerminate();
+    return 0;
+}
diff --git a/src/gl_studio_player.cpp b/src/gl_studio_player.cpp
new file mode 100644
index 0000000..ae22570
--- /dev/null
+++ b/src/gl_studio_player.cpp
@@ -0,0 +1,201 @@
+#include "gl_local.h"
+#include "CounterStrike.h"
+
+class CEnginePlayerInfoStorage
+{
+public:
+    struct player_info_s SavedPlayerInfo{};
+    bool                 Filled{};
+    bool                 EventsDispatched{};
+};
+
+static CEnginePlayerInfoStorage g_PlayerInfoStorage[MAX_CLIENTS]{};
+
+void CopyPlayerInfoStudioRenderData(const player_info_t* src, player_info_t* dst)
+{
+    dst->renderframe  = src->renderframe;
+    dst->gaitsequence = src->gaitsequence;
+    dst->gaitframe    = src->gaitframe;
+    dst->gaityaw      = src->gaityaw;
+    VectorCopy(src->prevgaitorigin, dst->prevgaitorigin);
+}
+
+/*
+
+	Purpose : StudioDrawPlayer hook handler
+
+*/
+
+template <typename CallType>
+__forceinline int StudioDrawPlayer_Template(CallType pfnDrawPlayer, int flags, struct entity_state_s* pplayer, void* pthis = nullptr, int dummy = 0)
+{
+    int playerindex = pplayer->number - 1;
+
+    int result = 0;
+
+    if (playerindex >= 0 && playerindex < gEngfuncs.GetMaxClients() && playerindex < MAX_CLIENTS)
+    {
+        auto pPlayerInfo = IEngineStudio.PlayerInfo(playerindex);
+
+        if (g_PlayerInfoStorage[playerindex].Filled)
+        {
+            CopyPlayerInfoStudioRenderData(&g_PlayerInfoStorage[playerindex].SavedPlayerInfo, pPlayerInfo);
+        }
+
+        CopyPlayerInfoStudioRenderData(pPlayerInfo, &g_PlayerInfoStorage[playerindex].SavedPlayerInfo);
+        g_PlayerInfoStorage[playerindex].Filled = true;
+
+        if (R_IsRenderingLowerBody())
+        {
+            bool bHideLowerbody = false;
+
+            //Sniber NMSL
+            vec3_t vecSavedModelOrigin            = {0};
+            float  flSavedModelScale              = 0;
+            int    iSavedViewEntityIndex_SCClient = 0;
+
+            float* pScale    = &(*currententity)->curstate.scale;
+            float* pModelPos = (*currententity)->origin;
+            VectorCopy(pModelPos, vecSavedModelOrigin);
+
+            //Don't emit event (muzzleflash or sound)
+            flags &= ~STUDIO_EVENTS;
+
+            flSavedModelScale = (*pScale);
+
+            auto model = IEngineStudio.SetupPlayerModel(playerindex);
+
+            if (g_bIsCounterStrike)
+            {
+                //Counter-Strike redirects playermodel in a pretty tricky way
+                int modelindex = 0;
+                model          = CounterStrike_RedirectPlayerModel(model, pplayer->number, &modelindex);
+            }
+
+            if (model)
+            {
+                auto pRenderData = R_GetStudioRenderDataFromModel(model);
+
+                if (pRenderData)
+                {
+                    vec3_t viewangles, forward, right, up;
+                    gEngfuncs.GetViewAngles(viewangles);
+                    viewangles[0] = 0;
+                    AngleVectors(viewangles, forward, right, up);
+
+                    float model_scale = pRenderData->LowerBodyControl.model_scale.GetValue();
+
+                    if (model_scale > 0)
+                    {
+                        (*pScale) = model_scale;
+                    }
+
+                    if ((*currententity)->curstate.usehull)
+                    {
+                        vec3_t duck_model_origin = {0};
+
+                        if (pRenderData->LowerBodyControl.duck_model_origin.GetValues(duck_model_origin))
+                        {
+                            VectorMA(pModelPos, duck_model_origin[0], forward, pModelPos);
+                            VectorMA(pModelPos, duck_model_origin[1], right, pModelPos);
+                            VectorMA(pModelPos, duck_model_origin[2], up, pModelPos);
+                        }
+                    }
+                    else
+                    {
+                        vec3_t model_origin = {0};
+
+                        if (pRenderData->LowerBodyControl.model_origin.GetValues(model_origin))
+                        {
+                            VectorMA(pModelPos, model_origin[0], forward, pModelPos);
+                            VectorMA(pModelPos, model_origin[1], right, pModelPos);
+                            VectorMA(pModelPos, model_origin[2], up, pModelPos);
+                        }
+                    }
+                }
+
+                auto pstudiohdr = (studiohdr_t*)IEngineStudio.Mod_Extradata(model);
+
+                if (pstudiohdr)
+                {
+                    if (pplayer->gaitsequence > 0 && (R_GetStudioSequenceFlags(pstudiohdr, pplayer->gaitsequence) & STUDIO_SF_HIDE_LOWERBODY))
+                        bHideLowerbody = true;
+                    else if (pplayer->sequence > 0 && (R_GetStudioSequenceFlags(pstudiohdr, pplayer->sequence) & STUDIO_SF_HIDE_LOWERBODY))
+                        bHideLowerbody = true;
+                }
+            }
+
+            if (!bHideLowerbody)
+            {
+                if (g_ViewEntityIndex_SCClient)
+                {
+                    iSavedViewEntityIndex_SCClient = (*g_ViewEntityIndex_SCClient);
+                    (*g_ViewEntityIndex_SCClient)  = 0;
+                }
+
+                result = pfnDrawPlayer(pthis, dummy, flags, pplayer);
+
+                if (g_ViewEntityIndex_SCClient)
+                {
+                    (*g_ViewEntityIndex_SCClient) = iSavedViewEntityIndex_SCClient;
+                }
+            }
+
+            VectorCopy(vecSavedModelOrigin, pModelPos);
+            (*pScale) = flSavedModelScale;
+        }
+        else
+        {
+            result = pfnDrawPlayer(pthis, dummy, flags, pplayer);
+        }
+    }
+    else
+    {
+        result = pfnDrawPlayer(pthis, dummy, flags, pplayer);
+    }
+
+    return result;
+}
+
+__forceinline int StudioDrawPlayer_originalcall_wrapper(void* pthis, int dummy, int flags, struct entity_state_s* pplayer)
+{
+    return gPrivateFuncs.studiointerface_StudioDrawPlayer(flags, pplayer);
+}
+
+int studiointerface_StudioDrawPlayer(int flags, struct entity_state_s* pplayer)
+{
+    if (!pplayer)
+        return 0;
+    const int  playerindex = pplayer->number - 1;
+    auto       storage     = playerindex >= 0 && playerindex < MAX_CLIENTS ? &g_PlayerInfoStorage[playerindex] : nullptr;
+    const bool auxiliary   = R_IsRenderingShadowView() || R_IsRenderingLinearDepth() ||
+        R_IsRenderingWaterView() || R_IsRenderingPortal();
+    if (auxiliary || (storage && storage->EventsDispatched))
+        flags &= ~STUDIO_EVENTS;
+
+    // Shadow-caster and reflected views may contain the local player even when
+    // it is absent from the engine's main visible list. In first person only the
+    // explicitly generated/clipped lower body may render in the main view.
+    bool hidden = false;
+    if (!auxiliary && (flags & STUDIO_RENDER) && R_IsRenderingFirstPersonView() &&
+        !R_IsRenderingLowerBody() && (*currententity) != cl_viewent &&
+        (*currententity)->player && (*currententity)->index == (*cl_viewentity))
+    {
+        flags &= ~STUDIO_RENDER;
+        hidden = true;
+    }
+    const int result = StudioDrawPlayer_Template(StudioDrawPlayer_originalcall_wrapper, flags, pplayer);
+    if (storage && result && (flags & STUDIO_EVENTS))
+        storage->EventsDispatched = true;
+    R_StudioDiagnosticsPlayer(flags, result, hidden);
+    return result;
+}
+
+void R_StudioPlayerStartFrame()
+{
+    for (auto& storage : g_PlayerInfoStorage)
+    {
+        storage.Filled           = false;
+        storage.EventsDispatched = false;
+    }
+}
diff --git a/src/studio_diagnostics.h b/src/studio_diagnostics.h
new file mode 100644
index 0000000..b60b742
--- /dev/null
+++ b/src/studio_diagnostics.h
@@ -0,0 +1,63 @@
+#pragma once
+
+void        R_StudioDiagnosticsInit();
+void        R_StudioDiagnosticsEndFrame();
+void        R_StudioDiagnosticsPlayer(int flags, int result, bool hidden);
+void        R_StudioDiagnosticsBBox(bool visible);
+void        R_StudioDiagnosticsBBoxBegin();
+void        R_StudioDiagnosticsCullBox(const float* mins, const float* maxs, bool culled);
+void        R_StudioDiagnosticsMesh();
+void        R_StudioDiagnosticsShadow(int sprite, bool skipped);
+void        R_StudioDiagnosticsShadowDraw();
+extern bool g_bDrawingStudioShadow;
+
+// Bounded, opt-in timings. GPU timestamps are collected only when available.
+enum class RProfileStage
+{
+    Setup,
+    Shadow,
+    Water,
+    Scene,
+    AmbientOcclusion,
+    Lights,
+    Composite,
+    Post,
+    EndFrame,
+    Present,
+    PointShadow,
+    SpotShadow,
+    DirectionalShadow,
+    StudioShadow,
+    StudioMain,
+    StudioBoneSetup,
+    StudioBoneSave,
+    StudioBoneMerge,
+    StudioMesh,
+    StudioSubmit,
+    Count
+};
+double R_ProfileBegin();
+void   R_ProfileEnd(RProfileStage stage, double start);
+void   R_ProfileShadowCull(bool culled);
+void   R_ProfileBoneCache(bool hit);
+void   R_ProfileBoneCacheStore(bool reused, bool overflow);
+int    R_ProfileGpuBegin(RProfileStage stage);
+void   R_ProfileGpuEnd(int span);
+void   R_ProfileMainView();
+void   R_ProfileFrameBegin();
+void   R_ProfileFrameEnd();
+void   R_ProfileShutdown();
+class RProfileScope
+{
+    RProfileStage stage_;
+    double        start_;
+    int           gpuSpan_;
+
+public:
+    explicit RProfileScope(RProfileStage stage) : stage_(stage), start_(R_ProfileBegin()), gpuSpan_(R_ProfileGpuBegin(stage)) {}
+    ~RProfileScope()
+    {
+        R_ProfileGpuEnd(gpuSpan_);
+        R_ProfileEnd(stage_, start_);
+    }
+};
diff --git a/src/studio_diagnostics.cpp b/src/studio_diagnostics.cpp
new file mode 100644
index 0000000..1e8619a
--- /dev/null
+++ b/src/studio_diagnostics.cpp
@@ -0,0 +1,513 @@
+#include "gl_local.h"
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <iomanip>
+#include <vector>
+
+bool g_bDrawingStudioShadow{};
+namespace
+{
+cvar_t* diagnostics{};
+cvar_t* profile{};
+cvar_t* profileCompare{};
+struct Player
+{
+    unsigned calls{}, rendered{}, culled{}, shadow{}, events{}, hidden{};
+    unsigned bbox{}, bboxVisible{}, meshes{}, shadowMeshes{};
+    unsigned firstPersonMain{}, lowerBody{}, localPlayer{};
+    int      model{}, sequence{}, gaitSequence{}, renderFrame{};
+    float    gait{};
+    bool     boundsCaptured{}, boundsCulled{};
+    vec3_t   mins{}, maxs{}, origin{}, viewOrigin{}, viewAngles{}, forward{};
+    float    transform[3][4]{};
+    mplane_t planes[4]{};
+    char     modelName[64]{};
+    int      boundsSequence{}, body{}, renderMode{}, renderAmount{};
+    unsigned boundsSerial{};
+    double   boundsTime{};
+};
+Player   players[MAX_CLIENTS]{};
+bool     inStudioBBox{};
+unsigned frames{}, contactCalls{}, contactSkipped{}, contactDraws{};
+int      sprite{}, texture{}, width{}, height{}, format{}, activeTexture{}, sampler{}, mask{};
+int      drawBuffers[4]{};
+unsigned zeroAlpha{}, partialAlpha{}, opaqueAlpha{};
+int      cornerAlpha = -1;
+auto     nextWrite   = std::chrono::steady_clock::time_point{};
+
+bool    Enabled() { return diagnostics && diagnostics->value > 0; }
+Player* CurrentPlayer()
+{
+    if (!Enabled() || !currententity || !(*currententity) || !(*currententity)->player)
+        return nullptr;
+    const int index = (*currententity)->index - 1;
+    return index >= 0 && index < MAX_CLIENTS ? &players[index] : nullptr;
+}
+} // namespace
+
+void R_StudioDiagnosticsInit()
+{
+    diagnostics    = gEngfuncs.pfnRegisterVariable("r_studio_diagnostics", "0", FCVAR_CLIENTDLL);
+    profile        = gEngfuncs.pfnRegisterVariable("r_renderer_profile", "0", FCVAR_CLIENTDLL);
+    profileCompare = gEngfuncs.pfnRegisterVariable("r_renderer_profile_compare", "0", FCVAR_CLIENTDLL);
+}
+
+void R_StudioDiagnosticsPlayer(int flags, int result, bool hidden)
+{
+    auto p = CurrentPlayer();
+    if (!p) return;
+    ++p->calls;
+    if (R_IsRenderingShadowView()) ++p->shadow;
+    else if (flags & STUDIO_RENDER)
+        result ? ++p->rendered : ++p->culled;
+    if (result && (flags & STUDIO_EVENTS)) ++p->events;
+    if (hidden) ++p->hidden;
+    if (R_IsRenderingLowerBody()) ++p->lowerBody;
+    if ((*currententity)->index == (*cl_viewentity)) ++p->localPlayer;
+    if (R_IsRenderingFirstPersonView() && !R_IsRenderingShadowView() && !R_IsRenderingLinearDepth() &&
+        !R_IsRenderingWaterView() && !R_IsRenderingPortal()) ++p->firstPersonMain;
+    p->model    = (*currententity)->curstate.modelindex;
+    p->sequence = (*currententity)->curstate.sequence;
+    if (auto info = IEngineStudio.PlayerInfo((*currententity)->index - 1))
+    {
+        p->gait         = info->gaitframe;
+        p->gaitSequence = info->gaitsequence;
+        p->renderFrame  = info->renderframe;
+    }
+}
+
+void R_StudioDiagnosticsBBox(bool visible)
+{
+    inStudioBBox = false;
+    if (auto p = CurrentPlayer(); p && !R_IsRenderingShadowView())
+    {
+        ++p->bbox;
+        if (visible) ++p->bboxVisible;
+    }
+}
+
+void R_StudioDiagnosticsBBoxBegin()
+{
+    inStudioBBox = Enabled() && !R_IsRenderingShadowView() && !R_IsRenderingLinearDepth() &&
+        !R_IsRenderingWaterView() && !R_IsRenderingPortal();
+}
+
+void R_StudioDiagnosticsCullBox(const float* mins, const float* maxs, bool culled)
+{
+    if (!inStudioBBox) return;
+    auto p = CurrentPlayer();
+    if (!p) return;
+    p->boundsCaptured = true;
+    p->boundsCulled   = culled;
+    ++p->boundsSerial;
+    p->boundsTime = gEngfuncs.GetClientTime();
+    VectorCopy(mins, p->mins);
+    VectorCopy(maxs, p->maxs);
+    VectorCopy((*currententity)->origin, p->origin);
+    VectorCopy(r_origin, p->viewOrigin);
+    VectorCopy((*r_refdef.viewangles), p->viewAngles);
+    VectorCopy(vpn, p->forward);
+    memcpy(p->transform, *rotationmatrix, sizeof(p->transform));
+    memcpy(p->planes, frustum, sizeof(p->planes));
+    memcpy(p->modelName, (*pstudiohdr)->name, sizeof(p->modelName));
+    p->modelName[sizeof(p->modelName) - 1] = 0;
+    p->boundsSequence                      = (*currententity)->curstate.sequence;
+    p->body                                = (*currententity)->curstate.body;
+    p->renderMode                          = (*currententity)->curstate.rendermode;
+    p->renderAmount                        = (*currententity)->curstate.renderamt;
+}
+
+void R_StudioDiagnosticsMesh()
+{
+    if (auto p = CurrentPlayer())
+        R_IsRenderingShadowView() ? ++p->shadowMeshes : ++p->meshes;
+}
+
+void R_StudioDiagnosticsShadow(int index, bool skipped)
+{
+    if (!Enabled()) return;
+    if (skipped) ++contactSkipped;
+    else
+    {
+        ++contactCalls;
+        sprite = index;
+    }
+}
+
+void R_StudioDiagnosticsShadowDraw()
+{
+    if (!Enabled() || !g_bDrawingStudioShadow) return;
+    ++contactDraws;
+    // Counters never synchronize the GPU. Mode 2 requests one explicit deep
+    // sample, then returns to counters-only mode even if diagnostics stays on.
+    if (diagnostics->value < 2) return;
+    gEngfuncs.Cvar_SetValue("r_studio_diagnostics", 1);
+    mask = R_GetGBufferMask();
+    for (int i = 0; i < 4; ++i) glGetIntegerv(GL_DRAW_BUFFER0 + i, &drawBuffers[i]);
+    glGetIntegerv(GL_ACTIVE_TEXTURE, &activeTexture);
+    glActiveTexture(GL_TEXTURE0);
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &texture);
+    glGetIntegerv(GL_SAMPLER_BINDING, &sampler);
+    glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_WIDTH, &width);
+    glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_HEIGHT, &height);
+    glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_INTERNAL_FORMAT, &format);
+    zeroAlpha = partialAlpha = opaqueAlpha = 0;
+    cornerAlpha                            = -1;
+    // Bounded numeric alpha statistics only; no framebuffer/image capture.
+    if (texture && width > 0 && width <= 256 && height > 0 && height <= 256)
+    {
+        int pack{}, alignment{}, rowLength{}, skipRows{}, skipPixels{};
+        glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack);
+        glGetIntegerv(GL_PACK_ALIGNMENT, &alignment);
+        glGetIntegerv(GL_PACK_ROW_LENGTH, &rowLength);
+        glGetIntegerv(GL_PACK_SKIP_ROWS, &skipRows);
+        glGetIntegerv(GL_PACK_SKIP_PIXELS, &skipPixels);
+        glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+        glPixelStorei(GL_PACK_ALIGNMENT, 1);
+        glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+        glPixelStorei(GL_PACK_SKIP_ROWS, 0);
+        glPixelStorei(GL_PACK_SKIP_PIXELS, 0);
+        std::vector<unsigned char> rgba(size_t(width) * height * 4);
+        glGetTexImage(GL_TEXTURE_2D, 0, GL_RGBA, GL_UNSIGNED_BYTE, rgba.data());
+        cornerAlpha = rgba[3];
+        for (size_t i = 3; i < rgba.size(); i += 4)
+        {
+            if (rgba[i] == 0) ++zeroAlpha;
+            else if (rgba[i] == 255)
+                ++opaqueAlpha;
+            else
+                ++partialAlpha;
+        }
+        glPixelStorei(GL_PACK_ALIGNMENT, alignment);
+        glPixelStorei(GL_PACK_ROW_LENGTH, rowLength);
+        glPixelStorei(GL_PACK_SKIP_ROWS, skipRows);
+        glPixelStorei(GL_PACK_SKIP_PIXELS, skipPixels);
+        glBindBuffer(GL_PIXEL_PACK_BUFFER, pack);
+    }
+    glActiveTexture(activeTexture);
+}
+
+void R_StudioDiagnosticsEndFrame()
+{
+    if (!Enabled()) return;
+    ++frames;
+    const auto now = std::chrono::steady_clock::now();
+    if (now < nextWrite) return;
+    nextWrite = now + std::chrono::seconds(2);
+    std::ostringstream out;
+    out << "{\"frames\":" << frames << ",\"time\":" << gEngfuncs.GetClientTime()
+        << ",\"deferred\":" << R_IsDeferredRenderingEnabled() << ",\"lowerBodyEnabled\":" << r_drawlowerbody->value
+        << ",\"firstPerson\":" << R_IsRenderingFirstPersonView() << ",\"viewEntity\":" << (*cl_viewentity)
+        << ",\"shadow\":{\"calls\":" << contactCalls << ",\"skipped\":" << contactSkipped
+        << ",\"draws\":" << contactDraws << ",\"sprite\":" << sprite << ",\"texture\":" << texture
+        << ",\"width\":" << width << ",\"height\":" << height << ",\"format\":" << format
+        << ",\"activeUnit\":" << activeTexture << ",\"sampler\":" << sampler << ",\"mask\":" << mask
+        << ",\"drawBuffers\":[" << drawBuffers[0] << ',' << drawBuffers[1] << ',' << drawBuffers[2] << ',' << drawBuffers[3]
+        << "],\"zeroAlpha\":" << zeroAlpha << ",\"partialAlpha\":" << partialAlpha
+        << ",\"opaqueAlpha\":" << opaqueAlpha << ",\"cornerAlpha\":" << cornerAlpha << "},\"players\":[";
+    bool first = true;
+    for (int i = 0; i < MAX_CLIENTS; ++i)
+    {
+        const auto& p = players[i];
+        if (!p.calls) continue;
+        if (!first) out << ',';
+        first = false;
+        out << "{\"entity\":" << i + 1 << ",\"calls\":" << p.calls << ",\"rendered\":" << p.rendered
+            << ",\"culled\":" << p.culled << ",\"shadow\":" << p.shadow << ",\"events\":" << p.events
+            << ",\"hidden\":" << p.hidden << ",\"bbox\":" << p.bbox << ",\"bboxVisible\":" << p.bboxVisible
+            << ",\"firstPersonMain\":" << p.firstPersonMain << ",\"lowerBody\":" << p.lowerBody << ",\"localPlayer\":" << p.localPlayer
+            << ",\"meshes\":" << p.meshes << ",\"shadowMeshes\":" << p.shadowMeshes << ",\"model\":" << p.model
+            << ",\"sequence\":" << p.sequence << ",\"gaitSequence\":" << p.gaitSequence
+            << ",\"gait\":" << p.gait << ",\"renderFrame\":" << p.renderFrame;
+        if (p.boundsCaptured)
+        {
+            auto vector = [&out](const float* v) {
+                out << '[' << v[0] << ',' << v[1] << ',' << v[2] << ']';
+            };
+            out << ",\"bounds\":{\"serial\":" << p.boundsSerial << ",\"time\":" << p.boundsTime
+                << ",\"culled\":" << p.boundsCulled << ",\"modelName\":" << std::quoted(p.modelName)
+                << ",\"sequence\":" << p.boundsSequence << ",\"body\":" << p.body
+                << ",\"renderMode\":" << p.renderMode << ",\"renderAmount\":" << p.renderAmount << ",\"mins\":";
+            vector(p.mins);
+            out << ",\"maxs\":";
+            vector(p.maxs);
+            out << ",\"origin\":";
+            vector(p.origin);
+            out << ",\"viewOrigin\":";
+            vector(p.viewOrigin);
+            out << ",\"viewAngles\":";
+            vector(p.viewAngles);
+            out << ",\"forward\":";
+            vector(p.forward);
+            out << ",\"planes\":[";
+            for (int j = 0; j < 4; ++j)
+            {
+                if (j) out << ',';
+                const auto& plane = p.planes[j];
+                out << '[' << plane.normal[0] << ',' << plane.normal[1] << ',' << plane.normal[2]
+                    << ',' << plane.dist << ',' << int(plane.signbits) << ']';
+            }
+            out << "],\"transform\":[";
+            for (int j = 0; j < 3; ++j)
+            {
+                if (j) out << ',';
+                out << '[' << p.transform[j][0] << ',' << p.transform[j][1] << ','
+                    << p.transform[j][2] << ',' << p.transform[j][3] << ']';
+            }
+            out << "]}";
+        }
+        out << '}';
+    }
+    out << "]}";
+    auto file = FILESYSTEM_ANY_OPEN("renderer/studio-diagnostics.json", "wt", "GAMECONFIG");
+    if (file)
+    {
+        const auto text = out.str();
+        FILESYSTEM_ANY_WRITE(text.data(), text.size(), file);
+        FILESYSTEM_ANY_CLOSE(file);
+    }
+}
+
+namespace
+{
+constexpr size_t      MaxProfileFrames            = 8192;
+constexpr size_t      ProfileStages               = static_cast<size_t>(RProfileStage::Count);
+constexpr const char* ProfileNames[ProfileStages] = {
+    "setup", "shadow", "water", "scene", "ambientOcclusion", "lights", "composite", "post", "endFrame", "present",
+    "pointShadow", "spotShadow", "directionalShadow", "studioShadow", "studioMain",
+    "studioBoneSetup", "studioBoneSave", "studioBoneMerge", "studioMesh", "studioSubmit"};
+struct ProfileFrame
+{
+    double                              time{}, interval{}, render{};
+    std::array<double, ProfileStages>   stages{};
+    std::array<unsigned, ProfileStages> calls{};
+    std::array<double, ProfileStages>   gpuStages{};
+    unsigned                            cullTests{}, culled{};
+    unsigned                            boneCacheHits{}, boneCacheMisses{};
+    unsigned                            boneCacheAllocations{}, boneCacheReuses{}, boneCacheOverflows{};
+    vec3_t                              origin{}, angles{};
+    int                                 focused{}, deferred{}, diagnostics{}, shadows{}, lights{}, width{}, height{};
+    int                                 shadowCull{}, views{}, gpuReady{};
+    float                               fpsMax{}, fpsOverride{}, vsync{};
+};
+std::vector<ProfileFrame> profileFrames;
+ProfileFrame              profileFrame{};
+bool                      profileActive{};
+double                    profileStart{}, profileStop{}, frameStart{}, previousFrame{};
+bool                      compareCulling{};
+float                     savedCulling{};
+constexpr size_t          GpuSlots = 16, GpuSpans = 32;
+struct GpuFrame
+{
+    std::array<GLuint, GpuSpans * 2>    queries{};
+    std::array<RProfileStage, GpuSpans> stages{};
+    size_t                              frame{}, count{};
+    bool                                pending{};
+};
+std::array<GpuFrame, GpuSlots> gpuFrames{};
+GpuFrame*                      gpuFrame{};
+double                         ProfileNow() { return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count(); }
+
+void CollectGpuProfile()
+{
+    for (auto& slot : gpuFrames)
+    {
+        if (!slot.pending) continue;
+        // An end timestamp of a nested stage can precede its parent's end.
+        // Check every span before reading any result; never wait on the GPU.
+        bool ready = true;
+        for (size_t i = 0; i < slot.count; ++i)
+        {
+            GLint available{};
+            glGetQueryObjectiv(slot.queries[2 * i + 1], GL_QUERY_RESULT_AVAILABLE, &available);
+            if (!available)
+            {
+                ready = false;
+                break;
+            }
+        }
+        if (!ready) continue;
+        auto& frame = profileFrames[slot.frame];
+        for (size_t i = 0; i < slot.count; ++i)
+        {
+            GLuint64 begin{}, end{};
+            glGetQueryObjectui64v(slot.queries[2 * i], GL_QUERY_RESULT, &begin);
+            glGetQueryObjectui64v(slot.queries[2 * i + 1], GL_QUERY_RESULT, &end);
+            if (end >= begin) frame.gpuStages[static_cast<size_t>(slot.stages[i])] += double(end - begin) / 1000000;
+        }
+        frame.gpuReady = 1;
+        slot.pending   = false;
+    }
+}
+
+void WriteProfile()
+{
+    CollectGpuProfile();
+    profileActive = false;
+    gEngfuncs.Cvar_SetValue("r_renderer_profile", 0);
+    if (compareCulling) gEngfuncs.Cvar_SetValue("r_shadow_caster_cull", savedCulling);
+    compareCulling = false;
+    gEngfuncs.Cvar_SetValue("r_renderer_profile_compare", 0);
+    std::ostringstream out;
+    out << std::fixed << std::setprecision(4)
+        << "{\"schema\":2,\"clock\":\"steady_clock\",\"unit\":\"milliseconds\","
+        << "\"stageTimesInclusive\":true,\"gpuClock\":\"GL_TIMESTAMP\",\"gpuWaits\":false,\"frames\":[";
+    bool first = true;
+    for (const auto& f : profileFrames)
+    {
+        if (!first) out << ',';
+        first = false;
+        out << "{\"time\":" << f.time << ",\"interval\":" << f.interval << ",\"render\":" << f.render
+            << ",\"focused\":" << f.focused << ",\"deferred\":" << f.deferred << ",\"diagnostics\":" << f.diagnostics
+            << ",\"shadows\":" << f.shadows << ",\"lightsVisible\":" << f.lights << ",\"width\":" << f.width << ",\"height\":" << f.height
+            << ",\"origin\":[" << f.origin[0] << ',' << f.origin[1] << ',' << f.origin[2]
+            << "],\"angles\":[" << f.angles[0] << ',' << f.angles[1] << ',' << f.angles[2] << ']';
+        out << ",\"shadowCullTests\":" << f.cullTests << ",\"shadowCulled\":" << f.culled;
+        out << ",\"boneCacheHits\":" << f.boneCacheHits << ",\"boneCacheMisses\":" << f.boneCacheMisses;
+        out << ",\"boneCacheAllocations\":" << f.boneCacheAllocations
+            << ",\"boneCacheReuses\":" << f.boneCacheReuses << ",\"boneCacheOverflows\":" << f.boneCacheOverflows;
+        out << ",\"shadowCull\":" << f.shadowCull << ",\"mainViews\":" << f.views << ",\"gpuReady\":" << f.gpuReady
+            << ",\"fpsMax\":" << f.fpsMax << ",\"fpsOverride\":" << f.fpsOverride << ",\"vsync\":" << f.vsync;
+        for (size_t i = 0; i < ProfileStages; ++i)
+            out << ",\"" << ProfileNames[i] << "\":" << f.stages[i] << ",\"" << ProfileNames[i] << "Calls\":" << f.calls[i]
+                << ",\"gpu_" << ProfileNames[i] << "\":" << f.gpuStages[i];
+        out << '}';
+    }
+    out << "]}";
+    if (auto file = FILESYSTEM_ANY_OPEN("renderer/frame-profile.json", "wt", "GAMECONFIG"))
+    {
+        const auto result = out.str();
+        FILESYSTEM_ANY_WRITE(result.data(), result.size(), file);
+        FILESYSTEM_ANY_CLOSE(file);
+    }
+    R_ProfileShutdown();
+}
+} // namespace
+
+int R_ProfileGpuBegin(RProfileStage stage)
+{
+    if (!profileActive || !gpuFrame || stage == RProfileStage::Setup || stage >= RProfileStage::PointShadow ||
+        gpuFrame->count == GpuSpans || !glQueryCounter || !glGetQueryObjectui64v) return -1;
+    if (!gpuFrame->queries[0]) glGenQueries(static_cast<GLsizei>(gpuFrame->queries.size()), gpuFrame->queries.data());
+    const auto span        = gpuFrame->count++;
+    gpuFrame->stages[span] = stage;
+    glQueryCounter(gpuFrame->queries[2 * span], GL_TIMESTAMP);
+    return static_cast<int>(span);
+}
+void R_ProfileGpuEnd(int span)
+{
+    if (span >= 0 && gpuFrame) glQueryCounter(gpuFrame->queries[2 * span + 1], GL_TIMESTAMP);
+}
+void R_ProfileMainView()
+{
+    if (!profileActive || R_IsRenderingPortal()) return;
+    if (!profileFrame.views++)
+    {
+        // Capture the actual view before shadow/water passes temporarily replace it.
+        VectorCopy((*r_refdef.vieworg), profileFrame.origin);
+        VectorCopy((*r_refdef.viewangles), profileFrame.angles);
+    }
+}
+void R_ProfileShutdown()
+{
+    if (compareCulling) gEngfuncs.Cvar_SetValue("r_shadow_caster_cull", savedCulling);
+    compareCulling = false;
+    profileActive  = false;
+    gpuFrame       = nullptr;
+    for (auto& slot : gpuFrames)
+    {
+        if (slot.queries[0]) glDeleteQueries(static_cast<GLsizei>(slot.queries.size()), slot.queries.data());
+        slot = {};
+    }
+}
+double R_ProfileBegin() { return profileActive ? ProfileNow() : 0; }
+void   R_ProfileEnd(RProfileStage stage, double start)
+{
+    if (start && profileActive)
+    {
+        profileFrame.stages[static_cast<size_t>(stage)] += (ProfileNow() - start) * 1000;
+        ++profileFrame.calls[static_cast<size_t>(stage)];
+    }
+}
+void R_ProfileShadowCull(bool culled)
+{
+    if (profileActive)
+    {
+        ++profileFrame.cullTests;
+        if (culled) ++profileFrame.culled;
+    }
+}
+void R_ProfileBoneCache(bool hit)
+{
+    if (profileActive)
+    {
+        if (hit) ++profileFrame.boneCacheHits;
+        else
+            ++profileFrame.boneCacheMisses;
+    }
+}
+void R_ProfileBoneCacheStore(bool reused, bool overflow)
+{
+    if (!profileActive) return;
+    if (overflow) ++profileFrame.boneCacheOverflows;
+    else if (reused)
+        ++profileFrame.boneCacheReuses;
+    else
+        ++profileFrame.boneCacheAllocations;
+}
+void R_ProfileFrameBegin()
+{
+    if (!profile) return;
+    if (!profileActive)
+    {
+        if (!(profile->value > 0)) return;
+        profileFrames.clear();
+        profileFrames.reserve(MaxProfileFrames);
+        profileStart   = ProfileNow();
+        profileStop    = profileStart + (std::min)(profile->value, 30.0f);
+        previousFrame  = 0;
+        compareCulling = profileCompare && profileCompare->value > 0;
+        savedCulling   = gEngfuncs.pfnGetCvarFloat("r_shadow_caster_cull");
+        profileActive  = true;
+    }
+    CollectGpuProfile();
+    if (compareCulling) gEngfuncs.Cvar_SetValue("r_shadow_caster_cull", static_cast<float>(profileFrames.size() % 2));
+    gpuFrame = nullptr;
+    for (auto& slot : gpuFrames)
+    {
+        if (slot.pending) continue;
+        slot.frame = profileFrames.size();
+        slot.count = 0;
+        gpuFrame   = &slot;
+        break;
+    }
+    frameStart            = ProfileNow();
+    profileFrame          = {};
+    profileFrame.time     = (frameStart - profileStart) * 1000;
+    profileFrame.interval = previousFrame ? (frameStart - previousFrame) * 1000 : 0;
+    previousFrame         = frameStart;
+}
+void R_ProfileFrameEnd()
+{
+    if (!profileActive) return;
+    const auto now      = ProfileNow();
+    profileFrame.render = (now - frameStart) * 1000;
+    DWORD foregroundProcess{};
+    GetWindowThreadProcessId(GetForegroundWindow(), &foregroundProcess);
+    profileFrame.focused     = foregroundProcess == GetCurrentProcessId();
+    profileFrame.deferred    = R_IsDeferredRenderingEnabled();
+    profileFrame.diagnostics = diagnostics ? static_cast<int>(diagnostics->value) : 0;
+    profileFrame.shadows     = static_cast<int>(r_shadow->value);
+    profileFrame.lights      = static_cast<int>(g_VisibleDynamicLights.size());
+    profileFrame.width       = glwidth;
+    profileFrame.height      = glheight;
+    profileFrame.shadowCull  = static_cast<int>(gEngfuncs.pfnGetCvarFloat("r_shadow_caster_cull"));
+    profileFrame.fpsMax      = gEngfuncs.pfnGetCvarFloat("fps_max");
+    profileFrame.fpsOverride = gEngfuncs.pfnGetCvarFloat("fps_override");
+    profileFrame.vsync       = gEngfuncs.pfnGetCvarFloat("gl_vsync");
+    profileFrames.push_back(profileFrame);
+    if (gpuFrame) gpuFrame->pending = gpuFrame->count > 0;
+    gpuFrame = nullptr;
+    if (now >= profileStop || profileFrames.size() >= MaxProfileFrames || profile->value <= 0) WriteProfile();
+}
diff --git a/tests/studio_player_tests.cpp b/tests/studio_player_tests.cpp
new file mode 100644
index 0000000..58fa881
--- /dev/null
+++ b/tests/studio_player_tests.cpp
@@ -0,0 +1,134 @@
+// Exercise the production public player callback: CS invokes its derived core
+// directly, so protecting only the base C++ virtual entry is insufficient.
+#include "../src/gl_studio_player.cpp"
+#include <cstdio>
+
+private_funcs_t     gPrivateFuncs{};
+cl_enginefunc_t     gEngfuncs{};
+engine_studio_api_t IEngineStudio{};
+bool                g_bIsCounterStrike{};
+int*                g_ViewEntityIndex_SCClient{};
+cl_entity_t         entity{}, viewmodel{};
+cl_entity_t*        current       = &entity;
+cl_entity_t**       currententity = &current;
+cl_entity_t*        cl_viewent    = &viewmodel;
+int                 viewEntity    = 1;
+int*                cl_viewentity = &viewEntity;
+player_info_t       info[2]{};
+static bool         shadow{}, depth{}, water{}, portal{}, firstPerson{}, lowerBody{}, visible = true;
+static unsigned     calls{}, events{}, renders{}, suppressed{};
+static int          lastFlags{}, frame = 20;
+static int          redirectedPlayerNumber = -1;
+
+bool R_IsRenderingShadowView() { return shadow; }
+bool R_IsRenderingLinearDepth() { return depth; }
+bool R_IsRenderingWaterView() { return water; }
+bool R_IsRenderingPortal() { return portal; }
+bool R_IsRenderingFirstPersonView() { return firstPerson; }
+bool R_IsRenderingLowerBody() { return lowerBody; }
+void R_StudioDiagnosticsPlayer(int, int, bool hidden)
+{
+    if (hidden) ++suppressed;
+}
+std::shared_ptr<CStudioModelRenderData> R_GetStudioRenderDataFromModel(model_t*) { return nullptr; }
+model_t*                                CounterStrike_RedirectPlayerModel(model_t* model, int number, int*)
+{
+    redirectedPlayerNumber = number;
+    return model;
+}
+int  R_GetStudioSequenceFlags(studiohdr_t*, int) { return 0; }
+void AngleVectors(const float*, float*, float*, float*) {}
+
+static int Draw(int flags, entity_state_t* state)
+{
+    ++calls;
+    lastFlags    = flags;
+    auto& player = info[state->number - 1];
+    player.gaitframe += 1.25f;
+    player.gaityaw += 2.f;
+    player.prevgaitorigin[0] += 4.f;
+    player.renderframe = frame;
+    if (!visible && (flags & STUDIO_RENDER)) return 0;
+    if (flags & STUDIO_RENDER) ++renders;
+    if (flags & STUDIO_EVENTS) ++events;
+    return 1;
+}
+
+int main()
+{
+    gEngfuncs.GetMaxClients = [] {
+        return 2;
+    };
+    IEngineStudio.PlayerInfo = [](int index) {
+        return &info[index];
+    };
+    IEngineStudio.SetupPlayerModel = [](int) -> model_t* {
+        return nullptr;
+    };
+    gPrivateFuncs.studiointerface_StudioDrawPlayer = Draw;
+    entity.player                                  = 1;
+    entity.index                                   = 2;
+    entity.curstate.number                         = 2;
+    auto* state                                    = &entity.curstate;
+    info[1].gaitframe                              = 10.f;
+    info[1].gaityaw                                = 90.f;
+    info[1].ping                                   = 42;
+    R_StudioPlayerStartFrame();
+    shadow = true;
+    for (int i = 0; i < 16; ++i) assert(studiointerface_StudioDrawPlayer(3, state));
+    assert(calls == 16 && events == 0 && renders == 16);
+    shadow = false;
+    assert(studiointerface_StudioDrawPlayer(3, state));
+    assert(studiointerface_StudioDrawPlayer(3, state));
+    assert(studiointerface_StudioDrawPlayer(0, state));
+    assert(info[1].gaitframe == 11.25f && info[1].gaityaw == 92.f && info[1].prevgaitorigin[0] == 4.f);
+    assert(events == 1 && info[1].ping == 42 && info[0].gaitframe == 0.f);
+
+    ++frame;
+    R_StudioPlayerStartFrame();
+    visible = false;
+    assert(!studiointerface_StudioDrawPlayer(3, state));
+    visible = true;
+    assert(studiointerface_StudioDrawPlayer(3, state));
+    assert(info[1].gaitframe == 12.5f && info[1].renderframe == frame && events == 2);
+
+    R_StudioPlayerStartFrame();
+    firstPerson  = true;
+    entity.index = viewEntity = state->number = 1;
+    const auto before                         = renders;
+    assert(studiointerface_StudioDrawPlayer(3, state));
+    assert(!(lastFlags & STUDIO_RENDER) && renders == before && suppressed == 1);
+    // Spectator/third-person, shadow, reflected and explicit clipped lower-body
+    // views retain their render path. They never replay gameplay events.
+    shadow = true;
+    assert(studiointerface_StudioDrawPlayer(3, state));
+    shadow = false;
+    assert((lastFlags & STUDIO_RENDER) && !(lastFlags & STUDIO_EVENTS));
+    water = true;
+    assert(studiointerface_StudioDrawPlayer(3, state));
+    water = false;
+    assert((lastFlags & STUDIO_RENDER) && !(lastFlags & STUDIO_EVENTS));
+    portal = true;
+    assert(studiointerface_StudioDrawPlayer(3, state));
+    portal = false;
+    depth  = true;
+    assert(studiointerface_StudioDrawPlayer(3, state));
+    depth     = false;
+    lowerBody = true;
+    assert(studiointerface_StudioDrawPlayer(3, state));
+    lowerBody   = false;
+    firstPerson = false;
+    assert(studiointerface_StudioDrawPlayer(3, state));
+    assert(lastFlags & STUDIO_RENDER);
+    assert(info[0].gaitframe == 1.25f && info[1].gaitframe == 12.5f);
+    assert(!studiointerface_StudioDrawPlayer(3, nullptr));
+    // CounterStrike's model/team helper consumes the one-based player number;
+    // the engine Studio player-info/setup-model API above consumes a zero-based index.
+    g_bIsCounterStrike = lowerBody = true;
+    assert(studiointerface_StudioDrawPlayer(3, state));
+    assert(redirectedPlayerNumber == 1);
+    entity.index = state->number = 2;
+    assert(studiointerface_StudioDrawPlayer(3, state));
+    assert(redirectedPlayerNumber == 2);
+    std::puts("PASS: public callback, 16 shadow passes, one gait step/event, culled-first pass, next frame, player isolation and first/third-person visibility.");
+}
diff --git a/src/gl_shadow_cull.h b/src/gl_shadow_cull.h
new file mode 100644
index 0000000..67da952
--- /dev/null
+++ b/src/gl_shadow_cull.h
@@ -0,0 +1,19 @@
+#pragma once
+
+// The six cubemap views cannot share one camera frustum, but casters outside
+// the point light's complete volume cannot shadow any lit receiver.
+class RPointShadowCullScope
+{
+    const RPointShadowCullScope* previous_;
+    float                        origin_[3];
+    float                        radius_;
+    friend bool                  R_CullPointShadowBox(const float* mins, const float* maxs);
+
+public:
+    RPointShadowCullScope(const float* origin, float radius);
+    ~RPointShadowCullScope();
+    RPointShadowCullScope(const RPointShadowCullScope&)            = delete;
+    RPointShadowCullScope& operator=(const RPointShadowCullScope&) = delete;
+};
+void R_InitShadowCulling();
+bool R_CullPointShadowBox(const float* mins, const float* maxs);
diff --git a/src/gl_shadow_cull.cpp b/src/gl_shadow_cull.cpp
new file mode 100644
index 0000000..796bd79
--- /dev/null
+++ b/src/gl_shadow_cull.cpp
@@ -0,0 +1,42 @@
+#include "gl_local.h"
+#include "gl_shadow_cull.h"
+#include <cmath>
+
+namespace
+{
+const RPointShadowCullScope* pointShadowVolume{};
+cvar_t*                      shadowCasterCull{};
+} // namespace
+
+RPointShadowCullScope::RPointShadowCullScope(const float* origin, float radius) : previous_(pointShadowVolume), origin_{origin[0], origin[1], origin[2]}, radius_(radius)
+{
+    pointShadowVolume = this;
+}
+RPointShadowCullScope::~RPointShadowCullScope() { pointShadowVolume = previous_; }
+
+void R_InitShadowCulling()
+{
+    shadowCasterCull = gEngfuncs.pfnRegisterVariable("r_shadow_caster_cull", "1", FCVAR_CLIENTDLL);
+}
+
+bool R_CullPointShadowBox(const float* mins, const float* maxs)
+{
+    if (!pointShadowVolume || !R_IsRenderingShadowView() || !shadowCasterCull || shadowCasterCull->value <= 0)
+        return false;
+    const auto& light = *pointShadowVolume;
+    if (!std::isfinite(light.radius_) || light.radius_ <= 0) return false;
+    double distanceSquared = 0;
+    for (int i = 0; i < 3; ++i)
+    {
+        if (!std::isfinite(mins[i]) || !std::isfinite(maxs[i]) || !std::isfinite(light.origin_[i]) || mins[i] > maxs[i])
+            return false;
+        const double offset = light.origin_[i] < mins[i] ? double(mins[i]) - light.origin_[i] :
+                                                           (light.origin_[i] > maxs[i] ? double(light.origin_[i]) - maxs[i] : 0);
+        distanceSquared += offset * offset;
+    }
+    // Retain tangent/near-boundary geometry despite engine bounds rounding.
+    const double radius = double(light.radius_) + 1;
+    const bool   culled = distanceSquared > radius * radius;
+    R_ProfileShadowCull(culled);
+    return culled;
+}
diff --git a/tests/shadow_cull_tests.cpp b/tests/shadow_cull_tests.cpp
new file mode 100644
