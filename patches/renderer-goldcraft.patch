+void CacheCases()
+{
+    const auto input = STUDIO_SHADOW_CASTER_ENABLED | STUDIO_MULTIVIEW_ENABLED | STUDIO_NF_CELSHADE_FACE;
+    const auto canonical = input | STUDIO_NF_CELSHADE;
+    for (int enabled : {0, 1, 0})
+    {
+        faceCull.value = float(enabled);
+        studio_program_t selected{};
+        R_UseStudioProgram(input, &selected);
+        GLint actual = -1;
+        glGetUniformiv(selected.program, selected.r_shadow_face_cull, &actual);
+        Check(actual == enabled && selected.shadowFaceCullValue == enabled &&
+              g_StudioProgramTable.at(canonical).shadowFaceCullValue == enabled,
+              "production canonical-key cache follows actual uniform 0/1/0");
+        Check(g_StudioProgramTable.find(input) == g_StudioProgramTable.end(), "no noncanonical empty program inserted");
+    }
+    glUseProgram(unrelatedProgram);
+}
