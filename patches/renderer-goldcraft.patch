+std::string Read(const std::string& name)
+{
+    std::ifstream file(std::string(RENDERER_SHADER_DIRECTORY) + "/" + name, std::ios::binary);
+    assert(file.good()); std::ostringstream text; text << file.rdbuf(); return text.str();
+}
+GLuint Compile(GLenum stage, const char* path, const char* defines)
+{
+    std::string name(path);
+    name = name.substr(name.find_last_of("/\\") + 1);
+    auto source = Read(name);
+    const auto at = source.find("#include \"common.h\"");
+    assert(at != std::string::npos); source.replace(at, 19, Read("common.h"));
+    source.insert(source.find('\n') + 1, std::string(defines) +
+        (stage == GL_VERTEX_SHADER ? "#define IS_VERTEX_SHADER\n" : "#define IS_FRAGMENT_SHADER\n"));
+    GLuint shader = glCreateShader(stage); const char* text = source.c_str();
+    glShaderSource(shader, 1, &text, nullptr); glCompileShader(shader);
+    GLint ok{}; glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+    if (!ok) { char log[16384]{}; glGetShaderInfoLog(shader, sizeof(log), nullptr, log); std::fprintf(stderr, "%s\n%s\n", defines, log); }
+    assert(ok); return shader;
+}
+GLuint GL_CompileShaderFileEx(const CCompileShaderArgs* args)
+{
+    assert(!args->gsfile);
+    const GLuint vs = Compile(GL_VERTEX_SHADER, args->vsfile, args->vsdefine);
+    const GLuint fs = Compile(GL_FRAGMENT_SHADER, args->fsfile, args->fsdefine);
+    const GLuint program = glCreateProgram(); glAttachShader(program, vs); glAttachShader(program, fs); glLinkProgram(program);
+    GLint ok{}; glGetProgramiv(program, GL_LINK_STATUS, &ok);
+    if (!ok) { char log[16384]{}; glGetProgramInfoLog(program, sizeof(log), nullptr, log); std::fprintf(stderr, "%s\n", log); }
+    assert(ok); glDeleteShader(vs); glDeleteShader(fs); return program;
