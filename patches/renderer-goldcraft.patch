+        float mins[]{1e20f,1e20f}, maxs[]{-1e20f,-1e20f};
+        for (unsigned edge=0;edge<count;++edge) {
+            const auto p=bsp.Vertex(std::bit_cast<std::int32_t>(bsp.U32(bsp.Record(13,first+edge,4)))); polygon.push_back(p);
+            for (int axis=0;axis<2;++axis) {
+                double uv=surf.texinfo->vecs[axis][3]; for (int j=0;j<3;++j) uv+=p[j]*surf.texinfo->vecs[axis][j];
+                mins[axis]=(std::min)(mins[axis],float(uv)); maxs[axis]=(std::max)(maxs[axis],float(uv));
+            }
+        }
+        for (int axis=0;axis<2;++axis) {
+            surf.texturemins[axis]=static_cast<short>(std::floor(mins[axis]/16)*16);
+            surf.extents[axis]=static_cast<short>((std::ceil(maxs[axis]/16)-std::floor(mins[axis]/16))*16);
+        }
+        if (offset>=0) {
+            std::size_t styles=0; while (styles<4 && surf.styles[styles]!=255) ++styles;
+            const auto size=std::size_t((surf.extents[0]>>4)+1)*((surf.extents[1]>>4)+1)*3*styles;
+            assert(std::size_t(offset)<=bsp.lengths[8] && size<=bsp.lengths[8]-offset);
+            surf.samples=const_cast<byte*>(bsp.bytes.data()+bsp.offsets[8]+offset);
+        }
+        surface::Instance instance{}; instance.packed_matId[0]=static_cast<std::uint16_t>(i);
+        std::copy_n(surf.styles,4,instance.styles); mesh->instances.push_back(instance);
+        surface::Face face{{static_cast<std::uint32_t>(mesh->indices.size()),0},{},{static_cast<std::uint32_t>(i),1},1,(surf.texinfo->flags&1)==0};
+        const auto base=static_cast<std::uint32_t>(mesh->vertices.size());
+        for (const auto& p : polygon) {
+            surface::Vertex vertex{}; surface::Frame frame{};
+            for (int j=0;j<3;++j) {
+                vertex.pos[j]=static_cast<float>(p[j]); frame.normal[j]=frame.smoothnormal[j]=surf.plane->normal[j]*((surf.flags&SURF_PLANEBACK)?-1.f:1.f);
+            }
+            for (int axis=0;axis<2;++axis) {
+                double uv=surf.texinfo->vecs[axis][3]; for (int j=0;j<3;++j) uv+=p[j]*surf.texinfo->vecs[axis][j];
+                vertex.texcoord[axis]=static_cast<float>(uv/64);
+            }
+            mesh->vertices.push_back(vertex); mesh->frames.push_back(frame);
+        }
+        for (std::uint32_t j=1;j+1<polygon.size();++j) mesh->indices.insert(mesh->indices.end(),{base,base+j,base+j+1});
+        face.forward.count=static_cast<std::uint32_t>(mesh->indices.size())-face.forward.first;
+        mesh->faces.push_back(face);
+    }
+    const auto world=bsp.Record(14,0,64), first=bsp.U32(world+56), count=bsp.U32(world+60);
+    const carving::HullView hull{hullPlanes,nodes,std::bit_cast<std::int32_t>(bsp.U32(world+36))};
+    model_t model{}; model.numsurfaces=static_cast<int>(surfaces.size()); model.surfaces=surfaces.data();
+    std::vector<msurface_hl25_t> hl25(surfaces.size());
+    for (std::size_t i=0;i<surfaces.size();++i) {
+        std::memset(&hl25[i],0x5a,sizeof(hl25[i]));
+        static_cast<msurface_t&>(hl25[i])=surfaces[i];
+    }
+    model_t model25=model; model25.surfaces=hl25.data();
+    for (int engine : {ENGINE_GOLDSRC_BLOB,ENGINE_GOLDSRC,ENGINE_SVENGINE,ENGINE_GOLDSRC_HL25,ENGINE_GOLDSRC_COF}) {
+        g_iEngineType=engine;
+        auto* selected=engine==ENGINE_GOLDSRC_HL25?&model25:&model;
+        for (int i=0;i<model.numsurfaces;++i) {
+            auto* expected=engine==ENGINE_GOLDSRC_HL25?static_cast<msurface_t*>(&hl25[i]):&surfaces[i];
+            assert(R_GetWorldSurfaceByIndex(selected,i)==expected);
+            assert(R_GetWorldSurfaceIndex(selected,expected)==i);
+        }
+        assert(R_GetWorldSurfaceIndex(selected,R_GetWorldSurfaceByIndex(selected,model.numsurfaces))==-1);
+    }
+    g_iEngineType=ENGINE_GOLDSRC;
+    auto original=std::make_shared<CWorldSurfaceWorldModel>(&model); original->m_pOriginalMesh=mesh; original->m_pSurfaceMesh=mesh;
+    original->m_vFaceBuffer.resize(mesh->faces.size());
+    auto original25=std::make_shared<CWorldSurfaceWorldModel>(&model25);
+    original25->m_pOriginalMesh=mesh; original25->m_pSurfaceMesh=mesh; original25->m_vFaceBuffer=original->m_vFaceBuffer;
+    std::size_t cases=0, rays=0, occluded=0, values=0, samples=0, triangles=0;
+    std::size_t opened_rays=0, bounded_views=0, max_visible=0, vis_operations=0;
+    double visibility_us=0;
+    double totalUs=0, maxUs=0;
+    for (std::size_t f=first;f<std::size_t(first)+count && cases<12;f+=count/24) {
+        const auto& face=mesh->faces[f]; if (!face.editable || !surfaces[f].samples || !face.forward.count) continue;
+        carving::Point center{};
+        for (std::size_t at=face.forward.first;at<std::size_t(face.forward.first)+face.forward.count;++at)
+            for (int j=0;j<3;++j) center[j]+=mesh->vertices[mesh->indices[at]].pos[j]/double(face.forward.count);
+        carving::Box cut{}; for (int j=0;j<3;++j) { cut.min[j]=center[j]-16; cut.max[j]=center[j]+16; }
+        const cavity::Model carvingModel{first,count,hull,{&cut,1}};
+        const auto vis_started=std::chrono::steady_clock::now();
+        const visibility::Prepared visibility(visibility_source,{&cut,1});
+        const auto view=visibility.view(visibility.key(MapLeaf(*visibility_source,center),center));
+        std::size_t visible_count=0;
+        for (auto word : view.leaves) visible_count+=std::popcount(word);
+        max_visible=(std::max)(max_visible,visible_count);
+        bounded_views+=visible_count+1<visibility_source->contents.size();
+        vis_operations+=visibility.operations()+view.operations;
+        visibility_us+=std::chrono::duration<double,std::micro>(std::chrono::steady_clock::now()-vis_started).count();
+        std::vector<std::pair<carving::Point,std::uint32_t>> points;
+        for (int x=-1;x<=1;++x) for (int y=-1;y<=1;++y) for (int z=-1;z<=1;++z) {
+            carving::Point p{center[0]+24*x,center[1]+24*y,center[2]+24*z};
+            const auto leaf=MapLeaf(*visibility_source,p); if (leaf) points.emplace_back(p,leaf);
+        }
+        for (std::size_t a=0;a<points.size();++a) for (std::size_t b=a+1;b<points.size();++b) {
+            std::size_t work=0;
+            if (lighting::visible(hull,{},points[a].first,points[b].first,work,1'000'000) ||
+                !lighting::visible(hull,{&cut,1},points[a].first,points[b].first,work,1'000'000)) continue;
+            assert(visibility.view(points[a].second).sees_leaf(points[b].second));
+            assert(visibility.view(points[b].second).sees_leaf(points[a].second));
+            ++opened_rays;
+        }
+        const auto started=std::chrono::steady_clock::now();
+        const auto lit=R_PrepareLitCarvedWorldGeometry(original,{&carvingModel,1});
+        const auto elapsed=std::chrono::duration<double,std::micro>(std::chrono::steady_clock::now()-started).count();
+        assert(lit->m_pCavityLighting && !lit->m_vCavityDraws.empty());
+        g_iEngineType=ENGINE_GOLDSRC_HL25;
+        const auto lit25=R_PrepareLitCarvedWorldGeometry(original25,{&carvingModel,1});
+        g_iEngineType=ENGINE_GOLDSRC;
+        assert(lit25->m_pCavityLighting && *lit25->m_pSurfaceMesh==*lit->m_pSurfaceMesh);
+        assert(lit25->m_pCavityLighting->vertices==lit->m_pCavityLighting->vertices);
+        assert(lit25->m_pCavityLighting->values==lit->m_pCavityLighting->values);
+        assert(lit25->m_pCavityLighting->rays==lit->m_pCavityLighting->rays);
+        assert(lit25->m_pCavityLighting->occluded==lit->m_pCavityLighting->occluded);
+        for (const auto& draw : lit->m_vCavityDraws) {
+            assert(!draw.needs_lighting); triangles+=draw.indices.count/3;
+            for (std::size_t at=draw.indices.first;at<std::size_t(draw.indices.first)+draw.indices.count;++at)
+                for (int axis=0;axis<3;++axis) {
+                    const auto value=lit->m_pSurfaceMesh->vertices[lit->m_pSurfaceMesh->indices[at]].pos[axis];
+                    assert(value>=draw.bounds.min[axis] && value<=draw.bounds.max[axis]);
+                }
+        }
+        const auto& light=*lit->m_pCavityLighting;
+        rays+=light.rays; occluded+=light.occluded; values+=light.values.size(); samples+=light.samples;
+        for (const auto& value : light.values) {
+            assert(value.style<255); for (float c : value.rgb) assert(std::isfinite(c) && c>=0 && c<=1);
+        }
+        totalUs+=elapsed; maxUs=(std::max)(maxUs,elapsed); ++cases;
+    }
+    assert(cases==12 && rays>0 && values>0 && occluded>0 && occluded<rays);
+    assert(opened_rays && bounded_views);
+    std::printf("{\"mapCarvedVisibility\":true,\"cases\":%zu,\"leaves\":%zu,\"newSightlines\":%zu,\"boundedViews\":%zu,\"maxVisibleLeaves\":%zu,\"operations\":%zu,\"prepareCpuUsMean\":%.3f,\"passed\":true}\n",
+        cases,visibility_source->contents.size()-1,opened_rays,bounded_views,max_visible,vis_operations,visibility_us/cases);
+    std::printf("{\"surfaceLayouts\":true,\"engines\":5,\"surfacesPerEngine\":%zu,\"hl25MapCandidates\":%zu,\"identicalGeometryAndLighting\":true,\"passed\":true}\n",surfaces.size(),cases);
+    std::printf("{\"mapCavityLighting\":true,\"map\":\"cs_assault\",\"crc32\":\"f6725c06\",\"cases\":%zu,\"samples\":%zu,\"rays\":%zu,\"occluded\":%zu,\"styleValues\":%zu,\"triangles\":%zu,\"prepareCpuUsMean\":%.3f,\"prepareCpuUsMax\":%.3f,\"passed\":true}\n",
+        cases,samples,rays,occluded,values,triangles,totalUs/cases,maxUs);
+}
