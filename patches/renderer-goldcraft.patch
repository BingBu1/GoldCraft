+++ b/tests/scene_lights_tests.cpp
@@ -0,0 +1,424 @@
+// Production snapshot/owner/API implementation and complete extracted engine
+// dispatch/visibility code. Host PVS/frustum inputs and texture objects are
+// adapters; this is CPU correctness evidence, not GL pixels or game FPS.
+#include "../src/gl_scene_lights.cpp"
+#include "../src/gl_shadow_cull.cpp"
+#include "../src/gl_scene_static_shadows.cpp"
+#include <cassert>
+#include <cstdio>
+#include <cstdlib>
+#include <limits>
+#include <new>
+#include <random>
+#include <source_location>
+#include <type_traits>
+#include <unordered_map>
+
+namespace
+{
+unsigned checks{}, cullQueries{}, pvsQueries{};
+size_t allocations{};
+int failAfter = -1;
+int frameNumber = 1;
+bool rejectAll{};
+float eye[3]{}, viewMins[3]{-100000, -100000, -100000}, viewMaxs[3]{100000, 100000, 100000};
+float pvsMins[3]{-100000, -100000, -100000}, pvsMaxs[3]{100000, 100000, 100000};
+void Check(bool value, const std::source_location& where = std::source_location::current())
+{
+    ++checks;
+    if (!value) std::fprintf(stderr, "Failed check %u at %s:%u\n", checks, where.file_name(), where.line());
+    assert(value);
+}
+bool Intersects(const float* low, const float* high, const float* otherLow, const float* otherHigh)
+{
+    for (int axis = 0; axis < 3; ++axis)
+        if (low[axis] > otherHigh[axis] || high[axis] < otherLow[axis]) return false;
+    return true;
+}
+}
+
+void* operator new(size_t size)
+{
+    ++allocations;
+    if (failAfter == 0) throw std::bad_alloc();
+    if (failAfter > 0) --failAfter;
+    if (void* result = std::malloc(size ? size : 1)) return result;
+    throw std::bad_alloc();
+}
+void* operator new[](size_t size) { return ::operator new(size); }
+void operator delete(void* value) noexcept { std::free(value); }
+void operator delete[](void* value) noexcept { std::free(value); }
+void operator delete(void* value, size_t) noexcept { std::free(value); }
+void operator delete[](void* value, size_t) noexcept { std::free(value); }
+
+cl_enginefunc_t gEngfuncs{};
+refdef_t r_refdef{};
+int* r_framecount = &frameNumber;
+std::vector<std::shared_ptr<CDynamicLight>> g_BSPDynamicLights, g_EngineDynamicLights;
+std::vector<CVisibleDynamicLightEntry> g_VisibleDynamicLights;
+MapConVar* r_dynlight_ambient{};
+MapConVar* r_dynlight_diffuse{};
+MapConVar* r_dynlight_specular{};
+MapConVar* r_dynlight_specularpow{};
+int r_draw_classify = DRAW_CLASSIFY_OPAQUE_ENTITIES;
+bool R_IsRenderingGBuffer() { return false; }
+bool R_IsRenderingShadowView() { return false; }
+bool R_IsRenderingMultiView() { return false; }
+bool R_IsRenderingLinearDepth() { return false; }
+bool R_IsRenderingGammaBlending() { return false; }
+void R_SetGBufferMask(int) {}
+void R_ProfileShadowCull(bool) {}
+void R_ClearExternalSceneVision(IMetaRendererSceneCallbacks*) noexcept {}
+qboolean R_CullBox(vec3_t mins, vec3_t maxs)
+{
+    ++cullQueries;
+    return rejectAll || !Intersects(mins, maxs, viewMins, viewMaxs);
+}
+int triapi_BoxInPVS(float* mins, float* maxs)
+{
+    ++pvsQueries;
+    return !rejectAll && Intersects(mins, maxs, pvsMins, pvsMaxs);
+}
+
+#include "scene_culling_dispatch.inc"
+#include "scene_lights_dispatch.inc"
+
+namespace
+{
+struct Owner final : IMetaRendererSceneCallbacks
+{
+    void DrawOpaqueScene(uint32_t) override {}
+};
+
+struct Shadow final : IShadowTexture
+{
+    bool ready = true;
+    mat4 matrix{};
+    float viewport[4]{};
+    bool IsReady() const override { return ready; }
+    void SetReady(bool value) override { ready = value; }
+    bool IsSingleLayer() const override { return false; }
+    bool IsCascaded() const override { return false; }
+    bool IsCubemap() const override { return true; }
+    bool IsStatic() const override { return true; }
+    GLuint GetDepthTexture() const override { return 0; }
+    uint32_t GetTextureSize() const override { return 256; }
+    void SetViewport(float, float, float, float) override {}
+    const float* GetViewport() const override { return viewport; }
+    void SetWorldMatrix(int, const mat4*) override {}
+    void SetProjectionMatrix(int, const mat4*) override {}
+    void SetShadowMatrix(int, const mat4*) override {}
+    const mat4* GetWorldMatrix(int) const override { return &matrix; }
+    const mat4* GetProjectionMatrix(int) const override { return &matrix; }
+    const mat4* GetShadowMatrix(int) const override { return &matrix; }
+    void SetCSMDistance(int, float) override {}
+    float GetCSMDistance(int) const override { return 0; }
+};
+
+std::vector<CDynamicLight*> VisiblePointers()
+{
+    std::vector<CDynamicLight*> result;
+    for (const auto& value : g_VisibleDynamicLights) result.push_back(value.m_pDynamicLight.get());
+    std::sort(result.begin(), result.end(), std::less<CDynamicLight*>());
+    return result;
+}
+
+void ResetQueryBounds()
+{
+    rejectAll = false;
+    for (int axis = 0; axis < 3; ++axis)
+    {
+        eye[axis] = 0;
+        viewMins[axis] = pvsMins[axis] = -100000;
+        viewMaxs[axis] = pvsMaxs[axis] = 100000;
+    }
+}
+}
+
+int main()
+{
+    static_assert(sizeof(MetaRendererSceneLight) == 20 && alignof(MetaRendererSceneLight) == 4);
+    static_assert(std::is_standard_layout_v<MetaRendererSceneLight> && std::is_trivially_copyable_v<MetaRendererSceneLight>);
+    static_assert(noexcept(std::declval<IMetaRendererSceneLights&>().UpdateLights(nullptr, nullptr, 0)));
+    static_assert(noexcept(std::declval<IMetaRendererSceneLights&>().ClearLights(nullptr)));
+    r_refdef.vieworg = &eye;
+    gEngfuncs.pfnRegisterVariable = [](const char*, const char*, int) -> cvar_t* { static cvar_t value{}; return &value; };
+    MapConVar ambient("ambient", "0", 0, 1, 0), diffuse("diffuse", "0", 0, 1, 0),
+        specular("specular", "0", 0, 1, 0), power("power", "0", 0, 1, 0);
+    r_dynlight_ambient = &ambient;
+    r_dynlight_diffuse = &diffuse;
+    r_dynlight_specular = &specular;
+    r_dynlight_specularpow = &power;
+    ambient.GetRawCvarValues()[0] = .11f;
+    diffuse.GetRawCvarValues()[0] = .72f;
+    specular.GetRawCvarValues()[0] = .23f;
+    power.GetRawCvarValues()[0] = 17;
+
+    int result{};
+    auto* scene = static_cast<IMetaRendererScene*>(CreateInterface(METARENDERER_SCENE_INTERFACE_VERSION, &result));
+    Check(scene && result == IFACE_OK);
+    auto* api = static_cast<IMetaRendererSceneLights*>(CreateInterface(METARENDERER_SCENE_LIGHTS_INTERFACE_VERSION, &result));
+    Check(api && result == IFACE_OK);
+    Check(CreateInterface(METARENDERER_SCENE_CULLING_INTERFACE_VERSION, nullptr) != nullptr);
+    Check(!CreateInterface("MetaRendererSceneLights_API_999", &result) && result == IFACE_FAILED);
+    Owner first, second, unregistered;
+    MetaRendererSceneLight single{{1200, 0, 0}, 96, 0xaaff8040};
+    Check(!api->UpdateLights(&first, &single, 1));
+    Check(!api->UpdateLights(nullptr, &single, 1));
+    Check(!api->UpdateLights(&unregistered, nullptr, 0));
+    scene->RegisterSceneCallbacks(&first);
+    scene->RegisterSceneCallbacks(&second);
+    Check(api->UpdateLights(&first, &single, 1));
+    single.origin[0] = 9999; // Caller owns/frees/mutates its input after the call.
+    Check(g_ExternalDynamicLights[0]->origin[0] == 1200);
+    single.origin[0] = 1200;
+
+    // More than the entire engine light pool, including emitters far beyond
+    // the removed 24-block camera cutoff, reach the normal per-view pipeline.
+    std::vector<MetaRendererSceneLight> many;
+    for (int i = 0; i < 96; ++i) many.push_back({{1200.0f + i * 32, float(i % 7) * 8, 0}, 96, 0xffa07040});
+    auto host = std::make_shared<CDynamicLight>();
+    host->type = DynamicLightType_Point;
+    host->size = 64;
+    host->color[0] = .123f;
+    g_EngineDynamicLights.push_back(host);
+    Check(api->UpdateLights(&first, many.data(), static_cast<uint32_t>(many.size())));
+    Check(api->UpdateLights(&second, &single, 1));
+    R_RenderViewStart();
+    Check(g_VisibleDynamicLights.size() == 98 && g_ExternalDynamicLights.size() == 97);
+    Check(g_EngineDynamicLights.size() == 1 && g_EngineDynamicLights[0] == host && host->color[0] == .123f && host->shadow == 0);
+    for (const auto& light : g_ExternalDynamicLights)
+    {
+        Check(light->static_shadow_size == 256 && light->dynamic_shadow_size == 256 && light->shadow == 1);
+        Check(light->ambient == .11f && light->diffuse == .72f && light->specular == .23f && light->specularpow == 17);
+        light->pStaticShadowTexture = std::make_shared<Shadow>();
+        light->pDynamicShadowTexture = std::make_shared<Shadow>();
+    }
+    auto previous = g_ExternalDynamicLights;
+    const auto beforeStable = allocations;
+    for (int i = 0; i < 64; ++i)
+    {
+        Check(api->UpdateLights(&first, many.data(), static_cast<uint32_t>(many.size())));
+        R_RenderViewStart();
+    }
+    Check(allocations == beforeStable);
+    Check(previous == g_ExternalDynamicLights);
+    for (const auto& light : g_ExternalDynamicLights) Check(light->pStaticShadowTexture->IsReady());
+    diffuse.GetRawCvarValues()[0] = .91f;
+    R_RenderViewStart();
+    Check(g_ExternalDynamicLights[0]->diffuse == .91f);
+
+    // Input ordering is not emitter identity: chunk reorder/removal must not
+    // destroy unchanged light objects or their cached shadows.
+    std::reverse(many.begin(), many.end());
+    Check(api->UpdateLights(&first, many.data(), static_cast<uint32_t>(many.size())));
+    for (const auto& light : previous) Check(std::find(g_ExternalDynamicLights.begin(), g_ExternalDynamicLights.end(), light) != g_ExternalDynamicLights.end());
+    many.erase(many.begin() + 15);
+    Check(api->UpdateLights(&first, many.data(), static_cast<uint32_t>(many.size())));
+    Check(g_ExternalDynamicLights.size() == 96);
+    for (const auto& light : g_ExternalDynamicLights) Check(light->pStaticShadowTexture && light->pStaticShadowTexture->IsReady());
+
+    // Every invalid request and every injected allocation failure preserves
+    // both owners' previous snapshots and their currently visible references.
+    previous = g_ExternalDynamicLights;
+    R_RenderViewStart();
+    const auto visibleBefore = VisiblePointers();
+    Check(!api->UpdateLights(&first, nullptr, 1));
+    Check(!api->UpdateLights(&first, &single, META_SCENE_LIGHTS_MAX_COUNT + 1));
+    for (float bad : {0.0f, -1.0f, 1000000.0f, std::numeric_limits<float>::infinity(), std::numeric_limits<float>::quiet_NaN()})
+    {
+        auto invalid = single;
+        invalid.radius = bad;
+        Check(!api->UpdateLights(&first, &invalid, 1));
+        Check(g_ExternalDynamicLights == previous && VisiblePointers() == visibleBefore);
+    }
+    for (int axis = 0; axis < 3; ++axis)
+        for (float bad : {std::numeric_limits<float>::infinity(), -std::numeric_limits<float>::infinity(), std::numeric_limits<float>::quiet_NaN()})
+        {
+            auto invalid = single;
+            invalid.origin[axis] = bad;
+            Check(!api->UpdateLights(&first, &invalid, 1));
+            Check(g_ExternalDynamicLights == previous);
+        }
+    auto changed = many;
+    changed.back().origin[1] += 1;
+    unsigned rejectedAllocations = 0;
+    for (int budget = 0; budget < 32; ++budget)
+    {
+        failAfter = budget;
+        const bool accepted = api->UpdateLights(&first, changed.data(), static_cast<uint32_t>(changed.size()));
+        failAfter = -1;
+        if (accepted) break;
+        ++rejectedAllocations;
+        Check(g_ExternalDynamicLights == previous && VisiblePointers() == visibleBefore);
+    }
+    Check(rejectedAllocations >= 5 && rejectedAllocations < 32);
+    previous.clear();
+    api->ClearLights(&first);
+    api->ClearLights(&second);
+    Check(g_ExternalDynamicLights.empty());
+    Check(g_EngineDynamicLights.size() == 1 && g_EngineDynamicLights[0] == host);
+
+    // The BVH must produce the same result as ordinary point-light selection,
+    // including eye-inside, touching extents, sparse views and separate PVS.
+    std::mt19937 random(0x4c495447);
+    std::uniform_real_distribution<float> coordinate(-10000, 10000), radius(1, 768);
+    many.clear();
+    for (int i = 0; i < 4096; ++i) many.push_back({{coordinate(random), coordinate(random), coordinate(random)}, radius(random), 0xff8080ff});
+    Check(api->UpdateLights(&first, many.data(), static_cast<uint32_t>(many.size())));
+    for (int view = 0; view < 128; ++view)
+    {
+        for (int axis = 0; axis < 3; ++axis)
+        {
+            eye[axis] = coordinate(random);
+            viewMins[axis] = eye[axis] - 800;
+            viewMaxs[axis] = eye[axis] + 800;
+            pvsMins[axis] = eye[axis] - 300;
+            pvsMaxs[axis] = eye[axis] + 300;
+        }
+        g_VisibleDynamicLights.clear();
+        for (const auto& light : g_ExternalDynamicLights) R_AddVisibleDynamicLight(light);
+        const auto expected = VisiblePointers();
+        g_VisibleDynamicLights.clear();
+        const auto before = allocations;
+        R_AddVisibleExternalSceneLights();
+        Check(allocations == before);
+        Check(VisiblePointers() == expected);
+    }
+    ResetQueryBounds();
+    for (int axis = 0; axis < 3; ++axis) eye[axis] = 50500, viewMins[axis] = 50000, viewMaxs[axis] = 51000;
+    cullQueries = pvsQueries = 0;
+    g_VisibleDynamicLights.clear();
+    R_AddVisibleExternalSceneLights();
+    Check(g_VisibleDynamicLights.empty() && cullQueries < 32 && pvsQueries == 0);
+    api->ClearLights(&first);
+    ResetQueryBounds();
+    single = {{176, 0, 0}, 144, 0xffffffff};
+    Check(api->UpdateLights(&first, &single, 1));
+    rejectAll = true;
+    g_VisibleDynamicLights.clear();
+    R_AddVisibleExternalSceneLights();
+    Check(g_VisibleDynamicLights.size() == 1); // exact radius + 32 boundary
+    eye[0] = -1;
+    g_VisibleDynamicLights.clear();
+    R_AddVisibleExternalSceneLights();
+    Check(g_VisibleDynamicLights.empty());
+    ResetQueryBounds();
+
+    // A currently invisible external emitter must invalidate its cached world
+    // shadow when mining changes its volume, just like a host dynamic light.
+    auto external = g_ExternalDynamicLights[0];
+    external->pStaticShadowTexture = std::make_shared<Shadow>();
+    host->pStaticShadowTexture = std::make_shared<Shadow>();
+    goldcraft::carving::Box edit{{175, -1, -1}, {177, 1, 1}};
+    g_VisibleDynamicLights.clear();
+    R_InvalidateWorldShadowCaches(std::span(&edit, 1));
+    Check(!external->pStaticShadowTexture->IsReady() && host->pStaticShadowTexture->IsReady());
+    external->pStaticShadowTexture->SetReady(true);
+    edit = {{10000, 10000, 10000}, {10001, 10001, 10001}};
+    R_InvalidateWorldShadowCaches(std::span(&edit, 1));
+    Check(external->pStaticShadowTexture->IsReady());
+    R_InvalidateWorldShadowCaches({});
+    Check(!external->pStaticShadowTexture->IsReady() && !host->pStaticShadowTexture->IsReady());
+    std::weak_ptr<CDynamicLight> released = external;
+    external.reset();
+    R_RenderViewStart();
+    scene->UnregisterSceneCallbacks(&first);
+    Check(g_ExternalDynamicLights.empty() && released.expired());
+    Check(!api->UpdateLights(&first, &single, 1));
+    Check(g_VisibleDynamicLights.size() == 1 && g_VisibleDynamicLights[0].m_pDynamicLight == host);
+    scene->RegisterSceneCallbacks(&first);
+    Check(api->UpdateLights(&first, &single, 1));
+    R_RenderViewStart();
+    R_ResetExternalSceneLights(); // Real map-teardown/shutdown hook target.
+    Check(g_ExternalDynamicLights.empty() && g_VisibleDynamicLights.size() == 1);
+    Check(api->UpdateLights(&first, &single, 1)); // Registration survives map load.
+    Check(api->UpdateLights(&first, nullptr, 0) && g_ExternalDynamicLights.empty());
+    api->ClearLights(nullptr);
+    api->ClearLights(&unregistered);
+
+    // Shadow cache lifetime uses the union of every view in the frame. A
+    // reflection/second view must not evict resources needed by the first.
+    const MetaRendererSceneLight cacheLights[]{
+        {{-2000, 0, 0}, 64, 0xffffffff}, {{0, 0, 0}, 64, 0xffffffff}, {{2000, 0, 0}, 64, 0xffffffff}};
+    Check(api->UpdateLights(&first, cacheLights, 3));
+    auto left = g_ExternalDynamicLights[0], middle = g_ExternalDynamicLights[1], right = g_ExternalDynamicLights[2];
+    ResetQueryBounds();
+    R_RenderViewStart(); // All three first become visible and acquire resources.
+    for (const auto& light : g_ExternalDynamicLights)
+    {
+        light->pStaticShadowTexture = std::make_shared<Shadow>();
+        light->pDynamicShadowTexture = std::make_shared<Shadow>();
+    }
+    auto leftStatic = left->pStaticShadowTexture;
+    auto rightStatic = right->pStaticShadowTexture;
+    const auto viewAt = [](float x) {
+        eye[0] = x;
+        viewMins[0] = x - 200;
+        viewMaxs[0] = x + 200;
+        R_RenderViewStart();
+    };
+    ++frameNumber;
+    viewAt(-2000);
+    viewAt(2000);
+    R_EndExternalSceneLightsFrame();
+    Check(left->pStaticShadowTexture == leftStatic && right->pStaticShadowTexture == rightStatic);
+    Check(left->pDynamicShadowTexture && right->pDynamicShadowTexture);
+    Check(!middle->pStaticShadowTexture && !middle->pDynamicShadowTexture);
+    Check(g_ExternalDynamicLights.size() == 3 && sceneShadowCandidates.size() == 2);
+    const auto stableCacheAllocations = allocations;
+    for (int i = 0; i < 64; ++i)
+    {
+        ++frameNumber;
+        viewAt(-2000);
+        viewAt(2000);
+        R_EndExternalSceneLightsFrame();
+    }
+    Check(allocations == stableCacheAllocations);
+    Check(left->pStaticShadowTexture == leftStatic && right->pStaticShadowTexture == rightStatic);
+    ++frameNumber;
+    viewAt(-2000);
+    R_EndExternalSceneLightsFrame();
+    Check(left->pStaticShadowTexture == leftStatic && !right->pStaticShadowTexture && !right->pDynamicShadowTexture);
+    Check(sceneShadowCandidates.size() == 1 && g_ExternalDynamicLights.size() == 3);
+    ++frameNumber;
+    viewAt(2000);
+    Check(g_VisibleDynamicLights.size() == 1 && g_VisibleDynamicLights[0].m_pDynamicLight == right);
+    Check(right->shadow == 1 && right->static_shadow_size == 256 && right->dynamic_shadow_size == 256);
+    Check(!right->pStaticShadowTexture); // Normal shadow pass will recreate it.
+    right->pStaticShadowTexture = std::make_shared<Shadow>();
+    right->pDynamicShadowTexture = std::make_shared<Shadow>();
+    R_EndExternalSceneLightsFrame();
+    Check(right->pStaticShadowTexture && !left->pStaticShadowTexture && sceneShadowCandidates.size() == 1);
+    // An owner update preserves the surviving cached light while removing the
+    // other descriptions, and Clear releases the cache's owning references.
+    Check(api->UpdateLights(&first, &cacheLights[2], 1));
+    Check(sceneShadowCandidates.size() == 1 && sceneShadowCandidates[0] == right);
+    Check(api->UpdateLights(&second, &cacheLights[0], 1));
+    viewAt(-2000);
+    Check(sceneShadowCandidates.size() == 2);
+    api->ClearLights(&first);
+    Check(sceneShadowCandidates.size() == 1 && sceneShadowCandidates[0]->external_scene_owner == &second);
+    api->ClearLights(&second);
+    Check(sceneShadowCandidates.empty() && g_ExternalDynamicLights.empty());
+    left.reset();
+    middle.reset();
+    right.reset();
+    ResetQueryBounds();
+
+    // Exercise the accepted upper count, not just overflow rejection. This is
+    // a CPU snapshot boundary test; no shadow textures or GL work are created.
+    std::vector<MetaRendererSceneLight> maximum(META_SCENE_LIGHTS_MAX_COUNT, single);
+    Check(api->UpdateLights(&first, maximum.data(), static_cast<uint32_t>(maximum.size())));
+    Check(g_ExternalDynamicLights.size() == META_SCENE_LIGHTS_MAX_COUNT);
+    const auto beforeMaximum = allocations;
+    Check(api->UpdateLights(&first, maximum.data(), static_cast<uint32_t>(maximum.size())));
+    Check(allocations == beforeMaximum);
+    R_ResetExternalSceneLights();
+    scene->UnregisterSceneCallbacks(&first);
+    scene->UnregisterSceneCallbacks(&second);
+    g_VisibleDynamicLights.clear();
+    g_EngineDynamicLights.clear();
+    std::printf("{\"sceneLightsChecks\":%u,\"allocationFailureBoundaries\":%u,\"visibilityViews\":128,\"maxSnapshot\":%u,\"steadyAllocations\":0,\"allViewCacheEviction\":true,\"realGL\":false,\"passed\":true}\n",
+        checks, rejectedAllocations, META_SCENE_LIGHTS_MAX_COUNT);
+}
diff --git a/include/Interface/IMetaRendererSceneStaticShadows.h b/include/Interface/IMetaRendererSceneStaticShadows.h
new file mode 100644
index 0000000..47711a6
--- /dev/null
+++ b/include/Interface/IMetaRendererSceneStaticShadows.h
@@ -0,0 +1,38 @@
+#pragma once
+#include <IMetaRendererScene.h>
+
+// Optional extension. Neither Scene001 nor its ordinary callbacks change ABI.
+class IMetaRendererStaticSceneCallbacks : public IBaseInterface
+{
+public:
+    // Called only inside a point light's static WORLD cubemap pass, with the
+    // same Scene001 flags, CameraUBO, target and GL restoration requirements.
+    // Render only geometry whose changes are reported through Invalidate.
+    // true means the complete relevant static scene was handled; an empty or
+    // fully culled scene is successful. false forces the ordinary dynamic
+    // scene path for every registered owner for this light until a later retry.
+    virtual bool DrawStaticShadow(uint32_t flags) noexcept = 0;
+};
+
+class IMetaRendererSceneStaticShadows : public IBaseInterface
+{
+public:
+    // Renderer thread only. Call registration, removal and invalidation
+    // outside all scene draw callbacks. Registration requires a live Scene001
+    // owner. Same owner/callback is
+    // idempotent. Replacement/removal invalidates all world-shadow caches.
+    virtual bool RegisterStaticScene(IMetaRendererSceneCallbacks* owner,
+                                     IMetaRendererStaticSceneCallbacks* callbacks) noexcept = 0;
+    virtual void UnregisterStaticScene(IMetaRendererSceneCallbacks* owner) noexcept = 0;
+    // Invalidate both previous and new bounds when static geometry changes.
+    // GoldSrc AABB; null, nonfinite or inverted bounds invalidate all lights.
+    virtual void InvalidateStaticScene(IMetaRendererSceneCallbacks* owner,
+                                      const float* mins, const float* maxs) noexcept = 0;
+    // true only during this owner's ordinary point-light dynamic shadow
+    // callback, when that light's ready static cubemap includes all currently
+    // registered static scenes. Never skip dynamic actors/particles on true.
+    // Outside that dispatch, for spot/directional/static0/failed caches: false.
+    virtual bool IsStaticSceneCovered(IMetaRendererSceneCallbacks* owner) noexcept = 0;
+};
+
+#define METARENDERER_SCENE_STATIC_SHADOWS_INTERFACE_VERSION "MetaRendererSceneStaticShadows_API_001"
