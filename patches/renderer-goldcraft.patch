+#pragma once
+#include <IMetaRendererSceneStaticShadows.h>
+#include <memory>
+
+class IShadowTexture;
+
+class RStaticScenePointLightScope
+{
+    const RStaticScenePointLightScope* previous_;
+    std::shared_ptr<IShadowTexture>* texture_;
+    unsigned size_;
+    friend bool R_IsExternalStaticSceneCovered(IMetaRendererSceneCallbacks*) noexcept;
+    friend bool R_DrawExternalStaticShadowScene(uint32_t) noexcept;
+public:
+    RStaticScenePointLightScope(std::shared_ptr<IShadowTexture>* texture, unsigned size) noexcept;
+    ~RStaticScenePointLightScope();
+    RStaticScenePointLightScope(const RStaticScenePointLightScope&) = delete;
+    RStaticScenePointLightScope& operator=(const RStaticScenePointLightScope&) = delete;
+};
+
+class RStaticSceneBakeScope
+{
+    RStaticSceneBakeScope* previous_;
+    uint64_t revision_;
+    bool hasScenes_;
+    bool dispatched_{};
+    bool succeeded_{};
+    bool worldComplete_{};
+    friend bool R_DrawExternalStaticShadowScene(uint32_t) noexcept;
+    friend void R_MarkExternalStaticWorldComplete(bool) noexcept;
+public:
+    RStaticSceneBakeScope() noexcept;
+    ~RStaticSceneBakeScope();
+    bool Complete(bool worldRendered) const noexcept;
+    RStaticSceneBakeScope(const RStaticSceneBakeScope&) = delete;
+    RStaticSceneBakeScope& operator=(const RStaticSceneBakeScope&) = delete;
+};
+
+class RExternalStaticSceneDispatchScope
+{
+    IMetaRendererSceneCallbacks* previous_;
+public:
+    explicit RExternalStaticSceneDispatchScope(IMetaRendererSceneCallbacks* owner) noexcept;
+    ~RExternalStaticSceneDispatchScope();
+    RExternalStaticSceneDispatchScope(const RExternalStaticSceneDispatchScope&) = delete;
+    RExternalStaticSceneDispatchScope& operator=(const RExternalStaticSceneDispatchScope&) = delete;
+};
+
+bool R_PointShadowHasReadyStaticWorld(const std::shared_ptr<IShadowTexture>* texture, unsigned size) noexcept;
+bool R_DrawExternalStaticShadowScene(uint32_t flags) noexcept;
+bool R_IsExternalStaticSceneCovered(IMetaRendererSceneCallbacks* owner) noexcept;
+void R_MarkExternalStaticWorldComplete(bool complete) noexcept;
+void R_UnregisterExternalStaticScene(IMetaRendererSceneCallbacks* owner) noexcept;
+void R_ExternalStaticSceneNewMap() noexcept;
+void R_ShutdownExternalStaticScenes() noexcept;
diff --git a/src/gl_scene_static_shadows.cpp b/src/gl_scene_static_shadows.cpp
new file mode 100644
index 0000000..06f26b3
--- /dev/null
+++ b/src/gl_scene_static_shadows.cpp
@@ -0,0 +1,179 @@
+#include "gl_local.h"
+#include "gl_external_scene.h"
+#include "gl_scene_static_shadows.h"
+#include "gl_shadow_cull.h"
+#include <algorithm>
+#include <array>
+#include <cmath>
+
+namespace
+{
+struct StaticScene
+{
+    IMetaRendererSceneCallbacks* owner{};
+    IMetaRendererStaticSceneCallbacks* callbacks{};
+};
+std::array<StaticScene, 16> staticScenes;
+uint64_t staticSceneRevision{};
+unsigned staticSceneDispatchDepth{};
+const RStaticScenePointLightScope* currentPointStaticScene{};
+RStaticSceneBakeScope* currentStaticBake{};
+IMetaRendererSceneCallbacks* currentDynamicSceneOwner{};
+
+auto FindStaticScene(IMetaRendererSceneCallbacks* owner) noexcept
+{
+    return std::find_if(staticScenes.begin(), staticScenes.end(),
+        [owner](const auto& scene) { return scene.owner == owner; });
+}
+
+void InvalidateAllStaticScenes() noexcept
+{
+    ++staticSceneRevision;
+    R_InvalidateWorldShadowCaches({});
+}
+}
+
+RStaticScenePointLightScope::RStaticScenePointLightScope(std::shared_ptr<IShadowTexture>* texture, unsigned size) noexcept :
+    previous_(currentPointStaticScene), texture_(texture), size_(size)
+{
+    currentPointStaticScene = this;
+}
+RStaticScenePointLightScope::~RStaticScenePointLightScope() { currentPointStaticScene = previous_; }
+
+RStaticSceneBakeScope::RStaticSceneBakeScope() noexcept :
+    previous_(currentStaticBake), revision_(staticSceneRevision),
+    hasScenes_(std::any_of(staticScenes.begin(), staticScenes.end(), [](const auto& scene) { return scene.owner != nullptr; }))
+{
+    currentStaticBake = this;
+}
+RStaticSceneBakeScope::~RStaticSceneBakeScope() { currentStaticBake = previous_; }
+
+bool RStaticSceneBakeScope::Complete(bool worldRendered) const noexcept
+{
+    if (staticSceneRevision != revision_) return false;
+    // Preserve ordinary Renderer semantics when nobody opted in. With an
+    // opted-in scene, successful empty work is a valid cleared shadow cache.
+    return hasScenes_ ? worldComplete_ && dispatched_ && succeeded_ : worldRendered;
+}
+
+void R_MarkExternalStaticWorldComplete(bool complete) noexcept
+{
+    if (currentStaticBake) currentStaticBake->worldComplete_ = complete;
+}
+
+RExternalStaticSceneDispatchScope::RExternalStaticSceneDispatchScope(IMetaRendererSceneCallbacks* owner) noexcept :
+    previous_(currentDynamicSceneOwner)
+{
+    currentDynamicSceneOwner = owner;
+}
+RExternalStaticSceneDispatchScope::~RExternalStaticSceneDispatchScope() { currentDynamicSceneOwner = previous_; }
+
+bool R_PointShadowHasReadyStaticWorld(const std::shared_ptr<IShadowTexture>* texture, unsigned size) noexcept
+{
+    return size > 0 && texture && *texture && (*texture)->IsReady() && (*texture)->IsStatic() &&
+           (*texture)->IsCubemap() && (*texture)->GetTextureSize() == size;
+}
+
+bool R_DrawExternalStaticShadowScene(uint32_t flags) noexcept
+{
+    if (!currentStaticBake || !currentPointStaticScene || !currentPointStaticScene->texture_ || !currentPointStaticScene->size_ ||
+        !(flags & META_SCENE_SHADOW) || !(r_draw_classify & DRAW_CLASSIFY_WORLD) ||
+        (r_draw_classify & DRAW_CLASSIFY_OPAQUE_ENTITIES)) return false;
+    auto& bake = *currentStaticBake;
+    // A reentrant dispatch must never certify a partially drawn static scene.
+    if (staticSceneDispatchDepth)
+    {
+        bake.succeeded_ = false;
+        return true;
+    }
+    const bool firstDispatch = !bake.dispatched_;
+    bake.dispatched_ = true;
+    bake.succeeded_ = firstDispatch;
+    ++staticSceneDispatchDepth;
+    R_SetGBufferMask(GBUFFER_MASK_ALL);
+    RExternalSceneShadowCullScope cullScope(true);
+    for (const auto& scene : staticScenes)
+        if (scene.owner && scene.callbacks)
+        {
+            // Do not short-circuit: each opted-in owner must get a chance to
+            // prepare/draw. Any failure invalidates the entire static cache.
+            const bool success = scene.callbacks->DrawStaticShadow(flags);
+            bake.succeeded_ &= success;
+        }
+    --staticSceneDispatchDepth;
+    return true;
+}
+
+bool R_IsExternalStaticSceneCovered(IMetaRendererSceneCallbacks* owner) noexcept
+{
+    return owner && owner == currentDynamicSceneOwner && currentPointStaticScene && !currentStaticBake &&
+           R_IsRenderingShadowView() && (r_draw_classify & DRAW_CLASSIFY_OPAQUE_ENTITIES) &&
+           FindStaticScene(owner) != staticScenes.end() &&
+           R_PointShadowHasReadyStaticWorld(currentPointStaticScene->texture_, currentPointStaticScene->size_);
+}
+
+void R_UnregisterExternalStaticScene(IMetaRendererSceneCallbacks* owner) noexcept
+{
+    if (!owner) return;
+    const auto entry = FindStaticScene(owner);
+    if (entry == staticScenes.end()) return;
+    *entry = {};
+    InvalidateAllStaticScenes();
+}
+
+void R_ExternalStaticSceneNewMap() noexcept
+{
+    // Scene001 registrations survive map reload. Keep opt-in registrations in
+    // lockstep; invalidate their old geometry and discard transient coverage.
+    InvalidateAllStaticScenes();
+    currentPointStaticScene = nullptr;
+    currentStaticBake = nullptr;
+    currentDynamicSceneOwner = nullptr;
+}
+
+void R_ShutdownExternalStaticScenes() noexcept
+{
+    staticScenes = {};
+    R_ExternalStaticSceneNewMap();
+}
+
+class CMetaRendererSceneStaticShadows final : public IMetaRendererSceneStaticShadows
+{
+public:
+    bool RegisterStaticScene(IMetaRendererSceneCallbacks* owner, IMetaRendererStaticSceneCallbacks* callbacks) noexcept override
+    {
+        if (!callbacks || !R_IsExternalSceneOwner(owner) || staticSceneDispatchDepth || currentDynamicSceneOwner) return false;
+        auto entry = FindStaticScene(owner);
+        if (entry != staticScenes.end() && entry->callbacks == callbacks) return true;
+        if (entry == staticScenes.end()) entry = FindStaticScene(nullptr);
+        if (entry == staticScenes.end()) return false;
+        *entry = {owner, callbacks};
+        InvalidateAllStaticScenes();
+        return true;
+    }
+    void UnregisterStaticScene(IMetaRendererSceneCallbacks* owner) noexcept override { R_UnregisterExternalStaticScene(owner); }
+    void InvalidateStaticScene(IMetaRendererSceneCallbacks* owner, const float* mins, const float* maxs) noexcept override
+    {
+        if (!owner || FindStaticScene(owner) == staticScenes.end()) return;
+        ++staticSceneRevision;
+        goldcraft::carving::Box box{};
+        if (mins && maxs)
+        {
+            bool valid = true;
+            for (int axis = 0; axis < 3; ++axis)
+            {
+                valid &= std::isfinite(mins[axis]) && std::isfinite(maxs[axis]) && mins[axis] <= maxs[axis];
+                box.min[axis] = mins[axis];
+                box.max[axis] = maxs[axis];
+            }
+            if (valid)
+            {
+                R_InvalidateWorldShadowCaches(std::span(&box, 1));
+                return;
+            }
+        }
+        R_InvalidateWorldShadowCaches({});
+    }
+    bool IsStaticSceneCovered(IMetaRendererSceneCallbacks* owner) noexcept override { return R_IsExternalStaticSceneCovered(owner); }
+};
+EXPOSE_SINGLE_INTERFACE(CMetaRendererSceneStaticShadows, IMetaRendererSceneStaticShadows, METARENDERER_SCENE_STATIC_SHADOWS_INTERFACE_VERSION);
