+"""Run production Studio UBO submission in the real-GL fixture, without engine callbacks."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from extract_studio_depth_executor import function
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--src", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--manifest", type=Path, required=True)
+    args = parser.parse_args()
+    paths = {name: args.src / name for name in ("gl_studio.cpp", "gl_draw.cpp", "gl_rmain.cpp",
+                                               "studio_bone_palette.h", "studio_bone_palette_gl.h")}
+    sources = {name: path.read_text(encoding="utf-8-sig") for name, path in paths.items()}
+    studio = sources["gl_studio.cpp"]
+    draw = function(studio, "void R_StudioDrawRenderDataBegin(")
+    if draw.count("R_StudioUploadDrawBuffers(StudioUBO, *pbonetransform,") != 1 or "static_cast<uint32_t>(*r_framecount)" not in draw:
+        raise SystemExit("Production palette submission/frame wiring changed")
+    if "R_ResetStudioBonePalette();" not in function(sources["gl_rmain.cpp"], "void R_NewMap("):
+        raise SystemExit("Missing unconditional map palette cleanup")
+    for signature in ("void R_InitStudio(", "void R_ShutdownStudio("):
+        if "R_ResetStudioBonePalette();" not in function(studio, signature):
+            raise SystemExit("Missing palette lifecycle cleanup: " + signature)
+    code = "// Exact production function bodies.\n\n" + "\n\n".join((
+        function(sources["gl_draw.cpp"], "void GL_UploadSubDataToUBO("),
+        function(sources["gl_draw.cpp"], "void GL_UploadDrawParameters("),
+        function(studio, "void R_ResetStudioBonePalette("),
+        function(studio, "static void R_StudioUploadDrawBuffers("))) + "\n"
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(code, encoding="utf-8")
+    args.manifest.write_text(json.dumps({
+        "sourceSha256": {name: hashlib.sha256(path.read_bytes()).hexdigest() for name, path in paths.items()},
+        "extractedSha256": hashlib.sha256(code.encode()).hexdigest(),
+        "scope": "Unchanged production GPU storage, submission and cleanup; lifecycle call sites checked. Host animation/callback execution and live FPS are not tested here."
+    }, indent=2) + "\n", encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
