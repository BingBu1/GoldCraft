+constexpr int Width = 256, Height = 192, Frames = 6;
+constexpr GLuint ModelBinding = 1, MaterialBinding = 5, ScratchBinding = 7, GuardBinding = 3;
+constexpr std::array<float, 4> ClearColor{.015625f, .03125f, .046875f, 1.f};
+struct alignas(16) Parameters { std::array<float, 16> matrix{}; std::array<float, 4> color{}; };
+static_assert(sizeof(Parameters) == 80 && offsetof(Parameters, color) == 64);
+struct Rectangle
+{
+    int x{}, y{}, halfX{}, halfY{};
+    float depth{};
+    Parameters parameters;
+};
+struct Image { std::vector<float> color, depth; };
+
+Parameters Material(float factor = 1.f)
+{
+    Parameters result{}; result.color = {factor, .75f, .5f, 1.f}; return result;
+}
+Rectangle MakeRectangle(unsigned tile, unsigned layer, unsigned seed)
+{
+    Rectangle result;
+    result.x = static_cast<int>(tile % 32) * 8 + 4;
+    result.y = static_cast<int>(tile / 32) * 8 + 4;
+    int sx = layer ? 1 : 3, sy = layer ? 2 : 2;
+    const unsigned quarter = (tile + seed + layer) % 4;
+    result.halfX = quarter % 2 ? sy : sx; result.halfY = quarter % 2 ? sx : sy;
+    if (layer) { result.x += (tile & 1) ? 1 : -1; result.y += (tile & 2) ? 1 : -1; }
+    result.depth = layer ? ((tile % 3) ? .8125f : .125f) : .375f + float((tile + seed) % 5) / 32.f;
+    constexpr int cosine[]{1, 0, -1, 0}, sine[]{0, 1, 0, -1};
+    auto& m = result.parameters.matrix;
+    m[0] = 2.f * sx * cosine[quarter] / Width; m[1] = 2.f * sx * sine[quarter] / Height;
+    m[4] = -2.f * sy * sine[quarter] / Width; m[5] = 2.f * sy * cosine[quarter] / Height;
+    m[10] = 1; m[12] = 2.f * result.x / Width - 1.f; m[13] = 2.f * result.y / Height - 1.f;
+    m[14] = result.depth * 2.f - 1.f; m[15] = 1;
+    const unsigned value = tile * 193u + layer * 971u + seed * 1237u;
+    result.parameters.color = {float(1 + value % 239) / 256.f,
+        float(1 + (value / 3) % 233) / 256.f, float(1 + (value / 7) % 227) / 256.f, 1.f};
+    return result;
+}
+std::vector<Rectangle> Rectangles(unsigned seed)
+{
+    std::vector<Rectangle> result; result.reserve(1536);
+    // Layer two arrives after every first-layer draw, so late UBO writes cannot
+    // silently replace early transforms/colors without changing the oracle.
+    for (unsigned layer = 0; layer < 2; ++layer)
+        for (unsigned tile = 0; tile < 32 * 24; ++tile) result.push_back(MakeRectangle(tile, layer, seed));
+    return result;
+}
+Image Oracle(const std::vector<Rectangle>& rectangles, const Parameters& material)
+{
+    Image result; result.color.resize(Width * Height * 4); result.depth.assign(Width * Height, 1.f);
+    for (int i = 0; i < Width * Height; ++i) std::copy(ClearColor.begin(), ClearColor.end(), result.color.begin() + i * 4);
+    // Analytic pixel centers and integer rectangle bounds, independent of UBO
+    // bytes, storage offsets, GLSL matrix multiplication and triangle rasterizer.
+    for (const auto& r : rectangles)
+        for (int y = (std::max)(0, r.y - r.halfY); y < (std::min)(Height, r.y + r.halfY); ++y)
+            for (int x = (std::max)(0, r.x - r.halfX); x < (std::min)(Width, r.x + r.halfX); ++x)
+            {
+                const auto pixel = static_cast<std::size_t>(y * Width + x);
+                if (r.depth >= result.depth[pixel]) continue;
+                result.depth[pixel] = r.depth;
+                for (unsigned component = 0; component < 4; ++component)
+                    result.color[pixel * 4 + component] = r.parameters.color[component] * material.color[component];
+            }
+    return result;
+}
+void Compare(const Image& expected, const Image& actual, const char* name)
+{
+    Check(expected.color.size() == actual.color.size() && expected.depth.size() == actual.depth.size(), "image dimensions");
+    float colorError{}, depthError{};
+    for (std::size_t i = 0; i < actual.color.size(); ++i)
+    {
+        Check(std::isfinite(actual.color[i]), "finite color readback");
+        colorError = (std::max)(colorError, std::abs(expected.color[i] - actual.color[i]));
+    }
+    for (std::size_t i = 0; i < actual.depth.size(); ++i)
+    {
+        Check(std::isfinite(actual.depth[i]), "finite depth readback");
+        depthError = (std::max)(depthError, std::abs(expected.depth[i] - actual.depth[i]));
+    }
+    comparedPixels += actual.depth.size(); comparedDepth += actual.depth.size();
+    if (colorError > .000002f || depthError > .000002f)
+        std::fprintf(stderr, "%s: color error %.9f, depth error %.9f\n", name, colorError, depthError);
+    Check(colorError <= .000002f && depthError <= .000002f, name);
+}
+GLuint Compile(GLenum stage, const char* source)
+{
+    const GLuint shader = glCreateShader(stage); glShaderSource(shader, 1, &source, nullptr); glCompileShader(shader);
+    GLint ok{}; glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+    if (!ok) { char log[4096]{}; glGetShaderInfoLog(shader, sizeof(log), nullptr, log); std::fprintf(stderr, "%s\n", log); }
+    Check(ok != 0, "test shader compiles"); return shader;
+}
+GLuint Program()
+{
+    const auto vs = Compile(GL_VERTEX_SHADER, R"(#version 330 core
+layout(std140) uniform ModelParameters { mat4 model; vec4 color; };
+layout(std140) uniform MaterialParameters { mat4 unusedMatrix; vec4 tint; };
+flat out vec4 shaded;
+void main() {
+    const vec2 p[6] = vec2[6](vec2(-1,-1),vec2(1,-1),vec2(1,1),vec2(-1,-1),vec2(1,1),vec2(-1,1));
+    gl_Position = model * vec4(p[gl_VertexID],0,1); shaded = color * tint;
+})");
+    const auto fs = Compile(GL_FRAGMENT_SHADER, R"(#version 330 core
+flat in vec4 shaded; out vec4 outputColor; void main() { outputColor = shaded; })");
+    const GLuint program = glCreateProgram(); glAttachShader(program, vs); glAttachShader(program, fs); glLinkProgram(program);
+    GLint ok{}; glGetProgramiv(program, GL_LINK_STATUS, &ok);
+    if (!ok) { char log[4096]{}; glGetProgramInfoLog(program, sizeof(log), nullptr, log); std::fprintf(stderr, "%s\n", log); }
+    Check(ok != 0, "test shader links"); glDeleteShader(vs); glDeleteShader(fs);
+    const auto model = glGetUniformBlockIndex(program, "ModelParameters");
+    const auto material = glGetUniformBlockIndex(program, "MaterialParameters");
+    Check(model != GL_INVALID_INDEX && material != GL_INVALID_INDEX, "both indexed UBO blocks active");
+    glUniformBlockBinding(program, model, ModelBinding); glUniformBlockBinding(program, material, MaterialBinding);
+    GLint bytes{}; glGetActiveUniformBlockiv(program, model, GL_UNIFORM_BLOCK_DATA_SIZE, &bytes);
+    Check(bytes == sizeof(Parameters), "driver validates 80-byte matrix/color layout"); return program;
+}
+struct Target
+{
+    GLuint fbo{}, color{}, depth{};
+    Target()
+    {
+        glGenFramebuffers(1, &fbo); glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+        glGenTextures(1, &color); glBindTexture(GL_TEXTURE_2D, color);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA32F, Width, Height, 0, GL_RGBA, GL_FLOAT, nullptr);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, color, 0);
+        glGenTextures(1, &depth); glBindTexture(GL_TEXTURE_2D, depth);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_DEPTH_COMPONENT32F, Width, Height, 0, GL_DEPTH_COMPONENT, GL_FLOAT, nullptr);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, depth, 0);
+        glDrawBuffer(GL_COLOR_ATTACHMENT0); glReadBuffer(GL_COLOR_ATTACHMENT0);
+        Check(glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE, "float color/depth framebuffer complete");
+    }
+    ~Target() { glDeleteTextures(1, &color); glDeleteTextures(1, &depth); glDeleteFramebuffers(1, &fbo); }
+    void Clear()
+    {
+        glBindFramebuffer(GL_FRAMEBUFFER, fbo); glViewport(0, 0, Width, Height);
+        glClearBufferfv(GL_COLOR, 0, ClearColor.data()); const float depthValue = 1;
+        glClearBufferfv(GL_DEPTH, 0, &depthValue);
+    }
+    Image Read()
+    {
+        glBindFramebuffer(GL_FRAMEBUFFER, fbo); Image result;
+        result.color.resize(Width * Height * 4); result.depth.resize(Width * Height);
+        glReadPixels(0, 0, Width, Height, GL_RGBA, GL_FLOAT, result.color.data());
+        glReadPixels(0, 0, Width, Height, GL_DEPTH_COMPONENT, GL_FLOAT, result.depth.data());
+        Check(glGetError() == GL_NO_ERROR, "draw/readback remains GL-clean"); return result;
+    }
+};
+struct Fixture
+{
+    GLuint program{Program()}, vao{}, fallback{}, material{}, guard{};
+    GLint maxBlock{}, alignment{}, maxBindings{};
+    Fixture()
+    {
+        glGetIntegerv(GL_MAX_UNIFORM_BLOCK_SIZE, &maxBlock); glGetIntegerv(GL_UNIFORM_BUFFER_OFFSET_ALIGNMENT, &alignment);
+        glGetIntegerv(GL_MAX_UNIFORM_BUFFER_BINDINGS, &maxBindings);
+        Check(maxBlock >= sizeof(Parameters) && maxBindings > ScratchBinding, "driver supports test blocks and bindings");
+        glGenVertexArrays(1, &vao); glBindVertexArray(vao); glUseProgram(program);
