+class CWorldSurfaceLeafAsyncLoadTask : public CGameResourceAsyncLoadTask
+{
+private:
+    std::shared_ptr<CWorldSurfaceLeaf>       m_pLeaf;
+    std::shared_ptr<CWorldSurfaceWorldModel> m_pWorldModel;
+    model_t*                                 m_model{};
+    mleaf_t*                                 m_leaf{};
+    bool                                     m_bIsWorldLeaf{};
+
+    visnodes_t                 m_visnodes;
+    vissurfaces_t              m_vissurfaces;
+    vissurfaces_t              m_watersurfaces;
+    vissurfaces_t              m_reversedwatersurfaces;
+    std::vector<texsurfaces_t> m_texsurfaces;
+
+    std::vector<CDrawIndexAttrib>              m_vDrawAttribBuffer;
+    std::optional<goldcraft::visibility::View> m_editedView;
+
+public:
+    CWorldSurfaceLeafAsyncLoadTask(
+        const std::shared_ptr<CWorldSurfaceLeaf>&       pLeaf,
+        const std::shared_ptr<CWorldSurfaceWorldModel>& pWorldModel,
+        model_t*                                        mod,
+        mleaf_t*                                        leaf,
+        bool                                            bIsWorldLeaf) :
+        m_pLeaf(pLeaf),
+        m_pWorldModel(pWorldModel),
+        m_model(mod),
+        m_leaf(leaf),
+        m_bIsWorldLeaf(bIsWorldLeaf)
+    {
+        //m_texsurfaces[m_model->numtextures] is empty texture
+        m_texsurfaces.resize(m_model->numtextures + 1);
+
+        m_hThreadWorkItem = g_pMetaHookAPI->CreateWorkItem(g_pMetaHookAPI->GetGlobalThreadPool(), [](void* context) {
+            auto ctx = (CWorldSurfaceLeafAsyncLoadTask*)context;
+            try
+            {
+                ctx->RunTask();
+            }
+            catch (...)
+            {
+                ctx->m_pLeaf->m_LoadError = std::current_exception();
+            }
+            ctx->m_pLeaf->m_bTaskFinished.store(true, std::memory_order_release);
+            return false; }, this);
+        if (!m_hThreadWorkItem) throw std::runtime_error("World leaf worker allocation failed");
+    }
+
+    void StartAsyncTask() override
+    {
+        g_pMetaHookAPI->QueueWorkItem(g_pMetaHookAPI->GetGlobalThreadPool(), m_hThreadWorkItem);
+    }
+
+    bool RunTask() override
+    {
+        if (m_pLeaf->m_bIsClosing.load())
+            return false;
+
+        if (m_bIsWorldLeaf)
+        {
+            if (m_pWorldModel->m_pCarvedVisibility)
+                m_editedView = m_pWorldModel->m_pCarvedVisibility->view(m_pLeaf->m_uViewKey);
+            if (m_editedView) m_pLeaf->m_pVisibilityView = std::make_shared<const goldcraft::visibility::View>(*m_editedView);
+            R_MarkPVSForLeaf(m_pWorldModel->m_model, m_leaf, m_visnodes, m_editedView ? &*m_editedView : nullptr);
+
+            R_RecursiveMarkSurfaces(m_model->nodes, m_visnodes, m_vissurfaces);
+
+            R_RecursiveLinkTextureChain(m_model, m_model->nodes, m_visnodes, m_vissurfaces, m_watersurfaces, m_texsurfaces.data());
+
+            R_GenerateTexChain(m_model, m_texsurfaces.data(), m_pWorldModel.get(), m_pLeaf.get(), TEXCHAIN_PASS_SOLID, m_vDrawAttribBuffer, m_editedView ? &*m_editedView : nullptr);
+
+            if (m_pLeaf->m_bIsClosing.load())
+                return false;
+
+            R_GenerateTexChain(m_model, m_texsurfaces.data(), m_pWorldModel.get(), m_pLeaf.get(), TEXCHAIN_PASS_SOLID_WITH_SKY, m_vDrawAttribBuffer, m_editedView ? &*m_editedView : nullptr);
+        }
+        else
+        {
+            R_BrushModelLinkTextureChain(m_model, m_watersurfaces, m_reversedwatersurfaces, m_texsurfaces.data());
+
+            R_GenerateTexChain(m_model, m_texsurfaces.data(), m_pWorldModel.get(), m_pLeaf.get(), TEXCHAIN_PASS_SOLID, m_vDrawAttribBuffer);
+
+            if (m_pLeaf->m_bIsClosing.load())
+                return false;
+
+            R_GenerateTexChain(m_model, m_texsurfaces.data(), m_pWorldModel.get(), m_pLeaf.get(), TEXCHAIN_PASS_SOLID_WITH_SKY, m_vDrawAttribBuffer);
+        }
+
+        if (m_pLeaf->m_bIsClosing.load())
+            return false;
+
+        static_assert(sizeof(CDrawIndexAttrib) == world_batch::CommandBytes);
+        m_pLeaf->vStaticMaterialBatches = world_batch::Prepare(
+            std::span<const CWorldSurfaceBrushTexChain>(m_pLeaf->vTextureChainList[WSURF_TEXCHAIN_LIST_STATIC]));
+        m_IsDataReady.store(true);
+        return true;
+    }
+
+    void UploadResource() override
+    {
+        if (m_pLeaf->m_bIsClosing.load())
+            return;
+
+        if (m_vDrawAttribBuffer.size() > 0)
+        {
+            m_pLeaf->hABO = GL_GenBuffer();
+            if (!m_pLeaf->hABO) throw std::runtime_error("World leaf GPU allocation failed");
+
+            GL_UploadDataToABOStaticDraw(m_pLeaf->hABO, sizeof(CDrawIndexAttrib) * m_vDrawAttribBuffer.size(), m_vDrawAttribBuffer.data());
+        }
+
+        for (auto surf : m_watersurfaces)
+        {
+            R_GetWaterSurfaceModel(m_model, surf, 0, m_pWorldModel.get(), m_pLeaf.get());
+        }
+
+        for (auto surf : m_reversedwatersurfaces)
+        {
+            R_GetWaterSurfaceModel(m_model, surf, 1, m_pWorldModel.get(), m_pLeaf.get());
+        }
+
+        R_GenerateResourceForWaterModels(m_model, m_pWorldModel.get(), m_pLeaf.get());
+        if (glGetError() != GL_NO_ERROR) throw std::runtime_error("World leaf GPU upload failed");
+        m_pLeaf->m_bIsReady = true;
+    }
+};
+
+void R_GenerateWorldSurfaceModelLeaf(const std::shared_ptr<CWorldSurfaceModel>& pModel, model_t* mod, mleaf_t* leaf, bool bIsWorldLeaf, int viewKey)
+{
+    if (!pModel || !mod || pModel->m_model != mod) throw std::invalid_argument("Missing world leaf model");
+    int leafIndex = viewKey >= 0 ? viewKey : ((bIsWorldLeaf && leaf) ? R_GetWorldLeafIndex(mod, leaf) : 0);
+
+    if (pModel->GetLeafByIndex(leafIndex))
+        return;
+
+    auto pWorldModel = pModel->m_pWorldModel.lock();
+    if (!pWorldModel || leafIndex < 0 ||
+        static_cast<std::size_t>(leafIndex) >= (pWorldModel->m_pCarvedVisibility ?
+                                                    pWorldModel->m_pCarvedVisibility->leaf_count() + pWorldModel->m_pCarvedVisibility->component_count() :
+                                                    static_cast<std::size_t>(mod->numleafs) + 1))
+        throw std::invalid_argument("Invalid world leaf view key");
+    R_PrepareWorldLeafData(*pWorldModel);
+
+    auto pLeaf = std::make_shared<CWorldSurfaceLeaf>(leaf);
+
+    pLeaf->m_pModel      = pModel;
+    pLeaf->m_pWorldModel = pWorldModel;
+    pLeaf->m_pBspModel   = mod;
+    pLeaf->m_uViewKey    = static_cast<uint32_t>(leafIndex);
+
+    if (pModel->m_vLeaves.size() < leafIndex + 1)
+    {
+        pModel->m_vLeaves.resize(leafIndex + 1);
+    }
+
+    pLeaf->m_pGameResourceAsyncLoadTask = std::make_shared<CWorldSurfaceLeafAsyncLoadTask>(pLeaf, pWorldModel, mod, leaf, bIsWorldLeaf);
+    try
+    {
+        R_TrackWorldLeafTask(pLeaf);
+        pLeaf->m_pGameResourceAsyncLoadTask->StartAsyncTask();
+    }
+    catch (...)
+    {
+        pLeaf->m_bIsClosing.store(true);
+        pLeaf->ReleaseAsyncLoadTask();
+        throw;
+    }
+    pModel->m_vLeaves[leafIndex] = std::move(pLeaf);
+}
+
+std::shared_ptr<CWorldSurfaceModel> R_PrepareWorldSurfaceLeafModel(
+    const std::shared_ptr<CWorldSurfaceWorldModel>& geometry,
+    model_t*                                        bsp,
+    uint32_t                                        viewKey)
+{
+    if (!geometry || !bsp || viewKey > static_cast<uint32_t>((std::numeric_limits<int>::max)()))
+        throw std::invalid_argument("Invalid world leaf candidate");
+    auto candidate           = std::make_shared<CWorldSurfaceModel>(bsp);
+    candidate->m_pWorldModel = geometry;
+    const bool world         = geometry->m_model == bsp;
+    try
+    {
+        // Prepare the no-vis leaf too: water and lights must never wait for an
+        // old geometry generation after an eventual coordinated commit.
+        R_GenerateWorldSurfaceModelLeaf(candidate, bsp, nullptr, world, 0);
+        if (world && viewKey)
+            R_GenerateWorldSurfaceModelLeaf(candidate, bsp,
+                                            viewKey <= static_cast<uint32_t>(bsp->numleafs) ? bsp->leafs + viewKey : nullptr, true,
+                                            static_cast<int>(viewKey));
+    }
+    catch (...)
+    {
+        candidate->RetireLeaves();
+        throw;
+    }
+    return candidate;
+}
