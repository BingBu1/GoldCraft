@@ -0,0 +1,35 @@
+from pathlib import Path
+import hashlib, json, re
+import argparse
+parser = argparse.ArgumentParser()
+parser.add_argument('--wsurf', type=Path, required=True)
+parser.add_argument('--rmain', type=Path, required=True)
+parser.add_argument('--output', type=Path, required=True)
+parser.add_argument('--manifest', type=Path, required=True)
+args = parser.parse_args()
+inputs = [(args.wsurf, ['R_ScrollSpeed', 'R_DrawWorldSurfaceModelShadowProxy', 'R_DrawWorldSurfaceModel', 'R_DrawBrushModel', 'R_PolygonToTriangleList']),
+          (args.rmain, ['R_RotateForEntity'])]
+out = ['''// Exact production bodies extracted by extract_brush_dispatch.py; do not hand edit.
+#include "gl_local.h"
+#include "draw_parameter_dispatch.h"
+#include "gl_scene_static_shadows.h"
+bool R_WorldSurfaceLeafHasSky(CWorldSurfaceModel*, CWorldSurfaceLeaf*);
+void R_DrawWorldSurfaceLeafSky(CWorldSurfaceModel*, CWorldSurfaceLeaf*);
+void R_DrawWorldSurfaceModelShadowProxyMesh(CWorldSurfaceShadowProxyModel*, CWorldSurfaceShadowProxyDraw*);
+''']
+evidence = []
+for file, names in inputs:
+    source=file.read_text(encoding='utf-8')
+    for name in names:
+        match=re.search(r'^(?:void|float|bool) '+name+r'\([^;]*?\)\s*\{', source, re.M)
+        assert match, name
+        depth=1; end=match.end()
+        while depth:
+            if source[end]=='{': depth+=1
+            if source[end]=='}': depth-=1
+            end+=1
+        body=source[match.start():end]
+        out.append(body+'\n')
+        evidence.append({'source':str(file),'function':name,'sha256':hashlib.sha256(body.encode()).hexdigest()})
+args.output.write_text('\n'.join(out),encoding='utf-8')
+args.manifest.write_text(json.dumps(evidence,indent=2))
