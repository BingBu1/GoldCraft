+        return &info[index];
+    };
+    IEngineStudio.SetupPlayerModel = [](int) -> model_t* {
+        return nullptr;
+    };
+    gPrivateFuncs.studiointerface_StudioDrawPlayer = Draw;
+    entity.player                                  = 1;
+    entity.index                                   = 2;
+    entity.curstate.number                         = 2;
+    auto* state                                    = &entity.curstate;
+    info[1].gaitframe                              = 10.f;
+    info[1].gaityaw                                = 90.f;
+    info[1].ping                                   = 42;
+    R_StudioPlayerStartFrame();
+    shadow = true;
+    for (int i = 0; i < 16; ++i) assert(studiointerface_StudioDrawPlayer(3, state));
+    assert(calls == 16 && events == 0 && renders == 16);
+    shadow = false;
+    assert(studiointerface_StudioDrawPlayer(3, state));
+    assert(studiointerface_StudioDrawPlayer(3, state));
+    assert(studiointerface_StudioDrawPlayer(0, state));
+    assert(info[1].gaitframe == 11.25f && info[1].gaityaw == 92.f && info[1].prevgaitorigin[0] == 4.f);
+    assert(events == 1 && info[1].ping == 42 && info[0].gaitframe == 0.f);
+
+    ++frame;
+    R_StudioPlayerStartFrame();
+    visible = false;
+    assert(!studiointerface_StudioDrawPlayer(3, state));
+    visible = true;
+    assert(studiointerface_StudioDrawPlayer(3, state));
+    assert(info[1].gaitframe == 12.5f && info[1].renderframe == frame && events == 2);
+
+    R_StudioPlayerStartFrame();
+    firstPerson  = true;
+    entity.index = viewEntity = state->number = 1;
+    const auto before                         = renders;
+    assert(studiointerface_StudioDrawPlayer(3, state));
+    assert(!(lastFlags & STUDIO_RENDER) && renders == before && suppressed == 1);
+    // Spectator/third-person, shadow, reflected and explicit clipped lower-body
+    // views retain their render path. They never replay gameplay events.
+    shadow = true;
+    assert(studiointerface_StudioDrawPlayer(3, state));
+    shadow = false;
+    assert((lastFlags & STUDIO_RENDER) && !(lastFlags & STUDIO_EVENTS));
+    water = true;
+    assert(studiointerface_StudioDrawPlayer(3, state));
+    water = false;
+    assert((lastFlags & STUDIO_RENDER) && !(lastFlags & STUDIO_EVENTS));
+    portal = true;
+    assert(studiointerface_StudioDrawPlayer(3, state));
+    portal = false;
+    depth  = true;
+    assert(studiointerface_StudioDrawPlayer(3, state));
+    depth     = false;
+    lowerBody = true;
+    assert(studiointerface_StudioDrawPlayer(3, state));
+    lowerBody   = false;
+    firstPerson = false;
+    assert(studiointerface_StudioDrawPlayer(3, state));
+    assert(lastFlags & STUDIO_RENDER);
+    assert(info[0].gaitframe == 1.25f && info[1].gaitframe == 12.5f);
+    assert(!studiointerface_StudioDrawPlayer(3, nullptr));
+    // CounterStrike's model/team helper consumes the one-based player number;
+    // the engine Studio player-info/setup-model API above consumes a zero-based index.
+    g_bIsCounterStrike = lowerBody = true;
+    assert(studiointerface_StudioDrawPlayer(3, state));
+    assert(redirectedPlayerNumber == 1);
+    entity.index = state->number = 2;
+    assert(studiointerface_StudioDrawPlayer(3, state));
+    assert(redirectedPlayerNumber == 2);
+    std::puts("PASS: public callback, 16 shadow passes, one gait step/event, culled-first pass, next frame, player isolation and first/third-person visibility.");
+}
diff --git a/src/gl_shadow_cull.h b/src/gl_shadow_cull.h
new file mode 100644
index 0000000..c352aca
--- /dev/null
+++ b/src/gl_shadow_cull.h
@@ -0,0 +1,33 @@
+#pragma once
+
+// The six cubemap views cannot share one camera frustum, but casters outside
+// the point light's complete volume cannot shadow any lit receiver.
+class RPointShadowCullScope
+{
+    const RPointShadowCullScope* previous_;
+    float                        origin_[3];
+    float                        radius_;
+    friend bool                  R_CullPointShadowBox(const float* mins, const float* maxs);
+
+public:
+    RPointShadowCullScope(const float* origin, float radius);
+    ~RPointShadowCullScope();
+    RPointShadowCullScope(const RPointShadowCullScope&)            = delete;
+    RPointShadowCullScope& operator=(const RPointShadowCullScope&) = delete;
+};
+void R_InitShadowCulling();
+bool R_CullPointShadowBox(const float* mins, const float* maxs);
+
+// Limit the optional public query to the actual external shadow dispatch.
+// A nested non-shadow dispatch temporarily revokes the outer capability.
+class RExternalSceneShadowCullScope
+{
+    bool previous_;
+
+public:
+    explicit RExternalSceneShadowCullScope(bool shadow) noexcept;
+    ~RExternalSceneShadowCullScope();
+    RExternalSceneShadowCullScope(const RExternalSceneShadowCullScope&)            = delete;
+    RExternalSceneShadowCullScope& operator=(const RExternalSceneShadowCullScope&) = delete;
+};
+bool R_CullExternalShadowBox(const float* mins, const float* maxs) noexcept;
diff --git a/src/gl_shadow_cull.cpp b/src/gl_shadow_cull.cpp
new file mode 100644
index 0000000..c03ee75
--- /dev/null
+++ b/src/gl_shadow_cull.cpp
@@ -0,0 +1,54 @@
+#include "gl_local.h"
+#include "gl_shadow_cull.h"
+#include <cmath>
+
+namespace
+{
+const RPointShadowCullScope* pointShadowVolume{};
+cvar_t*                      shadowCasterCull{};
+bool                         externalShadowDispatch{};
+} // namespace
+
+RPointShadowCullScope::RPointShadowCullScope(const float* origin, float radius) : previous_(pointShadowVolume), origin_{origin[0], origin[1], origin[2]}, radius_(radius)
+{
+    pointShadowVolume = this;
+}
+RPointShadowCullScope::~RPointShadowCullScope() { pointShadowVolume = previous_; }
+
+RExternalSceneShadowCullScope::RExternalSceneShadowCullScope(bool shadow) noexcept : previous_(externalShadowDispatch)
+{
+    externalShadowDispatch = shadow;
+}
+RExternalSceneShadowCullScope::~RExternalSceneShadowCullScope() { externalShadowDispatch = previous_; }
+
+bool R_CullExternalShadowBox(const float* mins, const float* maxs) noexcept
+{
+    return externalShadowDispatch && mins && maxs && R_CullPointShadowBox(mins, maxs);
+}
+
+void R_InitShadowCulling()
+{
+    shadowCasterCull = gEngfuncs.pfnRegisterVariable("r_shadow_caster_cull", "1", FCVAR_CLIENTDLL);
+}
+
+bool R_CullPointShadowBox(const float* mins, const float* maxs)
+{
+    if (!pointShadowVolume || !R_IsRenderingShadowView() || !shadowCasterCull || shadowCasterCull->value <= 0)
+        return false;
+    const auto& light = *pointShadowVolume;
+    if (!std::isfinite(light.radius_) || light.radius_ <= 0) return false;
+    double distanceSquared = 0;
+    for (int i = 0; i < 3; ++i)
+    {
+        if (!std::isfinite(mins[i]) || !std::isfinite(maxs[i]) || !std::isfinite(light.origin_[i]) || mins[i] > maxs[i])
+            return false;
+        const double offset = light.origin_[i] < mins[i] ? double(mins[i]) - light.origin_[i] :
+                                                           (light.origin_[i] > maxs[i] ? double(light.origin_[i]) - maxs[i] : 0);
+        distanceSquared += offset * offset;
+    }
+    // Retain tangent/near-boundary geometry despite engine bounds rounding.
+    const double radius = double(light.radius_) + 1;
+    const bool   culled = distanceSquared > radius * radius;
+    R_ProfileShadowCull(culled);
+    return culled;
+}
diff --git a/tests/shadow_cull_tests.cpp b/tests/shadow_cull_tests.cpp
new file mode 100644
index 0000000..ea9e3c7
--- /dev/null
+++ b/tests/shadow_cull_tests.cpp
@@ -0,0 +1,65 @@
+// Execute the production light-volume rejection and scope restoration.
+#include "../src/gl_shadow_cull.cpp"
+#include <cassert>
+#include <limits>
+
+cl_enginefunc_t gEngfuncs{};
+cvar_t          enabled{};
+bool            shadow{};
+bool            R_IsRenderingShadowView() { return shadow; }
+void            R_ProfileShadowCull(bool) {}
+
+int main()
+{
+    gEngfuncs.pfnRegisterVariable = [](const char*, const char*, int) {
+        return &enabled;
+    };
+    R_InitShadowCulling();
+    enabled.value = 1;
+    shadow        = true;
+    const float origin[]{0, 0, 0};
+    const float farMin[]{300, -10, -10}, farMax[]{320, 10, 10};
+    assert(!R_CullPointShadowBox(farMin, farMax));
+    {
+        RPointShadowCullScope light(origin, 100);
+        assert(R_CullPointShadowBox(farMin, farMax));
+        const float insideMin[]{-10, -10, -10}, insideMax[]{10, 10, 10};
+        assert(!R_CullPointShadowBox(insideMin, insideMax));
+        const float enclosingMin[]{-200, -200, -200}, enclosingMax[]{200, 200, 200};
+        assert(!R_CullPointShadowBox(enclosingMin, enclosingMax));
+        for (int axis = 0; axis < 3; ++axis)
+            for (int sign : {-1, 1})
+            {
+                float low[]{-1, -1, -1}, high[]{1, 1, 1};
+                low[axis]  = sign > 0 ? 100 : -110;
+                high[axis] = sign > 0 ? 110 : -100;
+                assert(!R_CullPointShadowBox(low, high)); // tangent retained
+                low[axis] += sign * 2;
+                high[axis] += sign * 2;
+                assert(R_CullPointShadowBox(low, high));
+            }
+        // Outside the sphere although inside its enclosing cube.
+        const float diagonalMin[]{75, 75, -1}, diagonalMax[]{80, 80, 1};
+        assert(R_CullPointShadowBox(diagonalMin, diagonalMax));
+        shadow = false;
+        assert(!R_CullPointShadowBox(farMin, farMax)); // main/reflection untouched
+        shadow        = true;
+        enabled.value = 0;
+        assert(!R_CullPointShadowBox(farMin, farMax));
+        enabled.value = 1;
+        const float other[]{310, 0, 0};
+        {
+            RPointShadowCullScope nested(other, 30);
+            assert(!R_CullPointShadowBox(farMin, farMax));
+        }
+        assert(R_CullPointShadowBox(farMin, farMax));
+        float invalid[]{std::numeric_limits<float>::quiet_NaN(), 0, 0};
+        assert(!R_CullPointShadowBox(invalid, farMax));
+        assert(!R_CullPointShadowBox(farMax, farMin));
+    }
+    assert(!R_CullPointShadowBox(farMin, farMax));
+    {
+        RPointShadowCullScope invalid(origin, 0);
+        assert(!R_CullPointShadowBox(farMin, farMax));
+    }
+}
diff --git a/src/studio_bone_cache.cpp b/src/studio_bone_cache.cpp
new file mode 100644
index 0000000..d190ac5
--- /dev/null
+++ b/src/studio_bone_cache.cpp
@@ -0,0 +1,85 @@
+#include "gl_local.h"
+#include <array>
+#include <optional>
+
+namespace
+{
+struct BoneCacheIndexEntry
+{
+    std::optional<CStudioBoneCacheHandle> key;
+    std::size_t hash{};
+    unsigned next{};
+};
+
+// Bucket links are one-based; zero denotes an empty chain, including before
+// the first frame reset. Only the index is cleared, never the matrix arena.
+std::array<unsigned, MAX_STUDIO_BONE_CACHES * 2> buckets{};
+std::array<BoneCacheIndexEntry, MAX_STUDIO_BONE_CACHES> entries;
+CStudioBoneCache storage[MAX_STUDIO_BONE_CACHES];
+unsigned used{};
+bool overflowReported{};
+
+unsigned FindBoneCache(const CStudioBoneCacheHandle& key, std::size_t hash)
+{
+    for (unsigned link = buckets[hash % buckets.size()]; link; link = entries[link - 1].next)
+    {
+        const auto& entry = entries[link - 1];
+        if (entry.hash == hash && *entry.key == key) return link;
+    }
+    return 0;
+}
+} // namespace
+
+void R_StudioClearAllBoneCaches()
+{
+    buckets.fill(0);
+    used = 0;
+    overflowReported = false;
+}
+
+void R_StudioSaveBoneCache(studiohdr_t*, int modelindex, int sequence, int gaitsequence, float frame, const float* origin, const float* angles)
+{
+    const CStudioBoneCacheHandle handle(modelindex, sequence, gaitsequence, frame, origin, angles);
+    const auto hash = CStudioBoneCacheHasher{}(handle);
+    unsigned link = FindBoneCache(handle, hash);
+    if (link)
+    {
+        // Preserve last-save-wins matrices, including updates after capacity.
+        R_ProfileBoneCacheStore(true, false);
+    }
+    else
+    {
+        if (used == MAX_STUDIO_BONE_CACHES)
+        {
+            R_ProfileBoneCacheStore(false, true);
+            if (!overflowReported)
+            {
+                gEngfuncs.Con_DPrintf("R_StudioSaveBoneCache: unique pose capacity reached; uncached poses use native bones.\n");
+                overflowReported = true;
+            }
+            return;
+        }
+        auto& entry = entries[used];
+        auto& bucket = buckets[hash % buckets.size()];
+        entry.key.emplace(handle);
+        entry.hash = hash;
+        entry.next = bucket;
+        link = ++used;
+        bucket = link;
+        R_ProfileBoneCacheStore(false, false);
+    }
+    auto& cache = storage[link - 1];
+    memcpy(cache.m_bonetransform, (*pbonetransform), sizeof(cache.m_bonetransform));
+    memcpy(cache.m_lighttransform, (*plighttransform), sizeof(cache.m_lighttransform));
+}
+
+bool R_StudioLoadBoneCache(studiohdr_t*, int modelindex, int sequence, int gaitsequence, float frame, const float* origin, const float* angles)
+{
+    const CStudioBoneCacheHandle handle(modelindex, sequence, gaitsequence, frame, origin, angles);
+    const unsigned link = FindBoneCache(handle, CStudioBoneCacheHasher{}(handle));
+    if (!link) return false;
+    const auto& cache = storage[link - 1];
+    memcpy((*pbonetransform), cache.m_bonetransform, sizeof(cache.m_bonetransform));
+    memcpy((*plighttransform), cache.m_lighttransform, sizeof(cache.m_lighttransform));
+    return true;
+}
diff --git a/tests/studio_bone_cache_tests.cpp b/tests/studio_bone_cache_tests.cpp
new file mode 100644
index 0000000..9b92fd6
--- /dev/null
+++ b/tests/studio_bone_cache_tests.cpp
@@ -0,0 +1,264 @@
+// Exercise the actual per-frame cache under repeated point-shadow passes.
+#include "../src/studio_bone_cache.cpp"
+#include <cassert>
+#include <cmath>
+#include <cstdio>
+#include <array>
+#include <cstdlib>
+#include <new>
+
+static size_t heapAllocations{}, heapFrees{};
+static bool trackHeap{};
+void* operator new(size_t size)
+{
+    if (trackHeap) ++heapAllocations;
+    if (void* value = std::malloc(size ? size : 1)) return value;
+    throw std::bad_alloc();
+}
+void* operator new[](size_t size) { return ::operator new(size); }
+void operator delete(void* value) noexcept
+{
+    if (trackHeap && value) ++heapFrees;
+    std::free(value);
+}
+void operator delete[](void* value) noexcept { ::operator delete(value); }
+void operator delete(void* value, size_t) noexcept { ::operator delete(value); }
+void operator delete[](void* value, size_t) noexcept { ::operator delete(value); }
+
+cl_enginefunc_t gEngfuncs{};
+static float    bones[MAXSTUDIOBONES][3][4]{}, lights[MAXSTUDIOBONES][3][4]{};
+float (*pbonetransform)[MAXSTUDIOBONES][3][4]  = &bones;
+float (*plighttransform)[MAXSTUDIOBONES][3][4] = &lights;
+static unsigned allocations{}, reuses{}, overflows{}, warnings{};
+
+void R_ProfileBoneCacheStore(bool reused, bool overflow)
+{
+    if (overflow) ++overflows;
+    else if (reused)
+        ++reuses;
+    else
+        ++allocations;
+}
+
+static void Warning(const char*, ...) { ++warnings; }
+
+static void Transforms(float value)
+{
+    for (int bone = 0; bone < MAXSTUDIOBONES; ++bone)
+        for (int row = 0; row < 3; ++row)
+            for (int col = 0; col < 4; ++col)
+            {
+                bones[bone][row][col]  = value + bone * 12 + row * 4 + col;
+                lights[bone][row][col] = -bones[bone][row][col] - 1.f;
+            }
+}
+
+static void VerifyTransforms(float value)
+{
+    for (int bone = 0; bone < MAXSTUDIOBONES; ++bone)
+        for (int row = 0; row < 3; ++row)
+            for (int col = 0; col < 4; ++col)
+            {
+                const float expected = value + bone * 12 + row * 4 + col;
+                assert(bones[bone][row][col] == expected);
+                assert(lights[bone][row][col] == -expected - 1.f);
+            }
+}
+
+// A linear reference has no shared hashing, links or cache-handle equality.
+// Replay interleaved saves/loads over many resets and compare all matrices.
+struct Pose
+{
+    int model{}, sequence{}, gait{};
+    float frame{}, origin[3]{}, angles[3]{};
+
+    bool operator==(const Pose&) const = default;
+    void Save() const { R_StudioSaveBoneCache(nullptr, model, sequence, gait, frame, origin, angles); }
+    bool Load() const { return R_StudioLoadBoneCache(nullptr, model, sequence, gait, frame, origin, angles); }
+};
+
+static void VerifyReferenceReplay()
+{
+    struct Record { Pose pose; float value; };
+    std::array<Record, MAX_STUDIO_BONE_CACHES> reference{};
+    std::array<Pose, 160> poses{};
+    unsigned random = 0x517cc1b7u;
+    const auto Next = [&]() { random = random * 1664525u + 1013904223u; return random; };
+    const auto Float = [&]() { return (static_cast<int>(Next() % 65536u) - 32768) / 8.f; };
+    for (auto& pose : poses)
+    {
+        pose.model = Next() % 17u;
+        pose.sequence = Next() % 9u;
+        pose.gait = Next() % 5u;
+        pose.frame = Float();
+        for (int axis = 0; axis < 3; ++axis)
+        {
+            pose.origin[axis] = Float();
+            pose.angles[axis] = Float();
+        }
+    }
+    for (int epoch = 0; epoch < 16; ++epoch)
+    {
+        R_StudioClearAllBoneCaches();
+        unsigned count = 0;
+        for (unsigned step = 0; step < 768; ++step)
+        {
+            const auto& pose = poses[(Next() >> 8) % poses.size()];
+            unsigned match = 0;
+            while (match < count && !(reference[match].pose == pose)) ++match;
+            if ((Next() >> 16) % 3u != 0)
+            {
+                const float value = epoch * 1000.f + step;
+                Transforms(value);
+                pose.Save();
+                if (match == count) ++count;
+                reference[match] = {pose, value};
+            }
+            else
+            {
+                Transforms(-30000.f);
+                assert(pose.Load() == (match < count));
+                VerifyTransforms(match < count ? reference[match].value : -30000.f);
+            }
+        }
+        for (unsigned i = 0; i < count; ++i)
+        {
+            assert(reference[i].pose.Load());
+            VerifyTransforms(reference[i].value);
+        }
+        R_StudioClearAllBoneCaches();
+        for (const auto& pose : poses) assert(!pose.Load());
+    }
+}
+
+static void VerifyCollidingBuckets()
+{
+    const float zero[]{0.f, 0.f, 0.f};
+    std::array<int, 32> models{};
+    unsigned count = 0;
+    for (int model = 1; model < 262144 && count < models.size(); ++model)
+    {
+        const CStudioBoneCacheHandle key(model, 0, 0, 0.f, zero, zero);
+        if (CStudioBoneCacheHasher{}(key) % (MAX_STUDIO_BONE_CACHES * 2) == 0)
+            models[count++] = model;
+    }
+    assert(count == models.size());
+    R_StudioClearAllBoneCaches();
+    for (unsigned i = 0; i < count; ++i)
+    {
+        Transforms(static_cast<float>(i));
+        R_StudioSaveBoneCache(nullptr, models[i], 0, 0, 0.f, zero, zero);
+    }
+    // Refresh both ends and the middle without breaking the collision chain.
+    for (unsigned i : {0u, 16u, 31u})
+    {
+        Transforms(9000.f + i);
+        R_StudioSaveBoneCache(nullptr, models[i], 0, 0, 0.f, zero, zero);
+    }
+    for (unsigned i = count; i-- > 0;)
+    {
+        assert(R_StudioLoadBoneCache(nullptr, models[i], 0, 0, 0.f, zero, zero));
+        VerifyTransforms((i == 0 || i == 16 || i == 31) ? 9000.f + i : static_cast<float>(i));
+    }
+    R_StudioClearAllBoneCaches();
+    Transforms(-333.f);
+    for (int model : models) assert(!R_StudioLoadBoneCache(nullptr, model, 0, 0, 0.f, zero, zero));
+    VerifyTransforms(-333.f);
+}
+
+int main()
+{
+    _set_error_mode(_OUT_TO_STDERR);
+    _set_abort_behavior(0, _WRITE_ABORT_MSG | _CALL_REPORTFAULT);
+    gEngfuncs.Con_DPrintf = Warning;
+    const float origin[]{-2527.5f, 1989.f, 66.f}, angles[]{0.f, 356.f, 0.f};
+    trackHeap = true;
+    // Static empty initialization must also work before the first frame reset.
+    Transforms(-321.f);
+    assert(!R_StudioLoadBoneCache(nullptr, 1, 2, 3, 4.f, origin, angles));
+    VerifyTransforms(-321.f);
+    R_StudioClearAllBoneCaches();
+    // 24 point lights, six cube faces, 24 players: 3,456 saves but 24 poses.
+    for (int pass = 0; pass < 144; ++pass)
+        for (int player = 0; player < 24; ++player)
+        {
+            Transforms(static_cast<float>(pass * 100 + player));
+            R_StudioSaveBoneCache(nullptr, player + 1, 2, 3, 4.f, origin, angles);
+        }
+    assert(allocations == 24 && reuses == 3432 && overflows == 0 && warnings == 0);
+    for (int player = 0; player < 24; ++player)
+    {
+        Transforms(-10000.f);
+        assert(R_StudioLoadBoneCache(nullptr, player + 1, 2, 3, 4.f, origin, angles));
+        VerifyTransforms(static_cast<float>(14300 + player));
+    }
+    // Every pose component remains part of the lookup. A miss leaves the
+    // native transform buffers intact for the caller's uncached path.
+    float otherOrigin[]{origin[0] + 1, origin[1], origin[2]};
+    float otherAngles[]{angles[0], angles[1] + 1, angles[2]};
+    Transforms(-123.f);
+    assert(!R_StudioLoadBoneCache(nullptr, 1, 20, 3, 4.f, origin, angles));
+    assert(!R_StudioLoadBoneCache(nullptr, 1, 2, 30, 4.f, origin, angles));
+    assert(!R_StudioLoadBoneCache(nullptr, 1, 2, 3, 4.5f, origin, angles));
+    assert(!R_StudioLoadBoneCache(nullptr, 1, 2, 3, 4.f, otherOrigin, angles));
+    assert(!R_StudioLoadBoneCache(nullptr, 1, 2, 3, 4.f, origin, otherAngles));
+    VerifyTransforms(-123.f);
+    R_StudioClearAllBoneCaches();
+    assert(!R_StudioLoadBoneCache(nullptr, 1, 2, 3, 4.f, origin, angles));
+    allocations = reuses = overflows = 0;
+    for (int pose = 0; pose < MAX_STUDIO_BONE_CACHES; ++pose)
+    {
+        Transforms(static_cast<float>(pose));
+        R_StudioSaveBoneCache(nullptr, pose + 1, 0, 0, 0.f, origin, angles);
+    }
+    assert(allocations == MAX_STUDIO_BONE_CACHES && overflows == 0);
+    // A genuine full frame must preserve existing entries, allow their
+    // refresh and report only once rather than flood every shadow pass.
+    for (int pass = 0; pass < 100; ++pass)
+        R_StudioSaveBoneCache(nullptr, MAX_STUDIO_BONE_CACHES + 1, 0, 0, 0.f, origin, angles);
+    assert(overflows == 100 && warnings == 1);
+    assert(!R_StudioLoadBoneCache(nullptr, MAX_STUDIO_BONE_CACHES + 1, 0, 0, 0.f, origin, angles));
+    for (int pose = 0; pose < MAX_STUDIO_BONE_CACHES; ++pose)
+    {
+        assert(R_StudioLoadBoneCache(nullptr, pose + 1, 0, 0, 0.f, origin, angles));
+        VerifyTransforms(static_cast<float>(pose));
+    }
+    Transforms(7777.f);
+    R_StudioSaveBoneCache(nullptr, 1, 0, 0, 0.f, origin, angles);
+    assert(reuses == 1 && overflows == 100);
+    Transforms(0.f);
+    assert(R_StudioLoadBoneCache(nullptr, 1, 0, 0, 0.f, origin, angles));
+    VerifyTransforms(7777.f);
+    R_StudioClearAllBoneCaches();
+    assert(!R_StudioLoadBoneCache(nullptr, 1, 0, 0, 0.f, origin, angles));
+    Transforms(8888.f);
+    R_StudioSaveBoneCache(nullptr, MAX_STUDIO_BONE_CACHES + 1, 0, 0, 0.f, origin, angles);
+    Transforms(0.f);
+    assert(R_StudioLoadBoneCache(nullptr, MAX_STUDIO_BONE_CACHES + 1, 0, 0, 0.f, origin, angles));
+    VerifyTransforms(8888.f);
+    assert(warnings == 1);
+    // Equal signed-zero keys must hash identically. Different representable
+    // coordinates must never receive another pose's transforms.
+    R_StudioClearAllBoneCaches();
+    const float zeros[]{0.f, 0.f, 0.f}, negativeZeros[]{-0.f, -0.f, -0.f};
+    Transforms(333.f);
+    R_StudioSaveBoneCache(nullptr, 65536, 0, 0, -0.f, negativeZeros, negativeZeros);
+    Transforms(0.f);
+    assert(R_StudioLoadBoneCache(nullptr, 65536, 0, 0, 0.f, zeros, zeros));
+    VerifyTransforms(333.f);
+    const float closeOrigin[]{std::nextafter(0.f, 1.f), 0.f, 0.f};
+    assert(!R_StudioLoadBoneCache(nullptr, 65536, 0, 0, 0.f, closeOrigin, zeros));
+    // Warning suppression resets per frame, while retained entries never do.
+    for (int pose = 1; pose < MAX_STUDIO_BONE_CACHES; ++pose)
+        R_StudioSaveBoneCache(nullptr, pose, 0, 0, 0.f, zeros, zeros);
+    R_StudioSaveBoneCache(nullptr, MAX_STUDIO_BONE_CACHES, 0, 0, 0.f, zeros, zeros);
+    assert(warnings == 2);
+    VerifyCollidingBuckets();
+    VerifyReferenceReplay();
+    R_StudioClearAllBoneCaches();
+    trackHeap = false;
+    std::printf("Tracked heap: %zu allocations, %zu frees\n", heapAllocations, heapFrees);
+    std::fflush(stdout);
+    assert(heapAllocations == 0 && heapFrees == 0);
+    std::puts("PASS: multipass/full-capacity transforms, 32 colliding keys, 12,288 reference operations and frame resets; zero heap activity.");
+}
diff --git a/src/gl_surface_edit.cpp b/src/gl_surface_edit.cpp
new file mode 100644
index 0000000..8c229a3
--- /dev/null
+++ b/src/gl_surface_edit.cpp
@@ -0,0 +1,263 @@
+#include "gl_local.h"
+#include <limits>
+#include <stdexcept>
+
+namespace
+{
+void CheckSurfaceGL()
+{
+    if (glGetError() != GL_NO_ERROR)
+        throw std::runtime_error("World surface GPU preparation failed");
+}
+struct SurfaceBindings
+{
+    GLint vao{}, array{}, indirect{};
+    SurfaceBindings()
+    {
+        glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &vao);
+        glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &array);
+        glGetIntegerv(GL_DRAW_INDIRECT_BUFFER_BINDING, &indirect);
+        CheckSurfaceGL();
+    }
+    ~SurfaceBindings()
+    {
+        glBindVertexArray(vao);
+        glBindBuffer(GL_ARRAY_BUFFER, array);
+        glBindBuffer(GL_DRAW_INDIRECT_BUFFER, indirect);
+    }
+};
+template <class T> void UploadSurfaceBuffer(GLuint& name, GLenum target, const std::vector<T>& values)
+{
+    if (values.size() > std::size_t((std::numeric_limits<GLsizeiptr>::max)()) / sizeof(T))
+        throw std::length_error("World surface GPU buffer size");
+    glGenBuffers(1, &name);
+    CheckSurfaceGL();
+    if (!name) throw std::runtime_error("World surface GPU buffer allocation failed");
+    glBindBuffer(target, name);
+    const auto bytes = static_cast<GLsizeiptr>(values.size() * sizeof(T));
+    if (bytes && glBufferStorage)
+        glBufferStorage(target, bytes, values.data(), 0);
+    else
+        glBufferData(target, bytes, values.data(), GL_STATIC_DRAW);
+    CheckSurfaceGL();
+}
+void FloatSurfaceAttribute(GLuint location, GLint components, GLsizei stride, const void* offset)
+{
+    glEnableVertexAttribArray(location);
+    glVertexAttribPointer(location, components, GL_FLOAT, GL_FALSE, stride, offset);
+}
+void DrawCavityBuffer(const CWorldSurfaceWorldModel& model, GLuint buffer, uint32_t first, uint32_t count)
+{
+    glBindVertexArray(model.hVAO);
+    glBindBuffer(GL_DRAW_INDIRECT_BUFFER, buffer);
+    if (model.m_hCavityLightValues)
+        glBindBufferBase(GL_SHADER_STORAGE_BUFFER, BINDING_POINT_CAVITY_LIGHT_SSBO, model.m_hCavityLightValues);
+    glMultiDrawElementsIndirect(GL_TRIANGLES, GL_UNSIGNED_INT,
+        reinterpret_cast<void*>(std::size_t(first) * sizeof(CDrawIndexAttrib)), count, 0);
+}
+} // namespace
+
+CWorldSurfaceWorldModel::~CWorldSurfaceWorldModel()
+{
+    if (hEBO) glDeleteBuffers(1, &hEBO);
+    glDeleteBuffers(WSURF_VBO_MAX, hVBO);
+    if (hVAO) glDeleteVertexArrays(1, &hVAO);
+    if (m_hCavityABO) glDeleteBuffers(1, &m_hCavityABO);
+    if (m_hCavityLightRanges) glDeleteBuffers(1, &m_hCavityLightRanges);
+    if (m_hCavityLightValues) glDeleteBuffers(1, &m_hCavityLightValues);
+}
+
+void R_UploadWorldSurfaceGeometry(CWorldSurfaceWorldModel& model)
+{
+    if (!model.m_pSurfaceMesh || model.hVAO || model.hEBO || model.m_hCavityABO ||
+        model.m_hCavityLightRanges || model.m_hCavityLightValues ||
+        model.hVBO[0] || model.hVBO[1] || model.hVBO[2])
+        throw std::invalid_argument("World surface upload requires a fresh candidate");
+    const SurfaceBindings restore;
+    const auto&           mesh = *model.m_pSurfaceMesh;
+    glGenVertexArrays(1, &model.hVAO);
+    CheckSurfaceGL();
+    if (!model.hVAO) throw std::runtime_error("World surface GPU VAO allocation failed");
+    glBindVertexArray(model.hVAO);
+    UploadSurfaceBuffer(model.hEBO, GL_ELEMENT_ARRAY_BUFFER, mesh.indices);
+    UploadSurfaceBuffer(model.hVBO[WSURF_VBO_VERTEX], GL_ARRAY_BUFFER, mesh.vertices);
+    FloatSurfaceAttribute(WSURF_VA_POSITION, 3, sizeof(brushvertex_t), OFFSET(brushvertex_t, pos));
+    FloatSurfaceAttribute(WSURF_VA_TEXCOORD, 2, sizeof(brushvertex_t), OFFSET(brushvertex_t, texcoord));
+    FloatSurfaceAttribute(WSURF_VA_LIGHTMAP_TEXCOORD, 2, sizeof(brushvertex_t), OFFSET(brushvertex_t, lightmaptexcoord));
+    UploadSurfaceBuffer(model.hVBO[WSURF_VBO_VERTEXTBN], GL_ARRAY_BUFFER, mesh.frames);
+    FloatSurfaceAttribute(WSURF_VA_NORMAL, 3, sizeof(brushvertextbn_t), OFFSET(brushvertextbn_t, normal));
+    FloatSurfaceAttribute(WSURF_VA_S_TANGENT, 3, sizeof(brushvertextbn_t), OFFSET(brushvertextbn_t, s_tangent));
+    FloatSurfaceAttribute(WSURF_VA_T_TANGENT, 3, sizeof(brushvertextbn_t), OFFSET(brushvertextbn_t, t_tangent));
+    FloatSurfaceAttribute(WSURF_VA_SMOOTHNORMAL, 3, sizeof(brushvertextbn_t), OFFSET(brushvertextbn_t, smoothnormal));
+    UploadSurfaceBuffer(model.hVBO[WSURF_VBO_INSTANCE], GL_ARRAY_BUFFER, mesh.instances);
+    glEnableVertexAttribArray(WSURF_VA_PACKED_MATID);
+    glVertexAttribIPointer(WSURF_VA_PACKED_MATID, 1, GL_UNSIGNED_INT, sizeof(brushinstancedata_t), OFFSET(brushinstancedata_t, packed_matId));
+    glEnableVertexAttribArray(WSURF_VA_STYLES);
+    glVertexAttribIPointer(WSURF_VA_STYLES, 4, GL_UNSIGNED_BYTE, sizeof(brushinstancedata_t), OFFSET(brushinstancedata_t, styles));
+    FloatSurfaceAttribute(WSURF_VA_DIFFUSESCALE, 1, sizeof(brushinstancedata_t), OFFSET(brushinstancedata_t, diffusescale));
+    glVertexAttribDivisor(WSURF_VA_PACKED_MATID, 1);
+    glVertexAttribDivisor(WSURF_VA_STYLES, 1);
+    glVertexAttribDivisor(WSURF_VA_DIFFUSESCALE, 1);
+    CheckSurfaceGL();
+    if (!model.m_vCavityDraws.empty())
+    {
+        static_assert(sizeof(CDrawIndexAttrib) == 5 * sizeof(uint32_t));
+        std::vector<CDrawIndexAttrib> commands;
+        commands.reserve(model.m_vCavityDraws.size());
+        for (const auto& draw : model.m_vCavityDraws)
+            commands.push_back({draw.indices.count, draw.instances.count, draw.indices.first, 0, draw.instances.first});
+        UploadSurfaceBuffer(model.m_hCavityABO, GL_DRAW_INDIRECT_BUFFER, commands);
+    }
+    if (model.m_pCavityLighting)
+    {
+        const auto& lighting = *model.m_pCavityLighting;
+        if (lighting.mesh != model.m_pSurfaceMesh || lighting.vertices.size() != mesh.vertices.size())
+            throw std::invalid_argument("Cavity lighting does not match candidate geometry");
+        UploadSurfaceBuffer(model.m_hCavityLightRanges, GL_ARRAY_BUFFER, lighting.vertices);
+        glEnableVertexAttribArray(WSURF_VA_CAVITY_LIGHT);
+        glVertexAttribIPointer(WSURF_VA_CAVITY_LIGHT, 2, GL_UNSIGNED_INT, sizeof(goldcraft::surface::Range), nullptr);
+        // A truly black bake still needs a valid SSBO object, but every range
+        // has count zero and the shader never reads the single padding record.
+        const std::vector<goldcraft::lighting::Value> black(1);
+        UploadSurfaceBuffer(model.m_hCavityLightValues, GL_ARRAY_BUFFER, lighting.values.empty() ? black : lighting.values);
+        CheckSurfaceGL();
+    }
+}
+
+void R_DrawCavityGeometry(const CWorldSurfaceWorldModel& model, uint32_t first, uint32_t count)
+{
+    if (!count) return;
+    if (!model.m_hCavityABO || first > model.m_vCavityDraws.size() ||
+        count > model.m_vCavityDraws.size() - first || count > uint32_t((std::numeric_limits<GLsizei>::max)()))
+        throw std::out_of_range("Cavity indirect draw range");
+    DrawCavityBuffer(model, model.m_hCavityABO, first, count);
+}
+
+CWorldSurfaceCavityView::~CWorldSurfaceCavityView()
+{
+    if (m_hABO) glDeleteBuffers(1, &m_hABO);
+}
+
+std::shared_ptr<const CWorldSurfaceCavityView> R_PrepareVisibleCavityGeometry(
+    std::shared_ptr<const CWorldSurfaceWorldModel> model,
+    const goldcraft::visibility::Prepared& visibility, uint32_t key)
+{
+    if (!model || !model->hVAO || model->m_vCavityDraws.size() > 65'536)
+        throw std::invalid_argument("Missing cavity geometry or excessive draw count");
+    const auto selected = visibility.view(key);
+    auto candidate = std::make_shared<CWorldSurfaceCavityView>();
+    candidate->m_pWorldModel = std::move(model);
+    std::vector<CDrawIndexAttrib> commands;
+    const auto& draws = candidate->m_pWorldModel->m_vCavityDraws;
+    for (std::size_t i = 0; i < draws.size(); ++i)
+    {
+        const auto& draw = draws[i];
+        if (!visibility.sees_bounds(selected, draw.bounds)) continue;
+        candidate->m_vDrawIndices.push_back(static_cast<uint32_t>(i));
+        commands.push_back({draw.indices.count, draw.instances.count, draw.indices.first, 0, draw.instances.first});
+    }
+    if (!commands.empty())
+    {
+        const SurfaceBindings restore;
+        UploadSurfaceBuffer(candidate->m_hABO, GL_DRAW_INDIRECT_BUFFER, commands);
+    }
+    return candidate;
+}
+
+void R_DrawVisibleCavityGeometry(const CWorldSurfaceCavityView& view, uint32_t first, uint32_t count)
+{
+    if (!count) return;
+    if (!view.m_pWorldModel || !view.m_hABO || first > view.m_vDrawIndices.size() ||
+        count > view.m_vDrawIndices.size() - first || count > uint32_t((std::numeric_limits<GLsizei>::max)()))
+        throw std::out_of_range("Visible cavity indirect draw range");
+    DrawCavityBuffer(*view.m_pWorldModel, view.m_hABO, first, count);
+}
+
+namespace
+{
+std::shared_ptr<CWorldSurfaceWorldModel> PrepareSurfaceCandidate(
+    const std::shared_ptr<CWorldSurfaceWorldModel>& original,
+    std::shared_ptr<const goldcraft::surface::Mesh> mesh,
+    std::vector<goldcraft::cavity::Draw> draws,
+    std::shared_ptr<const goldcraft::lighting::Prepared> lighting = {},
+    std::span<const goldcraft::surface::Selection> decalCuts = {})
+{
+    if (!original || !original->m_pOriginalMesh ||
+        original->m_vFaceBuffer.size() != original->m_pOriginalMesh->faces.size())
+        throw std::invalid_argument("Missing original world surface geometry");
+    if (mesh == original->m_pSurfaceMesh && draws.empty() && original->m_vCavityDraws.empty() &&
+        decalCuts.empty() && original->m_vDecalCuts.empty()) return original;
+    auto candidate             = std::make_shared<CWorldSurfaceWorldModel>(original->m_model);
+    candidate->m_pOriginalMesh = original->m_pOriginalMesh;
+    candidate->m_pSurfaceMesh  = std::move(mesh);
+    candidate->m_vCavityDraws  = std::move(draws);
+    candidate->m_pCavityLighting = std::move(lighting);
+    candidate->m_pVisibilitySource = original->m_pVisibilitySource;
+    candidate->m_pLeafData = original->m_pLeafData;
+    candidate->m_vDecalCuts.assign(decalCuts.begin(), decalCuts.end());
+    candidate->m_vFaceBuffer   = original->m_vFaceBuffer;
+    for (std::size_t i = 0; i < candidate->m_vFaceBuffer.size(); ++i)
+    {
+        auto&       target         = candidate->m_vFaceBuffer[i];
+        const auto& face           = candidate->m_pSurfaceMesh->faces[i];
+        target.start_index         = face.forward.first;
+        target.index_count         = face.forward.count;
+        target.reverse_start_index = face.reverse.first;
+        target.reverse_index_count = face.reverse.count;
+        target.instance_index      = face.instances.first;
+        target.instance_count      = face.instances.count;
+        target.poly_count          = face.polygons;
+    }
+    R_UploadWorldSurfaceGeometry(*candidate);
+    return candidate;
+}
+} // namespace
+
+std::shared_ptr<CWorldSurfaceWorldModel> R_PrepareWorldSurfaceGeometry(
+    const std::shared_ptr<CWorldSurfaceWorldModel>& original,
+    std::span<const goldcraft::surface::Selection> cuts,
+    goldcraft::surface::Limits limits)
+{
+    if (!original) throw std::invalid_argument("Missing original world surface geometry");
+    const auto prepared = goldcraft::surface::prepare(original->m_pOriginalMesh, cuts, limits);
+    return PrepareSurfaceCandidate(original, prepared.mesh, {}, {}, cuts);
+}
+
+std::shared_ptr<CWorldSurfaceWorldModel> R_PrepareCarvedWorldGeometry(
+    const std::shared_ptr<CWorldSurfaceWorldModel>& original,
+    std::span<const goldcraft::cavity::Model> models,
+    goldcraft::cavity::Limits limits)
+{
+    if (!original) throw std::invalid_argument("Missing original world surface geometry");
+    auto prepared = goldcraft::cavity::prepare(original->m_pOriginalMesh, models, limits);
+    std::vector<goldcraft::surface::Selection> cuts;
+    for (const auto& model : models)
+        for (const auto& box : model.boxes) cuts.push_back({model.first_face, model.face_count, box});
+    return PrepareSurfaceCandidate(original, std::move(prepared.mesh), std::move(prepared.draws), {}, cuts);
+}
+
+std::shared_ptr<CWorldSurfaceWorldModel> R_PrepareLitCarvedWorldGeometry(
+    const std::shared_ptr<CWorldSurfaceWorldModel>& original,
+    std::span<const goldcraft::cavity::Model> models,
+    goldcraft::cavity::Limits limits, goldcraft::lighting::Settings settings)
+{
+    if (!original) throw std::invalid_argument("Missing original world surface geometry");
+    const auto geometry = goldcraft::cavity::prepare(original->m_pOriginalMesh, models, limits);
+    std::vector<goldcraft::surface::Selection> cuts;
+    for (const auto& model : models)
+        for (const auto& box : model.boxes) cuts.push_back({model.first_face, model.face_count, box});
+    if (geometry.draws.empty()) return PrepareSurfaceCandidate(original, geometry.mesh, {}, {}, cuts);
+    std::vector<CWorldLightProbes> storage;
+    std::vector<goldcraft::lighting::Model> lightingModels;
+    storage.reserve(models.size());
+    lightingModels.reserve(models.size());
+    for (const auto& model : models)
+    {
+        if (model.boxes.empty()) continue;
+        storage.push_back(R_CollectCavityLightProbes(*original, model, settings));
+        const auto& probes = storage.back();
+        lightingModels.push_back({model.first_face, model.face_count, model.hull, model.boxes, probes.probes, probes.values});
+    }
+    auto lighting = std::make_shared<goldcraft::lighting::Prepared>(goldcraft::lighting::prepare(geometry, lightingModels, settings));
+    return PrepareSurfaceCandidate(original, lighting->mesh, lighting->draws, lighting, cuts);
+}
diff --git a/tests/surface_mesh_gl_tests.cpp b/tests/surface_mesh_gl_tests.cpp
new file mode 100644
index 0000000..bbeae5c
--- /dev/null
+++ b/tests/surface_mesh_gl_tests.cpp
@@ -0,0 +1,560 @@
+// Driver-backed readback of the production candidate resource and VAO layout.
+// No CS process or desktop input is used; the GLFW window remains hidden.
+#include "../src/gl_local.h"
+#include <GLFW/glfw3.h>
+#include <array>
+#include <cassert>
+#include <cmath>
+#include <chrono>
+#include <cstdio>
+#include <stdexcept>
+
+int g_iEngineType = ENGINE_GOLDSRC;
+
+namespace
+{
+constexpr int Size = 64;
+using Pixels       = std::vector<float>;
+static PFNGLBUFFERSTORAGEPROC real_storage;
+static PFNGLBUFFERDATAPROC real_data;
+static PFNGLBUFFERSUBDATAPROC real_sub_data;
+static GLuint                 failed_buffer;
+static int                    failure_after;
+static std::vector<GLuint>     attempted_buffers;
+static std::size_t             uploads, submissions;
+static PFNGLMULTIDRAWELEMENTSINDIRECTPROC real_multi_draw;
+void APIENTRY MultiDraw(GLenum mode, GLenum type, const void* indirect, GLsizei count, GLsizei stride)
+{
+    ++submissions;
+    real_multi_draw(mode, type, indirect, count, stride);
+}
+void APIENTRY Data(GLenum target, GLsizeiptr bytes, const void* data, GLenum usage)
+{
+    ++uploads; real_data(target, bytes, data, usage);
+}
+void APIENTRY SubData(GLenum target, GLintptr offset, GLsizeiptr bytes, const void* data)
+{
+    ++uploads; real_sub_data(target, offset, bytes, data);
+}
+void APIENTRY                 Storage(GLenum target, GLsizeiptr size, const void* data, GLbitfield flags)
+{
+    ++uploads;
+    if (failure_after)
+    {
+        GLint bound{};
+        glGetIntegerv(target == GL_ARRAY_BUFFER ? GL_ARRAY_BUFFER_BINDING :
+            (target == GL_DRAW_INDIRECT_BUFFER ? GL_DRAW_INDIRECT_BUFFER_BINDING : GL_ELEMENT_ARRAY_BUFFER_BINDING), &bound);
+        attempted_buffers.push_back(bound);
+        if (--failure_after == 0)
+        {
+            failed_buffer = bound;
+            size = -1; // Ask the real driver to reject preparation after all five allocations.
+        }
+    }
+    real_storage(target, size, data, flags);
+}
+GLuint Compile(GLenum type, const char* text)
+{
+    auto shader = glCreateShader(type);
+    glShaderSource(shader, 1, &text, nullptr);
+    glCompileShader(shader);
+    GLint ok{};
+    glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+    if (!ok)
+    {
+        char log[2048]{};
+        glGetShaderInfoLog(shader, sizeof(log), nullptr, log);
+        std::fprintf(stderr, "%s\n", log);
+    }
+    assert(ok);
+    return shader;
+}
+GLuint Program()
+{
+    const auto vs      = Compile(GL_VERTEX_SHADER, R"(#version 440
+layout(location=0) in vec3 pos;
+layout(location=2) in vec2 uv;
+layout(location=3) in vec2 lm;
+layout(location=6) in vec3 smoothnormal;
+layout(location=7) in uint material_bits;
+layout(location=8) in uvec4 styles;
+layout(location=9) in float scale;
+uniform bool side_view;
+out vec2 diffuse_uv; out vec2 lightmap_uv; out vec3 sn;
+flat out uvec4 instance; flat out float diffuse_scale;
+void main() {
+    gl_Position=side_view ? vec4(pos.y/64.0-1.0,pos.z/64.0,(48.0-pos.x)/64.0,1.0)
+        : vec4(pos.xy / 64.0 - 1.0, -pos.z / 64.0, 1.0);
+    diffuse_uv=uv; lightmap_uv=lm; sn=smoothnormal;
+    instance=uvec4(material_bits & 65535u, material_bits >> 16, styles.y, styles.z);
+    diffuse_scale=scale;
+})");
+    const auto fs      = Compile(GL_FRAGMENT_SHADER, R"(#version 440
+in vec2 diffuse_uv; in vec2 lightmap_uv; in vec3 sn;
+flat in uvec4 instance; flat in float diffuse_scale;
+layout(location=0) out vec4 diffuse;
+layout(location=1) out vec4 lightmap;
+layout(location=2) out vec4 frame;
+layout(location=3) out vec4 material;
+void main() {
+    diffuse=vec4(diffuse_uv,0,1); lightmap=vec4(lightmap_uv,0,1);
+    frame=vec4(sn,diffuse_scale); material=vec4(instance);
+})");
+    auto       program = glCreateProgram();
+    glAttachShader(program, vs);
+    glAttachShader(program, fs);
+    glLinkProgram(program);
+    GLint ok{};
+    glGetProgramiv(program, GL_LINK_STATUS, &ok);
+    assert(ok);
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+    return program;
+}
+std::shared_ptr<CWorldSurfaceWorldModel> Original(model_t* mod)
+{
+    auto mesh = std::make_shared<goldcraft::surface::Mesh>();
+    for (const auto xy : {std::array<float, 2>{0, 0}, {128, 0}, {128, 128}, {0, 128}})
+    {
+        const float x = xy[0], y = xy[1];
+        mesh->vertices.push_back({{x, y, 0}, {x * .25f + 3, y * .5f - 7}, {x / 2048 + .0625f, y / 2048 + .125f}});
+        mesh->frames.push_back({{0, 0, 1}, {1, 0, 0}, {0, 1, 0}, {x / 256, y / 512, 1}});
+    }
+    mesh->instances.push_back({{60001, 513}, {3, 15, 200, 255}, .015625f});
+    mesh->instances.push_back({{60002, 514}, {4, 16, 201, 254}, .03125f});
+    mesh->indices             = {0, 2, 1, 0, 3, 2};
+    mesh->faces               = {{{0, 6}, {}, {1, 1}, 1, true}};
+    auto original             = std::make_shared<CWorldSurfaceWorldModel>(mod);
+    original->m_pOriginalMesh = mesh;
+    original->m_pSurfaceMesh  = mesh;
+    CWorldSurfaceBrushFace face{};
+    face.index_count    = 6;
+    face.instance_index = 1;
+    face.instance_count = 1;
+    face.poly_count     = 1;
+    original->m_vFaceBuffer.push_back(face);
+    R_UploadWorldSurfaceGeometry(*original);
+    return original;
+}
+std::array<Pixels, 4> Readback()
+{
+    std::array<Pixels, 4> pixels{};
+    for (int i = 0; i < 4; ++i)
+    {
+        pixels[i].resize(Size * Size * 4);
+        glReadBuffer(GL_COLOR_ATTACHMENT0 + i);
+        glReadPixels(0, 0, Size, Size, GL_RGBA, GL_FLOAT, pixels[i].data());
+    }
+    assert(glGetError() == GL_NO_ERROR);
+    return pixels;
+}
+std::array<Pixels, 4> Draw(const CWorldSurfaceWorldModel& model, bool cavities = false)
+{
+    const float empty[4]{};
+    for (int i = 0; i < 4; ++i) glClearBufferfv(GL_COLOR, i, empty);
+    const float depth = 1;
+    glClearBufferfv(GL_DEPTH, 0, &depth);
+    glBindVertexArray(model.hVAO);
+    for (const auto& face : model.m_vFaceBuffer)
+        glDrawElementsInstancedBaseInstance(GL_TRIANGLES, face.index_count, GL_UNSIGNED_INT,
