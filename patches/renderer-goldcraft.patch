+        Scene empty(0);
+        worldModel = &empty.model;
+        entity.model = &empty.model;
+        viewLeaf = nullptr;
+        const auto emptyModel = R_PrepareWorldSurfaceLeafModel(empty.geometry, &empty.model, 0);
+        Finish(emptyModel);
+        drawCalls = 0;
+        draw(emptyModel);
+        assert(staticWorldCompletionCalls == 1 && staticWorldComplete && drawCalls == 0);
+    }
+    R_DrainWorldLeafTasks();
+    g_WorldSurfaceRenderer.pCurrentWorldLeaf.reset();
+    g_WorldSurfaceRenderer.hEntityUBO = 0;
+    glDeleteBuffers(1, &ubo);
+    entity.model = nullptr;
+    worldModel = nullptr;
+    viewLeaf = nullptr;
+    shadow = false;
+    r_draw_classify = DRAW_CLASSIFY_LIGHTMAP;
+    assert(liveWork == 0 && glGetError() == GL_NO_ERROR);
+    std::printf("{\"staticWorldCompletionGL\":true,\"productionWorldDispatch\":true,\"actualWorkerPendingAndReady\":true,\"explicitNoVisFallback\":true,\"previousFallbackUnverified\":true,\"closingFallbackRejected\":true,\"expiredProxyRejected\":true,\"emptyWorldComplete\":true,\"cubemapPixelsTested\":false,\"passed\":true}\n");
+}
+
+#include "renderer_collision_tests.inc"
+
+int main(int argc, char** argv)
+{
+    SetErrorMode(SEM_FAILCRITICALERRORS | SEM_NOGPFAULTERRORBOX);
+    std::memset(mod_novis, 0xff, sizeof(mod_novis));
+    if (argc == 2) LoadedVisibility(argv[1]);
