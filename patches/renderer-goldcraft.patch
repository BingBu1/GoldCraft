+// Match MetaHook/src/metahook.cpp's actual Queue/Wait/Delete contract,
+// including cancellation of an unstarted work item. No fake task algorithm.
+ThreadWorkItemHandle_t Create(ThreadPoolHandle_t, fnThreadWorkItemCallback callback, void* context)
+{
+    MainThread();
+    if (failCreate) return nullptr;
+    auto* work   = new Work{callback, context, nullptr, holdWork};
+    work->handle = CreateThreadpoolWork([](PTP_CALLBACK_INSTANCE, void* context, PTP_WORK) {
+        auto* work = static_cast<Work*>(context);
+        assert(std::this_thread::get_id() != gameThread && !wglGetCurrentContext());
+        if (work->held)
+        {
+            SetEvent(entered);
+            assert(WaitForSingleObject(resume, 10'000) == WAIT_OBJECT_0);
+        }
+        assert(!work->callback(work->context));
+        ++completedWork;
+    },
+                                        work, nullptr);
+    assert(work->handle);
+    ++liveWork;
+    return work;
+}
+void Queue(ThreadPoolHandle_t, ThreadWorkItemHandle_t handle)
+{
+    MainThread();
+    if (failQueue) throw std::bad_alloc();
+    SubmitThreadpoolWork(static_cast<Work*>(handle)->handle);
+}
+void Wait(ThreadWorkItemHandle_t handle)
+{
+    MainThread();
+    SetEvent(draining);
+    WaitForThreadpoolWorkCallbacks(static_cast<Work*>(handle)->handle, TRUE);
+}
+void Delete(ThreadWorkItemHandle_t handle)
+{
+    MainThread();
+    auto* work = static_cast<Work*>(handle);
+    CloseThreadpoolWork(work->handle);
+    delete work;
+    --liveWork;
+    ++deletedWork;
+}
