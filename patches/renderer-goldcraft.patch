+    }
+    void Draw() { glDrawArrays(GL_TRIANGLES, 0, 6); ++realDraws; }
+    void CheckGuards()
+    {
+        GLint bound{}; glGetIntegeri_v(GL_UNIFORM_BUFFER_BINDING, GuardBinding, &bound);
+        Check(static_cast<GLuint>(bound) == guard, "unrelated indexed UBO binding survives");
+        for (const GLuint binding : {ModelBinding, MaterialBinding})
+        {
+            glGetIntegeri_v(GL_SHADER_STORAGE_BUFFER_BINDING, binding, &bound);
+            Check(static_cast<GLuint>(bound) == guard, "equal-numbered SSBO binding survives UBO uploads");
+        }
