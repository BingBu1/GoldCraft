+        RPointShadowCullScope largeLight(largeOrigin, large);
+        Check(culling->CullShadowBounds(largeBox, largeBox)); // finite double arithmetic
+    }
+    const float other[]{310, 0, 0};
+    {
+        RPointShadowCullScope nested(other, 30);
+        Check(!culling->CullShadowBounds(farMin, farMax));
+    }
+    Check(culling->CullShadowBounds(farMin, farMax));
+}
+
+int dispatchDepth{};
+void NestedDispatch(uint32_t flags)
+{
+    if (dispatchDepth)
+    {
+        Check(!(flags & META_SCENE_SHADOW));
+        // Keep the renderer shadow input true to prove the per-dispatch gate
+        // revokes capability, independently of R_CullPointShadowBox's guard.
+        shadow = true;
+        Check(!culling->CullShadowBounds(farMin, farMax));
+        shadow = false;
+        return;
+    }
+    Check(culling->CullShadowBounds(farMin, farMax));
+    ++dispatchDepth;
+    shadow = false;
+    R_DrawExternalOpaqueScene();
+    shadow = true;
+    --dispatchDepth;
+    Check(culling->CullShadowBounds(farMin, farMax));
+}
+
+void Throwing(uint32_t)
+{
+    Check(culling->CullShadowBounds(farMin, farMax));
+    throw 17;
+}
+
+void Dispatch()
+{
+    const auto before = allocations;
+    R_DrawExternalOpaqueScene();
+    Check(allocations == before);
+}
+}
+
+int main()
+{
+    static_assert(noexcept(culling->CullShadowBounds(nullptr, nullptr)));
+    static_assert(!std::is_copy_constructible_v<RExternalSceneShadowCullScope>);
+    int result = -1;
+    scene = static_cast<IMetaRendererScene*>(CreateInterface(METARENDERER_SCENE_INTERFACE_VERSION, &result));
+    Check(scene && result == IFACE_OK);
+    culling = static_cast<IMetaRendererSceneCulling*>(CreateInterface(METARENDERER_SCENE_CULLING_INTERFACE_VERSION, &result));
+    Check(culling && result == IFACE_OK);
+    Check(CreateInterface(METARENDERER_SCENE_INTERFACE_VERSION, nullptr) == scene);
+    Check(CreateInterface(METARENDERER_SCENE_CULLING_INTERFACE_VERSION, nullptr) == culling);
+    Check(!CreateInterface("MetaRendererSceneCulling_API_999", &result) && result == IFACE_FAILED);
+    Check(!culling->CullShadowBounds(farMin, farMax));
+    scene->RegisterSceneCallbacks(nullptr);
+    scene->RegisterSceneCallbacks(&callback);
+    scene->RegisterSceneCallbacks(&callback);
+    callback.body = ExpectFar;
+    shadow = true;
+    {
+        RPointShadowCullScope light(origin, 100);
+        Dispatch(); // uninitialized cvar must retain geometry
+    }
+    Check(callbacks == 1 && maskCalls == 1); // duplicate registration is idempotent
+    gEngfuncs.pfnRegisterVariable = [](const char*, const char*, int) { return &enabled; };
+    R_InitShadowCulling();
+    enabled.value = 1;
+    Dispatch(); // no actual point volume: spot/directional/unknown fail open
+    {
+        RPointShadowCullScope light(origin, 100);
+        Check(!culling->CullShadowBounds(farMin, farMax)); // outside callback
+        expectedCull = true;
+        Dispatch();
+        const auto beforeCallbacks = callbacks, beforeMasks = maskCalls;
+        r_draw_classify = DRAW_CLASSIFY_WORLD;
+        Dispatch(); // cached static-world shadow must not dispatch plugin
+        Check(callbacks == beforeCallbacks && maskCalls == beforeMasks);
+        r_draw_classify = DRAW_CLASSIFY_OPAQUE_ENTITIES;
+        expectedCull = false;
+        enabled.value = 0;
+        Dispatch();
+        enabled.value = -1;
+        Dispatch();
+        enabled.value = 1;
+        shadow = false;
+        gbuffer = gamma = true;
+        Dispatch(); // main/reflection do not borrow the point-light volume
+        shadow = multiview = linearDepth = true;
+        gbuffer = gamma = false;
+        callback.body = Boundaries;
+        Dispatch();
+        callback.body = NestedDispatch;
+        Dispatch();
+        callback.body = Throwing;
+        try { R_DrawExternalOpaqueScene(); Check(false); }
+        catch (int value) { Check(value == 17); }
+        Check(!culling->CullShadowBounds(farMin, farMax)); // unwind revoked gate
+        callback.body = ExpectFar;
+        expectedCull = true;
+        Dispatch();
+    }
+    expectedCull = false;
+    Dispatch(); // point scope revoked, even with shadow flags still set
+    Check(!culling->CullShadowBounds(farMin, farMax));
+    const auto beforeCallbacks = callbacks, beforeMasks = maskCalls;
+    scene->UnregisterSceneCallbacks(&callback);
+    scene->UnregisterSceneCallbacks(&callback);
+    Dispatch();
+    Check(callbacks == beforeCallbacks && maskCalls == beforeMasks);
+    // Old Scene001 methods still use the actual unchanged factory/vtable.
+    scene->SetDynamicLightShadowSize(7, 128);
+    Check(R_GetExternalDlightShadowSize(7) == 128);
+    scene->SetDynamicLightShadowSize(7, 0);
+    Check(R_GetExternalDlightShadowSize(7) == 0);
+    Check(profileCalls > 0);
+    std::printf("SceneCulling001: %u checks, %u production callbacks; CPU-only dispatch/volume/factory evidence\n", checks, callbacks);
+}
diff --git a/tests/extract_scene_culling_dispatch.py b/tests/extract_scene_culling_dispatch.py
new file mode 100644
index 0000000..44e2e80
--- /dev/null
+++ b/tests/extract_scene_culling_dispatch.py
@@ -0,0 +1,37 @@
+"""Extract the complete production scene registry, dispatch and API factories.
+
+Only engine view inputs and the pre-dispatch GBuffer mask call are adapted by
+the CPU fixture. Its optional culling provider and light-volume implementation
+remain production code. This does not prove a rendered shadow or game FPS.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument("--rmain", type=Path, required=True)
+parser.add_argument("--output", type=Path, required=True)
+parser.add_argument("--manifest", type=Path, required=True)
+args = parser.parse_args()
+source = args.rmain.read_text(encoding="utf-8-sig")
+start = "namespace\n{\nstd::vector<IMetaRendererSceneCallbacks*> externalSceneCallbacks;"
+end = "\nclass CMetaRenderer : public IMetaRenderer\n"
+if source.count(start) != 1 or source.count(end) != 1:
+    raise SystemExit("Production scene extraction boundaries changed")
+body = source[source.index(start):source.index(end)]
+for required in (
+    "void R_DrawExternalOpaqueScene()",
+    "RExternalSceneShadowCullScope cullScope((flags & META_SCENE_SHADOW) != 0);",
+    "EXPOSE_SINGLE_INTERFACE(CMetaRendererScene, IMetaRendererScene, METARENDERER_SCENE_INTERFACE_VERSION);",
+    "EXPOSE_SINGLE_INTERFACE(CMetaRendererSceneCulling, IMetaRendererSceneCulling, METARENDERER_SCENE_CULLING_INTERFACE_VERSION);",
+):
+    if body.count(required) != 1:
+        raise SystemExit("Missing or duplicated production boundary: " + required)
+args.output.parent.mkdir(parents=True, exist_ok=True)
+args.output.write_text("// Complete production scene dispatch and factories.\n" + body, encoding="utf-8")
+args.manifest.write_text(json.dumps({
+    "sourceSha256": hashlib.sha256(args.rmain.read_bytes()).hexdigest(),
+    "extractedSha256": hashlib.sha256(body.encode()).hexdigest(),
+    "boundary": "Production registry, DrawOpaqueScene dispatch, existing Scene001 and optional SceneCulling001 factories; engine view inputs adapted.",
+}, indent=2) + "\n", encoding="utf-8")
