+#pragma once
+#include <interface.h>
+
+// Optional, same-process CPU culling extension. The existing Renderer and
+// Scene_API_001 vtables are unchanged. Use only on the Renderer/GL thread.
+class IMetaRendererSceneCulling : public IBaseInterface
+{
+public:
+    // Valid only during DrawOpaqueScene with META_SCENE_SHADOW. Supply the
+    // complete geometry's AABB in final GoldSrc world coordinates, including
+    // its current animation. Each non-null pointer addresses three floats.
+    // true proves this box cannot shadow a lit receiver in the current pass;
+    // the consumer may omit that geometry for this invocation only. false
+    // means visible OR unknown: draw normally. Do not cache across callbacks.
+    //
+    // API001 uses the actual current point-light sphere, with conservative
+    // boundary tolerance. Spot/directional/unknown volumes, calls outside an
+    // external shadow callback, disabled culling, null pointers and invalid
+    // bounds all return false. No main-camera frustum is substituted. This
+    // performs no GL queries, changes no GL state and allocates no memory.
+    virtual bool CullShadowBounds(const float* mins, const float* maxs) noexcept = 0;
+};
+
+#define METARENDERER_SCENE_CULLING_INTERFACE_VERSION "MetaRendererSceneCulling_API_001"
