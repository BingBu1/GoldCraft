+        excludedHosts.fill(false); std::fill(std::begin(g_bPortalClipPlaneEnabled), std::end(g_bPortalClipPlaneEnabled), false);
+        model.mStudioMaterials.clear(); texture = {}; std::strcpy(texture.name, "ordinary.bmp");
