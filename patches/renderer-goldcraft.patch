+}
+void CountGetIntegerv(GLenum name, GLint* value) { ++calls.queries; glGetIntegerv(name, value); }
+GLenum CountGetError() { ++calls.queries; return glGetError(); }
+void CountFinish() { ++calls.finishes; glFinish(); }
