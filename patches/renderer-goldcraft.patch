+    r_draw_opaque = testShadow = testMultiview = true;
+    r_draw_hasoutline = false; faceCull.value = 0; depthExecutor.value = 1;
+
+    for (bool cube : {false, true})
+    {
+        testLinear = cube;
+        Target target(cube);
+        const auto camera = Camera(cube);
+        Mesh geometry = cube ? CubeGeometry() : Triangle({-.7f,-.7f,0},{.7f,-.7f,0},{0,.7f,0});
+        if (!cube) Append(geometry, Triangle({-.5f,-.5f,-.2f},{.5f,-.5f,-.2f},{0,.5f,-.2f}));
+        source.submodel.nummesh = int(geometry.size() / 3);
+        Check(source.submodel.nummesh <= 64, "bounded batch source fixture");
+        prepared.vMesh.clear();
