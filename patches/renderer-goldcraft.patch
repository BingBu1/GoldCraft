+bool R_CanBatchWorldMaterials()
+{
+    return r_world_material_batch && r_world_material_batch->value == 1.f && GLEW_ARB_shader_draw_parameters &&
+        g_WorldSurfaceRenderer.bDiffuseTexture && r_draw_opaque && !R_IsRenderingShadowView() &&
+        !R_IsRenderingMultiView() && !R_IsRenderingWaterView() && !g_bPortalClipPlaneEnabled[0] &&
+        ((*currententity)->curstate.rendermode == kRenderNormal || (*currententity)->curstate.rendermode == kRenderTransAlpha);
+}
+
+bool R_ResolveWorldMaterialBatch(const world_batch::Batch& batch,
+    const std::vector<CWorldSurfaceBrushTexChain>& chains, std::array<GLuint, world_batch::TextureCount>& textures)
+{
+    for (unsigned slot = 0; slot < batch.chainCount; ++slot)
+    {
+        const auto& chain = chains[batch.firstChain + slot];
+        if (!chain.texture || !chain.texture->gl_texturenum) return false;
+        textures[slot] = chain.texture->gl_texturenum;
+        if (const auto* material = chain.pRenderMaterial.get())
+        {
+            // Detail/normal/parallax/specular materials retain their complete
+            // existing path. A diffuse replacement alone is batch-compatible.
+            if (r_detailtextures && (int)r_detailtextures->value > 0)
+                for (int layer = WSURF_DETAIL_TEXTURE; layer < WSURF_MAX_TEXTURE; ++layer)
+                    if (material->textures[layer].gltexturenum) return false;
+            if (material->textures[WSURF_DIFFUSE_TEXTURE].gltexturenum)
+                textures[slot] = material->textures[WSURF_DIFFUSE_TEXTURE].gltexturenum;
+        }
+    }
+    return true;
+}
