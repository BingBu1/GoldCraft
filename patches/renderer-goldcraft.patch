+          STUDIO_SHADOW_CASTER_ENABLED), "missing host texture header falls back");
+    Check(!R_StudioDepthExecutorEligible(&model, &renderMesh, &sourceMesh, &textureHeader, nullptr, &skinref,
+          STUDIO_SHADOW_CASTER_ENABLED), "missing host texture array falls back");
+    Check(!R_StudioDepthExecutorEligible(&model, &renderMesh, &sourceMesh, &textureHeader, &texture, nullptr,
+          STUDIO_SHADOW_CASTER_ENABLED), "missing host skin mapping falls back");
