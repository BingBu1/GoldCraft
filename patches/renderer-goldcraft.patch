+void GeometryCases(const std::string& original)
+{
+    Target csm(false), cube(true);
+    const auto cascades = Camera(false), faces = Camera(true);
+    const auto programs = MakePrograms("", false, true, original);
+    Bones(false);
+    Compare("inside", csm, cascades, Triangle({-.7f,-.7f,0},{.7f,-.7f,0},{0,.7f,0}), programs, 4);
+    for (int axis = 0; axis < 2; ++axis)
+        for (int sign : {-1, 1})
+        {
+            Vec a{-.3f,-.3f,0}, b{.3f,-.3f,0}, c{0,.3f,0};
+            a[axis] = b[axis] = c[axis] = sign * 20.f;
+            Compare("common side outside", csm, cascades, Triangle(a,b,c), programs, 0);
+        }
+    Compare("one cascade rejects", csm, cascades, Triangle({1.2f,-.2f,0},{1.8f,-.2f,0},{1.5f,.3f,0}), programs, 3);
+    Compare("one vertex enters", csm, cascades, Triangle({.8f,0,0},{1.6f,-.6f,0},{1.6f,.6f,0}), programs, 4);
+    Compare("all vertices outside but triangle encloses view", csm, cascades,
+        Triangle({-3,-3,0},{3,-3,0},{0,3,0}), programs, 4);
+    Compare("crosses adjacent sides", csm, cascades, Triangle({-.6f,1.4f,0},{1.4f,-.6f,0},{2,2,0}), programs, 4);
+    for (float edge : {1.f, std::nextafter(1.f, 2.f), 1.000005f})
+        Compare("edge or uncertainty band retained", csm, cascades,
+            Triangle({edge,-.5f,0},{edge,.5f,0},{edge+.000001f,0,0}), programs, 4);
+    Compare("degenerate retained", csm, cascades, Triangle({0,0,0},{0,0,0},{0,0,0}), programs, 4);
+    auto behind = cascades;
+    for (int i = 0; i < 4; ++i) behind.views[i].projMatrix[3][3] = -1.f;
+    Compare("negative w fails open", csm, behind, Triangle({20,-1,0},{21,-1,0},{20,1,0}), programs, 4);
+    for (bool clamp : {false, true})
+    {
+        if (clamp) glEnable(GL_DEPTH_CLAMP); else glDisable(GL_DEPTH_CLAMP);
+        for (float z : {-2.f, -1.f, 1.f, 2.f})
+            Compare(clamp ? "z-only with depth clamp" : "z-only with clipping", csm, cascades,
+                Triangle({-.7f,-.7f,z},{.7f,-.7f,z},{0,.7f,z}), programs, 4);
+    }
+    glDisable(GL_DEPTH_CLAMP);
+    const auto cloud = CubeGeometry();
+    const auto allFaces = Compare("six real cube views", cube, faces, cloud, programs);
+    for (int layer = 0; layer < 6; ++layer) Check(Written(allFaces.depth, layer) > 20, "all cube layers receive geometry");
+    Check(allFaces.primitives < cloud.size() / 3 * 6, "real cubemap reduces GS primitive emissions");
+    Compare("cube seam crossing", cube, faces, Triangle({3,2.8f,-1},{2.8f,3,1},{4,4,0}), programs);
+    Compare("eye-plane crossing with negative w", cube, faces,
+        Triangle({-1,-.2f,-.2f},{3,-1,1},{3,1,-1}), programs, 6);
+    Compare("surrounds eye", cube, faces, Triangle({-4,-4,.2f},{4,-4,.2f},{0,4,.2f}), programs, 6);
+    Compare("near-zero w fails open", cube, faces,
+        Triangle({1e-8f,1e-8f,1e-8f},{2e-8f,1e-8f,1e-8f},{1e-8f,2e-8f,1e-8f}), programs, 6);
+    for (float bad : {std::numeric_limits<float>::quiet_NaN(), std::numeric_limits<float>::infinity(),
+             -std::numeric_limits<float>::infinity(), (std::numeric_limits<float>::max)()})
+    {
+        const auto mesh = Triangle({bad,0,0},{0,.5f,0},{0,0,.5f});
+        const auto retained = Draw(cube, faces, mesh, programs.layered, 1, false, true);
+        Check(retained.primitives == 6, "non-finite/uncertain clip coordinates fail open (raster discard)");
+    }
+    // Packed bone 0x0101 selects distinct vertex AND normal bone 1 in actual VS.
+    const auto skin = Triangle({-.65f,-.65f,0},{.65f,-.65f,0},{0,.65f,0}, 0x0101);
+    const auto rest = Compare("bone rest pose", csm, cascades, skin, programs);
+    Bones(true);
+    const auto moved = Compare("bone rotated and translated", csm, cascades, skin, programs);
+    Check(rest.depth != moved.depth && Written(moved.depth) > 0, "actual production bone transform changes coverage");
+    Bones(false);
+    Delete(programs);
+
+    const auto linear = MakePrograms("", true, true, original);
+    Compare("cube production radial depth", cube, faces, cloud, linear);
+    for (bool clamp : {false, true})
+    {
+        if (clamp) glEnable(GL_DEPTH_CLAMP); else glDisable(GL_DEPTH_CLAMP);
+        Compare("cube near-plane and depth-clamp radial", cube, faces,
+            Triangle({.05f,-.025f,-.025f},{.05f,.025f,-.025f},{.05f,0,.025f}), linear);
+    }
+    glDisable(GL_DEPTH_CLAMP);
+    Delete(linear);
+
+    const auto normal = MakePrograms("", false, false, original);
+    Compare("non-shadow multiview unchanged", cube, faces, cloud, normal, int(cloud.size() / 3 * 6));
+    Delete(normal);
+}
