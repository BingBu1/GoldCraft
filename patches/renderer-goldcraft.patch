+void R_DrawWorldSurfaceLeafShadow(CWorldSurfaceLeaf* pLeaf, bool bWithSky)
+{
+    const auto& combined = pLeaf->TextureChainSpecial[bWithSky ? WSURF_TEXCHAIN_SPECIAL_SOLID_WITH_SKY : WSURF_TEXCHAIN_SPECIAL_SOLID];
+    if (!combined.drawCount) return;
+
+    GL_BeginDebugGroup("R_DrawWorldSurfaceLeafShadow");
+    R_DrawWorldSurfaceLeafBegin(pLeaf);
+    glDisable(GL_CULL_FACE);
+
+    program_state_t state = 0;
+    if (R_IsRenderingGBuffer()) state |= WSURF_GBUFFER_ENABLED;
+    if (R_IsRenderingShadowView()) state |= WSURF_SHADOW_CASTER_ENABLED;
+    if (R_IsRenderingMultiView()) state |= WSURF_MULTIVIEW_ENABLED;
+    if (R_IsRenderingLinearDepth()) state |= WSURF_LINEAR_DEPTH_ENABLED;
+    if (R_IsRenderingWaterView()) state |= WSURF_CLIP_WATER_ENABLED;
+    else if (g_bPortalClipPlaneEnabled[0])
+        state |= WSURF_CLIP_ENABLED;
+
+    if ((*currententity)->curstate.rendermode != kRenderTransAlpha)
+    {
+        // Depth-only opaque casters have no material-dependent discard. The
+        // immutable combined commands include ordinary, animated and cavity
+        // surfaces, without a texture fetch or a bind for each material.
+        wsurf_program_t program{};
+        R_UseWSurfProgram(state, &program);
+        glMultiDrawElementsIndirect(GL_TRIANGLES, GL_UNSIGNED_INT,
+                                    reinterpret_cast<void*>(combined.startDrawOffset), combined.drawCount, 0);
+        (*c_brush_polys) += combined.polyCount;
+    }
+    else
+    {
+        const auto draw = [&](const CWorldSurfaceBrushTexChain& chain, bool animated) {
+            if (!chain.drawCount) return;
+            auto* texture = animated ? R_GetAnimatedTexture(chain.texture) : chain.texture;
+            GL_Bind(texture ? texture->gl_texturenum : 0);
+            wsurf_program_t program{};
+            R_UseWSurfProgram(state | WSURF_ALPHA_SOLID_ENABLED | (texture ? WSURF_DIFFUSE_ENABLED : 0), &program);
+            glMultiDrawElementsIndirect(GL_TRIANGLES, GL_UNSIGNED_INT,
+                                        reinterpret_cast<void*>(chain.startDrawOffset), chain.drawCount, 0);
+            (*c_brush_polys) += chain.polyCount;
+        };
+        for (const auto& chain : pLeaf->vTextureChainList[WSURF_TEXCHAIN_LIST_STATIC]) draw(chain, false);
+        for (const auto& chain : pLeaf->vTextureChainList[WSURF_TEXCHAIN_LIST_ANIM]) draw(chain, true);
+        if (bWithSky) draw(pLeaf->TextureChainSpecial[WSURF_TEXCHAIN_SPECIAL_SKY], false);
+    }
+
+    GL_UseProgram(0);
+    glEnable(GL_CULL_FACE);
+    R_DrawWorldSurfaceLeafEnd();
+    GL_EndDebugGroup();
+}
