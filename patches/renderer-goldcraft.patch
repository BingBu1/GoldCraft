+namespace {
+std::vector<IMetaRendererSceneCallbacks*> externalSceneCallbacks;
+std::unordered_map<int, unsigned> externalLightShadowSizes;
+}
+
+void R_DrawExternalOpaqueScene()
+{
+	// Static shadow textures are cached. Mutable plugin geometry belongs in
+	// dynamic entity shadow passes, never the cached world-only pass.
+	if (!(r_draw_classify & DRAW_CLASSIFY_OPAQUE_ENTITIES) || externalSceneCallbacks.empty())
+		return;
+	uint32_t flags = 0;
+	if (R_IsRenderingGBuffer()) flags |= META_SCENE_GBUFFER;
+	if (R_IsRenderingShadowView()) flags |= META_SCENE_SHADOW;
+	if (R_IsRenderingMultiView()) flags |= META_SCENE_MULTIVIEW;
+	if (R_IsRenderingLinearDepth()) flags |= META_SCENE_LINEAR_DEPTH;
+	if (R_IsRenderingGammaBlending()) flags |= META_SCENE_GAMMA_BLEND;
+	R_SetGBufferMask(GBUFFER_MASK_ALL);
+	for (auto* callback : externalSceneCallbacks) callback->DrawOpaqueScene(flags);
+}
+
+unsigned R_GetExternalDlightShadowSize(int key)
+{
+	auto it = externalLightShadowSizes.find(key);
+	return it == externalLightShadowSizes.end() ? 0 : it->second;
+}
+
+class CMetaRendererScene : public IMetaRendererScene
+{
+public:
+	void RegisterSceneCallbacks(IMetaRendererSceneCallbacks* callbacks) override
+	{
+		if (callbacks && externalSceneCallbacks.size() < 16 &&
+			std::find(externalSceneCallbacks.begin(), externalSceneCallbacks.end(), callbacks) == externalSceneCallbacks.end())
+			externalSceneCallbacks.push_back(callbacks);
+	}
+	void UnregisterSceneCallbacks(IMetaRendererSceneCallbacks* callbacks) override
+	{
+		externalSceneCallbacks.erase(std::remove(externalSceneCallbacks.begin(), externalSceneCallbacks.end(), callbacks), externalSceneCallbacks.end());
+	}
+	void SetDynamicLightShadowSize(int key, unsigned size) override
+	{
+		if (size == 0) externalLightShadowSizes.erase(key);
+		else if ((size == 128 || size == 256 || size == 512) &&
+			(externalLightShadowSizes.size() < 32 || externalLightShadowSizes.count(key)))
+			externalLightShadowSizes[key] = size;
+	}
+};
+EXPOSE_SINGLE_INTERFACE(CMetaRendererScene, IMetaRendererScene, METARENDERER_SCENE_INTERFACE_VERSION);
