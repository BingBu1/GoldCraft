+};
+struct Binding { GLint buffer{}; GLint64 offset{}, size{}; bool operator==(const Binding&) const = default; };
+Binding ReadBinding(GLuint binding)
+{
+    Binding result; glGetIntegeri_v(GL_UNIFORM_BUFFER_BINDING, binding, &result.buffer);
+    glGetInteger64i_v(GL_UNIFORM_BUFFER_START, binding, &result.offset);
+    glGetInteger64i_v(GL_UNIFORM_BUFFER_SIZE, binding, &result.size); return result;
+}
+void NoDrawAllocation(const DriverCalls& before)
+{
+    Check(calls.generated == before.generated && calls.storage == before.storage && calls.maps == before.maps &&
+        calls.data == before.data && calls.queries == before.queries && calls.finishes == before.finishes,
+        "draw path performs no storage allocation, remap, BufferData, synchronous state query or glFinish");
+    Check(calls.nonzeroTimeouts == 0 && calls.flushWaits == 0, "arena never blocks or requests implicit flush on fence polls");
+}
+bool Dispatch(GLuint fallback, GLuint binding, std::size_t size, const void* data)
+{
+    const auto before = calls; const auto stats = g_DrawParameters.Stats();
+    GL_UploadDrawParameters(fallback, binding, size, data);
+    NoDrawAllocation(before);
+    const bool streamed = g_DrawParameters.Stats().streamedDraws == stats.streamedDraws + 1;
+    if (streamed)
+    {
+        Check(calls.subData == before.subData && calls.namedSubData == before.namedSubData && calls.ranges == before.ranges + 1,
+            "successful persistent upload uses one range bind and no driver data upload");
+    }
+    else
+        Check(calls.subData + calls.namedSubData == before.subData + before.namedSubData + 1,
+            "actual production dispatcher uploads mutable fallback exactly once");
+    return streamed;
+}
+void CheckReset()
+{
+    const auto buffers = arenaBuffers; const auto fences = arenaFences;
+    g_DrawParameters.Reset();
+    for (auto buffer : buffers) Check(!glIsBuffer(buffer), "Reset deletes arena buffer names");
+    for (auto fence : fences) Check(!glIsSync(fence), "Reset deletes arena fence names");
+    Check(arenaBuffers.empty() && arenaFences.empty(), "Reset releases every tracked arena resource");
+    const auto& stats = g_DrawParameters.Stats();
+    Check(!stats.streamedDraws && !stats.streamedBytes && !stats.fallbacks && !stats.busyFallbacks && !stats.pageRotations && !stats.syncFailures,
+        "Reset clears context-owned statistics");
+    const auto before = calls; g_DrawParameters.Reset();
+    Check(calls.deleted == before.deleted && calls.deletedFences == before.deletedFences && calls.unmaps == before.unmaps,
+        "repeated Reset makes no further resource calls");
+}
+void InitStream()
+{
+    const auto before = calls;
+    Check(g_DrawParameters.Init(), "persistent parameter arena initializes on capable driver");
+    Check(calls.generated == before.generated + CDrawParameterStream::PAGE_COUNT &&
+        calls.storage == before.storage + CDrawParameterStream::PAGE_COUNT && calls.maps == before.maps + CDrawParameterStream::PAGE_COUNT,
+        "Init allocates/maps exactly the fixed three pages");
+    Check(calls.data == before.data, "Init uses immutable storage only");
+    Check(arenaBuffers.size() == CDrawParameterStream::PAGE_COUNT, "arena resource bound is fixed");
