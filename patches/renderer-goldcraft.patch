+"""Extract unchanged world submission and shader selection for a real GL regression."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from extract_studio_depth_executor import function
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--src', type=Path, required=True)
+    p.add_argument('--output', type=Path, required=True)
+    p.add_argument('--manifest', type=Path, required=True)
+    args = p.parse_args()
+    groups = {
+        'gl_rmisc.cpp': ('void GL_BindTextureUnit(', 'void GL_BeginStencilWrite(',
+                         'void GL_BeginStencilCompareNotEqual('),
+        'gl_wsurf.cpp': ('void R_UseWSurfProgram(', 'void R_BeginDetailTextureFromRenderMaterial(',
+                         'void R_EndDetailTexture('),
+        'world_leaf_draw.cpp': ('bool R_CanBatchWorldMaterials(', 'bool R_ResolveWorldMaterialBatch(',
+                               'void R_DrawWorldSurfaceLeafBegin(', 'void R_DrawWorldSurfaceLeafEnd(',
+                               'void R_DrawWorldSurfaceLeafStatic('),
+    }
+    code = 'std::unordered_map<program_state_t, wsurf_program_t> g_WSurfProgramTable;\n'
+    for filename, signatures in groups.items():
+        source = (args.src / filename).read_text(encoding='utf-8-sig')
+        code += '\n\n'.join(function(source, s) for s in signatures) + '\n'
+    args.output.write_text(code, encoding='utf-8')
+    args.manifest.write_text(json.dumps({
+        'inputs': {n: hashlib.sha256((args.src/n).read_bytes()).hexdigest() for n in groups},
+        'output': hashlib.sha256(code.encode()).hexdigest(),
+        'scope': 'Exact production texture/stencil/selection/static leaf draw; full world shaders. Host decisions and loading adapted. Not game FPS.'
+    }, indent=2) + '\n', encoding='utf-8')
+
+
+if __name__ == '__main__':
+    main()
