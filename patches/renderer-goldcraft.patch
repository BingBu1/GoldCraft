+
+void EligibilityCases()
+{
+    const auto base = Eligible();
+    Check(R_StudioCanUseDepthExecutor(base), "ordinary opaque shadow qualifies");
+    const program_state_t allowed = STUDIO_NF_FLATSHADE | STUDIO_NF_FULLBRIGHT | STUDIO_NF_NOMIPS | STUDIO_NF_NOOUTLINE;
+    for (program_state_t flags : {program_state_t(0), allowed})
+    {
+        auto context = base;
+        context.textureFlags = flags;
+        context.drawState |= flags;
+        Check(R_StudioCanUseDepthExecutor(context), "explicit opaque flag subset qualifies");
+    }
+    for (int bit = 0; bit < int(sizeof(program_state_t) * 8); ++bit)
+    {
+        const program_state_t flag = program_state_t(1) << bit;
+        if (allowed & flag) continue;
+        auto context = base;
+        context.textureFlags |= flag;
+        Check(!R_StudioCanUseDepthExecutor(context), "all unrecognized material flags fail closed");
+    }
+    for (const char* name : {"Packed_abc.bmp", "pAcKeD_abc.bmp", "Remap001.bmp", "rEmAp001.bmp", "DM_Base.bmp", "dm_base.BMP"})
+    {
+        auto context = base;
+        context.textureName = name;
+        Check(!R_StudioCanUseDepthExecutor(context), "packed/remap material names fall back");
+    }
+    for (program_state_t flag : {program_state_t(STUDIO_NF_MASKED), program_state_t(STUDIO_ALPHA_BLEND_ENABLED),
+             program_state_t(STUDIO_ADDITIVE_BLEND_ENABLED), program_state_t(STUDIO_GLOW_SHELL_ENABLED),
+             program_state_t(STUDIO_OUTLINE_ENABLED), program_state_t(STUDIO_CLIP_ENABLED),
+             program_state_t(STUDIO_CLIP_WATER_ENABLED), program_state_t(STUDIO_CLIP_BONE_ENABLED),
+             program_state_t(STUDIO_CLIP_NEARPLANE_ENABLED), program_state_t(STUDIO_ANIMATED_TEXTURE_ENABLED),
+             program_state_t(STUDIO_PACKED_DIFFUSETEXTURE_ENABLED), program_state_t(STUDIO_NORMALTEXTURE_ENABLED),
+             program_state_t(STUDIO_GBUFFER_ENABLED), program_state_t(1ull << 63)})
+    {
+        auto context = base;
+        context.drawState |= flag;
+        Check(!R_StudioCanUseDepthExecutor(context), "special/unknown draw state falls back");
+    }
+    for (int which = 0; which < 16; ++which)
+    {
+        auto context = base;
+        switch (which)
+        {
+        case 0: context.enabled = false; break;
+        case 1: context.shadowView = false; break;
+        case 2: context.opaque = false; break;
+        case 3: context.ordinaryMode = false; break;
+        case 4: context.ordinaryFx = false; break;
+        case 5: context.externalMaterials = true; break;
+        case 6: context.excludedView = true; break;
+        case 7: context.fullbrightAllowed = false; break;
+        case 8: context.indexCount = 0; break;
+        case 9: context.indexCount = -1; break;
+        case 10: context.firstIndex = -1; break;
+        case 11: context.textureWidth = 0; break;
+        case 12: context.textureHeight = -1; break;
+        case 13: context.textureName = {}; break;
+        case 14: context.drawState = 0; break;
+        case 15: context.validTexture = false; break;
+        }
+        const auto before = State();
+        const auto draws = meshSubmissions;
+        Check(!R_StudioCanUseDepthExecutor(context), "individual unsafe context falls back");
+        Check(State() == before && meshSubmissions == draws, "eligibility fallback has no GL effects");
+    }
+}
