+namespace
+{
+// File records follow pinned ReHLDS public/rehlds/bspfile.h and
+// engine/model.cpp::CalcSurfaceExtents. No client-engine private ABI is read.
+struct CavityBspFile
+{
+    std::vector<std::uint8_t> bytes;
+    std::array<std::size_t,15> offsets{}, lengths{};
+    explicit CavityBspFile(const char* path)
+    {
+        std::ifstream file(path,std::ios::binary); assert(file.good());
+        bytes.assign(std::istreambuf_iterator<char>(file),{});
+        assert(bytes.size()>=124 && U32(0)==30);
+        std::uint32_t crc=0xffffffffu;
+        for (auto byte : bytes) { crc^=byte; for (int i=0;i<8;++i) crc=(crc>>1)^((0u-(crc&1))&0xedb88320u); }
+        assert((crc^0xffffffffu)==0xf6725c06u);
+        for (int i=0;i<15;++i) { offsets[i]=U32(4+i*8); lengths[i]=U32(8+i*8); assert(offsets[i]<=bytes.size() && lengths[i]<=bytes.size()-offsets[i]); }
+    }
+    std::uint16_t U16(std::size_t at) const { assert(at+2<=bytes.size()); return std::uint16_t(bytes[at])|(std::uint16_t(bytes[at+1])<<8); }
+    std::uint32_t U32(std::size_t at) const { return std::uint32_t(U16(at))|(std::uint32_t(U16(at+2))<<16); }
+    float F32(std::size_t at) const { return std::bit_cast<float>(U32(at)); }
+    std::size_t Record(unsigned lump,std::size_t index,std::size_t stride) const {
+        assert(lengths[lump]%stride==0 && index<lengths[lump]/stride); return offsets[lump]+index*stride;
+    }
+    goldcraft::carving::Point Vertex(std::int32_t surfedge) const {
+        const auto edge=Record(12,std::size_t(surfedge<0?-std::int64_t(surfedge):surfedge),4);
+        const auto vertex=Record(3,U16(edge+(surfedge<0?2:0)),12); return {F32(vertex),F32(vertex+4),F32(vertex+8)};
+    }
+};
+
+std::shared_ptr<const goldcraft::visibility::Source> MapVisibility(const CavityBspFile& bsp)
+{
+    using namespace goldcraft;
+    auto source=std::make_shared<visibility::Source>();
+    for (std::size_t i=0;i<bsp.lengths[1]/20;++i) {
+        const auto at=bsp.Record(1,i,20);
+        source->planes.push_back({{bsp.F32(at),bsp.F32(at+4),bsp.F32(at+8)},bsp.F32(at+12)});
+    }
+    const auto world=bsp.Record(14,0,64), leaves=std::size_t(bsp.U32(world+52));
+    // The file also contains brush submodels with leaves beyond world.visleafs.
+    // Snapshot the reachable WORLD tree; those leaves have no world PVS row.
+    std::vector<std::int32_t> mapping(bsp.lengths[5]/24,-1);
+    const auto copy_node=[&](auto&& self,std::int32_t index)->std::int32_t {
+        if (index<0) { assert(std::size_t(-1-index)<=leaves); return index; }
+        assert(std::size_t(index)<mapping.size());
+        if (mapping[index]>=0) return mapping[index];
+        const auto result=static_cast<std::int32_t>(source->nodes.size()); mapping[index]=result;
+        const auto at=bsp.Record(5,index,24);
+        source->nodes.push_back({bsp.U32(at),{}});
+        const auto front=self(self,std::bit_cast<std::int16_t>(bsp.U16(at+4)));
+        const auto back=self(self,std::bit_cast<std::int16_t>(bsp.U16(at+6)));
+        source->nodes[result].children={front,back}; return result;
+    };
+    source->root=copy_node(copy_node,std::bit_cast<std::int32_t>(bsp.U32(world+36)));
+    const auto words=(leaves+63)/64, bytes=(leaves+7)/8;
+    source->pvs.resize(words*leaves);
+    for (std::size_t i=0;i<=leaves;++i) {
+        const auto at=bsp.Record(10,i,28);
+        source->contents.push_back(std::bit_cast<std::int32_t>(bsp.U32(at)));
+        if (!i) continue;
+        const auto offset=std::bit_cast<std::int32_t>(bsp.U32(at+4));
+        auto* row=source->pvs.data()+(i-1)*words;
+        if (offset<0) { std::fill_n(row,words,~std::uint64_t{}); continue; }
+        std::size_t input=std::size_t(offset), output=0;
+        // Independent, bounded decoding of the actual file's Quake PVS bytes.
+        while (output<bytes) {
+            assert(input<bsp.lengths[4]); const auto value=bsp.bytes[bsp.offsets[4]+input++];
+            if (value) { row[output/8]|=std::uint64_t(value)<<((output%8)*8); ++output; }
+            else {
+                assert(input<bsp.lengths[4]); const auto run=bsp.bytes[bsp.offsets[4]+input++];
+                // ReHLDS cmodel.cpp::CM_DecompressPVS clips a terminal zero
+                // run to the requested row width (real map rows can be padded).
+                assert(run); output+=(std::min)(std::size_t(run),bytes-output);
+            }
+        }
+    }
+    return source;
+}
+std::uint32_t MapLeaf(const goldcraft::visibility::Source& source, const goldcraft::carving::Point& point)
+{
+    auto index=source.root;
+    while (index>=0) {
+        const auto& node=source.nodes[index]; const auto& plane=source.planes[node.plane];
+        double distance=-plane.distance;
+        for (int i=0;i<3;++i) distance+=plane.normal[i]*point[i];
+        index=node.children[distance>=0?0:1];
+    }
+    return static_cast<std::uint32_t>(-1-index);
+}
