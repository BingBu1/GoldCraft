+    const std::vector<carving::HullNode> nodes{{0, {-1, -2}}};
+    const std::vector<carving::Box> cuts{{{16, 32, -8}, {32, 64, 8}}, {{96, 32, -8}, {112, 64, 8}}};
+    const cavity::Model carving{0, 2, {planes, nodes, 0}, cuts};
+    auto geometry = R_PrepareCarvedWorldGeometry(base, {&carving, 1});
+    assert(geometry->m_vCavityDraws.size() == 2);
+    auto source = std::make_shared<visibility::Source>();
+    source->planes = {{{0, 0, 1}, 0}, {{1, 0, 0}, 64}};
+    source->nodes = {{0, {1, -1}}, {1, {-3, -2}}};
+    source->contents = {-2, -1, -1}; source->pvs = {1, 2};
+    const visibility::Prepared visibility(source, cuts), restored(source, {});
+    const auto left = R_PrepareVisibleCavityGeometry(geometry, visibility, 1);
+    const auto right = R_PrepareVisibleCavityGeometry(geometry, visibility, 2);
+    const auto both = R_PrepareVisibleCavityGeometry(geometry, visibility, 0);
+    const auto empty = R_PrepareVisibleCavityGeometry(geometry, restored, 1);
+    assert(left->m_vDrawIndices == std::vector<uint32_t>{0});
+    assert(right->m_vDrawIndices == std::vector<uint32_t>{1});
+    assert(both->m_vDrawIndices == (std::vector<uint32_t>{0, 1}));
+    assert(empty->m_vDrawIndices.empty() && !empty->m_hABO);
+    const auto all_pixels = Draw(*geometry, true);
+    const auto base_pixels = Draw(*geometry);
+    R_DrawVisibleCavityGeometry(*left, 0, 1); const auto left_pixels = Readback();
+    (void)Draw(*geometry); R_DrawVisibleCavityGeometry(*right, 0, 1); const auto right_pixels = Readback();
+    std::size_t left_count = 0, right_count = 0;
+    for (int y = 0; y < Size; ++y) for (int x = 0; x < Size; ++x)
+    {
+        const auto pixel = (y * Size + x) * 4;
+        const bool is_left = x >= 8 && x < 16 && y >= 16 && y < 32;
+        const bool is_right = x >= 48 && x < 56 && y >= 16 && y < 32;
