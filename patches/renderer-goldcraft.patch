+            << ",\"studioBonePaletteReuses\":" << f.studioBonePaletteReuses
+            << ",\"studioBonePaletteUploadBytes\":" << f.studioBonePaletteUploadBytes
+            << ",\"studioBonePaletteFallbacks\":" << f.studioBonePaletteFallbacks
+            << ",\"studioBonePaletteCache\":" << f.studioBonePaletteCache;
+        out << ",\"studioShadowPlan\":" << f.studioShadowPlan
+            << ",\"studioShadowPlanBuilds\":" << f.shadowPlan.builds
+            << ",\"studioShadowPlanReuses\":" << f.shadowPlan.reuses
+            << ",\"studioShadowPlanInvalidations\":" << f.shadowPlan.invalidations
+            << ",\"studioShadowPlanFallbackModels\":" << f.shadowPlan.fallbackModels;
+        out << ",\"drawParameterStream\":" << f.drawParameterStream
+            << ",\"drawParameterUploads\":" << f.drawParameters.streamedDraws
+            << ",\"drawParameterBytes\":" << f.drawParameters.streamedBytes
+            << ",\"drawParameterFallbacks\":" << f.drawParameters.fallbacks
+            << ",\"drawParameterBusyFallbacks\":" << f.drawParameters.busyFallbacks
+            << ",\"drawParameterSyncFailures\":" << f.drawParameters.syncFailures;
+        out << ",\"worldMaterialBatch\":" << f.worldMaterialBatch
+            << ",\"worldMaterialChains\":" << f.worldMaterialChains
+            << ",\"worldMaterialSubmissions\":" << f.worldMaterialSubmissions
+            << ",\"worldMaterialBatches\":" << f.worldMaterialBatches;
+        out << ",\"shadowCull\":" << f.shadowCull << ",\"mainViews\":" << f.views << ",\"gpuReady\":" << f.gpuReady
+            << ",\"studioFaceCull\":" << f.studioFaceCull
