+void RunDepth()
+{
+    // Shared setup utilities prepare the exact production UBO and vertex ABI.
+    glViewport(0, 0, Size, Size);
+    glGenVertexArrays(1, &vao); glBindVertexArray(vao);
+    glGenBuffers(1, &vbo); glBindBuffer(GL_ARRAY_BUFFER, vbo);
+    glEnableVertexAttribArray(STUDIO_VA_POSITION);
+    glVertexAttribPointer(STUDIO_VA_POSITION, 3, GL_FLOAT, GL_FALSE, sizeof(Vertex), reinterpret_cast<void*>(offsetof(Vertex, position)));
+    glEnableVertexAttribArray(STUDIO_VA_TEXCOORD);
+    glVertexAttribPointer(STUDIO_VA_TEXCOORD, 2, GL_FLOAT, GL_FALSE, sizeof(Vertex), reinterpret_cast<void*>(offsetof(Vertex, uv)));
+    glEnableVertexAttribArray(STUDIO_VA_PACKEDBONE);
+    glVertexAttribIPointer(STUDIO_VA_PACKEDBONE, 1, GL_UNSIGNED_INT, sizeof(Vertex), reinterpret_cast<void*>(offsetof(Vertex, bone)));
+    glVertexAttrib3f(STUDIO_VA_NORMAL, 0, 0, 1); glVertexAttrib3f(STUDIO_VA_SMOOTHNORMAL, 0, 0, 1);
+    glVertexAttrib3f(STUDIO_VA_TANGENT, 1, 0, 0); glVertexAttrib3f(STUDIO_VA_BITANGENT, 0, 1, 0);
+    glGenBuffers(1, &elementBuffer);
+    glGenBuffers(1, &cameraBuffer); glBindBufferBase(GL_UNIFORM_BUFFER, BINDING_POINT_CAMERA_UBO, cameraBuffer);
+    glGenBuffers(1, &sceneBuffer); glBindBufferBase(GL_UNIFORM_BUFFER, BINDING_POINT_SCENE_UBO, sceneBuffer);
+    glGenBuffers(1, &studioBuffer); glBindBufferBase(GL_UNIFORM_BUFFER, BINDING_POINT_STUDIO_UBO, studioBuffer);
+    glGenBuffers(1, &bonesBuffer); glBindBufferBase(GL_UNIFORM_BUFFER, BINDING_POINT_STUDIO_BONES_UBO, bonesBuffer);
+    glGenQueries(1, &query);
+    scene = {}; scene.r_g = scene.v_gamma = scene.v_texgamma = scene.v_lightgamma = 1.f; scene.r_g3 = .125f;
+    Upload(sceneBuffer, scene); Bones(false);
+    for (auto& texture : poisonTextures) texture = Texture2D(1, 1, {255, 255, 255, 255});
+    unrelatedProgram = Program("#define SHADOW_CASTER_ENABLED\n", nullptr);
+    EligibilityCases();
+    HostEligibilityCases();
+    CacheCases();
+    DepthCases();
+    ShadowBatchCases();
+    glUseProgram(0);
+    for (const auto& entry : g_StudioProgramTable) glDeleteProgram(entry.second.program);
+    g_StudioProgramTable.clear();
+    glDeleteProgram(unrelatedProgram); glDeleteTextures(9, poisonTextures);
+    glDeleteBuffers(1, &elementBuffer); glDeleteBuffers(1, &vbo);
+    glDeleteBuffers(1, &cameraBuffer); glDeleteBuffers(1, &sceneBuffer); glDeleteBuffers(1, &studioBuffer);
+    glDeleteBuffers(1, &bonesBuffer);
+    glDeleteVertexArrays(1, &vao); glDeleteQueries(1, &query);
+    Check(glGetError() == GL_NO_ERROR, "depth executor suite cleanup is GL-clean");
+}
+}
+
+int main()
+{
+    if (!glfwInit()) return 2;
+    for (int profile : {GLFW_OPENGL_COMPAT_PROFILE, GLFW_OPENGL_CORE_PROFILE})
+    {
+        glfwWindowHint(GLFW_VISIBLE, GLFW_FALSE);
+        glfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 4); glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 3);
+        glfwWindowHint(GLFW_OPENGL_PROFILE, profile);
+        auto* window = glfwCreateWindow(Size, Size, "studio depth executor regression", nullptr, nullptr);
+        if (!window) { glfwTerminate(); return 2; }
+        glfwMakeContextCurrent(window); glewExperimental = GL_TRUE;
+        if (glewInit() != GLEW_OK) { glfwDestroyWindow(window); glfwTerminate(); return 2; }
+        while (glGetError() != GL_NO_ERROR) {}
+        std::printf("Depth executor driver: %s / %s / profile=%d\n", glGetString(GL_RENDERER), glGetString(GL_VERSION), profile);
+        RunDepth();
+        glfwDestroyWindow(window);
+    }
+    glfwTerminate();
+    std::printf("Studio depth executor: %u checks, %u depth comparisons, %u actual mesh draws. No FPS claim.\n", checks, comparisons, meshSubmissions);
+    return 0;
+}
diff --git a/tests/extract_studio_depth_executor.py b/tests/extract_studio_depth_executor.py
new file mode 100644
index 0000000..e959c35
--- /dev/null
+++ b/tests/extract_studio_depth_executor.py
@@ -0,0 +1,84 @@
+"""Extract real Studio submission/state/eligibility functions for a GL fixture.
+
+The fixture adapts host decisions and shader-file loading; the generated code
+retains production program selection, GL calls, stencil and mesh submission.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+
+def function(source, signature):
+    if source.count(signature) != 1:
+        raise SystemExit("Missing or ambiguous production boundary: " + signature)
+    start = source.index(signature)
+    position = source.index("{", start) + 1
+    depth = 1
+    while depth:
+        depth += (source[position] == "{") - (source[position] == "}")
+        position += 1
+    return source[start:position]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--src", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--manifest", type=Path, required=True)
+    args = parser.parse_args()
+    names = ("gl_studio.cpp", "gl_studio.h", "gl_rmisc.cpp", "gl_shader.cpp", "gl_gbuffer.cpp")
+    sources = {name: (args.src / name).read_text(encoding="utf-8-sig") for name in names}
+    studio = sources["gl_studio.cpp"]
+    signatures = (
+        "static bool R_StudioDepthHostEligible(",
+        "bool R_StudioCanUseDepthExecutor(",
+        "static StudioDepthExecutorContext R_StudioDepthHostContext(",
+        "static bool R_StudioDepthExecutorEligible(",
+        "void R_UseStudioProgram(",
+        "static void R_StudioBeginOpaqueStencil(",
+        "static void R_StudioSetShadowDepthState(",
+        "static void R_StudioSubmitMesh(",
+        "static void R_StudioEndMeshDraw(",
+        "static void R_StudioDrawOpaqueShadowMesh(",
+        "static size_t R_StudioCollectShadowBatch(",
+        "static size_t R_StudioTryDrawShadowBatch(",
+        "static const StudioShadowSkinPlan* R_StudioGetShadowSubmissionPlan(",
+        "static bool R_StudioTryDrawShadowPlan(",
+    )
+    extracted = [function(sources["gl_rmisc.cpp"], signature) for signature in
+                 ("void GL_BindTextureUnit(", "void GL_BeginStencilWrite(", "void GL_EndStencil(")]
+    extracted += [function(sources["gl_shader.cpp"], "void GL_UseProgram("),
+                  function(sources["gl_gbuffer.cpp"], "void R_SetGBufferMask(")]
+    extracted += [function(studio, signature) for signature in signatures]
+    draw = function(studio, "void R_StudioDrawMesh_DrawPass(")
+    for call in ("R_StudioBeginOpaqueStencil(", "R_StudioSetShadowDepthState(",
+                 "R_StudioSubmitMesh(", "R_StudioEndMeshDraw(",
+                 "R_StudioDrawOpaqueShadowMesh(", "R_StudioDepthExecutorEligible("):
+        if draw.count(call) != 1:
+            raise SystemExit("Shared production DrawPass wiring changed: " + call)
+    if studio.count('"r_studio_shadow_depth_executor", "0"') != 1:
+        raise SystemExit("Depth executor must remain registered default-off")
+    if studio.count('"r_studio_shadow_plan", "0"') != 1:
+        raise SystemExit("Shadow plan must remain registered default-off")
+    submodel = function(studio, "void R_StudioDrawSubmodel(\n")
+    if submodel.count("R_StudioTryDrawShadowBatch(") != 1 or "i += count;" not in submodel or "++i;" not in submodel:
+        raise SystemExit("Production submodel must consume the batch and retain individual fallback")
+    if submodel.count("R_StudioTryDrawShadowPlan(") != 1:
+        raise SystemExit("Production submodel must dispatch the prepared plan after the model callback")
+    reload = function(studio, "std::shared_ptr<CStudioModelRenderData> R_CreateStudioRenderData(")
+    if "submodel->shadowPlan = {};" not in reload:
+        raise SystemExit("Same-object resource reload must invalidate submission plans")
+    body = "// Generated from unchanged production function bodies.\n\n" + "\n\n".join(extracted) + "\n"
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(body, encoding="utf-8")
+    args.manifest.write_text(json.dumps({
+        "sourceSha256": {name: hashlib.sha256((args.src / name).read_bytes()).hexdigest() for name in names},
+        "extractedSha256": hashlib.sha256(body.encode()).hexdigest(),
+        "functions": signatures,
+        "scope": "Production eligibility/program/state/stencil/submission/cleanup; actual shared legacy DrawPass wiring checked. Host decisions and file loading adapted; not the full material parser or game.",
+    }, indent=2) + "\n", encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/src/gl_studio_player.cpp b/src/gl_studio_player.cpp
new file mode 100644
index 0000000..ae22570
--- /dev/null
+++ b/src/gl_studio_player.cpp
@@ -0,0 +1,201 @@
+#include "gl_local.h"
+#include "CounterStrike.h"
+
+class CEnginePlayerInfoStorage
+{
+public:
+    struct player_info_s SavedPlayerInfo{};
+    bool                 Filled{};
+    bool                 EventsDispatched{};
+};
+
+static CEnginePlayerInfoStorage g_PlayerInfoStorage[MAX_CLIENTS]{};
+
+void CopyPlayerInfoStudioRenderData(const player_info_t* src, player_info_t* dst)
+{
+    dst->renderframe  = src->renderframe;
+    dst->gaitsequence = src->gaitsequence;
+    dst->gaitframe    = src->gaitframe;
+    dst->gaityaw      = src->gaityaw;
+    VectorCopy(src->prevgaitorigin, dst->prevgaitorigin);
+}
+
+/*
+
+	Purpose : StudioDrawPlayer hook handler
+
+*/
+
+template <typename CallType>
+__forceinline int StudioDrawPlayer_Template(CallType pfnDrawPlayer, int flags, struct entity_state_s* pplayer, void* pthis = nullptr, int dummy = 0)
+{
+    int playerindex = pplayer->number - 1;
+
+    int result = 0;
+
+    if (playerindex >= 0 && playerindex < gEngfuncs.GetMaxClients() && playerindex < MAX_CLIENTS)
+    {
+        auto pPlayerInfo = IEngineStudio.PlayerInfo(playerindex);
+
+        if (g_PlayerInfoStorage[playerindex].Filled)
+        {
+            CopyPlayerInfoStudioRenderData(&g_PlayerInfoStorage[playerindex].SavedPlayerInfo, pPlayerInfo);
+        }
+
+        CopyPlayerInfoStudioRenderData(pPlayerInfo, &g_PlayerInfoStorage[playerindex].SavedPlayerInfo);
+        g_PlayerInfoStorage[playerindex].Filled = true;
+
+        if (R_IsRenderingLowerBody())
+        {
+            bool bHideLowerbody = false;
+
+            //Sniber NMSL
+            vec3_t vecSavedModelOrigin            = {0};
+            float  flSavedModelScale              = 0;
+            int    iSavedViewEntityIndex_SCClient = 0;
+
+            float* pScale    = &(*currententity)->curstate.scale;
+            float* pModelPos = (*currententity)->origin;
+            VectorCopy(pModelPos, vecSavedModelOrigin);
+
+            //Don't emit event (muzzleflash or sound)
+            flags &= ~STUDIO_EVENTS;
+
+            flSavedModelScale = (*pScale);
+
+            auto model = IEngineStudio.SetupPlayerModel(playerindex);
+
+            if (g_bIsCounterStrike)
+            {
+                //Counter-Strike redirects playermodel in a pretty tricky way
+                int modelindex = 0;
+                model          = CounterStrike_RedirectPlayerModel(model, pplayer->number, &modelindex);
+            }
+
+            if (model)
+            {
+                auto pRenderData = R_GetStudioRenderDataFromModel(model);
+
+                if (pRenderData)
+                {
+                    vec3_t viewangles, forward, right, up;
+                    gEngfuncs.GetViewAngles(viewangles);
+                    viewangles[0] = 0;
+                    AngleVectors(viewangles, forward, right, up);
+
+                    float model_scale = pRenderData->LowerBodyControl.model_scale.GetValue();
+
+                    if (model_scale > 0)
+                    {
+                        (*pScale) = model_scale;
+                    }
+
+                    if ((*currententity)->curstate.usehull)
+                    {
+                        vec3_t duck_model_origin = {0};
+
+                        if (pRenderData->LowerBodyControl.duck_model_origin.GetValues(duck_model_origin))
+                        {
+                            VectorMA(pModelPos, duck_model_origin[0], forward, pModelPos);
+                            VectorMA(pModelPos, duck_model_origin[1], right, pModelPos);
+                            VectorMA(pModelPos, duck_model_origin[2], up, pModelPos);
+                        }
+                    }
+                    else
+                    {
+                        vec3_t model_origin = {0};
+
+                        if (pRenderData->LowerBodyControl.model_origin.GetValues(model_origin))
+                        {
+                            VectorMA(pModelPos, model_origin[0], forward, pModelPos);
+                            VectorMA(pModelPos, model_origin[1], right, pModelPos);
+                            VectorMA(pModelPos, model_origin[2], up, pModelPos);
+                        }
+                    }
+                }
+
+                auto pstudiohdr = (studiohdr_t*)IEngineStudio.Mod_Extradata(model);
+
+                if (pstudiohdr)
+                {
+                    if (pplayer->gaitsequence > 0 && (R_GetStudioSequenceFlags(pstudiohdr, pplayer->gaitsequence) & STUDIO_SF_HIDE_LOWERBODY))
+                        bHideLowerbody = true;
+                    else if (pplayer->sequence > 0 && (R_GetStudioSequenceFlags(pstudiohdr, pplayer->sequence) & STUDIO_SF_HIDE_LOWERBODY))
+                        bHideLowerbody = true;
+                }
+            }
+
+            if (!bHideLowerbody)
+            {
+                if (g_ViewEntityIndex_SCClient)
+                {
+                    iSavedViewEntityIndex_SCClient = (*g_ViewEntityIndex_SCClient);
+                    (*g_ViewEntityIndex_SCClient)  = 0;
+                }
+
+                result = pfnDrawPlayer(pthis, dummy, flags, pplayer);
+
+                if (g_ViewEntityIndex_SCClient)
+                {
+                    (*g_ViewEntityIndex_SCClient) = iSavedViewEntityIndex_SCClient;
+                }
+            }
+
+            VectorCopy(vecSavedModelOrigin, pModelPos);
+            (*pScale) = flSavedModelScale;
+        }
+        else
+        {
+            result = pfnDrawPlayer(pthis, dummy, flags, pplayer);
+        }
+    }
+    else
+    {
+        result = pfnDrawPlayer(pthis, dummy, flags, pplayer);
+    }
+
+    return result;
+}
+
+__forceinline int StudioDrawPlayer_originalcall_wrapper(void* pthis, int dummy, int flags, struct entity_state_s* pplayer)
+{
+    return gPrivateFuncs.studiointerface_StudioDrawPlayer(flags, pplayer);
+}
+
+int studiointerface_StudioDrawPlayer(int flags, struct entity_state_s* pplayer)
+{
+    if (!pplayer)
+        return 0;
+    const int  playerindex = pplayer->number - 1;
+    auto       storage     = playerindex >= 0 && playerindex < MAX_CLIENTS ? &g_PlayerInfoStorage[playerindex] : nullptr;
+    const bool auxiliary   = R_IsRenderingShadowView() || R_IsRenderingLinearDepth() ||
+        R_IsRenderingWaterView() || R_IsRenderingPortal();
+    if (auxiliary || (storage && storage->EventsDispatched))
+        flags &= ~STUDIO_EVENTS;
+
+    // Shadow-caster and reflected views may contain the local player even when
+    // it is absent from the engine's main visible list. In first person only the
+    // explicitly generated/clipped lower body may render in the main view.
+    bool hidden = false;
+    if (!auxiliary && (flags & STUDIO_RENDER) && R_IsRenderingFirstPersonView() &&
+        !R_IsRenderingLowerBody() && (*currententity) != cl_viewent &&
+        (*currententity)->player && (*currententity)->index == (*cl_viewentity))
+    {
+        flags &= ~STUDIO_RENDER;
+        hidden = true;
+    }
+    const int result = StudioDrawPlayer_Template(StudioDrawPlayer_originalcall_wrapper, flags, pplayer);
+    if (storage && result && (flags & STUDIO_EVENTS))
+        storage->EventsDispatched = true;
+    R_StudioDiagnosticsPlayer(flags, result, hidden);
+    return result;
+}
+
+void R_StudioPlayerStartFrame()
+{
+    for (auto& storage : g_PlayerInfoStorage)
+    {
+        storage.Filled           = false;
+        storage.EventsDispatched = false;
+    }
+}
