+    // Busy/full/unsupported storage uses its own mutable buffer. Never update
+    // a page that is still referenced by current or unfinished previous draws.
+    GL_UploadSubDataToUBO(fallback, 0, size, data);
+    glBindBufferBase(GL_UNIFORM_BUFFER, binding, fallback);
