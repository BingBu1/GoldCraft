+void DepthCases()
+{
+    for (bool cube : {false, true})
+    {
+        Target target(cube);
+        const auto camera = Camera(cube);
+        Mesh mesh = cube ? CubeGeometry() : Triangle({-.7f,-.7f,0},{.7f,-.7f,0},{0,.7f,0});
+        for (auto& vertex : mesh) vertex.bone = 0x0101;
+        testLinear = cube;
+        const auto oracle = MakePrograms("", testLinear, true, "");
+        for (bool animated : {false, true})
+        {
+            Bones(animated);
+            for (int stencilCase = 0; stencilCase < 3; ++stencilCase)
+            {
+                r_draw_hasoutline = stencilCase == 1;
+                header.flags = stencilCase == 2 ? FMODEL_NOBLOOM : 0;
+                const program_state_t flags = stencilCase == 2 ? STUDIO_NF_FLATSHADE : 0;
+                const unsigned char expected = (stencilCase == 1 ? STENCIL_MASK_HAS_OUTLINE : 0) |
+                    (stencilCase == 2 ? STENCIL_MASK_NO_BLOOM | STENCIL_MASK_HAS_FLATSHADE : 0);
+                for (int poison = 0; poison < 3; ++poison)
+                {
+                    const auto legacy = Execute(target, camera, mesh, flags, false, poison);
+                    const auto fast = Execute(target, camera, mesh, flags, true, poison);
+                    Equal(legacy.depth, fast.depth, "depth executor exactly matches shared legacy depth");
+                    Check(legacy.stencil == fast.stencil, "depth executor exactly matches every legacy stencil pixel");
+                    Check(legacy.state == fast.state, "all observed GL and engine exit state matches legacy");
+                    if (poison != 1)
+                    {
+                        if (Written(fast.depth) <= 20)
+                            std::fprintf(stderr, "Nonempty probe: cube=%d animated=%d stencil=%d poison=%d legacy=%zu fast=%zu\n",
+                                int(cube), int(animated), stencilCase, poison, Written(legacy.depth), Written(fast.depth));
+                        Check(Written(fast.depth) > 20, "executor actually writes visible depth");
+                        if (cube) for (int layer = 0; layer < 6; ++layer)
+                            Check(Written(fast.depth, layer) > 0, "every actual cube face receives depth");
+                        for (size_t i = 0; i < fast.depth.size(); ++i)
+                            Check(fast.stencil[i] == (fast.depth[i] < 1.f ? expected : 93),
+                                  "stencil matches written depth and preserves untouched pixels");
+                        glDepthMask(GL_TRUE); glStencilMask(0xff); glDisable(GL_STENCIL_TEST);
+                        glDisable(GL_CULL_FACE); glDepthFunc(GL_LESS); glActiveTexture(GL_TEXTURE0);
+                        const auto independent = Draw(target, camera, mesh, oracle.single, 0, true);
+                        Equal(independent.depth, fast.depth, "executor matches independent array/no-GS depth", .000001f);
+                    }
+                }
+            }
+        }
+        // z-only clipping/clamp must preserve the legacy depth/stencil outcome.
+        if (!cube) for (bool clamp : {false, true})
+        {
+            if (clamp) glEnable(GL_DEPTH_CLAMP); else glDisable(GL_DEPTH_CLAMP);
+            for (float z : {-2.f, 2.f})
+            {
+                const auto outsideZ = Triangle({-.7f,-.7f,z},{.7f,-.7f,z},{0,.7f,z});
+                const auto legacy = Execute(target, camera, outsideZ, 0, false, 0);
+                const auto fast = Execute(target, camera, outsideZ, 0, true, 0);
+                Equal(legacy.depth, fast.depth, "depth clamp executor equals legacy");
+                Check(legacy.stencil == fast.stencil && legacy.state == fast.state, "depth clamp stencil and state equal");
+            }
+        }
+        glDisable(GL_DEPTH_CLAMP);
+        Delete(oracle);
+    }
+}
