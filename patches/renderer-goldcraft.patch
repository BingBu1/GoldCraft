+        &textureHeader, &texture, &skinref, flags | STUDIO_SHADOW_CASTER_ENABLED);
+    Check(selected == fast && State() == beforeEligibility, "actual host selector routes OFF/ON without GL changes");
+    if (selected) R_StudioDrawOpaqueShadowMesh(&renderMesh, state);
+    else LegacySharedDraw(&renderMesh, state);
+    Check(meshSubmissions == beforeCalls + 1 && meshNotifications == beforeNotifications + 1,
+          "one actual production indexed draw and mesh notification per mesh/light");
+    Check(executorCounts == beforeExecutor + (fast ? 1 : 0) && legacyCounts == beforeLegacy + (fast ? 0 : 1),
+          "production path counter matches executed path");
+    Check(profileSubmitEnds == beforeTimings + 1 && debugDepth == 0, "submit timing and debug group balanced");
+    const auto after = State();
