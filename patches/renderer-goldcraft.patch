diff --git a/include/Interface/IMetaRendererSceneVision.h b/include/Interface/IMetaRendererSceneVision.h
new file mode 100644
index 0000000..c8adc2f
--- /dev/null
+++ b/include/Interface/IMetaRendererSceneVision.h
@@ -0,0 +1,18 @@
+#pragma once
+#include <IMetaRendererScene.h>
+
+// Optional per-observer extension. Does not mutate map lighting or cvars.
+struct MetaRendererSceneVision
+{
+    float nightVision, blindness, darkness, darknessPulse;
+};
+static_assert(sizeof(MetaRendererSceneVision) == 16);
+class IMetaRendererSceneVision : public IBaseInterface
+{
+public:
+    // Registered scene owner only; finite [0,1] coefficients. Values expire
+    // after 350ms of engine time, including on backward time/map transitions.
+    virtual bool UpdateVision(IMetaRendererSceneCallbacks* owner, const MetaRendererSceneVision& state) noexcept = 0;
+    virtual void ClearVision(IMetaRendererSceneCallbacks* owner) noexcept = 0;
+};
+#define METARENDERER_SCENE_VISION_INTERFACE_VERSION "MetaRendererSceneVision_API_001"
diff --git a/src/gl_scene_vision.cpp b/src/gl_scene_vision.cpp
new file mode 100644
index 0000000..73e898a
--- /dev/null
+++ b/src/gl_scene_vision.cpp
@@ -0,0 +1,42 @@
+#include "gl_local.h"
+#include "gl_external_scene.h"
+#include <cmath>
+
+namespace
+{
+IMetaRendererSceneCallbacks* visionOwner{};
+MetaRendererSceneVision vision{};
+double visionTime{};
+class CMetaRendererSceneVision : public IMetaRendererSceneVision
+{
+public:
+    bool UpdateVision(IMetaRendererSceneCallbacks* owner, const MetaRendererSceneVision& state) noexcept override
+    {
+        if (!owner || !R_IsExternalSceneOwner(owner) || (visionOwner && visionOwner != owner)) return false;
+        for (float value : {state.nightVision, state.blindness, state.darkness, state.darknessPulse})
+            if (!std::isfinite(value) || value < 0 || value > 1) return false;
+        if (state.darknessPulse > state.darkness * .45f + .00001f) return false;
+        visionOwner = owner;
+        vision = state;
+        visionTime = *cl_time;
+        return true;
+    }
+    void ClearVision(IMetaRendererSceneCallbacks* owner) noexcept override { R_ClearExternalSceneVision(owner); }
+};
+}
+void R_ClearExternalSceneVision(IMetaRendererSceneCallbacks* owner) noexcept
+{
+    if (!owner || owner == visionOwner) { visionOwner = nullptr; vision = {}; visionTime = 0; }
+}
+void R_ApplyExternalSceneVision(scene_ubo_t& scene) noexcept
+{
+    for (auto& value : scene.statusVision) value = 0;
+    const double now = *cl_time;
+    if (visionOwner && (now < visionTime || now - visionTime >= .35)) R_ClearExternalSceneVision(nullptr);
+    if (!visionOwner || R_IsRenderingShadowView()) return;
+    scene.statusVision[0] = vision.nightVision;
+    scene.statusVision[1] = vision.blindness;
+    scene.statusVision[2] = vision.darkness;
+    scene.statusVision[3] = vision.darknessPulse;
+}
+EXPOSE_SINGLE_INTERFACE(CMetaRendererSceneVision, IMetaRendererSceneVision, METARENDERER_SCENE_VISION_INTERFACE_VERSION);
