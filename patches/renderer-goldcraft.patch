+    auto selected = R_FindEditedBrushSurfaceModel(&first);
+    assert(selected && selected != ordinary && !R_FindEditedBrushSurfaceModel(&second));
+    assert(g_WorldSurfaceWorldModels[1] == scene.geometry && g_WorldSurfaceModels[2]->m_pWorldModel.lock() == scene.geometry);
+    // Draw the production selected leaf; a same-model sibling retains all pixels.
+    const auto read = [&](const std::shared_ptr<CWorldSurfaceModel>& model) {
+        glViewport(0, 0, 64, 64); glDisable(GL_DEPTH_TEST); glDisable(GL_CULL_FACE);
+        glClearColor(0, 0, 0, 0); glClear(GL_COLOR_BUFFER_BIT);
+        shadow = false; gbuffer = false; recordStates = false;
+        R_DrawWorldSurfaceLeafStatic(model.get(), model->GetLeafByIndex(0).get());
+        R_DrawWorldSurfaceLeafAnim(model.get(), model->GetLeafByIndex(0).get());
+        std::vector<byte> pixels(64 * 64 * 4);
+        glReadPixels(0, 0, 64, 64, GL_RGBA, GL_UNSIGNED_BYTE, pixels.data());
+        return pixels;
+    };
+    const auto editedPixels = read(selected), siblingPixels = read(g_WorldSurfaceModels[2]);
+    std::size_t changed = 0;
+    for (int y = 0; y < 64; ++y)
+        for (int x = 0; x < 64; ++x)
+        {
+            const auto at = (y * 64 + x) * 4;
+            const bool hole = x >= 16 && x < 32 && y >= 16 && y < 32;
+            assert(siblingPixels[at + 1] > 250);
+            assert((editedPixels[at] > 250) == hole);
+            assert((editedPixels[at + 1] > 250) != hole);
+            changed += hole;
+        }
+    beforeUploads = uploads; countedAllocations = 0; countAllocations = true;
+    for (int i = 0; i < 256; ++i)
+    {
+        assert(api->UpdateBrushSnapshot(9, 2, 42, identities, 2));
+        const auto model = R_FindEditedBrushSurfaceModel(&first);
