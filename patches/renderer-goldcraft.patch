+++ b/tests/extract_scene_static_shadows.py
@@ -0,0 +1,75 @@
+"""Extract actual point dynamic fallback, static readiness and cache invalidation.
+
+Tests execute these production statements plus the production scene dispatch
+and static-scene implementation. GL drawing and world preparation are adapters;
+this does not establish rendered pixels or an actual asynchronous engine run.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument("--src", type=Path, required=True)
+parser.add_argument("--output", type=Path, required=True)
+parser.add_argument("--manifest", type=Path, required=True)
+args = parser.parse_args()
+
+
+def function(source, signature):
+    if source.count(signature) != 1:
+        raise SystemExit("Missing or ambiguous production boundary: " + signature)
+    start = source.index(signature)
+    position = source.index("{", start) + 1
+    depth = 1
+    while depth:
+        depth += (source[position] == "{") - (source[position] == "}")
+        position += 1
+    return source[start:position]
+
+
+names = ("gl_shadow.cpp", "gl_wsurf.cpp", "gl_rmain.cpp", "world_edit_cache.cpp")
+sources = {name: (args.src / name).read_text(encoding="utf-8-sig") for name in names}
+shadow = sources["gl_shadow.cpp"]
+start = "if (R_PointShadowHasReadyStaticWorld(args->ppStaticShadowTexture, args->staticShadowSize))"
+if shadow.count(start) != 1:
+    raise SystemExit("Point dynamic fallback boundary changed")
+dynamic = shadow[shadow.index(start):shadow.index("                    R_PopRefDef();", shadow.index(start))]
+ready = "pCurrentShadowTexture->SetReady(staticSceneBake.Complete(bAnyPolyRendered));"
+for token, count in (
+    (ready, 1),
+    ("RStaticSceneBakeScope staticSceneBake;", 1),
+    ("RStaticScenePointLightScope staticSceneScope(args->ppStaticShadowTexture, args->staticShadowSize);", 1),
+    ("RStaticScenePointLightScope staticSceneScope(nullptr, 0);", 2),
+):
+    if shadow.count(token) != count:
+        raise SystemExit("Missing shadow lifecycle guard: " + token)
+world = function(sources["gl_wsurf.cpp"], "void R_DrawWorldSurfaceModel(")
+for token in (
+    "bool staticWorldComplete = pLeaf && pLeaf->m_bIsReady && !pLeaf->m_bIsClosing.load();",
+    "staticWorldComplete = true;",
+    "staticWorldComplete = R_DrawWorldSurfaceModelShadowProxy(pModel.get()) && staticWorldComplete;",
+    "R_MarkExternalStaticWorldComplete(staticWorldComplete);",
+):
+    if world.count(token) != 1:
+        raise SystemExit("Missing world preparation completion guard: " + token)
+for filename, signature, token in (
+    ("gl_wsurf.cpp", "void R_FreeWorldResources(void)", "R_ExternalStaticSceneNewMap();"),
+    ("gl_shadow.cpp", "void R_ShutdownShadow(void)", "R_ShutdownExternalStaticScenes();"),
+):
+    if function(sources[filename], signature).count(token) != 1:
+        raise SystemExit("Missing static scene lifecycle hook: " + token)
+invalidate = function(sources["world_edit_cache.cpp"], "void R_InvalidateWorldShadowCaches(")
+for pool in ("g_BSPDynamicLights", "g_EngineDynamicLights", "g_ExternalDynamicLights"):
+    if invalidate.count("invalidate(" + pool + ");") != 1:
+        raise SystemExit("Missing shadow invalidation pool: " + pool)
+body = (invalidate + "\n\nvoid TestProductionPointDynamicSelection(PointLightCallbackArgs* args)\n{\n" + dynamic +
+        "}\n\nvoid TestProductionPointStaticReady(RStaticSceneBakeScope& staticSceneBake, "
+        "const std::shared_ptr<IShadowTexture>& pCurrentShadowTexture, bool bAnyPolyRendered)\n{\n" + ready + "\n}\n")
+args.output.parent.mkdir(parents=True, exist_ok=True)
+args.output.write_text(body, encoding="utf-8")
+args.manifest.write_text(json.dumps({
+    "sourceSha256": {name: hashlib.sha256((args.src / name).read_bytes()).hexdigest() for name in names},
+    "extractedSha256": hashlib.sha256(body.encode()).hexdigest(),
+    "boundary": "Actual point fallback/readiness, all-pool invalidation and production scene dispatch; GL/world-preparation adapted, lifecycle wiring checked.",
+}, indent=2) + "\n", encoding="utf-8")
