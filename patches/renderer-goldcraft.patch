new file mode 100644
index 0000000..029fb40
--- /dev/null
+++ b/include/Interface/IMetaRendererWorldEdit.h
@@ -0,0 +1,57 @@
+#pragma once
+#include <interface.h>
+#include <stdint.h>
+
+struct model_s;
+struct MetaWorldEditBox
+{ float min[3], max[3]; };
+static_assert(sizeof(MetaWorldEditBox) == 24);
+enum class MetaWorldEditStatus : uint32_t
+{
+    Missing,
+    Preparing,
+    Ready,
+    Failed
+};
+
+// Same-process optional extension; no change to MetaRenderer_API_002. All calls
+// run on the game/GL thread, outside drawing. Begin copies the boxes. Tickets
+// expire at map/model unload; no exception or owned STL object crosses the ABI.
+class IMetaRendererWorldEdit : public IBaseInterface
+{
+public:
+    virtual uint64_t            Begin(model_s* world, uint64_t epoch, uint64_t revision, const MetaWorldEditBox* boxes, uint32_t count) noexcept = 0;
+    virtual MetaWorldEditStatus Poll(uint64_t ticket) noexcept                                                                                   = 0;
+    // Ready commit performs no allocation, GPU upload or callback. The caller
+    // then publishes its already-prepared collision and Replica in this frame.
+    virtual bool Commit(uint64_t ticket) noexcept = 0;
+    virtual void Cancel(uint64_t ticket) noexcept = 0;
+    virtual void Reset() noexcept                 = 0;
+};
+#define METARENDERER_WORLD_EDIT_INTERFACE_VERSION "MetaRendererWorldEdit_API_001"
+
+// A distinct optional interface; API_001 and MetaRenderer_API_002 remain intact.
+// Inline model IDs are BSP *N indices, never engine precache model indices.
+struct MetaWorldEditTarget
+{
+    uint32_t slot, serial, inlineModel;
+};
+struct MetaWorldEditCut
+{
+    MetaWorldEditTarget target;
+    MetaWorldEditBox box;
+};
+static_assert(sizeof(MetaWorldEditTarget) == 12 && sizeof(MetaWorldEditCut) == 36);
+class IMetaRendererWorldEdit2 : public IMetaRendererWorldEdit
+{
+public:
+    virtual uint64_t BeginTargeted(model_s* world, uint64_t epoch, uint64_t revision,
+        const MetaWorldEditCut* cuts, uint32_t count) noexcept = 0;
+    // Publish only a complete, authenticated GCBrush frame, before drawing.
+    // A null entries pointer/count=0 is a valid empty frame. epoch=0 revokes
+    // validation after disconnect, incomplete/invalid input, or provider loss.
+    // No allocation/upload. Same sequence is accepted only for identical data.
+    virtual bool UpdateBrushSnapshot(uint64_t epoch, uint64_t revision, uint32_t sequence,
+        const MetaWorldEditTarget* entries, uint32_t count) noexcept = 0;
+};
+#define METARENDERER_WORLD_EDIT2_INTERFACE_VERSION "MetaRendererWorldEdit_API_002"
diff --git a/src/world_edit.cpp b/src/world_edit.cpp
new file mode 100644
index 0000000..a02bca1
--- /dev/null
+++ b/src/world_edit.cpp
@@ -0,0 +1,524 @@
+#include <goldcraft/brush_identity.hpp>
+#include "gl_local.h"
+#include <IMetaRendererWorldEdit.h>
+#include <algorithm>
+#include <cmath>
+#include <stdexcept>
+#include <iterator>
+#include <tuple>
+#include <array>
+#include <charconv>
+
+namespace
+{
+using namespace goldcraft;
+struct Entry
+{
+    std::size_t                         index;
+    std::shared_ptr<CWorldSurfaceModel> expected, prepared;
+};
+struct Instance
+{
+    MetaWorldEditTarget identity{};
+    int engineModel{};
+    std::shared_ptr<CWorldSurfaceWorldModel> geometry;
+    std::shared_ptr<CWorldSurfaceModel> prepared;
+    bool snapshotValidated{};
+};
+struct Pending
+{
+    uint64_t                                 ticket{}, epoch{}, revision{};
+    std::shared_ptr<CWorldSurfaceWorldModel> geometry;
+    std::vector<Entry>                       models;
+    std::vector<carving::Box>                changedBounds;
+    bool                                     failed{};
+    std::vector<Instance> instances;
+    std::vector<MetaWorldEditCut> cuts;
+    ~Pending()
+    {
+        for (auto& entry : models)
+            if (entry.prepared) entry.prepared->RetireLeaves();
+        for (auto& entry : instances)
+            if (entry.prepared) entry.prepared->RetireLeaves();
+    }
+};
+struct Session
+{
+    model_t*                                 world{};
+    std::size_t                              index{};
+    uint64_t                                 epoch{}, revision{};
+    bool                                     committed{};
+    std::shared_ptr<CWorldSurfaceWorldModel> original, active;
+    std::unique_ptr<Pending>                 pending;
+    std::vector<Instance> instances;
+    std::vector<MetaWorldEditCut> cuts;
+};
+Session  session;
+uint64_t nextTicket = 0;
+struct SnapshotSlot { uint64_t generation{}; uint32_t serial{}, model{}; };
+std::array<SnapshotSlot, goldcraft::brush::max_slots> snapshotSlots;
+uint64_t snapshotEpoch{}, snapshotRevision{}, snapshotGeneration{};
+uint32_t snapshotSequence{}, snapshotCount{};
+bool snapshotReady{}, snapshotSeen{};
+
+void RefreshInstanceShadows() noexcept
+{
+    bool changed = false;
+    for (auto& instance : session.instances)
+    {
+        const auto& slot = snapshotSlots[instance.identity.slot];
+        const bool valid = snapshotReady && snapshotEpoch == session.epoch && snapshotRevision >= session.revision &&
+            slot.generation == snapshotGeneration && slot.serial == instance.identity.serial && slot.model == instance.identity.inlineModel;
+        changed |= valid != instance.snapshotValidated;
+        instance.snapshotValidated = valid;
+    }
+    if (changed) R_InvalidateWorldShadowCaches({});
+}
+
+// Bounds immutable mesh copies before/after preparation. This is the mesh
+// CPU/GPU budget, not a promise that 1024 edited BSP instances fit in memory.
+constexpr uint64_t MeshBudget = 256ull * 1024 * 1024;
+uint64_t MeshBytes(const CWorldSurfaceWorldModel& geometry) noexcept
+{
+    if (!geometry.m_pSurfaceMesh) return 0;
+    const auto& mesh = *geometry.m_pSurfaceMesh;
+    uint64_t result = 2 * (uint64_t(mesh.vertices.size()) * sizeof(surface::Vertex) +
+        uint64_t(mesh.frames.size()) * sizeof(surface::Frame) +
+        uint64_t(mesh.instances.size()) * sizeof(surface::Instance) +
+        uint64_t(mesh.indices.size()) * sizeof(uint32_t));
+    result += uint64_t(mesh.faces.size()) * sizeof(surface::Face) +
+        uint64_t(geometry.m_vFaceBuffer.size()) * sizeof(geometry.m_vFaceBuffer[0]) +
+        uint64_t(geometry.m_vCavityDraws.size()) * (sizeof(cavity::Draw) + sizeof(CDrawIndexAttrib));
+    if (geometry.m_pCavityLighting)
+        result += 2 * (uint64_t(geometry.m_pCavityLighting->vertices.size()) * sizeof(surface::Range) +
+            uint64_t(geometry.m_pCavityLighting->values.size()) * sizeof(lighting::Value));
+    return result;
+}
+
+bool SameTarget(const MetaWorldEditTarget& a, const MetaWorldEditTarget& b) noexcept
+{ return a.slot == b.slot && a.serial == b.serial && a.inlineModel == b.inlineModel; }
+bool CutLess(const MetaWorldEditCut& a, const MetaWorldEditCut& b) noexcept
+{
+    return std::tie(a.target.slot, a.target.serial, a.target.inlineModel,
+        a.box.min[0], a.box.min[1], a.box.min[2], a.box.max[0], a.box.max[1], a.box.max[2]) <
+        std::tie(b.target.slot, b.target.serial, b.target.inlineModel,
+        b.box.min[0], b.box.min[1], b.box.min[2], b.box.max[0], b.box.max[1], b.box.max[2]);
+}
+bool LeavesReady(const std::shared_ptr<CWorldSurfaceModel>& model) noexcept
+{
+    if (!model) return false;
+    for (const auto& leaf : model->m_vLeaves)
+        if (leaf && (!leaf->m_bIsReady || leaf->m_bIsClosing.load())) return false;
+    return true;
+}
+
+std::shared_ptr<CWorldSurfaceWorldModel> PrepareGeometry(model_t* model,
+    std::span<const carving::Box> cuts)
+{
+    if (cuts.empty()) return session.original;
+    const auto& hull = model->hulls[0];
+    if (!hull.planes || !hull.clipnodes || model->numplanes < 1 || model->numplanes > 262144 ||
+        hull.lastclipnode < 0 || hull.lastclipnode >= 262144 || model->firstmodelsurface < 0 || model->nummodelsurfaces < 1)
+        throw std::invalid_argument("Invalid world edit hull");
+    std::vector<carving::Plane> planes;
+    std::vector<carving::HullNode> nodes;
+    planes.reserve(model->numplanes);
+    nodes.reserve(hull.lastclipnode + 1);
+    for (int i = 0; i < model->numplanes; ++i)
+    {
+        const auto& source = hull.planes[i];
+        carving::Plane plane{{}, source.dist};
+        if (source.type < 3) plane.normal[source.type] = 1;
+        else for (int axis = 0; axis < 3; ++axis) plane.normal[axis] = source.normal[axis];
+        planes.push_back(plane);
+    }
+    for (int i = 0; i <= hull.lastclipnode; ++i)
+    {
+        const auto& node = hull.clipnodes[i];
+        nodes.push_back({static_cast<uint32_t>(node.planenum), {node.children[0], node.children[1]}});
+    }
+    const cavity::Model source{static_cast<uint32_t>(model->firstmodelsurface),
+        static_cast<uint32_t>(model->nummodelsurfaces), {planes, nodes, hull.firstclipnode}, cuts};
+    return R_PrepareLitCarvedWorldGeometry(session.original, {&source, 1});
+}
+
+bool Current() noexcept
+{
+    return session.world && cl_worldmodel && *cl_worldmodel == session.world &&
+        session.index < g_WorldSurfaceWorldModels.size() && g_WorldSurfaceWorldModels[session.index] == session.active;
+}
+
+void CollectModels(Pending& pending)
+{
+    for (std::size_t i = 0; i < g_WorldSurfaceModels.size(); ++i)
+    {
+        const auto& model = g_WorldSurfaceModels[i];
+        const auto  found = std::find_if(pending.models.begin(), pending.models.end(),
+                                         [&](const Entry& entry) { return entry.index == i; });
+        if (found != pending.models.end())
+        {
+            if (found->expected != model) throw std::runtime_error("World model changed during edit preparation");
+            continue;
+        }
+        if (!model || model->m_pWorldModel.lock() != session.active) continue;
+        auto prepared = R_PrepareWorldSurfaceLeafModel(pending.geometry, model->m_model, 0);
+        if (pending.geometry == session.original) R_LinkShadowProxyForWorldSurfaceModel(prepared.get());
+        pending.models.push_back({i, model, std::move(prepared)});
+    }
+    if (pending.models.empty()) throw std::runtime_error("Missing loaded world surface model");
+}
+
+class CMetaRendererWorldEdit final : public IMetaRendererWorldEdit2
+{
+public:
+    uint64_t Begin(model_t* world, uint64_t epoch, uint64_t revision, const MetaWorldEditBox* boxes, uint32_t count) noexcept override
+    {
+        try
+        {
+            if (count > 65536 || (count && !boxes)) return 0;
+            std::vector<MetaWorldEditCut> cuts;
+            cuts.reserve(count);
+            for (uint32_t i = 0; i < count; ++i) cuts.push_back({{}, boxes[i]});
+            return BeginTargeted(world, epoch, revision, cuts.data(), count);
+        }
+        catch (...) { return 0; }
+    }
+    uint64_t BeginTargeted(model_t* world, uint64_t epoch, uint64_t revision, const MetaWorldEditCut* edits, uint32_t count) noexcept override
+    {
+        try
+        {
+            if (!world || !cl_worldmodel || world != *cl_worldmodel || world->type != mod_brush ||
+                !epoch || count > 65536 || (count && !edits) || !wglGetCurrentContext()) return 0;
+            if (session.world && (!Current() || session.epoch != epoch || (session.committed && revision < session.revision))) return 0;
+            auto candidate = std::make_unique<Pending>();
+            candidate->cuts.reserve(count);
+            std::vector<carving::Box> cuts;
+            cuts.reserve(count);
+            for (uint32_t i = 0; i < count; ++i)
+            {
+                const auto& edit = edits[i];
+                if (edit.target.slot ? !brush::valid({edit.target.slot, edit.target.serial, edit.target.inlineModel}) :
+                    (edit.target.serial || edit.target.inlineModel)) return 0;
+                carving::Box box;
+                for (int axis = 0; axis < 3; ++axis)
+                {
+                    box.min[axis] = edit.box.min[axis];
+                    box.max[axis] = edit.box.max[axis];
+                    if (!std::isfinite(box.min[axis]) || !std::isfinite(box.max[axis]) ||
+                        box.min[axis] >= box.max[axis]) return 0;
+                }
+                candidate->cuts.push_back(edit);
+                if (!edit.target.slot) cuts.push_back(box);
+            }
+            std::sort(candidate->cuts.begin(), candidate->cuts.end(), CutLess);
+            candidate->cuts.erase(std::unique(candidate->cuts.begin(), candidate->cuts.end(), [](const auto& a, const auto& b) {
+                return !CutLess(a, b) && !CutLess(b, a); }), candidate->cuts.end());
+            if (session.committed && revision == session.revision &&
+                (session.cuts.size() != candidate->cuts.size() || !std::equal(session.cuts.begin(), session.cuts.end(), candidate->cuts.begin(),
+                    [](const auto& a, const auto& b) { return !CutLess(a, b) && !CutLess(b, a); }))) return 0;
+            const auto index = EngineGetModelIndex(world);
+            if (index < 0) return 0;
+            const auto current = R_GetWorldSurfaceWorldModel(world);
+            R_GetWorldSurfaceModel(world);
+            if (!session.world)
+            {
+                session.world    = world;
+                session.index    = index;
+                session.epoch    = epoch;
+                session.original = session.active = current;
+            }
+            candidate->epoch    = epoch;
+            candidate->revision = revision;
+            std::vector<carving::Box> oldCuts, newCuts = cuts;
+            for (const auto& cut : session.active->m_vDecalCuts) oldCuts.push_back(cut.box);
+            const auto less = [](const auto& a, const auto& b) {
+                return std::tie(a.min, a.max) < std::tie(b.min, b.max);
+            };
+            const auto unique = [&](auto& values) {
+                std::sort(values.begin(), values.end(), less);
+                values.erase(std::unique(values.begin(), values.end(), [&](const auto& a, const auto& b) {
+                                 return !less(a, b) && !less(b, a);
+                             }),
+                             values.end());
+            };
+            unique(oldCuts);
+            unique(newCuts);
+            if (session.committed && revision == session.revision &&
+                (oldCuts.size() != newCuts.size() || !std::equal(oldCuts.begin(), oldCuts.end(), newCuts.begin(), [&](const auto& a, const auto& b) { return !less(a, b) && !less(b, a); }))) return 0;
+            std::set_symmetric_difference(oldCuts.begin(), oldCuts.end(), newCuts.begin(), newCuts.end(),
+                                          std::back_inserter(candidate->changedBounds), less);
+            candidate->geometry = PrepareGeometry(world, cuts);
+            if (!cuts.empty()) R_PrepareCarvedWorldVisibility(*candidate->geometry, cuts);
+            uint64_t preparedBytes = MeshBytes(*candidate->geometry);
+            std::size_t instanceCount = 0;
+            for (std::size_t i = 0; i < candidate->cuts.size(); ++i)
+                if (candidate->cuts[i].target.slot && (!i || candidate->cuts[i - 1].target.slot != candidate->cuts[i].target.slot)) ++instanceCount;
+            const auto baseBytes = MeshBytes(*session.original);
+            if (instanceCount && (preparedBytes > MeshBudget || (baseBytes && instanceCount > (MeshBudget - preparedBytes) / baseBytes)))
+                throw std::length_error("Brush edit immutable mesh budget");
+            for (std::size_t first = 0; first < candidate->cuts.size();)
+            {
+                const auto target = candidate->cuts[first].target;
+                auto last = first + 1;
+                while (last < candidate->cuts.size() && candidate->cuts[last].target.slot == target.slot)
+                {
+                    if (!SameTarget(target, candidate->cuts[last].target))
+                        throw std::invalid_argument("Mixed brush identities in edit slot");
+                    ++last;
+                }
+                if (target.slot)
+                {
+                    if (world->numsubmodels <= 0 || target.inlineModel >= static_cast<uint32_t>(world->numsubmodels) ||
+                        !gEngfuncs.CL_LoadModel || !gEngfuncs.hudGetModelByIndex)
+                        throw std::invalid_argument("Missing inline brush model provider");
+                    std::array<char, 16> name{};
+                    name[0] = '*';
+                    const auto encoded = std::to_chars(name.data() + 1, name.data() + name.size() - 1, target.inlineModel);
+                    if (encoded.ec != std::errc{}) throw std::invalid_argument("Inline brush model name");
+                    Instance instance;
+                    instance.identity = target;
+                    auto* model = gEngfuncs.CL_LoadModel(name.data(), &instance.engineModel);
+                    if (!model || model->type != mod_brush || instance.engineModel <= 0 ||
+                        gEngfuncs.hudGetModelByIndex(instance.engineModel) != model ||
+                        !std::equal(name.data(), encoded.ptr + 1, model->name) ||
+                        model->surfaces != world->surfaces || model->planes != world->planes)
+                        throw std::invalid_argument("Inline brush model identity/storage mismatch");
+                    std::vector<carving::Box> local;
+                    local.reserve(last - first);
+                    for (auto i = first; i < last; ++i)
+                    {
+                        carving::Box box;
+                        for (int axis = 0; axis < 3; ++axis)
+                        {
+                            box.min[axis] = candidate->cuts[i].box.min[axis];
+                            box.max[axis] = candidate->cuts[i].box.max[axis];
+                        }
+                        local.push_back(box);
+                    }
+                    instance.geometry = PrepareGeometry(model, local);
+                    const auto bytes = MeshBytes(*instance.geometry);
+                    if (bytes > MeshBudget - preparedBytes) throw std::length_error("Brush edit prepared mesh budget");
+                    preparedBytes += bytes;
+                    instance.prepared = R_PrepareWorldSurfaceLeafModel(instance.geometry, model, 0);
+                    candidate->instances.push_back(std::move(instance));
+                }
+                first = last;
+            }
+            CollectModels(*candidate);
+            if (++nextTicket == 0) ++nextTicket;
+            candidate->ticket = nextTicket;
+            session.pending   = std::move(candidate);
+            return nextTicket;
+        }
+        catch (const std::exception& error)
+        {
+            if (gEngfuncs.Con_DPrintf) gEngfuncs.Con_DPrintf("Renderer: world edit preparation failed: %s\n", error.what());
+            return 0;
+        }
+        catch (...)
+        {
+            return 0;
+        }
+    }
+
+    MetaWorldEditStatus Poll(uint64_t ticket) noexcept override
+    {
+        if (!ticket || !session.pending || session.pending->ticket != ticket || !Current()) return MetaWorldEditStatus::Missing;
+        auto& pending = *session.pending;
+        if (pending.failed) return MetaWorldEditStatus::Failed;
+        try
+        {
+            // HUD_Frame normally pumps first, but the public API is also usable
+            // from other game-thread frame orderings without a blocking wait.
+            R_PumpWorldLeafTasks();
+            CollectModels(pending);
+            for (const auto& entry : pending.models)
+                for (const auto& leaf : entry.prepared->m_vLeaves)
+                {
+                    if (!leaf) continue;
+                    if (leaf->m_bIsClosing.load()) throw std::runtime_error("World edit leaf closed");
+                    if (!leaf->m_bIsReady)
+                    {
+                        if (leaf->m_bTaskFinished.load(std::memory_order_acquire) && leaf->m_LoadError)
+                            throw std::runtime_error("World edit leaf failed");
+                        return MetaWorldEditStatus::Preparing;
+                    }
+                }
+            for (const auto& entry : pending.instances)
+                for (const auto& leaf : entry.prepared->m_vLeaves)
+                {
+                    if (!leaf) continue;
+                    if (leaf->m_bIsClosing.load() || (leaf->m_bTaskFinished.load(std::memory_order_acquire) && leaf->m_LoadError))
+                        throw std::runtime_error("Brush edit leaf failed");
+                    if (!leaf->m_bIsReady) return MetaWorldEditStatus::Preparing;
+                }
+            return MetaWorldEditStatus::Ready;
+        }
+        catch (...)
+        {
+            pending.failed = true;
+            return MetaWorldEditStatus::Failed;
+        }
+    }
+
+    bool Commit(uint64_t ticket) noexcept override
+    {
+        if (!ticket || !Current() || !session.pending || session.pending->ticket != ticket || session.pending->failed) return false;
+        auto& pending = *session.pending;
+        // Recheck without preparation/allocation: another plugin may have
+        // loaded/replaced an inline model after the previous Poll.
+        std::size_t affected = 0;
+        for (const auto& model : g_WorldSurfaceModels)
+            if (model && model->m_pWorldModel.lock() == session.active) ++affected;
+        if (affected != pending.models.size()) return false;
+        for (const auto& entry : pending.models)
+        {
+            if (entry.index >= g_WorldSurfaceModels.size() || g_WorldSurfaceModels[entry.index] != entry.expected) return false;
+            for (const auto& leaf : entry.prepared->m_vLeaves)
+                if (leaf && (!leaf->m_bIsReady || leaf->m_bIsClosing.load())) return false;
+        }
+        for (const auto& entry : pending.instances)
+            if (!LeavesReady(entry.prepared)) return false;
+        for (auto& entry : pending.models)
+        {
+            entry.expected->RetireLeaves();
+            g_WorldSurfaceModels[entry.index] = std::move(entry.prepared);
+        }
+        g_WorldSurfaceWorldModels[session.index] = pending.geometry;
+        session.active                           = std::move(pending.geometry);
+        session.revision                         = pending.revision;
+        session.committed                        = true;
+        for (auto& entry : session.instances) if (entry.prepared) entry.prepared->RetireLeaves();
+        // Swap only already-allocated immutable resources. Identity snapshots
+        // gate use on each draw; an absent/deleted slot never borrows a sibling.
+        session.instances.swap(pending.instances);
+        session.cuts.swap(pending.cuts);
+        RefreshInstanceShadows();
+        // Decals compare immutable mesh identity on their next use and rebuild
+        // only when their own bounds meet a cut, or a prior clipped decal must
+        // be restored. Unaffected VBO slots remain resident.
+        if (!session.instances.empty() || !pending.instances.empty()) R_InvalidateWorldShadowCaches({});
+        else if (!pending.changedBounds.empty()) R_InvalidateWorldShadowCaches(pending.changedBounds);
+        session.pending.reset();
+        return true;
+    }
+    void Cancel(uint64_t ticket) noexcept override
+    {
+        if (session.pending && session.pending->ticket == ticket) session.pending.reset();
+    }
+    void Reset() noexcept override
+    {
+        snapshotReady = false;
+        snapshotSeen = false;
+        session.pending.reset();
+        if (Current() && !session.instances.empty() && session.active == session.original)
+        {
+            R_ClearDecalCache();
+            R_InvalidateWorldShadowCaches({});
+        }
+        if (Current() && session.active != session.original)
+        {
+            for (auto& model : g_WorldSurfaceModels)
+                if (model && model->m_pWorldModel.lock() == session.active)
+                {
+                    model->RetireLeaves();
+                    model.reset();
+                }
+            g_WorldSurfaceWorldModels[session.index] = session.original;
+            R_ClearDecalCache();
+            R_InvalidateWorldShadowCaches({});
+        }
+        session = {};
+    }
+    bool UpdateBrushSnapshot(uint64_t epoch, uint64_t revision, uint32_t sequence,
+        const MetaWorldEditTarget* entries, uint32_t count) noexcept override
+    {
+        if (!epoch || !revision || sequence > brush::sequence_mask || count > brush::max_entities || (count && !entries))
+        {
+            snapshotReady = false;
+            RefreshInstanceShadows();
+            return false;
+        }
+        for (uint32_t i = 0; i < count; ++i)
+            if (!brush::valid({entries[i].slot, entries[i].serial, entries[i].inlineModel}) ||
+                (i && entries[i - 1].slot >= entries[i].slot))
+            {
+                snapshotReady = false;
+                RefreshInstanceShadows();
+                return false;
+            }
+        if (snapshotSeen && epoch == snapshotEpoch)
+        {
+            if (sequence == snapshotSequence)
+            {
+                bool identical = revision == snapshotRevision && count == snapshotCount;
+                for (uint32_t i = 0; i < count && identical; ++i)
+                {
+                    const auto& slot = snapshotSlots[entries[i].slot];
+                    identical = slot.generation == snapshotGeneration && slot.serial == entries[i].serial && slot.model == entries[i].inlineModel;
+                }
+                if (!identical) snapshotReady = false;
+                RefreshInstanceShadows();
+                return snapshotReady && identical;
+            }
+            if (((sequence - snapshotSequence) & brush::sequence_mask) >= 0x40000000) return false;
+        }
+        if (++snapshotGeneration == 0) { snapshotSlots = {}; ++snapshotGeneration; }
+        for (uint32_t i = 0; i < count; ++i)
+            snapshotSlots[entries[i].slot] = {snapshotGeneration, entries[i].serial, entries[i].inlineModel};
+        snapshotEpoch = epoch;
+        snapshotRevision = revision;
+        snapshotSequence = sequence;
+        snapshotCount = count;
+        snapshotReady = true;
+        snapshotSeen = true;
+        RefreshInstanceShadows();
+        return true;
+    }
+};
+} // namespace
+
+void R_ForgetWorldEdits(model_t* model) noexcept
+{
+    if (!model || model == session.world) { session = {}; snapshotReady = snapshotSeen = false; }
+    else if (session.pending)
+    {
+        for (const auto& entry : session.pending->instances)
+            if (entry.prepared->m_model == model) { session.pending.reset(); break; }
+        if (session.pending)
+        for (const auto& entry : session.pending->models)
+            if (entry.expected->m_model == model)
+            {
+                session.pending.reset();
+                break;
+            }
+    }
+    if (model)
+        for (auto& entry : session.instances)
+            if (entry.prepared && entry.prepared->m_model == model)
+            {
+                entry.prepared->RetireLeaves();
+                entry.prepared.reset();
+                entry.geometry.reset();
+            }
+}
+
+std::shared_ptr<CWorldSurfaceModel> R_FindEditedBrushSurfaceModel(const cl_entity_t* entity) noexcept
+{
+    if (!entity || !snapshotReady || !session.committed || !Current() ||
+        snapshotEpoch != session.epoch || snapshotRevision < session.revision ||
+        entity->index <= 0 || entity->curstate.number != entity->index || entity->curstate.solid != 4 ||
+        static_cast<uint32_t>(entity->curstate.messagenum) != snapshotSequence) return {};
+    const auto found = std::lower_bound(session.instances.begin(), session.instances.end(), static_cast<uint32_t>(entity->index),
+        [](const Instance& entry, uint32_t slot) { return entry.identity.slot < slot; });
+    if (found == session.instances.end() || found->identity.slot != static_cast<uint32_t>(entity->index) ||
+        !found->prepared || entity->model != found->prepared->m_model || entity->curstate.modelindex != found->engineModel ||
+        !gEngfuncs.hudGetModelByIndex || gEngfuncs.hudGetModelByIndex(found->engineModel) != entity->model) return {};
+    const auto& slot = snapshotSlots[found->identity.slot];
+    if (slot.generation != snapshotGeneration || slot.serial != found->identity.serial || slot.model != found->identity.inlineModel)
+        return {};
+    return found->prepared;
+}
+
+EXPOSE_SINGLE_INTERFACE(CMetaRendererWorldEdit, IMetaRendererWorldEdit, METARENDERER_WORLD_EDIT_INTERFACE_VERSION);
+EXPOSE_SINGLE_INTERFACE_GLOBALVAR(CMetaRendererWorldEdit, IMetaRendererWorldEdit2, METARENDERER_WORLD_EDIT2_INTERFACE_VERSION, __g_CMetaRendererWorldEdit_singleton);
diff --git a/src/world_edit_cache.cpp b/src/world_edit_cache.cpp
new file mode 100644
index 0000000..4c5b37d
--- /dev/null
+++ b/src/world_edit_cache.cpp
@@ -0,0 +1,148 @@
+#include "gl_local.h"
+#include <algorithm>
+#include <cmath>
+#include <stdexcept>
+
+std::shared_ptr<CWorldSurfaceWorldModel> R_PrepareCarvedDecal(
+    const CWorldSurfaceWorldModel& world,
+    uint32_t                       face,
+    std::span<const float>         vertices,
+    const brushinstancedata_t&     instance)
+{
+    using namespace goldcraft;
+    if (world.m_vDecalCuts.empty()) return {};
+    if (face >= world.m_vFaceBuffer.size() || vertices.size() % VERTEXSIZE ||
+        vertices.size() < 3 * VERTEXSIZE || vertices.size() > MAX_DECALVERTS * VERTEXSIZE)
+        throw std::invalid_argument("Invalid edited decal polygon");
+    carving::Box bounds;
+    for (int axis = 0; axis < 3; ++axis) bounds.min[axis] = bounds.max[axis] = vertices[axis];
+    for (std::size_t i = 0; i < vertices.size(); i += VERTEXSIZE)
+        for (int axis = 0; axis < 3; ++axis)
+        {
+            bounds.min[axis] = (std::min)(bounds.min[axis], double(vertices[i + axis]));
+            bounds.max[axis] = (std::max)(bounds.max[axis], double(vertices[i + axis]));
+        }
+    std::vector<surface::Selection> cuts;
+    for (const auto& cut : world.m_vDecalCuts)
+    {
+        if (face < cut.first_face || face - cut.first_face >= cut.face_count) continue;
+        bool intersects = true;
+        for (int axis = 0; axis < 3; ++axis)
+            if (bounds.min[axis] > cut.box.max[axis] || bounds.max[axis] < cut.box.min[axis]) intersects = false;
+        if (intersects) cuts.push_back({0, 1, cut.box});
+    }
+    if (cuts.empty()) return {};
+    auto        mesh  = std::make_shared<surface::Mesh>();
+    const auto& plane = world.m_vFaceBuffer[face];
+    for (std::size_t i = 0; i < vertices.size(); i += VERTEXSIZE)
+    {
+        surface::Vertex vertex;
+        std::memcpy(&vertex, vertices.data() + i, sizeof(vertex));
+        mesh->vertices.push_back(vertex);
+        surface::Frame frame;
+        for (int axis = 0; axis < 3; ++axis)
+        {
+            frame.normal[axis] = frame.smoothnormal[axis] = plane.normal[axis];
+            frame.s_tangent[axis]                         = plane.s_tangent[axis];
+            frame.t_tangent[axis]                         = plane.t_tangent[axis];
+        }
+        mesh->frames.push_back(frame);
+    }
+    for (uint32_t i = 2; i < mesh->vertices.size(); ++i) mesh->indices.insert(mesh->indices.end(), {0, i - 1, i});
+    surface::Instance material;
+    static_assert(sizeof(material) == sizeof(instance));
+    std::memcpy(&material, &instance, sizeof(material));
+    mesh->instances.push_back(material);
+    mesh->faces.push_back({{0, static_cast<uint32_t>(mesh->indices.size())}, {}, {0, 1}, static_cast<uint32_t>(mesh->indices.size() / 3), true});
+    const auto prepared = surface::prepare(mesh, cuts, {16'384, 65'536, 4096, 1'048'576});
+    if (!prepared.changed_faces) return {};
+    auto result             = std::make_shared<CWorldSurfaceWorldModel>(world.m_model);
+    result->m_pOriginalMesh = std::move(mesh);
+    result->m_pSurfaceMesh  = prepared.mesh;
+    R_UploadWorldSurfaceGeometry(*result);
+    return result;
+}
+
+void R_InvalidateWorldShadowCaches(std::span<const goldcraft::carving::Box> bounds) noexcept
+{
+    const auto invalidate = [&](const auto& lights) {
+        for (const auto& light : lights)
+        {
+            if (!light || !light->pStaticShadowTexture || !light->pStaticShadowTexture->IsReady()) continue;
+            bool         affected = bounds.empty() || light->type == DynamicLightType_Directional;
+            const double radius   = light->type == DynamicLightType_Spot ?
+                (std::max)(std::abs(double(light->size)), std::abs(double(light->distance))) :
+                std::abs(double(light->size));
+            if (!std::isfinite(radius)) affected = true;
+            for (const auto& box : bounds)
+            {
+                if (affected) break;
+                double distance = 0;
+                for (int axis = 0; axis < 3; ++axis)
+                {
+                    const double origin = light->origin[axis];
+                    if (!std::isfinite(origin))
+                    {
+                        affected = true;
+                        break;
+                    }
+                    const auto delta = (std::max)({box.min[axis] - origin, 0.0, origin - box.max[axis]});
+                    distance += delta * delta;
+                }
+                affected |= distance <= radius * radius;
+            }
+            if (affected) light->pStaticShadowTexture->SetReady(false);
+        }
+    };
+    // Include currently invisible lights: they must rebake when next seen.
+    invalidate(g_BSPDynamicLights);
+    invalidate(g_EngineDynamicLights);
+    invalidate(g_ExternalDynamicLights);
+}
+
+void R_ClearDecalCache(void)
+{
+    for (int i = 0; i < MAX_DECALS; ++i)
+    {
+        VectorClear(g_WorldSurfaceRenderer.vCachedDecals[i].origin);
+        VectorClear(g_WorldSurfaceRenderer.vCachedDecals[i].mins);
+        VectorClear(g_WorldSurfaceRenderer.vCachedDecals[i].maxs);
+        g_WorldSurfaceRenderer.vCachedDecals[i].boundsValid   = false;
+        g_WorldSurfaceRenderer.vCachedDecals[i].geometryReady = false;
+        g_WorldSurfaceRenderer.vCachedDecals[i].worldMesh.reset();
+        g_WorldSurfaceRenderer.vCachedDecals[i].carvedGeometry.reset();
+        g_WorldSurfaceRenderer.vCachedDecals[i].indiceCount     = 0;
+        g_WorldSurfaceRenderer.vCachedDecals[i].instanceCount   = 0;
+        g_WorldSurfaceRenderer.vCachedDecals[i].pRenderMaterial = nullptr;
+    }
+}
+
+bool R_IsDecalCacheInvalidated(int decalIndex, texture_t* texture, const std::shared_ptr<CWorldSurfaceRenderMaterial>& pRenderMaterial, const CWorldSurfaceWorldModel& world)
+{
+    auto& cachedDecal = g_WorldSurfaceRenderer.vCachedDecals[decalIndex];
+
+    if (!cachedDecal.boundsValid ||
+        !cachedDecal.geometryReady ||
+        cachedDecal.gltexturenum != texture->gl_texturenum ||
+        cachedDecal.gltexturewidth != texture->width ||
+        cachedDecal.gltextureheight != texture->height ||
+        cachedDecal.pRenderMaterial != pRenderMaterial)
+    {
+        return true;
+    }
+
+    if (cachedDecal.worldMesh.lock() != world.m_pSurfaceMesh)
+    {
+        if (cachedDecal.carvedGeometry || !cachedDecal.indiceCount) return true;
+        for (const auto& cut : world.m_vDecalCuts)
+        {
+            if (cachedDecal.surfaceIndex < cut.first_face || cachedDecal.surfaceIndex - cut.first_face >= cut.face_count) continue;
+            bool intersects = true;
+            for (int axis = 0; axis < 3; ++axis)
+                if (cachedDecal.mins[axis] > cut.box.max[axis] || cachedDecal.maxs[axis] < cut.box.min[axis]) intersects = false;
+            if (intersects) return true;
+        }
+        cachedDecal.worldMesh = world.m_pSurfaceMesh;
+    }
+    return false;
+}
diff --git a/include/Interface/IMetaRendererPostScene.h b/include/Interface/IMetaRendererPostScene.h
new file mode 100644
index 0000000..c528bd4
--- /dev/null
+++ b/include/Interface/IMetaRendererPostScene.h
@@ -0,0 +1,69 @@
+#pragma once
+#include <interface.h>
+#include <stdint.h>
+
+// Optional, same-process extension. Existing Renderer and scene vtables do not
+// change. Registration, callbacks and unregistration use the Renderer/GL thread.
+enum MetaRendererPostSceneFlags : uint32_t
+{
+    META_POST_SCENE_GAMMA  = 1u << 0,
+    META_POST_SCENE_LINEAR = 1u << 1,
+    // The host HDR/tone-map pipeline will run later; this is not a storage type.
+    META_POST_SCENE_HDR    = 1u << 2
+};
+
+struct MetaRendererPostSceneFrame
+{
+    uint32_t struct_size;
+    uint32_t flags; // Exactly one of GAMMA and LINEAR, optionally HDR.
+    uint32_t framebuffer;
+    uint32_t color_texture;
+    uint32_t depth_texture;        // Packed GL_DEPTH24_STENCIL8 attachment.
+    uint32_t depth_sample_texture; // GL_DEPTH_COMPONENT texture view.
+    uint32_t width, height;        // Full attachment dimensions, not viewport size.
+    uint32_t color_format;         // GL_RGBA8 or GL_RGBA16F.
+    uint32_t depth_format;         // GL_DEPTH24_STENCIL8.
+    int32_t viewport[4];           // x,y,width,height; OpenGL lower-left origin.
+    // Column-major host-world camera matrices, in GoldSrc units. The view looks
+    // along negative Z. NDC Z is [-1,1], sampled depth is [0,1], clear depth is 1.
+    // These describe world geometry, before CS viewmodel projection/depth clear.
+    float world_matrix[16];
+    float projection_matrix[16];
+    float inverse_world_matrix[16];
+    float inverse_projection_matrix[16];
+    uint32_t frame_number, view_index;
+    uint32_t samples; // API001 supplies single-sample GL_TEXTURE_2D resources only.
+    float near_plane, far_plane;
+};
+static_assert(sizeof(MetaRendererPostSceneFrame) == 332, "Post-scene ABI layout");
+
+class IMetaRendererPostSceneCallbacks : public IBaseInterface
+{
+public:
+    // Runs once for the eligible main view, after host transparency/OIT resolve/
+    // particles and before viewmodel, HDR/gamma correction, FXAA and HUD. Shadow,
+    // water/reflection/refraction, portal, overview, nested and client-only views
+    // are excluded. Color is the current lit CS scene in the indicated space;
+    // depth is real world depth, including depth-writing scene geometry.
+    //
+    // The descriptor/handles are borrowed only for this invocation and current
+    // GL context. Never retain/delete/reallocate/reattach them or send them over
+    // IPC. A consumer may update scene color through this FBO, but must preserve
+    // depth/stencil and all changed GL AND Renderer cached binding/state. Copy
+    // scene color/depth to owned targets before sampling while writing; avoid
+    // texture feedback. Do not recurse RenderScene/RenderView or throw. No
+    // callback is evidence that a separately paired content producer is fresh.
+    virtual void DrawPostScene(const MetaRendererPostSceneFrame& frame) noexcept = 0;
+};
+
+class IMetaRendererPostScene : public IBaseInterface
+{
+public:
+    // Bounded to 16 consumers. Duplicate registration is idempotent. Consumers
+    // added during dispatch start next dispatch; removed consumers are skipped
+    // immediately. Unregister before destroying/unloading a callback object.
+    virtual bool RegisterPostSceneCallbacks(IMetaRendererPostSceneCallbacks* callbacks) noexcept = 0;
+    virtual bool UnregisterPostSceneCallbacks(IMetaRendererPostSceneCallbacks* callbacks) noexcept = 0;
+};
+
+#define METARENDERER_POST_SCENE_INTERFACE_VERSION "MetaRendererPostScene_API_001"
diff --git a/src/post_scene.h b/src/post_scene.h
new file mode 100644
index 0000000..d6772b3
--- /dev/null
+++ b/src/post_scene.h
@@ -0,0 +1,31 @@
+#pragma once
+#include <IMetaRendererPostScene.h>
+
+namespace RendererPostScene
+{
+struct Context
+{
+    bool rendering_view{};
+    bool nested_view{};
+    bool shadow_view{};
+    bool water_view{};
+    bool portal_view{};
+    bool overview{};
+    bool only_client_draws{};
+    bool multiview{};
+    bool linear_depth{};
+    bool gbuffer{};
+    bool unresolved_oit{};
+    uint32_t view_index{};
+};
+
+bool Eligible(const Context& context) noexcept;
+// SvEngine's R_RenderView(int) supplies a zero-based view index. GoldSrc has
+// R_RenderView(void); its existing wrapper increments the frame counter before
+// calling the shared renderer, so that counter is one-based. Do not change the
+// host counter/clear behavior when exposing the public zero-based descriptor.
+uint32_t NormalizeViewIndex(int engine_view_index, bool explicit_view_index) noexcept;
+bool HasCallbacks() noexcept;
+bool ValidFrame(const MetaRendererPostSceneFrame& frame) noexcept;
+uint32_t Dispatch(const Context& context, const MetaRendererPostSceneFrame& frame) noexcept;
+} // namespace RendererPostScene
diff --git a/src/post_scene.cpp b/src/post_scene.cpp
new file mode 100644
index 0000000..8a9f955
--- /dev/null
+++ b/src/post_scene.cpp
@@ -0,0 +1,120 @@
+#include "post_scene.h"
+#include <array>
+#include <cmath>
+
+namespace
+{
+struct Slot
+{
+    IMetaRendererPostSceneCallbacks* callback{};
+    uint64_t generation{};
+};
+std::array<Slot, 16> slots{};
+uint64_t next_generation = 1;
+uint32_t callback_count{};
+bool dispatching{};
+
+class CMetaRendererPostScene final : public IMetaRendererPostScene
+{
+public:
+    bool RegisterPostSceneCallbacks(IMetaRendererPostSceneCallbacks* callback) noexcept override
+    {
+        if (!callback) return false;
+        for (const auto& slot : slots)
+            if (slot.callback == callback) return true;
+        if (next_generation == ~uint64_t{0}) return false;
+        for (auto& slot : slots)
+        {
+            if (slot.callback) continue;
+            slot = {callback, next_generation++};
+            ++callback_count;
+            return true;
+        }
+        return false;
+    }
+
+    bool UnregisterPostSceneCallbacks(IMetaRendererPostSceneCallbacks* callback) noexcept override
+    {
+        if (!callback) return false;
+        for (auto& slot : slots)
+        {
+            if (slot.callback != callback) continue;
+            slot = {};
+            --callback_count;
+            return true;
+        }
+        return false;
+    }
+};
+} // namespace
+
+EXPOSE_SINGLE_INTERFACE(CMetaRendererPostScene, IMetaRendererPostScene, METARENDERER_POST_SCENE_INTERFACE_VERSION);
+
+namespace RendererPostScene
+{
+uint32_t NormalizeViewIndex(int engine_view_index, bool explicit_view_index) noexcept
+{
+    const int first_view = explicit_view_index ? 0 : 1;
+    if (engine_view_index < first_view) return ~uint32_t{0};
+    return static_cast<uint32_t>(engine_view_index - first_view);
+}
+
+bool Eligible(const Context& context) noexcept
+{
+    return context.rendering_view && !context.nested_view && !context.shadow_view &&
+           !context.water_view && !context.portal_view && !context.overview &&
+           !context.only_client_draws && !context.multiview && !context.linear_depth &&
+           !context.gbuffer && !context.unresolved_oit && context.view_index == 0;
+}
+
+bool HasCallbacks() noexcept
+{
+    return callback_count != 0 && !dispatching;
+}
+
+bool ValidFrame(const MetaRendererPostSceneFrame& frame) noexcept
+{
+    constexpr uint32_t known_flags = META_POST_SCENE_GAMMA | META_POST_SCENE_LINEAR | META_POST_SCENE_HDR;
+    constexpr uint32_t color_flags = META_POST_SCENE_GAMMA | META_POST_SCENE_LINEAR;
+    constexpr uint32_t rgba8 = 0x8058, rgba16f = 0x881A, depth24_stencil8 = 0x88F0;
+    const uint32_t space = frame.flags & color_flags;
+    if (frame.struct_size != sizeof(frame) || (frame.flags & ~known_flags) ||
+        (space != META_POST_SCENE_GAMMA && space != META_POST_SCENE_LINEAR) ||
+        !frame.framebuffer || !frame.color_texture || !frame.depth_texture || !frame.depth_sample_texture ||
+        frame.color_texture == frame.depth_texture || frame.color_texture == frame.depth_sample_texture ||
+        frame.depth_texture == frame.depth_sample_texture ||
+        !frame.width || !frame.height || frame.width > 0x7fffffffu || frame.height > 0x7fffffffu ||
+        (frame.color_format != rgba8 && frame.color_format != rgba16f) || frame.depth_format != depth24_stencil8 ||
+        frame.samples != 1 || frame.view_index != 0 ||
+        frame.viewport[0] < 0 || frame.viewport[1] < 0 || frame.viewport[2] <= 0 || frame.viewport[3] <= 0 ||
+        uint64_t(frame.viewport[0]) + uint64_t(frame.viewport[2]) > frame.width ||
+        uint64_t(frame.viewport[1]) + uint64_t(frame.viewport[3]) > frame.height ||
+        !std::isfinite(frame.near_plane) || !std::isfinite(frame.far_plane) ||
+        frame.near_plane <= 0 || frame.far_plane <= frame.near_plane)
+        return false;
+    for (const auto* matrix : {frame.world_matrix, frame.projection_matrix,
+                              frame.inverse_world_matrix, frame.inverse_projection_matrix})
+        for (unsigned i = 0; i != 16; ++i)
+            if (!std::isfinite(matrix[i])) return false;
+    return true;
+}
+
+uint32_t Dispatch(const Context& context, const MetaRendererPostSceneFrame& frame) noexcept
+{
+    if (!HasCallbacks() || !Eligible(context) || !ValidFrame(frame)) return 0;
+    dispatching = true;
+    const uint64_t limit = next_generation;
+    uint32_t invoked = 0;
+    for (const auto& slot : slots)
+    {
+        // Do not hold a callback reference across the call: it may unregister
+        // itself/another consumer and reuse the vacated registry slot.
+        auto* callback = slot.callback;
+        if (!callback || slot.generation >= limit) continue;
+        ++invoked;
+        callback->DrawPostScene(frame);
+    }
+    dispatching = false;
+    return invoked;
+}
+} // namespace RendererPostScene
diff --git a/tests/post_scene_tests.cpp b/tests/post_scene_tests.cpp
new file mode 100644
index 0000000..c7d90d0
