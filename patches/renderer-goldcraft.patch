+void CapabilityCases()
+{
+    const GLboolean core = __GLEW_VERSION_4_4, extension = __GLEW_ARB_buffer_storage;
+    __GLEW_VERSION_4_4 = __GLEW_ARB_buffer_storage = GL_FALSE;
+    const auto before = calls; const bool supported = g_DrawParameters.Init();
+    __GLEW_VERSION_4_4 = core; __GLEW_ARB_buffer_storage = extension;
+    Check(!supported && calls.generated == before.generated && calls.queries == before.queries, "missing capability rejected before allocation/query");
+    const auto storage = __glewBufferStorage; __glewBufferStorage = nullptr;
+    const bool entrypointSupported = g_DrawParameters.Init(); __glewBufferStorage = storage;
+    Check(!entrypointSupported && calls.generated == before.generated, "advertised extension with missing entry point rejected");
+    CheckReset();
+}
+void ValidationCases(Fixture& fixture)
+{
+    const auto p = MakeRectangle(0, 0, 0).parameters;
+    Check(!g_DrawParameters.UploadAndBind(ModelBinding, sizeof(p), &p), "uploads require BeginFrame");
+    g_DrawParameters.BeginFrame();
+    glBindBufferBase(GL_UNIFORM_BUFFER, ModelBinding, fixture.guard);
+    const auto initial = ReadBinding(ModelBinding); const auto before = calls;
+    Check(!g_DrawParameters.UploadAndBind(ModelBinding, 0, &p), "zero size rejected");
+    Check(!g_DrawParameters.UploadAndBind(ModelBinding, -1, &p), "negative size rejected");
+    Check(!g_DrawParameters.UploadAndBind(ModelBinding, sizeof(p), nullptr), "null payload rejected");
+    Check(!g_DrawParameters.UploadAndBind(ModelBinding, CDrawParameterStream::PAGE_BYTES + 1, &p), "oversized page request rejected before read");
+    Check(!g_DrawParameters.UploadAndBind(ModelBinding, static_cast<GLsizeiptr>(fixture.maxBlock) + 1, &p), "driver block-size overflow rejected before read");
+    Check(!g_DrawParameters.UploadAndBind(static_cast<GLuint>(fixture.maxBindings), sizeof(p), &p), "out-of-range indexed binding rejected");
+    Check(ReadBinding(ModelBinding) == initial && calls.ranges == before.ranges, "invalid uploads preserve existing indexed binding");
+    NoDrawAllocation(before); fixture.CheckGuards();
+    g_DrawParameters.EndFrame(); const auto fences = calls.fences; g_DrawParameters.EndFrame();
+    Check(calls.fences == fences, "repeated EndFrame does not fence again");
+    Check(!g_DrawParameters.UploadAndBind(ModelBinding, sizeof(p), &p), "uploads rejected after EndFrame");
+}
+void Render(Target& target, Fixture& fixture, const std::vector<Rectangle>& rectangles, bool enabled)
+{
+    streamCvar.value = enabled ? 1.f : 0.f; target.Clear();
+    const auto material = Material();
+    // Keep the second shader binding live across all per-draw model uploads.
+    Dispatch(fixture.material, MaterialBinding, sizeof(material), &material);
+    for (const auto& rectangle : rectangles)
+        { Dispatch(fixture.fallback, ModelBinding, sizeof(Parameters), &rectangle.parameters); fixture.Draw(); }
+}
+void PixelBurst(std::array<Target, Frames>& targets, Fixture& fixture)
+{
+    std::array<std::vector<Rectangle>, Frames> rectangles;
+    std::array<Image, Frames> legacy;
+    for (unsigned frame = 0; frame < Frames; ++frame)
+    {
+        rectangles[frame] = Rectangles(frame + 11);
+        Render(targets[frame], fixture, rectangles[frame], false); legacy[frame] = targets[frame].Read();
+        Compare(Oracle(rectangles[frame], Material()), legacy[frame], "legacy mutable path matches independent pixel/depth oracle");
+    }
+    const auto before = calls; const auto start = g_DrawParameters.Stats();
+    // No readback or finish until all six frames are submitted. Individual
+    // targets retain early output while later frames rotate or use fallback.
+    for (unsigned frame = 0; frame < Frames; ++frame)
+    {
+        g_DrawParameters.BeginFrame(); Render(targets[frame], fixture, rectangles[frame], true);
+        g_DrawParameters.EndFrame(); glFlush();
+    }
+    NoDrawAllocation(before);
+    const auto& stats = g_DrawParameters.Stats();
+    Check(stats.streamedDraws > start.streamedDraws && stats.streamedBytes > start.streamedBytes, "burst actually consumes persistent slices");
+    for (unsigned frame = 0; frame < Frames; ++frame)
+    {
+        const auto pixels = targets[frame].Read();
+        Compare(legacy[frame], pixels, "queued streamed frames equal mutable reference");
+        Compare(Oracle(rectangles[frame], Material()), pixels, "queued streamed frames match independent oracle");
+    }
+    fixture.CheckGuards();
+    std::printf("queued frames: %d, streamed uploads: %llu, fallbacks: %llu, intra-frame page rotations: %llu\n", Frames,
+        static_cast<unsigned long long>(stats.streamedDraws - start.streamedDraws),
+        static_cast<unsigned long long>(stats.fallbacks - start.fallbacks),
+        static_cast<unsigned long long>(stats.pageRotations - start.pageRotations));
+}
+void RetainedBindingsAndCapacity(Target& target, Fixture& fixture)
+{
+    const auto payloadSize = (std::min)(static_cast<GLsizeiptr>(fixture.maxBlock), CDrawParameterStream::PAGE_BYTES);
+    std::vector<std::byte> payload(static_cast<std::size_t>(payloadSize));
+    const auto initialRotations = g_DrawParameters.Stats().pageRotations;
+    const auto upperBound = static_cast<unsigned>(CDrawParameterStream::PAGE_COUNT * CDrawParameterStream::PAGE_BYTES / payloadSize + 4);
+    for (unsigned frame = 0; frame < 8; ++frame)
+    {
+        // EndFrame already inserted the preceding frame's real fences. This
+        // test-only finish makes reuse deterministic, never part of production.
+        glFinish(); g_DrawParameters.BeginFrame(); streamCvar.value = 1; target.Clear();
+        const auto rectangle = MakeRectangle(31 + frame * 33, 0, frame + 80);
+        const auto material = Material(.5f);
+        Check(Dispatch(fixture.fallback, ModelBinding, sizeof(Parameters), &rectangle.parameters), "model receives persistent slice");
+        Check(Dispatch(fixture.material, MaterialBinding, sizeof(material), &material), "material receives independent persistent slice");
+        const auto modelBinding = ReadBinding(ModelBinding), materialBinding = ReadBinding(MaterialBinding);
+        Check(modelBinding.size == sizeof(Parameters) && materialBinding.size == sizeof(Parameters) &&
+            modelBinding.offset % fixture.alignment == 0 && materialBinding.offset % fixture.alignment == 0,
+            "actual indexed ranges satisfy driver size/alignment");
+        Check(modelBinding.buffer != materialBinding.buffer || modelBinding.offset != materialBinding.offset, "simultaneous bindings use disjoint slices");
+        GLint generic{}; glGetIntegerv(GL_UNIFORM_BUFFER_BINDING, &generic); Check(generic == 0, "persistent dispatcher clears generic UBO binding");
+        bool exhausted = false;
+        for (unsigned i = 0; i < upperBound; ++i)
+        {
+            std::fill(payload.begin(), payload.end(), static_cast<std::byte>((i + frame) & 255));
+            if (!Dispatch(fixture.fallback, ScratchBinding, payload.size(), payload.data())) { exhausted = true; break; }
+        }
+        Check(exhausted, "fixed three-page capacity produces deterministic mutable fallback");
+        Check(ReadBinding(ModelBinding) == modelBinding && ReadBinding(MaterialBinding) == materialBinding,
+            "later page allocations and exhaustion preserve both live indexed bindings");
+        fixture.Draw(); fixture.CheckGuards();
+        g_DrawParameters.EndFrame();
+        Compare(Oracle({rectangle}, material), target.Read(), "late consumer retains model/material slices after full arena");
+        Check(arenaBuffers.size() == CDrawParameterStream::PAGE_COUNT, "capacity fallback never allocates another page");
+    }
+    Check(g_DrawParameters.Stats().pageRotations >= initialRotations + 16, "eight frames exercise at least sixteen real page rotations");
+}
+void InjectedBusyAndWaitFailure(Target& target, Fixture& fixture)
+{
+    // Deterministic scheduling seam only: actual GPU speed cannot guarantee a
+    // timeout in a short regression test. The real fences remain owned/live.
+    const auto rectangle = MakeRectangle(44, 0, 199); const auto material = Material();
+    g_DrawParameters.BeginFrame(); waitInjection = WaitInjection::Busy;
+    const auto before = calls; const auto stats = g_DrawParameters.Stats(); streamCvar.value = 1;
+    target.Clear();
+    Check(!Dispatch(fixture.fallback, ModelBinding, sizeof(Parameters), &rectangle.parameters), "injected busy pages select actual mutable dispatcher path");
+    Check(!Dispatch(fixture.material, MaterialBinding, sizeof(material), &material), "all busy pages preserve independent fallback bindings");
+    for (unsigned i = 0; i < 40; ++i) Check(!g_DrawParameters.UploadAndBind(ScratchBinding, sizeof(material), &material), "busy frame stays bounded");
+    Check(calls.waits == before.waits + CDrawParameterStream::PAGE_COUNT, "busy pages polled at most once each in a frame");
+    Check(g_DrawParameters.Stats().busyFallbacks >= stats.busyFallbacks + 2, "busy statistics identify pressure separately");
+    fixture.Draw(); g_DrawParameters.EndFrame(); waitInjection = WaitInjection::None;
+    Compare(Oracle({rectangle}, material), target.Read(), "injected busy fallback still renders real correct pixels/depth");
+    glFinish(); g_DrawParameters.BeginFrame();
+    Check(Dispatch(fixture.fallback, ModelBinding, sizeof(Parameters), &rectangle.parameters), "real signalled fences permit recovery next frame");
+    g_DrawParameters.EndFrame();
+    g_DrawParameters.BeginFrame(); waitInjection = WaitInjection::Failed;
+    const auto failures = g_DrawParameters.Stats().syncFailures;
+    Check(!g_DrawParameters.UploadAndBind(ModelBinding, sizeof(Parameters), &rectangle.parameters), "injected wait failure rejects arena write");
+    waitInjection = WaitInjection::None;
+    Check(g_DrawParameters.Stats().syncFailures == failures + 1, "wait failure recorded");
+    Check(!g_DrawParameters.UploadAndBind(ModelBinding, sizeof(Parameters), &rectangle.parameters), "wait failure disables arena until reinitialization");
+    Check(glGetError() == GL_NO_ERROR, "injected scheduling tests introduce no real GL error");
+    std::printf("labelled sync-result injections: %llu; all pixel draws/readbacks use real GL\n", static_cast<unsigned long long>(calls.injectedWaits));
+}
+void RunContext(unsigned context)
+{
+    Fixture fixture; std::array<Target, Frames> targets; DriverProbe probe;
+    Check(arenaBuffers.empty() && arenaFences.empty(), "new context starts without arena resources");
+    CapabilityCases(); InitStream(); ValidationCases(fixture);
+    PixelBurst(targets, fixture); RetainedBindingsAndCapacity(targets[0], fixture);
+    InjectedBusyAndWaitFailure(targets[0], fixture); CheckReset(); InitStream();
+    g_DrawParameters.BeginFrame();
+    const auto rectangles = Rectangles(context + 401);
+    Render(targets[0], fixture, rectangles, true); g_DrawParameters.EndFrame();
+    Compare(Oracle(rectangles, Material()), targets[0].Read(), "Reset/reinit draws use current context storage");
+    // Exercise the non-DSA production mutable fallback too, including cvar-null.
+    const auto named = __glewNamedBufferSubData; __glewNamedBufferSubData = nullptr;
+    r_draw_parameter_stream = nullptr;
+    Render(targets[0], fixture, rectangles, false);
+    r_draw_parameter_stream = &streamCvar; __glewNamedBufferSubData = named;
+    Compare(Oracle(rectangles, Material()), targets[0].Read(), "null-cvar/non-DSA production fallback remains correct");
+    CheckReset();
+    Check(calls.generated == calls.deleted && calls.maps == calls.unmaps && calls.fences == calls.deletedFences,
+        "owning context releases every allocation, persistent mapping and fence");
+    Check(glGetError() == GL_NO_ERROR, "context teardown is GL-clean");
+    std::printf("context %u: storage=%llu maps=%llu real draws cumulative=%llu, no per-draw storage allocation\n", context,
+        static_cast<unsigned long long>(calls.storage), static_cast<unsigned long long>(calls.maps), static_cast<unsigned long long>(realDraws));
+}
+}
+
+int main()
+{
+    if (!glfwInit()) return 2;
+    glfwWindowHint(GLFW_VISIBLE, GLFW_FALSE); glfwWindowHint(GLFW_FOCUSED, GLFW_FALSE);
+    glfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 4); glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 3);
+    glfwWindowHint(GLFW_CONTEXT_CREATION_API, GLFW_NATIVE_CONTEXT_API);
+    for (unsigned context = 1; context <= 2; ++context)
+    {
+        auto* window = glfwCreateWindow(Width, Height, "draw parameter stream regression", nullptr, nullptr);
+        if (!window) { glfwTerminate(); return 2; }
+        glfwMakeContextCurrent(window); glewExperimental = GL_TRUE;
+        if (glewInit() != GLEW_OK || !(GLEW_VERSION_4_4 || GLEW_ARB_buffer_storage))
+        {
+            std::fprintf(stderr, "SKIP: real GL context/persistent storage unavailable\n");
+            glfwDestroyWindow(window); glfwTerminate(); return 2;
+        }
+        while (glGetError() != GL_NO_ERROR) {}
+        std::printf("Context %u driver: %s / %s\n", context, glGetString(GL_RENDERER), glGetString(GL_VERSION));
+        try
+        {
+#ifdef _WIN32
+            Check(glfwGetWGLContext(window) != nullptr, "test runs on real Windows WGL context");
+#endif
+            RunContext(context);
+        }
+        catch (const std::exception& error)
+        {
+            std::fprintf(stderr, "FAILED: %s\n", error.what());
+            g_DrawParameters.Reset(); glfwDestroyWindow(window); glfwTerminate(); return 1;
+        }
+        glfwMakeContextCurrent(nullptr); glfwDestroyWindow(window);
+        // The next context is explicitly unshared. Numeric GL object names may
+        // repeat; only explicit Reset plus fresh allocation is a valid oracle.
+    }
+    glfwTerminate();
+    std::printf("PASS: %llu checks, %llu pixel comparisons, %llu depth comparisons, %llu real draws; not FPS evidence\n",
+        static_cast<unsigned long long>(checks), static_cast<unsigned long long>(comparedPixels),
+        static_cast<unsigned long long>(comparedDepth), static_cast<unsigned long long>(realDraws));
+    return 0;
+}
diff --git a/tests/extract_draw_parameter_dispatch.py b/tests/extract_draw_parameter_dispatch.py
new file mode 100644
index 0000000..ef33679
--- /dev/null
+++ b/tests/extract_draw_parameter_dispatch.py
@@ -0,0 +1,37 @@
+"""Extract the actual UBO dispatch and validate outer-frame ownership sites."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from extract_studio_depth_executor import function
+
+p = argparse.ArgumentParser(description=__doc__)
+p.add_argument('--src', type=Path, required=True)
+p.add_argument('--output', type=Path, required=True)
+p.add_argument('--manifest', type=Path, required=True)
+a = p.parse_args()
+names = ('gl_draw.cpp', 'gl_rmain.cpp', 'gl_studio.cpp', 'gl_wsurf.cpp',
+         'draw_parameter_stream.h', 'draw_parameter_dispatch.h')
+sources = {name: (a.src/name).read_text(encoding='utf-8-sig') for name in names}
+main = sources['gl_rmain.cpp']
+sites = (('void R_Init(', 'R_InitDrawParameters();'),
+         ('void R_Shutdown(', 'R_ShutdownDrawParameters();'),
+         ('void R_RenderFrameStart(', 'R_BeginDrawParameterFrame();'),
+         ('void R_RenderEndFrame(', 'R_EndDrawParameterFrame();'))
+for signature, call in sites:
+    assert function(main, signature).count(call) == 1, (signature, call)
+assert sources['gl_studio.cpp'].count('GL_UploadDrawParameters(g_hStudioUBO,') == 1
+assert sources['gl_wsurf.cpp'].count('GL_UploadDrawParameters(g_WorldSurfaceRenderer.hEntityUBO,') == 2
+# Camera/scene data is shared between views and may be partially overwritten.
+# Keep those APIs on their original storage; only complete draw records stream.
+assert 'GL_UploadDrawParameters(g_WorldSurfaceRenderer.hCameraUBO' not in sources['gl_wsurf.cpp']
+code = '// Exact production draw-parameter dispatch; engine lifecycle checked by extractor.\n'
+code += '\n\n'.join(function(sources['gl_draw.cpp'], signature) for signature in
+                    ('void GL_UploadSubDataToUBO(', 'void GL_UploadDrawParameters('))
+a.output.parent.mkdir(parents=True, exist_ok=True)
+a.output.write_text(code+'\n', encoding='utf-8')
+a.manifest.write_text(json.dumps({
+    'inputs': {name: hashlib.sha256((a.src/name).read_bytes()).hexdigest() for name in names},
+    'output': hashlib.sha256((code+'\n').encode()).hexdigest(),
+    'scope': 'Actual mutable/stream dispatch, complete parameter callers and outer frame ownership. No game FPS.'
+}, indent=2)+'\n', encoding='utf-8')
diff --git a/tests/studio_bone_palette_tests.cpp b/tests/studio_bone_palette_tests.cpp
new file mode 100644
index 0000000..06d17ce
--- /dev/null
+++ b/tests/studio_bone_palette_tests.cpp
@@ -0,0 +1,34 @@
+#include "../src/studio_bone_palette.h"
+#include <cassert>
+#include <cstdio>
+
+int main()
+{
+    CStudioBonePaletteCache<2> cache;
+    std::array<std::byte, decltype(cache)::PaletteBytes> first{}, second{}, third{};
+    second.back() = std::byte{1}; third[0] = std::byte{2};
+    const auto a = cache.Select(first.data(), 17, 42);
+    assert(a.index == 0 && !a.reused);
+    // A deliberate collision must not reuse even when the final byte differs.
+    const auto b = cache.Select(second.data(), 17, 42);
+    assert(b.index == 1 && !b.reused);
+    assert(cache.Select(first.data(), 17, 42).reused);
+    assert(cache.Select(second.data(), 17, 42).reused);
+    const auto overflow = cache.Select(third.data(), 17, 42);
+    assert(overflow.index == decltype(cache)::NoEntry && !overflow.reused);
+    assert(cache.Select(first.data(), 17, 42).index == a.index);
+    assert(cache.Select(second.data(), 17, 42).index == b.index);
+    // Frame advance, rewind and wrap all invalidate, including same content.
+    for (auto frame : {43u, 0u, UINT32_MAX, 0u})
+    {
+        const auto changed = cache.Select(second.data(), 17, frame);
+        assert(changed.index == 0 && !changed.reused);
+        assert(cache.Select(second.data(), 17, frame).reused);
+    }
+    cache.Reset();
+    assert(!cache.Select(second.data(), 17, 0).reused);
+    // Two cache instances never share ownership, even at the same frame/hash.
+    CStudioBonePaletteCache<2> other;
+    assert(!other.Select(second.data(), 17, 0).reused);
+    std::puts("Studio palette: exact collision/final-byte comparison, capacity, frame/map reset and isolation passed.");
+}
diff --git a/tests/studio_bone_palette_gl_tests.cpp b/tests/studio_bone_palette_gl_tests.cpp
new file mode 100644
index 0000000..0c6a943
--- /dev/null
+++ b/tests/studio_bone_palette_gl_tests.cpp
@@ -0,0 +1,333 @@
+// Real production Studio shaders and GPU submission, with a frozen-layout
+// monolithic UBO oracle. Includes the existing layered-target fixture utilities.
+#define main StudioFaceFixtureMainNotRun
+#include "studio_shadow_face_gl_tests.cpp"
+#undef main
+
+namespace
+{
+unsigned paletteUploads{}, paletteReuses{}, paletteFallbacks{}, parameterUploads{};
+std::size_t paletteBytes{}, driverBytes{};
+unsigned allocations{}, subUploads{};
+GLuint g_hStudioUBO{};
+void CountData(GLenum target, GLsizeiptr size, const void* data, GLenum usage)
+{
+    ++allocations;
+    if (data) driverBytes += size;
+    glBufferData(target, size, data, usage);
+}
+void CountSubData(GLenum target, GLintptr offset, GLsizeiptr size, const void* data)
+{
+    ++subUploads; driverBytes += size;
+    if (size == sizeof(studio_ubo_t)) ++parameterUploads;
+    glBufferSubData(target, offset, size, data);
+}
+void CountNamedSubData(GLuint buffer, GLintptr offset, GLsizeiptr size, const void* data)
+{
+    ++subUploads; driverBytes += size;
+    if (size == sizeof(studio_ubo_t)) ++parameterUploads;
+    glNamedBufferSubData(buffer, offset, size, data);
+}
+}
+
+void R_ProfileStudioBonePalette(bool reused, bool fallback, unsigned bytes)
+{
+    if (reused) ++paletteReuses; else ++paletteUploads;
+    if (fallback) ++paletteFallbacks;
+    paletteBytes += bytes;
+}
+
+#pragma push_macro("glBufferData")
+#pragma push_macro("glBufferSubData")
+#pragma push_macro("glNamedBufferSubData")
+#undef glBufferData
+#define glBufferData CountData
+#undef glBufferSubData
+#define glBufferSubData CountSubData
+#include "../src/studio_bone_palette_gl.h"
+#include "../src/draw_parameter_stream.h"
+static CStudioBonePaletteStorage<> g_StudioBonePalettes;
+static CDrawParameterStream g_DrawParameters;
+static cvar_t* r_draw_parameter_stream{}; // Existing palette oracle retains its baseline path.
+// Preserve the actual availability test inside the production helper.
+#undef glNamedBufferSubData
+#define glNamedBufferSubData (__glewNamedBufferSubData ? CountNamedSubData : nullptr)
+#include "studio_palette_upload.inc"
+#pragma pop_macro("glNamedBufferSubData")
+#pragma pop_macro("glBufferSubData")
+#pragma pop_macro("glBufferData")
+
+namespace
+{
+void Replace(std::string& source, const char* oldText, const char* newText)
+{
+    const auto at = source.find(oldText);
+    Check(at != std::string::npos, "legacy oracle ABI boundary exists");
+    source.replace(at, std::strlen(oldText), newText);
+}
+
+GLuint LegacyStage(GLenum type, std::string source, const std::string& defines)
+{
+    auto common = Read("common.h");
+    Replace(common, "\tuvec4 r_clipbone;", "\tmat3x4 bonematrix[128];\n\tuvec4 r_clipbone;");
+    for (auto at = source.find("StudioBonesUBO.bonematrix"); at != std::string::npos;
+         at = source.find("StudioBonesUBO.bonematrix", at + 1))
+        source.replace(at, std::strlen("StudioBonesUBO.bonematrix"), "StudioUBO.bonematrix");
+    const auto at = source.find("#include \"common.h\"");
+    Check(at != std::string::npos, "legacy stage includes common");
+    source.replace(at, std::strlen("#include \"common.h\""), common);
+    source.insert(source.find('\n') + 1, defines +
+        (type == GL_FRAGMENT_SHADER ? "#define IS_FRAGMENT_SHADER\n" :
+         type == GL_GEOMETRY_SHADER ? "#define IS_GEOMETRY_SHADER\n" : "#define IS_VERTEX_SHADER\n"));
+    const GLuint shader = glCreateShader(type); const char* text = source.c_str();
+    glShaderSource(shader, 1, &text, nullptr); glCompileShader(shader);
+    GLint ok{}; glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+    if (!ok) { char log[16384]{}; glGetShaderInfoLog(shader, sizeof(log), nullptr, log); std::fprintf(stderr, "%s\n", log); }
+    Check(ok != 0, "legacy full production stage compiles");
+    return shader;
+}
+
+GLuint LegacyProgram(const std::string& defines)
+{
+    const GLuint program = glCreateProgram();
+    const std::array stages{
+        LegacyStage(GL_VERTEX_SHADER, Read("studio_shader.vert.glsl"), defines),
+        LegacyStage(GL_FRAGMENT_SHADER, Read("studio_shader.frag.glsl"), defines),
+        LegacyStage(GL_GEOMETRY_SHADER, Read("studio_shader.geom.glsl"), defines)};
+    for (auto shader : stages) glAttachShader(program, shader);
+    glLinkProgram(program);
+    GLint ok{}; glGetProgramiv(program, GL_LINK_STATUS, &ok);
+    if (!ok) { char log[16384]{}; glGetProgramInfoLog(program, sizeof(log), nullptr, log); std::fprintf(stderr, "%s\n", log); }
+    Check(ok != 0, "legacy full production stages link");
+    for (auto shader : stages) glDeleteShader(shader);
+    glUseProgram(program);
+    glUniform2f(glGetUniformLocation(program, "r_uvscale"), 1, 1);
+    return program;
+}
+
+GLuint BoundPalette()
+{
+    GLint buffer{}; glGetIntegeri_v(GL_UNIFORM_BUFFER_BINDING, BINDING_POINT_STUDIO_BONES_UBO, &buffer);
+    return static_cast<GLuint>(buffer);
+}
+
+void CheckBuffers(const studio_bone_palette_t& pose, const studio_ubo_t& parameters)
+{
+    studio_bone_palette_t actualPose{};
+    const GLuint palette = BoundPalette();
+    Check(palette != 0, "palette always bound, including hits and fallback");
+    glBindBuffer(GL_UNIFORM_BUFFER, palette);
+    GLint bytes{}; glGetBufferParameteriv(GL_UNIFORM_BUFFER, GL_BUFFER_SIZE, &bytes);
+    Check(bytes == sizeof(actualPose), "GPU palette has exact matrix block size");
+    glGetBufferSubData(GL_UNIFORM_BUFFER, 0, sizeof(actualPose), &actualPose);
+    Check(!std::memcmp(&pose, &actualPose, sizeof(pose)), "all 128 GPU matrices match input bytes");
+    GLint parameter{}; glGetIntegeri_v(GL_UNIFORM_BUFFER_BINDING, BINDING_POINT_STUDIO_UBO, &parameter);
+    Check(static_cast<GLuint>(parameter) == g_hStudioUBO, "draw parameters rebound after foreign pass");
+    glBindBuffer(GL_UNIFORM_BUFFER, parameter);
+    studio_ubo_t actualParameters{};
+    glGetBufferSubData(GL_UNIFORM_BUFFER, 0, sizeof(actualParameters), &actualParameters);
+    Check(!std::memcmp(&parameters, &actualParameters, sizeof(parameters)), "every draw updates all 224 parameter bytes");
+    glBindBuffer(GL_UNIFORM_BUFFER, 0);
+    Check(glGetError() == GL_NO_ERROR, "GPU readback is GL-clean");
+}
+
+void Submit(const studio_bone_palette_t& pose, std::uint32_t frame, bool enabled)
+{
+    R_StudioUploadDrawBuffers(studio, &pose, frame, enabled);
+    GLint generic{}; glGetIntegerv(GL_UNIFORM_BUFFER_BINDING, &generic);
+    Check(generic == 0, "production leaves generic UBO binding clean");
+    CheckBuffers(pose, studio);
+}
+
+studio_bone_palette_t Pose(float angle)
+{
+    studio_bone_palette_t pose{};
+    for (auto& matrix : pose.bonematrix)
+        for (unsigned i = 0; i < 3; ++i) matrix[i][i] = 1;
+    for (int bone : {1, 127})
+    {
+        auto& matrix = pose.bonematrix[bone];
+        matrix[0][0] = matrix[1][1] = std::cos(angle);
+        matrix[0][1] = -std::sin(angle); matrix[1][0] = std::sin(angle);
+        matrix[0][3] = angle * .3f; matrix[2][3] = angle * .1f;
+    }
+    return pose;
+}
+
+void StorageCases(GLuint poison)
+{
+    const auto first = Pose(0), second = Pose(.5f);
+    const auto initialAllocations = allocations;
+    Submit(first, 1, true);
+    Check(allocations == initialAllocations + 1, "one new GPU slot allocated");
+    const GLuint firstBuffer = BoundPalette();
+    const auto bytes = paletteBytes, driver = driverBytes;
+    const auto uploads = paletteUploads, reused = paletteReuses, params = parameterUploads;
+    // A foreign callback may bind another UBO/SSBO at numeric index 4.
+    glBindBufferBase(GL_UNIFORM_BUFFER, BINDING_POINT_STUDIO_BONES_UBO, poison);
+    glBindBufferBase(GL_UNIFORM_BUFFER, BINDING_POINT_STUDIO_UBO, poison);
+    glBindBufferBase(GL_SHADER_STORAGE_BUFFER, BINDING_POINT_MATERIAL_SSBO, poison);
+    studio.r_color[0] = .25f; studio.r_origin[0] = 123; studio.r_clipbone[3] = 0x80000000u;
+    Submit(first, 1, true);
+    GLint ssbo{}; glGetIntegeri_v(GL_SHADER_STORAGE_BUFFER_BINDING, BINDING_POINT_MATERIAL_SSBO, &ssbo);
+    Check(static_cast<GLuint>(ssbo) == poison, "UBO4 does not disturb SSBO4");
+    Check(BoundPalette() == firstBuffer && paletteBytes == bytes && paletteUploads == uploads && paletteReuses == reused + 1,
+        "same-frame hit restores buffer without matrix upload");
+    Check(parameterUploads == params + 1 && driverBytes == driver + sizeof(studio_ubo_t), "hit only uploads small draw parameters");
+    Submit(second, 1, true);
+    Check(BoundPalette() != firstBuffer, "changed pose gets distinct slot");
+    Submit(first, 1, true);
+    Check(BoundPalette() == firstBuffer, "interleaved model/attachment pose remains reusable");
+    Submit(second, 1, false);
+    const auto baselineBytes = paletteBytes;
+    Submit(second, 1, false);
+    Check(paletteBytes == baselineBytes + sizeof(second), "disabled baseline always uploads matrices");
+    Submit(first, 1, true);
+    Check(BoundPalette() == firstBuffer, "disabled fallback never corrupts cached slots");
+    const auto warmAllocations = allocations;
+    const auto warmUploads = paletteUploads;
+    Submit(first, 2, true);
+    Check(BoundPalette() == firstBuffer && allocations == warmAllocations && paletteUploads == warmUploads + 1,
+        "new frame reuses GPU storage but uploads content");
+    auto changing = first;
+    for (unsigned i = 1; i < 256; ++i)
+    {
+        changing.bonematrix[127][2][3] = static_cast<float>(i);
+        Submit(changing, 2, true);
+    }
+    const auto beforeOverflow = paletteFallbacks;
+    changing.bonematrix[127][2][3] = 999;
+    Submit(changing, 2, true);
+    Check(paletteFallbacks == beforeOverflow + 1, "257th unique pose uses bounded fallback");
+    Submit(first, 2, true);
+    Check(BoundPalette() == firstBuffer, "capacity overflow preserves early cache entries");
+    const auto beforeReset = paletteUploads;
+    R_ResetStudioBonePalette();
+    Check(!glIsBuffer(firstBuffer), "map cleanup deletes cached GPU storage");
+    Submit(first, 2, true);
+    Check(paletteUploads == beforeReset + 1, "same frame after map reset uploads again");
+    R_ResetStudioBonePalette();
+    R_ResetStudioBonePalette();
+    Check(glGetError() == GL_NO_ERROR, "repeated lifecycle cleanup is safe");
+}
+
+void LegacyUpload(GLuint buffer, const studio_bone_palette_t& pose)
+{
+    // The original block has 208 bytes of params, then 6144 matrices, then clip mask.
+    std::array<std::byte, 6368> unified{};
+    std::memcpy(unified.data(), &studio, 208);
+    std::memcpy(unified.data() + 208, &pose, sizeof(pose));
+    std::memcpy(unified.data() + 6352, studio.r_clipbone, 16);
+    glBindBuffer(GL_UNIFORM_BUFFER, buffer);
+    glBufferData(GL_UNIFORM_BUFFER, unified.size(), unified.data(), GL_DYNAMIC_DRAW);
+    glBindBufferBase(GL_UNIFORM_BUFFER, BINDING_POINT_STUDIO_UBO, buffer);
+}
+
+void PixelCases(GLuint legacyBuffer)
+{
+    const auto geometry = Read("studio_shader.geom.glsl");
+    for (const std::string material : {std::string{}, std::string{"#define STUDIO_NF_MASKED\n"},
+                                     std::string{"#define CLIP_BONE_ENABLED\n"}, std::string{"#define LINEAR_DEPTH_ENABLED\n"}})
+    {
+        const auto defines = "#define SHADOW_CASTER_ENABLED\n#define MULTIVIEW_ENABLED\n" + material;
+        const auto program = Program(defines, &geometry), legacy = LegacyProgram(defines);
+        GLint size{}, binding{};
+        const auto block = glGetUniformBlockIndex(program, "StudioBonesBlock");
+        Check(block != GL_INVALID_INDEX, "actual production VS consumes separated bone block");
+        glGetActiveUniformBlockiv(program, block, GL_UNIFORM_BLOCK_DATA_SIZE, &size);
+        glGetActiveUniformBlockiv(program, block, GL_UNIFORM_BLOCK_BINDING, &binding);
+        Check(size == 6144 && binding == BINDING_POINT_STUDIO_BONES_UBO, "driver verifies palette std140 size and binding");
+        for (bool cube : {false, true})
+        {
+            Target target(cube); const auto camera = Camera(cube);
+            auto mesh = Triangle({-.7f,-.7f,cube ? -3.f : 0.f},{.7f,-.7f,cube ? -3.f : 0.f},{0,.7f,cube ? -3.f : 0.f});
+            const bool clip = material.find("CLIP_BONE") != std::string::npos;
+            for (auto& vertex : mesh) vertex.bone = (clip ? 1u : 127u) | (1u << 8);
+            for (float angle : {0.f, .45f, 0.f})
+            {
+                const auto pose = Pose(angle);
+                studio.r_scale = angle * .05f;
+                studio.r_clipbone[0] = clip && angle > 0 ? 2u : 0;
+                studio.r_clipbone[3] = 0;
+                LegacyUpload(legacyBuffer, pose);
+                const auto expected = Draw(target, camera, mesh, legacy, 1);
+                Submit(pose, 19, false);
+                const auto disabled = Draw(target, camera, mesh, program, 1);
+                Submit(pose, 19, true);
+                const auto enabled = Draw(target, camera, mesh, program, 1);
+                Submit(pose, 19, true);
+                const auto repeated = Draw(target, camera, mesh, program, 1);
+                Equal(expected.depth, disabled.depth, "split upload equals legacy monolithic UBO pixels");
+                Equal(disabled.depth, enabled.depth, "palette cache on/off pixels equal");
+                Equal(enabled.depth, repeated.depth, "repeated palette pixels equal");
+                if (clip && angle > 0) Check(Written(expected.depth) == 0, "changed per-draw clip mask discards geometry");
+                if (angle == 0 && material.find("LINEAR_DEPTH") == std::string::npos)
+                    Check(Written(expected.depth) > 0, "pixel oracle contains visible geometry");
+            }
+        }
+        glDeleteProgram(program); glDeleteProgram(legacy);
+    }
+    // All full forward/GBuffer variants must also resolve the new VS binding.
+    for (const std::string define : {std::string{}, std::string{"#define GBUFFER_ENABLED\n"},
+             std::string{"#define CLIP_ENABLED\n"}, std::string{"#define CLIP_WATER_ENABLED\n"},
+             std::string{"#define STUDIO_NF_CHROME\n"}, std::string{"#define STUDIO_NF_CELSHADE\n#define STUDIO_NF_CELSHADE_FACE\n"}})
+        glDeleteProgram(Program(define, nullptr));
+}
+
+void RunPalette()
+{
+    glViewport(0, 0, Size, Size); glEnable(GL_DEPTH_TEST); glDepthFunc(GL_LEQUAL);
+    glGenVertexArrays(1, &vao); glBindVertexArray(vao);
+    glGenBuffers(1, &vbo); glBindBuffer(GL_ARRAY_BUFFER, vbo);
+    glEnableVertexAttribArray(STUDIO_VA_POSITION);
+    glVertexAttribPointer(STUDIO_VA_POSITION, 3, GL_FLOAT, GL_FALSE, sizeof(Vertex), reinterpret_cast<void*>(offsetof(Vertex, position)));
+    glEnableVertexAttribArray(STUDIO_VA_TEXCOORD);
+    glVertexAttribPointer(STUDIO_VA_TEXCOORD, 2, GL_FLOAT, GL_FALSE, sizeof(Vertex), reinterpret_cast<void*>(offsetof(Vertex, uv)));
+    glEnableVertexAttribArray(STUDIO_VA_PACKEDBONE);
+    glVertexAttribIPointer(STUDIO_VA_PACKEDBONE, 1, GL_UNSIGNED_INT, sizeof(Vertex), reinterpret_cast<void*>(offsetof(Vertex, bone)));
+    glVertexAttrib3f(STUDIO_VA_NORMAL, 0, 0, 1); glVertexAttrib3f(STUDIO_VA_SMOOTHNORMAL, 0, 0, 1);
+    glVertexAttrib3f(STUDIO_VA_TANGENT, 1, 0, 0); glVertexAttrib3f(STUDIO_VA_BITANGENT, 0, 1, 0);
+    glGenBuffers(1, &cameraBuffer); glBindBufferBase(GL_UNIFORM_BUFFER, BINDING_POINT_CAMERA_UBO, cameraBuffer);
+    glGenBuffers(1, &sceneBuffer); glBindBufferBase(GL_UNIFORM_BUFFER, BINDING_POINT_SCENE_UBO, sceneBuffer);
+    glGenBuffers(1, &g_hStudioUBO); glBindBuffer(GL_UNIFORM_BUFFER, g_hStudioUBO);
+    glBufferData(GL_UNIFORM_BUFFER, sizeof(studio_ubo_t), nullptr, GL_DYNAMIC_DRAW);
+    GLuint poison{}, legacyBuffer{}; glGenBuffers(1, &poison); glGenBuffers(1, &legacyBuffer);
+    glBindBuffer(GL_UNIFORM_BUFFER, poison); glBufferData(GL_UNIFORM_BUFFER, 8192, nullptr, GL_DYNAMIC_DRAW);
+    glGenQueries(1, &query);
+    scene = {}; scene.r_g = scene.v_gamma = scene.v_texgamma = scene.v_lightgamma = 1.f;
+    scene.r_g3 = .125f; Upload(sceneBuffer, scene);
+    studio = {}; studio.r_ambientlight = 1; studio.r_plightvec[2] = 1;
+    for (auto& value : studio.r_color) value = 1;
+    glActiveTexture(GL_TEXTURE0);
+    const auto texture = Texture2D(2, 2, {255,255,255,255, 255,255,255,0, 255,255,255,0, 255,255,255,255});
+    StorageCases(poison);
+    studio.r_clipbone[3] = 0; studio.r_color[0] = 1;
+    PixelCases(legacyBuffer);
+    R_ResetStudioBonePalette();
+    glUseProgram(0);
+    glDeleteBuffers(1, &g_hStudioUBO); glDeleteBuffers(1, &poison); glDeleteBuffers(1, &legacyBuffer);
+    glDeleteBuffers(1, &cameraBuffer); glDeleteBuffers(1, &sceneBuffer); glDeleteBuffers(1, &vbo);
+    glDeleteTextures(1, &texture); glDeleteVertexArrays(1, &vao); glDeleteQueries(1, &query);
+    Check(glGetError() == GL_NO_ERROR, "palette suite cleanup GL-clean");
+}
+}
+
+int main()
+{
+    if (!glfwInit()) return 2;
+    for (int profile : {GLFW_OPENGL_COMPAT_PROFILE, GLFW_OPENGL_CORE_PROFILE})
+    {
+        glfwWindowHint(GLFW_VISIBLE, GLFW_FALSE); glfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 4);
+        glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 3); glfwWindowHint(GLFW_OPENGL_PROFILE, profile);
+        auto* window = glfwCreateWindow(Size, Size, "studio palette regression", nullptr, nullptr);
+        if (!window) { glfwTerminate(); return 2; }
+        glfwMakeContextCurrent(window); glewExperimental = GL_TRUE;
+        if (glewInit() != GLEW_OK) { glfwDestroyWindow(window); glfwTerminate(); return 2; }
+        while (glGetError() != GL_NO_ERROR) {}
+        std::printf("Driver: %s / %s / profile=%d\n", glGetString(GL_RENDERER), glGetString(GL_VERSION), profile);
+        RunPalette(); glfwDestroyWindow(window);
+    }
+    glfwTerminate();
+    std::printf("Studio palette: %u checks, %u pixel comparisons; uploads=%u reuse=%u fallback=%u bytes=%zu. No FPS claim.\n",
+        checks, comparisons, paletteUploads, paletteReuses, paletteFallbacks, paletteBytes);
+}
