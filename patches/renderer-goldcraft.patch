+                    assert(state & WSURF_LIGHTMAP_ENABLED);
+            }
+        };
+        stateCheck();
+        usedStates.clear();
+        gbuffer          = true;
+        fullbright.value = 1;
+        R_DrawWorldSurfaceLeafStatic(candidate.get(), leaf.get());
+        R_DrawWorldSurfaceLeafAnim(candidate.get(), leaf.get());
+        stateCheck();
+        gbuffer          = false;
+        fullbright.value = 0;
+        usedStates.clear();
+        recordStates = false;
+        uploads = bufferBinds = vaoBinds = 0;
+        countedAllocations               = 0;
+        countAllocations                 = true;
