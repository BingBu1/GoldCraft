+void Poison(int style)
+{
+    glUseProgram(unrelatedProgram);
+    for (int unit = 0; unit < 9; ++unit)
+    {
+        glActiveTexture(GL_TEXTURE0 + unit);
+        glBindTexture(GL_TEXTURE_2D, poisonTextures[unit]);
+    }
+    // The old path assumes unit zero but does not force it. Compare both the
+    // ordinary entry and an external renderer leaving a different active unit.
+    glActiveTexture(style == 2 ? GL_TEXTURE3 : GL_TEXTURE0);
+    *currenttexture = 54321;
+    glDepthMask(GL_FALSE);
+    if (style == 1) glDisable(GL_DEPTH_TEST); else glEnable(GL_DEPTH_TEST);
+    glDepthFunc(style == 1 ? GL_GREATER : GL_LESS);
+    glEnable(GL_CULL_FACE);
+    glCullFace(GL_BACK);
+    glFrontFace(GL_CW);
+    glEnable(GL_BLEND);
+    glBlendFuncSeparate(GL_DST_COLOR, GL_ONE_MINUS_DST_COLOR, GL_ZERO, GL_ONE);
+    glEnable(GL_STENCIL_TEST);
+    glStencilFuncSeparate(GL_FRONT, GL_NEVER, 31, 0x3f);
+    glStencilFuncSeparate(GL_BACK, GL_LESS, 79, 0xa5);
+    glStencilMaskSeparate(GL_FRONT, 0x18);
+    glStencilMaskSeparate(GL_BACK, 0x60);
+    glStencilOpSeparate(GL_FRONT, GL_INCR, GL_DECR, GL_INVERT);
