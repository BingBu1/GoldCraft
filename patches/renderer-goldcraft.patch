+        failCreate                               = true;
+        Reject([&] { R_PrepareWorldSurfaceLeafModel(carved, &scene.model, 0); });
+        failCreate = false;
+        failQueue  = true;
+        Reject([&] { R_PrepareWorldSurfaceLeafModel(carved, &scene.model, 0); });
+        failQueue = false;
+        assert(liveWork == 0);
+
+        Scene      empty(0);
+        const auto emptyModel = R_PrepareWorldSurfaceLeafModel(empty.geometry, &empty.model, 1);
+        Finish(emptyModel);
+        const auto emptyLeaf = emptyModel->GetLeafByIndex(1);
+        assert(emptyLeaf->m_bIsReady && !emptyLeaf->hABO && R_CompatibleWorldLeaf(emptyLeaf, emptyModel) == emptyLeaf);
+
+        const carving::Box  fullFace{{-8, -8, -8}, {136, 136, 8}};
+        const cavity::Model fullFaceModel{0, 4, {planes, nodes, 0}, {&fullFace, 1}};
