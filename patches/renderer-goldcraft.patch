+// Driver-backed readback of the production candidate resource and VAO layout.
+// No CS process or desktop input is used; the GLFW window remains hidden.
+#include "../src/gl_local.h"
+#include <GLFW/glfw3.h>
+#include <array>
+#include <cassert>
+#include <cmath>
+#include <chrono>
+#include <cstdio>
+#include <stdexcept>
+
+int g_iEngineType = ENGINE_GOLDSRC;
+
+namespace
+{
+constexpr int Size = 64;
+using Pixels       = std::vector<float>;
+static PFNGLBUFFERSTORAGEPROC real_storage;
+static PFNGLBUFFERDATAPROC real_data;
+static PFNGLBUFFERSUBDATAPROC real_sub_data;
+static GLuint                 failed_buffer;
+static int                    failure_after;
+static std::vector<GLuint>     attempted_buffers;
+static std::size_t             uploads, submissions;
+static PFNGLMULTIDRAWELEMENTSINDIRECTPROC real_multi_draw;
+void APIENTRY MultiDraw(GLenum mode, GLenum type, const void* indirect, GLsizei count, GLsizei stride)
+{
+    ++submissions;
+    real_multi_draw(mode, type, indirect, count, stride);
+}
+void APIENTRY Data(GLenum target, GLsizeiptr bytes, const void* data, GLenum usage)
+{
+    ++uploads; real_data(target, bytes, data, usage);
+}
+void APIENTRY SubData(GLenum target, GLintptr offset, GLsizeiptr bytes, const void* data)
+{
+    ++uploads; real_sub_data(target, offset, bytes, data);
+}
+void APIENTRY                 Storage(GLenum target, GLsizeiptr size, const void* data, GLbitfield flags)
+{
+    ++uploads;
+    if (failure_after)
+    {
+        GLint bound{};
+        glGetIntegerv(target == GL_ARRAY_BUFFER ? GL_ARRAY_BUFFER_BINDING :
+            (target == GL_DRAW_INDIRECT_BUFFER ? GL_DRAW_INDIRECT_BUFFER_BINDING : GL_ELEMENT_ARRAY_BUFFER_BINDING), &bound);
+        attempted_buffers.push_back(bound);
+        if (--failure_after == 0)
+        {
+            failed_buffer = bound;
+            size = -1; // Ask the real driver to reject preparation after all five allocations.
+        }
+    }
+    real_storage(target, size, data, flags);
+}
+GLuint Compile(GLenum type, const char* text)
+{
+    auto shader = glCreateShader(type);
+    glShaderSource(shader, 1, &text, nullptr);
+    glCompileShader(shader);
+    GLint ok{};
+    glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+    if (!ok)
+    {
+        char log[2048]{};
+        glGetShaderInfoLog(shader, sizeof(log), nullptr, log);
+        std::fprintf(stderr, "%s\n", log);
+    }
+    assert(ok);
+    return shader;
+}
+GLuint Program()
+{
+    const auto vs      = Compile(GL_VERTEX_SHADER, R"(#version 440
+layout(location=0) in vec3 pos;
+layout(location=2) in vec2 uv;
+layout(location=3) in vec2 lm;
+layout(location=6) in vec3 smoothnormal;
+layout(location=7) in uint material_bits;
+layout(location=8) in uvec4 styles;
+layout(location=9) in float scale;
+out vec2 diffuse_uv; out vec2 lightmap_uv; out vec3 sn;
+flat out uvec4 instance; flat out float diffuse_scale;
+void main() {
+    gl_Position=vec4(pos.xy / 64.0 - 1.0, -pos.z / 64.0, 1.0);
+    diffuse_uv=uv; lightmap_uv=lm; sn=smoothnormal;
+    instance=uvec4(material_bits & 65535u, material_bits >> 16, styles.y, styles.z);
+    diffuse_scale=scale;
+})");
+    const auto fs      = Compile(GL_FRAGMENT_SHADER, R"(#version 440
+in vec2 diffuse_uv; in vec2 lightmap_uv; in vec3 sn;
+flat in uvec4 instance; flat in float diffuse_scale;
+layout(location=0) out vec4 diffuse;
+layout(location=1) out vec4 lightmap;
+layout(location=2) out vec4 frame;
+layout(location=3) out vec4 material;
+void main() {
+    diffuse=vec4(diffuse_uv,0,1); lightmap=vec4(lightmap_uv,0,1);
+    frame=vec4(sn,diffuse_scale); material=vec4(instance);
+})");
+    auto       program = glCreateProgram();
+    glAttachShader(program, vs);
+    glAttachShader(program, fs);
+    glLinkProgram(program);
+    GLint ok{};
+    glGetProgramiv(program, GL_LINK_STATUS, &ok);
+    assert(ok);
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+    return program;
+}
+std::shared_ptr<CWorldSurfaceWorldModel> Original(model_t* mod)
+{
+    auto mesh = std::make_shared<goldcraft::surface::Mesh>();
+    for (const auto xy : {std::array<float, 2>{0, 0}, {128, 0}, {128, 128}, {0, 128}})
+    {
+        const float x = xy[0], y = xy[1];
+        mesh->vertices.push_back({{x, y, 0}, {x * .25f + 3, y * .5f - 7}, {x / 2048 + .0625f, y / 2048 + .125f}});
+        mesh->frames.push_back({{0, 0, 1}, {1, 0, 0}, {0, 1, 0}, {x / 256, y / 512, 1}});
+    }
+    mesh->instances.push_back({{60001, 513}, {3, 15, 200, 255}, .015625f});
+    mesh->instances.push_back({{60002, 514}, {4, 16, 201, 254}, .03125f});
+    mesh->indices             = {0, 1, 2, 0, 2, 3};
+    mesh->faces               = {{{0, 6}, {}, {1, 1}, 1, true}};
+    auto original             = std::make_shared<CWorldSurfaceWorldModel>(mod);
+    original->m_pOriginalMesh = mesh;
+    original->m_pSurfaceMesh  = mesh;
+    CWorldSurfaceBrushFace face{};
+    face.index_count    = 6;
+    face.instance_index = 1;
+    face.instance_count = 1;
+    face.poly_count     = 1;
+    original->m_vFaceBuffer.push_back(face);
+    R_UploadWorldSurfaceGeometry(*original);
+    return original;
+}
+std::array<Pixels, 4> Readback()
+{
+    std::array<Pixels, 4> pixels{};
+    for (int i = 0; i < 4; ++i)
+    {
+        pixels[i].resize(Size * Size * 4);
+        glReadBuffer(GL_COLOR_ATTACHMENT0 + i);
+        glReadPixels(0, 0, Size, Size, GL_RGBA, GL_FLOAT, pixels[i].data());
+    }
+    assert(glGetError() == GL_NO_ERROR);
+    return pixels;
+}
+std::array<Pixels, 4> Draw(const CWorldSurfaceWorldModel& model, bool cavities = false)
+{
+    const float empty[4]{};
+    for (int i = 0; i < 4; ++i) glClearBufferfv(GL_COLOR, i, empty);
+    const float depth = 1;
+    glClearBufferfv(GL_DEPTH, 0, &depth);
+    glBindVertexArray(model.hVAO);
+    for (const auto& face : model.m_vFaceBuffer)
+        glDrawElementsInstancedBaseInstance(GL_TRIANGLES, face.index_count, GL_UNSIGNED_INT,
+            reinterpret_cast<void*>(std::size_t(face.start_index) * 4), face.instance_count, face.instance_index);
+    if (cavities)
+        R_DrawCavityGeometry(model, 0, static_cast<uint32_t>(model.m_vCavityDraws.size()));
+    return Readback();
+}
+float Depth(int x, int y)
+{
+    float value{};
+    glReadPixels(x, y, 1, 1, GL_DEPTH_COMPONENT, GL_FLOAT, &value);
+    return value;
+}
+void Bindings(GLuint vao, GLuint array, GLuint element, GLuint indirect)
+{
+    GLint current{};
+    glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &current);
+    assert(GLuint(current) == vao);
+    glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &current);
+    assert(GLuint(current) == array);
+    glGetIntegerv(GL_ELEMENT_ARRAY_BUFFER_BINDING, &current);
+    assert(GLuint(current) == element);
+    glGetIntegerv(GL_DRAW_INDIRECT_BUFFER_BINDING, &current);
+    assert(GLuint(current) == indirect);
+}
+void Attributes(const CWorldSurfaceWorldModel& model)
+{
+    const GLint       strides[]    = {28, 48, 28, 28, 48, 48, 48, 12, 12, 12};
+    const GLint       components[] = {3, 3, 2, 2, 3, 3, 3, 1, 4, 1};
+    const std::size_t offsets[]    = {0, 0, 12, 20, 12, 24, 36, 0, 4, 8};
+    glBindVertexArray(model.hVAO);
+    for (GLuint i = 0; i < 10; ++i)
+    {
+        GLint value{};
+        glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_ENABLED, &value);
+        assert(value);
+        glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_STRIDE, &value);
+        assert(value == strides[i]);
+        glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_SIZE, &value);
+        assert(value == components[i]);
+        glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_DIVISOR, &value);
+        assert(value == (i >= 7));
+        glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_INTEGER, &value);
+        assert(bool(value) == (i == 7 || i == 8));
+        glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_BUFFER_BINDING, &value);
+        const int buffer = i >= 7 ? WSURF_VBO_INSTANCE :
+                                    (i == 0 || i == 2 || i == 3 ? WSURF_VBO_VERTEX : WSURF_VBO_VERTEXTBN);
+        assert(GLuint(value) == model.hVBO[buffer]);
+        void* pointer{};
+        glGetVertexAttribPointerv(i, GL_VERTEX_ATTRIB_ARRAY_POINTER, &pointer);
+        assert(reinterpret_cast<std::size_t>(pointer) == offsets[i]);
+    }
+    assert(glGetError() == GL_NO_ERROR);
+}
+void VisibilityCommands(const std::shared_ptr<CWorldSurfaceWorldModel>& original)
+{
+    using namespace goldcraft;
+    auto mesh = std::make_shared<surface::Mesh>();
+    mesh->instances = original->m_pOriginalMesh->instances;
+    for (uint32_t side = 0; side < 2; ++side)
+    {
+        for (auto vertex : original->m_pOriginalMesh->vertices)
+        {
+            vertex.pos[0] = vertex.pos[0] * .5f + side * 64;
+            mesh->vertices.push_back(vertex);
+        }
+        for (auto frame : original->m_pOriginalMesh->frames) mesh->frames.push_back(frame);
+        for (auto index : original->m_pOriginalMesh->indices) mesh->indices.push_back(index + side * 4);
+        mesh->faces.push_back({{side * 6, 6}, {}, {side, 1}, 1, true});
+    }
