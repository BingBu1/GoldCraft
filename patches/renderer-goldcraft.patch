+            glGetIntegeri_v(GL_SHADER_STORAGE_BUFFER_BINDING, BINDING_POINT_MATERIAL_SSBO, &materialBinding);
+            glGetIntegerv(GL_TEXTURE_BINDING_2D, &texture);
+            glGetUniformfv(shader, colorLocation, color);
+        }
+        ~RestoreFixtureState()
+        {
+            worldModel = world; currentEntity = current; entity = savedEntity; viewLeaf = leaf;
+            r_draw_classify = classify; shadow = shadowView; holdWork = held;
+            g_WorldSurfaceRenderer.bLightmapTexture = lightmap;
+            g_WorldSurfaceRenderer.hEntityUBO = entityBuffer;
+            g_WorldSurfaceRenderer.pCurrentWorldLeaf = previous;
+            glBindVertexArray(vao);
+            glBindBuffer(GL_ARRAY_BUFFER, array);
+            glBindBuffer(GL_DRAW_INDIRECT_BUFFER, indirect);
+            glBindBufferBase(GL_UNIFORM_BUFFER, BINDING_POINT_ENTITY_UBO, entityBinding);
+            glBindBufferBase(GL_SHADER_STORAGE_BUFFER, BINDING_POINT_MATERIAL_SSBO, materialBinding);
+            glBindBuffer(GL_UNIFORM_BUFFER, uniform);
+            glBindBuffer(GL_SHADER_STORAGE_BUFFER, storage);
+            glBindTexture(GL_TEXTURE_2D, texture);
+            glUseProgram(shader); glUniform3fv(colorLocation, 1, color); glUseProgram(program);
+            assert(glGetError() == GL_NO_ERROR);
+        }
+    } restoreFixtureState;
+    Scene scene(1);
+    worldModel = &scene.model;
+    const auto model = R_PrepareWorldSurfaceLeafModel(scene.geometry, &scene.model, 0);
+    Finish(model);
+    const auto noVis = model->GetLeafByIndex(0);
+    GLuint ubo{};
+    glGenBuffers(1, &ubo);
+    glBindBuffer(GL_UNIFORM_BUFFER, ubo);
+    glBufferData(GL_UNIFORM_BUFFER, sizeof(entity_ubo_t), nullptr, GL_DYNAMIC_DRAW);
+    g_WorldSurfaceRenderer.hEntityUBO = ubo;
+    g_WorldSurfaceRenderer.bLightmapTexture = false;
+    g_WorldSurfaceRenderer.pCurrentWorldLeaf.reset();
+    currentEntity = &entity;
+    entity.model = &scene.model;
+    entity.curstate.rendermode = kRenderNormal;
+    viewLeaf = &scene.leaves[1];
+    r_draw_classify = DRAW_CLASSIFY_WORLD;
+    shadow = true;
+    const auto draw = [&](const std::shared_ptr<CWorldSurfaceModel>& value) {
+        staticWorldComplete = false;
+        staticWorldCompletionCalls = 0;
+        R_DrawWorldSurfaceModel(value, &entity);
+        assert(glGetError() == GL_NO_ERROR);
+    };
+    holdWork = true;
+    ResetEvent(entered);
+    ResetEvent(resume);
+    draw(model); // Requested PVS leaf is pending, explicit no-vis fallback is complete.
+    assert(WaitForSingleObject(entered, 10'000) == WAIT_OBJECT_0);
+    assert(!model->GetLeafByIndex(1)->m_bIsReady);
+    assert(staticWorldCompletionCalls == 1 && staticWorldComplete);
+    g_WorldSurfaceRenderer.pCurrentWorldLeaf = noVis;
+    draw(model); // The generic previous-leaf fallback is conservatively unverified.
+    assert(staticWorldCompletionCalls == 1 && !staticWorldComplete);
+    g_WorldSurfaceRenderer.pCurrentWorldLeaf.reset();
