+        holdGeometry = true;
+        ResetEvent(entered);
+        ResetEvent(resume);
+        ResetEvent(draining);
+        model_t brush   = scene.model;
+        auto    retired = R_PrepareWorldSurfaceLeafModel(carved, &brush, 0);
+        assert(WaitForSingleObject(entered, 10'000) == WAIT_OBJECT_0);
+        const std::weak_ptr<CWorldSurfaceLeaf> retiredLeaf   = retired->GetLeafByIndex(0);
+        const auto                             beforeUploads = uploads;
+        retired->RetireLeaves();
+        retired.reset();
+        assert(WaitForSingleObject(resume, 0) == WAIT_TIMEOUT && !retiredLeaf.expired());
+        std::thread release([] {
+            assert(WaitForSingleObject(draining, 10'000) == WAIT_OBJECT_0);
+            std::this_thread::sleep_for(std::chrono::milliseconds(30));
