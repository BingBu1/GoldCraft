diff --git a/src/world_visibility_access.cpp b/src/world_visibility_access.cpp
new file mode 100644
index 0000000..21ab60e
--- /dev/null
+++ b/src/world_visibility_access.cpp
@@ -0,0 +1,145 @@
+#include "gl_local.h"
+#include <algorithm>
+#include <bit>
+#include <limits>
+#include <stdexcept>
+
+void CM_DecompressPVS(byte* in, byte* decompressed, int byteCount)
+{
+    if (byteCount <= 0) return;
+    int   c;
+    byte* out;
+
+    out = decompressed;
+
+    do
+    {
+        if (*in)
+        {
+            *out++ = *in++;
+            continue;
+        }
+
+        c = in[1];
+        in += 2;
+        if (!c) throw std::invalid_argument("Invalid zero-length world PVS run");
+        // Match ReHLDS: padded terminal zero runs may exceed the row width.
+        c = (std::min)(c, int(decompressed + byteCount - out));
+        while (c)
+        {
+            *out++ = 0;
+            c--;
+        }
+    } while (out < decompressed + byteCount);
+}
+
+void Mod_DecompressVis(byte* in, model_t* model, byte* decompressed)
+{
+    int row = (model->numleafs + 7) >> 3;
+
+    CM_DecompressPVS(in, decompressed, row);
+}
+
+void Mod_LeafPVS(mleaf_t* leaf, model_t* model, byte* decompressed)
+{
+    if (!leaf || leaf == model->leafs || !leaf->compressed_vis)
+    {
+        memcpy(decompressed, mod_novis, MAX_MAP_LEAFS_SVENGINE / 8);
+        return;
+    }
+
+    Mod_DecompressVis(leaf->compressed_vis, model, decompressed);
+}
+
+void Mod_Init(void)
+{
+    memset(mod_novis, 0xff, sizeof(mod_novis));
+}
+
+namespace
+{
+template <class T> int ArrayIndex(const T* base, int count, const void* pointer)
+{
+    if (!base || !pointer || count < 0) return -1;
+    const auto first = reinterpret_cast<uintptr_t>(base), value = reinterpret_cast<uintptr_t>(pointer);
+    if (value < first || (value - first) % sizeof(T)) return -1;
+    const auto index = (value - first) / sizeof(T);
+    return index < static_cast<uintptr_t>(count) ? static_cast<int>(index) : -1;
+}
+} // namespace
+
+std::shared_ptr<const goldcraft::visibility::Source> R_CaptureWorldVisibility(model_t* world)
+{
+    using namespace goldcraft;
+    constexpr visibility::Limits limits;
+    if (!world || !world->nodes || !world->planes || !world->leafs ||
+        world->numleafs < 1 || world->numleafs > MAX_MAP_LEAFS_SVENGINE ||
+        world->numnodes < 1 || world->numnodes > 1'048'576 ||
+        world->numplanes < 1 || world->numplanes > 1'048'576)
+        throw std::invalid_argument("Invalid loaded world visibility source");
+    const auto leaves = static_cast<std::size_t>(world->numleafs), words = (leaves + 63) / 64;
+    if (leaves > limits.words / words) throw std::length_error("Loaded world PVS capacity");
+    auto result = std::make_shared<visibility::Source>();
+    result->planes.reserve(world->numplanes);
+    for (int i = 0; i < world->numplanes; ++i)
+    {
+        const auto& plane = world->planes[i];
+        result->planes.push_back({{plane.normal[0], plane.normal[1], plane.normal[2]}, plane.dist});
+    }
+    result->contents.reserve(leaves + 1);
+    result->pvs.resize(leaves * words);
+    std::array<byte, MAX_MAP_LEAFS_SVENGINE / 8> pvs{};
+    static_assert(std::endian::native == std::endian::little);
+    for (std::size_t i = 0; i <= leaves; ++i)
+    {
+        result->contents.push_back(world->leafs[i].contents);
+        if (i)
+        {
+            // The engine has already loaded/validated the BSP. Use the same
+            // public model/leaf layout and PVS decoder as normal Renderer.
+            Mod_LeafPVS(world->leafs + i, world, pvs.data());
+            std::memcpy(result->pvs.data() + (i - 1) * words, pvs.data(), (leaves + 7) / 8);
+        }
+    }
+    std::vector<int>  mapping(world->numnodes, -1);
+    std::vector<byte> visiting(world->numnodes);
+    const auto        copy = [&](auto&& self, int index, int depth) -> int {
+        if (depth > 256 || visiting[index]) throw std::invalid_argument("Loaded world BSP depth/cycle");
+        if (mapping[index] >= 0) return mapping[index];
+        visiting[index]   = 1;
+        const auto& node  = world->nodes[index];
+        const auto  plane = ArrayIndex(world->planes, world->numplanes, node.plane);
+        if (plane < 0) throw std::invalid_argument("Loaded world BSP plane pointer");
+        const auto mapped = static_cast<int>(result->nodes.size());
+        mapping[index]    = mapped;
+        result->nodes.push_back({static_cast<uint32_t>(plane), {}});
+        for (int side = 0; side < 2; ++side)
+        {
+            const auto leaf = ArrayIndex(world->leafs, world->numleafs + 1, node.children[side]);
+            if (leaf >= 0) result->nodes[mapped].children[side] = -1 - leaf;
+            else
+            {
+                const auto child = ArrayIndex(world->nodes, world->numnodes, node.children[side]);
+                if (child < 0) throw std::invalid_argument("Loaded world BSP child pointer");
+                const auto target                    = self(self, child, depth + 1);
+                result->nodes[mapped].children[side] = target;
+            }
+        }
+        visiting[index] = 0;
+        return mapped;
+    };
+    // Exactly the root used by R_RecursiveMarkSurfaces, not brush submodels
+    // sharing the same allocation with nonworld leaves beyond numleafs.
+    result->root = copy(copy, 0, 1);
+    return result;
+}
+
+void R_PrepareCarvedWorldVisibility(CWorldSurfaceWorldModel&                 candidate,
+                                    std::span<const goldcraft::carving::Box> worldCuts)
+{
+    if (candidate.m_pCarvedVisibility) throw std::invalid_argument("World visibility already prepared");
+    auto source                   = candidate.m_pVisibilitySource ? candidate.m_pVisibilitySource : R_CaptureWorldVisibility(candidate.m_model);
+    auto visibility               = std::make_shared<goldcraft::visibility::Prepared>(source, worldCuts);
+    candidate.m_pVisibilitySource = std::move(source);
+    candidate.m_pCarvedVisibility = std::move(visibility);
+}
diff --git a/src/world_leaf_cache.cpp b/src/world_leaf_cache.cpp
new file mode 100644
index 0000000..478a984
--- /dev/null
+++ b/src/world_leaf_cache.cpp
@@ -0,0 +1,120 @@
+#include "gl_local.h"
+#include <stdexcept>
+
+CWorldSurfaceLeaf::~CWorldSurfaceLeaf()
+{
+    if (hABO)
+    {
+        GL_DeleteBuffer(hABO);
+        hABO = 0;
+    }
+
+    m_vWaterSurfaceModels.clear();
+}
+
+namespace
+{
+// Only the game thread edits this registry. Strong ownership keeps even a
+// retired leaf's GL resources on this thread; workers publish a completion bit
+// and never allocate a game-thread callback or release the final GL owner.
+std::vector<std::shared_ptr<CWorldSurfaceLeaf>> s_WorldLeafTasks;
+constexpr auto                                  NoTaskSlot = static_cast<std::size_t>(-1);
+void                                            RemoveTaskSlot(std::size_t slot)
+{
+    if (slot + 1 != s_WorldLeafTasks.size())
+    {
+        s_WorldLeafTasks[slot]              = std::move(s_WorldLeafTasks.back());
+        s_WorldLeafTasks[slot]->m_iTaskSlot = slot;
+    }
+    s_WorldLeafTasks.pop_back();
+}
+} // namespace
+void R_TrackWorldLeafTask(const std::shared_ptr<CWorldSurfaceLeaf>& leaf)
+{
+    if (!leaf || !leaf->m_pGameResourceAsyncLoadTask || leaf->m_iTaskSlot != NoTaskSlot)
+        throw std::invalid_argument("Invalid world leaf task registration");
+    s_WorldLeafTasks.emplace_back(leaf);
+    leaf->m_iTaskSlot = s_WorldLeafTasks.size() - 1;
+}
+void CWorldSurfaceLeaf::ReleaseAsyncLoadTask()
+{
+    if (m_pGameResourceAsyncLoadTask)
+    {
+        if (m_pGameResourceAsyncLoadTask->m_hThreadWorkItem)
+        {
+            g_pMetaHookAPI->WaitForWorkItemToComplete(m_pGameResourceAsyncLoadTask->m_hThreadWorkItem);
+            g_pMetaHookAPI->DeleteWorkItem(m_pGameResourceAsyncLoadTask->m_hThreadWorkItem);
+            m_pGameResourceAsyncLoadTask->m_hThreadWorkItem = nullptr;
+        }
+        m_pGameResourceAsyncLoadTask.reset();
+    }
+    if (m_iTaskSlot != NoTaskSlot)
+    {
+        RemoveTaskSlot(m_iTaskSlot);
+        m_iTaskSlot = NoTaskSlot;
+    }
+}
+void R_PumpWorldLeafTasks()
+{
+    for (std::size_t i = 0; i < s_WorldLeafTasks.size();)
+    {
+        if (!s_WorldLeafTasks[i]->m_bTaskFinished.load(std::memory_order_acquire))
+        {
+            ++i;
+            continue;
+        }
+        const auto leaf = s_WorldLeafTasks[i];
+        if (!leaf->m_bIsClosing.load())
+        {
+            try
+            {
+                if (leaf->m_LoadError) std::rethrow_exception(leaf->m_LoadError);
+                if (leaf->m_pGameResourceAsyncLoadTask->m_IsDataReady.load()) leaf->AsyncUploadResouce();
+            }
+            catch (...)
+            {
+                leaf->m_LoadError = std::current_exception();
+                leaf->m_bIsReady  = false;
+                if (leaf->hABO) GL_DeleteBuffer(leaf->hABO);
+                leaf->hABO = 0;
+                leaf->m_vWaterSurfaceModels.clear();
+                if (gEngfuncs.Con_Printf) gEngfuncs.Con_Printf("Renderer: world leaf %u preparation failed; candidate remains unready.\n", leaf->m_uViewKey);
+            }
+        }
+        // The completion bit is set only after the worker's BSP reads end.
+        // The host wait just closes its callback lifetime before deletion.
+        leaf->ReleaseAsyncLoadTask();
+    }
+}
+void R_DrainWorldLeafTasks(model_t* model)
+{
+    // Cancel all affected work before waiting. Map unload must not free raw
+    // BSP nodes/surfaces/textures while any retired worker still reads them.
+    for (const auto& leaf : s_WorldLeafTasks)
+        if (!model || leaf->m_pBspModel == model || leaf->m_pWorldModel->m_model == model)
+            leaf->m_bIsClosing.store(true);
+    for (std::size_t i = 0; i < s_WorldLeafTasks.size();)
+    {
+        const auto leaf = s_WorldLeafTasks[i];
+        if (!model || leaf->m_pBspModel == model || leaf->m_pWorldModel->m_model == model) leaf->ReleaseAsyncLoadTask();
+        else
+            ++i;
+    }
+}
+std::shared_ptr<CWorldSurfaceLeaf> R_CompatibleWorldLeaf(
+    const std::weak_ptr<CWorldSurfaceLeaf>&    previous,
+    const std::shared_ptr<CWorldSurfaceModel>& model)
+{
+    const auto leaf = previous.lock();
+    if (!leaf || !model || !leaf->m_bIsReady || leaf->m_bIsClosing.load() ||
+        leaf->m_pModel.lock() != model || leaf->m_pWorldModel != model->m_pWorldModel.lock()) return {};
+    return leaf;
+}
+uint32_t R_WorldSurfaceViewKey(const CWorldSurfaceModel& model, mleaf_t* leaf, const float* origin)
+{
+    const auto key   = leaf ? static_cast<uint32_t>(R_GetWorldLeafIndex(model.m_model, leaf)) : 0u;
+    const auto world = model.m_pWorldModel.lock();
+    return world && world->m_pCarvedVisibility ?
+        world->m_pCarvedVisibility->key(key, {origin[0], origin[1], origin[2]}) :
+        key;
+}
diff --git a/src/world_leaf_build.cpp b/src/world_leaf_build.cpp
new file mode 100644
index 0000000..f9bc842
--- /dev/null
+++ b/src/world_leaf_build.cpp
@@ -0,0 +1,816 @@
+#include "gl_local.h"
+#include <algorithm>
+#include <limits>
+#include <optional>
+#include <set>
+#include <stdexcept>
+#include <tuple>
+
+void R_PrepareWorldLeafData(CWorldSurfaceWorldModel& world)
+{
+    if (world.m_pLeafData) return;
+    const auto* bsp = world.m_model;
+    if (!bsp || bsp->numtextures < 0 || bsp->numtextures > 1'048'576 || (bsp->numtextures && !bsp->textures))
+        throw std::invalid_argument("Invalid world texture table");
+    auto data            = std::make_shared<CWorldSurfaceLeafData>();
+    data->missingTexture = R_GetEmptyWorldTexture();
+    std::vector<texture_t*> pending;
+    pending.reserve(bsp->numtextures + 1);
+    pending.push_back(data->missingTexture);
+    for (int i = 0; i < bsp->numtextures; ++i) pending.push_back(bsp->textures[i]);
+    bool random = false;
+    while (!pending.empty())
+    {
+        auto* texture = pending.back();
+        pending.pop_back();
+        if (!texture || data->materials.contains(texture)) continue;
+        if (data->materials.size() >= 1'048'576) throw std::length_error("World texture animation capacity");
+        data->materials.emplace(texture, R_GetRenderMaterialForWorldTexture(texture));
+        random |= texture->name[0] == '-' && texture->anim_total > 0;
+        if (texture->anim_next) pending.push_back(texture->anim_next);
+        if (texture->alternate_anims) pending.push_back(texture->alternate_anims);
+    }
+    if (random)
+    {
+        if (!rtable || !gEngfuncs.pfnRandomLong) throw std::invalid_argument("Missing world random texture table");
+        if ((*rtable)[0][0] == 0)
+            for (int x = 0; x < 20; ++x)
+                for (int y = 0; y < 20; ++y)
+                    (*rtable)[x][y] = gEngfuncs.pfnRandomLong(0, 0x7FFF);
+        for (int x = 0; x < 20; ++x)
+            for (int y = 0; y < 20; ++y)
+                data->randomTextures[x][y] = (*rtable)[x][y];
+    }
+    world.m_pLeafData = std::move(data);
+}
+
+namespace
+{
+std::shared_ptr<CWorldSurfaceRenderMaterial> LeafMaterial(const CWorldSurfaceWorldModel& world, texture_t* texture)
+{
+    const auto& materials = world.m_pLeafData->materials;
+    const auto  found     = materials.find(texture);
+    return found == materials.end() ? nullptr : found->second;
+}
+int RandomTextureFrame(const CWorldSurfaceWorldModel& world, const msurface_t& surface, const texture_t& texture)
+{
+    if (!texture.width || !texture.height || texture.anim_total <= 0 || texture.anim_total > 100)
+        throw std::invalid_argument("Invalid random world texture");
+    // Preserve GoldSrc's shifted tiling without overflowing a 32-bit width.
+    const auto x     = (std::int64_t(surface.texturemins[0]) + (std::int64_t(texture.width) << 16)) / texture.width % 20;
+    const auto y     = (std::int64_t(surface.texturemins[1]) + (std::int64_t(texture.height) << 16)) / texture.height % 20;
+    const int  value = world.m_pLeafData->randomTextures[x][y];
+    if (value < 0) throw std::invalid_argument("Invalid random world texture entry");
+    return value % texture.anim_total;
+}
+} // namespace
+
+using visnodes_t    = std::set<mbasenode_t*>;
+using vissurfaces_t = std::set<msurface_t*>;
+using texsurfaces_t = std::vector<msurface_t*>;
+
+void R_MarkPVSForLeaf(model_t* worldmodel, mleaf_t* leaf, visnodes_t& visnodes, const goldcraft::visibility::View* edited = nullptr)
+{
+    //Decompress vis bytes from world model.
+
+    byte vis[MAX_MAP_LEAFS_SVENGINE / 8];
+
+    if (!edited) Mod_LeafPVS(leaf, worldmodel, vis);
+
+    //Mark node as visnode, from leaf to root
+    for (int i = 0; i < worldmodel->numleafs; i++)
+    {
+        if (edited ? edited->sees_leaf(static_cast<uint32_t>(i + 1)) : ((byte)(1 << (i & 7)) & vis[i >> 3]))
+        {
+            auto basenode = (mbasenode_t*)&worldmodel->leafs[i + 1];
+
+            do
+            {
+                // Ancestors already reached from another visible leaf need
+                // neither another tree lookup nor another allocation.
+                if (!visnodes.emplace(basenode).second) break;
+
+                basenode = basenode->parent;
+
+            } while (basenode);
+        }
+    }
+}
+
+void R_RecursiveMarkSurfaces(mbasenode_t* basenode, const visnodes_t& visnodes, vissurfaces_t& vissurfaces)
+{
+    if (basenode->contents == CONTENTS_SOLID)
+        return;
+
+    if (visnodes.find(basenode) == visnodes.end())
+        return;
+
+    if (basenode->contents < 0)
+    {
+        auto leaf = (mleaf_t*)basenode;
+
+        auto marks    = leaf->firstmarksurface;
+        auto nummarks = leaf->nummarksurfaces;
+
+        for (int i = 0; i < nummarks; ++i)
+        {
+            vissurfaces.emplace(marks[i]);
+        }
+        return;
+    }
+
+    auto node = (mnode_t*)basenode;
+
+    R_RecursiveMarkSurfaces(node->children[0], visnodes, vissurfaces);
+
+    R_RecursiveMarkSurfaces(node->children[1], visnodes, vissurfaces);
+}
+
+void R_RecursiveLinkTextureChain(model_t* mod, mbasenode_t* basenode, const visnodes_t& visnodes, const vissurfaces_t& vissurfaces, vissurfaces_t& watersurfaces, texsurfaces_t* texsurfaces)
+{
+    if (basenode->contents == CONTENTS_SOLID)
+        return;
+
+    if (visnodes.find(basenode) == visnodes.end())
+        return;
+
+    if (basenode->contents < 0)
+        return;
+
+    auto node = (mnode_t*)basenode;
+
+    R_RecursiveLinkTextureChain(mod, node->children[0], visnodes, vissurfaces, watersurfaces, texsurfaces);
+
+    for (int i = 0; i < node->numsurfaces; ++i)
+    {
+        auto surf = R_GetWorldSurfaceByIndex(mod, node->firstsurface + i);
+
+        if (vissurfaces.find(surf) == vissurfaces.end())
+        {
+            continue;
+        }
+
+        if (surf->flags & SURF_DRAWTURB)
+        {
+            watersurfaces.emplace(surf);
+            continue;
+        }
+
+        auto ptexture = (surf->texinfo && surf->texinfo->texture) ? surf->texinfo->texture : nullptr;
+
+        if (ptexture)
+        {
+            auto textureIndex = R_FindTextureIdByTexture(mod, ptexture);
+
+            if (textureIndex >= 0 && textureIndex < mod->numtextures)
+            {
+                texsurfaces[textureIndex + 1].emplace_back(surf);
+            }
+            else
+            {
+                texsurfaces[0].emplace_back(surf);
+            }
+        }
+        else
+        {
+            texsurfaces[0].emplace_back(surf);
+        }
+    }
+
+    R_RecursiveLinkTextureChain(mod, node->children[1], visnodes, vissurfaces, watersurfaces, texsurfaces);
+}
+
+void R_BrushModelLinkTextureChain(model_t* mod, vissurfaces_t& watersurfaces, vissurfaces_t& reversedwatersurfaces, texsurfaces_t* texsurfaces)
+{
+    for (int i = 0; i < mod->nummodelsurfaces; i++)
+    {
+        auto surf = R_GetWorldSurfaceByIndex(mod, mod->firstmodelsurface + i);
+
+        auto pplane = surf->plane;
+
+        if (surf->flags & SURF_DRAWTURB)
+        {
+            //Skip non-Z planes
+            if (pplane->type != PLANE_Z)
+                continue;
+
+            watersurfaces.emplace(surf);
+            reversedwatersurfaces.emplace(surf);
+            continue;
+        }
+
+        auto ptexture = (surf->texinfo && surf->texinfo->texture) ? surf->texinfo->texture : nullptr;
+
+        if (ptexture)
+        {
+            auto textureIndex = R_FindTextureIdByTexture(mod, ptexture);
+
+            if (textureIndex >= 0 && textureIndex < mod->numtextures)
+            {
+                texsurfaces[textureIndex + 1].emplace_back(surf);
+            }
+            else
+            {
+                texsurfaces[0].emplace_back(surf);
+            }
+        }
+        else
+        {
+            texsurfaces[0].emplace_back(surf);
+        }
+    }
+}
+
+void R_GenerateIndicesForTexChain(model_t* mod, msurface_t* surf, CWorldSurfaceBrushTexChain* texchain, CWorldSurfaceWorldModel* pWorldModel, CWorldSurfaceLeaf* pLeaf, std::vector<CDrawIndexAttrib>& vDrawAttribBuffer)
+{
+    if (pLeaf->m_bIsClosing.load())
+        return; //Leaf is closing, stop generating texchain
+
+    auto surfIndex = R_GetWorldSurfaceIndex(pWorldModel->m_model, surf);
+
+    if (surfIndex < 0 || static_cast<std::size_t>(surfIndex) >= pWorldModel->m_vFaceBuffer.size())
+        throw std::invalid_argument("Invalid world leaf surface index");
+
+    const auto& brushface = pWorldModel->m_vFaceBuffer[surfIndex];
+    // A successfully carved-away face is ready but has no GPU command.
+    if (!brushface.index_count || !brushface.instance_count) return;
+
+    if (surf->flags & SURF_DRAWSKY)
+    {
+        if (texchain->type == TEXCHAIN_SKY)
+        {
+            CDrawIndexAttrib drawAttrib;
+
+            drawAttrib.FirstIndexLocation    = brushface.start_index;
+            drawAttrib.NumIndices            = brushface.index_count;
+            drawAttrib.FirstInstanceLocation = brushface.instance_index;
+            drawAttrib.NumInstances          = brushface.instance_count;
+
+            vDrawAttribBuffer.emplace_back(drawAttrib);
+
+            texchain->drawCount++;
+            texchain->polyCount += brushface.poly_count;
+        }
+    }
+    else if (surf->flags & SURF_DRAWTURB)
+    {
+    }
+    else if (surf->flags & SURF_UNDERWATER)
+    {
+    }
+    else if (surf->flags & SURF_DRAWTILED)
+    {
+        if (texchain->type == TEXCHAIN_SCROLL)
+        {
+            CDrawIndexAttrib drawAttrib;
+
+            drawAttrib.FirstIndexLocation    = brushface.start_index;
+            drawAttrib.NumIndices            = brushface.index_count;
+            drawAttrib.FirstInstanceLocation = brushface.instance_index;
+            drawAttrib.NumInstances          = brushface.instance_count;
+
+            vDrawAttribBuffer.emplace_back(drawAttrib);
+
+            texchain->drawCount++;
+            texchain->polyCount += brushface.poly_count;
+        }
+    }
+    else
+    {
+        if (texchain->type == TEXCHAIN_STATIC)
+        {
+            CDrawIndexAttrib drawAttrib;
+
+            drawAttrib.FirstIndexLocation    = brushface.start_index;
+            drawAttrib.NumIndices            = brushface.index_count;
+            drawAttrib.FirstInstanceLocation = brushface.instance_index;
+            drawAttrib.NumInstances          = brushface.instance_count;
+
+            vDrawAttribBuffer.emplace_back(drawAttrib);
+
+            texchain->drawCount++;
+            texchain->polyCount += brushface.poly_count;
+        }
+    }
+}
