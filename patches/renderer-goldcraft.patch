+            }
+        assert(cavityChains == 3 && cavityCommands == 4);
+        assert(leaf->TextureChainSpecial[WSURF_TEXCHAIN_SPECIAL_SOLID].drawCount == commands.size());
+
+        shader        = Program();
+        colorLocation = glGetUniformLocation(shader, "stateColor");
+        glViewport(0, 0, 64, 64);
+        glEnable(GL_DEPTH_TEST);
+        glEnable(GL_CULL_FACE);
+        g_WorldSurfaceRenderer.bLightmapTexture  = true;
+        g_WorldSurfaceRenderer.iLightmapUsedBits = 15;
