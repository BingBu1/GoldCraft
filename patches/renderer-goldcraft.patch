+        assert(glGetError() == GL_NO_ERROR);
+
+        // The opaque shadow pass submits all eight commands once, including
+        // animated textures. Alpha-tested models retain material batches.
+        shadow       = true;
+        recordStates = true;
+        usedStates.clear();
+        drawCalls = drawnCommands = 0;
