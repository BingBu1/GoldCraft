+#if defined(MULTIVIEW_ENABLED) && defined(SHADOW_CASTER_ENABLED)
+// Opt-in until the complete shadow pass has been measured in the game.
+uniform bool r_shadow_face_cull;
+
+bool StudioTriangleOutsideSidePlanes(vec4 clipPositions[3])
+{
+	float scale = 1.0;
+	for (int i = 0; i < 3; ++i)
+	{
+		vec4 p = clipPositions[i];
+		if (any(isnan(p)) || any(isinf(p)))
+			return false;
+		scale = max(scale, max(max(abs(p.x), abs(p.y)), max(abs(p.z), abs(p.w))));
+	}
+
+	// Retain uncertain boundaries and triangles crossing/behind the eye. Only
+	// common homogeneous x/y half-spaces are rejected; depth clamp still owns z.
+	float margin = scale * 0.00001;
+	bool left = true, right = true, bottom = true, top = true;
+	for (int i = 0; i < 3; ++i)
+	{
+		vec4 p = clipPositions[i];
+		if (p.w <= margin)
+			return false;
+		float bound = p.w + margin;
+		left = left && p.x < -bound;
+		right = right && p.x > bound;
+		bottom = bottom && p.y < -bound;
+		top = top && p.y > bound;
+	}
+	return left || right || bottom || top;
+}
+#endif
