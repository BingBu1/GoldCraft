+void AlphaCases(const std::string& original, const std::string& oldVertex)
+{
+    Target csm(false), cube(true);
+    const auto cascades = Camera(false), faces = Camera(true);
+    const auto quad = Mesh{{{-.8f,-.8f,0},{0,0},0},{{.8f,-.8f,0},{1,0},0},{{.8f,.8f,0},{1,1},0},
+        {{-.8f,-.8f,0},{0,0},0},{{.8f,.8f,0},{1,1},0},{{-.8f,.8f,0},{0,1},0}};
+    auto cubeQuad = quad;
+    for (auto& vertex : cubeQuad) vertex.position[2] = -3.f;
+    std::vector<unsigned char> pattern(8 * 8 * 4, 255), packed(16 * 8 * 4, 255), animated(8 * 8 * 4 * 2, 255);
+    for (int y = 0; y < 8; ++y) for (int x = 0; x < 8; ++x)
+    {
+        const unsigned char alpha = ((x / 2 + y / 2) & 1) ? 255 : 0;
+        pattern[(y * 8 + x) * 4 + 3] = alpha;
+        packed[(y * 16 + x + 8) * 4 + 3] = alpha;
+        animated[(y * 8 + x) * 4 + 3] = alpha;
+        animated[(64 + y * 8 + x) * 4 + 3] = 255 - alpha;
+    }
+    glActiveTexture(GL_TEXTURE0);
+    const GLuint mask = Texture2D(8, 8, pattern), packedMask = Texture2D(16, 8, packed);
+    GLuint animation{};
+    glGenTextures(1, &animation);
+    glActiveTexture(GL_TEXTURE5);
+    glBindTexture(GL_TEXTURE_2D_ARRAY, animation);
+    glTexImage3D(GL_TEXTURE_2D_ARRAY, 0, GL_RGBA8, 8, 8, 2, 0, GL_RGBA, GL_UNSIGNED_BYTE, animated.data());
+    glTexParameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, mask);
+    const auto opaque = MakePrograms("", false, true, original);
+    const auto solid = Draw(csm, cascades, quad, opaque.layered, 1);
+    const auto cubeSolid = Draw(cube, faces, cubeQuad, opaque.layered, 1);
+    if (!oldVertex.empty())
+    {
+        const auto geometry = Read("studio_shader.geom.glsl");
+        const auto oldOpaque = Program("#define SHADOW_CASTER_ENABLED\n#define MULTIVIEW_ENABLED\n", &geometry, &oldVertex);
+        const auto legacySolid = Draw(csm, cascades, quad, oldOpaque, 0);
+        Equal(solid.depth, legacySolid.depth, "UV correction preserves old opaque depth");
+        const auto oldMasked = Program("#define SHADOW_CASTER_ENABLED\n#define MULTIVIEW_ENABLED\n#define STUDIO_NF_MASKED\n", &geometry, &oldVertex);
+        const auto legacyMasked = Draw(csm, cascades, quad, oldMasked, 0);
+        // Undefined UVs cannot be required to fail on every driver. Report the
+        // old result honestly; the corrected shader must pass the assertions below.
+        std::printf("OLD UV DEFECT PROBE: opaque=%zu masked=%zu pixels (expected patterned mask about half); old UV is undefined.\n",
+            Written(legacySolid.depth), Written(legacyMasked.depth));
+        glDeleteProgram(oldOpaque); glDeleteProgram(oldMasked);
+    }
+    Delete(opaque);
+    Pixels firstAnimated;
+    for (const std::string material : {std::string(""), std::string("#define PACKED_DIFFUSETEXTURE_ENABLED\n#define PACKED_NORMALTEXTURE_ENABLED\n"),
+             std::string("#define ANIMATED_TEXTURE_ENABLED\n")})
+    {
+        const bool isPacked = material.find("PACKED") != std::string::npos;
+        const bool isAnimated = material.find("ANIMATED") != std::string::npos;
+        glBindTexture(GL_TEXTURE_2D, isPacked ? packedMask : mask);
+        const auto programs = MakePrograms("#define STUDIO_NF_MASKED\n" + material, false, true, original);
+        glUseProgram(programs.layered);
+        glUniform2f(glGetUniformLocation(programs.layered, "r_uvscale"), isPacked ? .5f : 1.f, 1.f);
+        glUseProgram(programs.single);
+        glUniform2f(glGetUniformLocation(programs.single, "r_uvscale"), isPacked ? .5f : 1.f, 1.f);
+        if (programs.original)
+        {
+            glUseProgram(programs.original);
+            glUniform2f(glGetUniformLocation(programs.original, "r_uvscale"), isPacked ? .5f : 1.f, 1.f);
+        }
+        for (int frame = 0; frame < (isAnimated ? 2 : 1); ++frame)
+        {
+            scene.cl_time = float(frame);
+            Upload(sceneBuffer, scene);
+            const auto masked = Compare(isAnimated ? "animated alpha holes" : isPacked ? "packed alpha holes" : "alpha holes",
+                csm, cascades, quad, programs, 8);
+            const size_t written = Written(masked.depth), full = Written(solid.depth);
+            Check(written > full / 3 && written < full * 2 / 3, "real texture alpha removes only holes");
+            const auto cubeMasked = Compare("cube alpha holes", cube, faces, cubeQuad, programs);
+            Check(Written(cubeMasked.depth) > 0 && Written(cubeMasked.depth) < Written(cubeSolid.depth), "cube retains opaque texels and holes");
+            if (isAnimated)
+            {
+                if (frame == 0) firstAnimated = masked.depth;
+                else Check(firstAnimated != masked.depth, "production animated alpha switches layers");
+            }
+        }
+        Delete(programs);
+    }
+    scene.cl_time = 0;
+    Upload(sceneBuffer, scene);
+    glDeleteTextures(1, &mask); glDeleteTextures(1, &packedMask); glDeleteTextures(1, &animation);
+}
+
+void Run(const std::string& original, const std::string& oldVertex)
+{
+    glViewport(0, 0, Size, Size);
+    glEnable(GL_DEPTH_TEST);
+    glDepthFunc(GL_LESS);
+    glDepthMask(GL_TRUE);
+    glDisable(GL_CULL_FACE);
+    glDisable(GL_STENCIL_TEST);
+    glGenVertexArrays(1, &vao);
+    glBindVertexArray(vao);
+    glGenBuffers(1, &vbo);
+    glBindBuffer(GL_ARRAY_BUFFER, vbo);
+    glEnableVertexAttribArray(STUDIO_VA_POSITION);
+    glVertexAttribPointer(STUDIO_VA_POSITION, 3, GL_FLOAT, GL_FALSE, sizeof(Vertex), reinterpret_cast<void*>(offsetof(Vertex, position)));
+    glEnableVertexAttribArray(STUDIO_VA_TEXCOORD);
+    glVertexAttribPointer(STUDIO_VA_TEXCOORD, 2, GL_FLOAT, GL_FALSE, sizeof(Vertex), reinterpret_cast<void*>(offsetof(Vertex, uv)));
+    glEnableVertexAttribArray(STUDIO_VA_PACKEDBONE);
+    glVertexAttribIPointer(STUDIO_VA_PACKEDBONE, 1, GL_UNSIGNED_INT, sizeof(Vertex), reinterpret_cast<void*>(offsetof(Vertex, bone)));
+    glVertexAttrib3f(STUDIO_VA_NORMAL, 0, 0, 1);
+    glVertexAttrib3f(STUDIO_VA_SMOOTHNORMAL, 0, 0, 1);
+    glVertexAttrib3f(STUDIO_VA_TANGENT, 1, 0, 0);
+    glVertexAttrib3f(STUDIO_VA_BITANGENT, 0, 1, 0);
+    glGenBuffers(1, &cameraBuffer); glBindBufferBase(GL_UNIFORM_BUFFER, BINDING_POINT_CAMERA_UBO, cameraBuffer);
+    glGenBuffers(1, &sceneBuffer); glBindBufferBase(GL_UNIFORM_BUFFER, BINDING_POINT_SCENE_UBO, sceneBuffer);
+    glGenBuffers(1, &studioBuffer); glBindBufferBase(GL_UNIFORM_BUFFER, BINDING_POINT_STUDIO_UBO, studioBuffer);
+    glGenBuffers(1, &bonesBuffer); glBindBufferBase(GL_UNIFORM_BUFFER, BINDING_POINT_STUDIO_BONES_UBO, bonesBuffer);
+    glGenQueries(1, &query);
+    scene = {};
+    scene.r_g = scene.v_gamma = scene.v_texgamma = scene.v_lightgamma = 1.f;
+    scene.r_g3 = .125f;
+    Upload(sceneBuffer, scene);
+    Bones(false);
+    const auto white = Texture2D(1, 1, {255, 255, 255, 255});
+    GeometryCases(original);
+    AlphaCases(original, oldVertex);
+    glDeleteTextures(1, &white);
+    glDeleteBuffers(1, &cameraBuffer); glDeleteBuffers(1, &sceneBuffer); glDeleteBuffers(1, &studioBuffer);
+    glDeleteBuffers(1, &bonesBuffer);
+    glDeleteBuffers(1, &vbo); glDeleteVertexArrays(1, &vao); glDeleteQueries(1, &query);
+    glUseProgram(0);
+    Check(glGetError() == GL_NO_ERROR, "suite cleanup has no GL errors");
+}
+} // namespace
+
+int main(int argc, char** argv)
+{
+    const std::string original = argc >= 2 ? ReadPath(argv[1]) : std::string{};
+    const std::string oldVertex = argc >= 3 ? ReadPath(argv[2]) : std::string{};
+    if (!glfwInit()) return 2;
+    for (int profile : {GLFW_OPENGL_COMPAT_PROFILE, GLFW_OPENGL_CORE_PROFILE})
+    {
+        glfwWindowHint(GLFW_VISIBLE, GLFW_FALSE);
+        glfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 4);
+        glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 3);
+        glfwWindowHint(GLFW_OPENGL_PROFILE, profile);
+        auto* window = glfwCreateWindow(Size, Size, "studio shadow face regression", nullptr, nullptr);
+        if (!window) { glfwTerminate(); return 2; }
+        glfwMakeContextCurrent(window);
+        glewExperimental = GL_TRUE;
+        if (glewInit() != GLEW_OK) { glfwDestroyWindow(window); glfwTerminate(); return 2; }
+        while (glGetError() != GL_NO_ERROR) {}
+        std::printf("Driver: %s / %s / profile=%d / frozen-baseline=%s\n", glGetString(GL_RENDERER),
+            glGetString(GL_VERSION), profile, original.empty() ? "no (independent per-layer oracle)" : "yes");
+        Run(original, oldVertex);
+        glfwDestroyWindow(window);
+    }
+    glfwTerminate();
+    std::printf("Studio face culling: %u checks, %u complete depth comparisons passed. Primitive counts are not FPS evidence.\n", checks, comparisons);
+    return 0;
+}
