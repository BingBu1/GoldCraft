+void EditIntegration()
+{
+    auto* api = static_cast<IMetaRendererWorldEdit*>(CreateInterface(METARENDERER_WORLD_EDIT_INTERFACE_VERSION, nullptr));
+    assert(api);
+    Scene scene;
+    worldModel = &scene.model;
+    dclipnode_t clip{0, {-1, -2}};
+    scene.model.hulls[0] = {&clip, &scene.plane, 0, 0};
+    auto original        = R_PrepareWorldSurfaceLeafModel(scene.geometry, &scene.model, 0);
+    Finish(original);
+    g_WorldSurfaceModels      = {nullptr, original};
+    g_WorldSurfaceWorldModels = {nullptr, scene.geometry};
+    const auto wait           = [&](uint64_t ticket) {
+        const auto limit = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+        while (api->Poll(ticket) == MetaWorldEditStatus::Preparing)
+        {
+            assert(std::chrono::steady_clock::now() < limit);
+            std::this_thread::sleep_for(std::chrono::milliseconds(1));
+        }
+        assert(api->Poll(ticket) == MetaWorldEditStatus::Ready);
+    };
+    const auto light = [](float x, DynamicLightType type) {
+        auto value       = std::make_shared<CDynamicLight>();
+        value->type      = type;
+        value->origin[0] = x;
+        value->origin[1] = value->origin[2] = 48;
+        value->size                         = 64;
+        value->pStaticShadowTexture         = std::make_shared<Shadow>();
+        return value;
+    };
+    auto nearLight = light(48, DynamicLightType_Point), next = light(176, DynamicLightType_Spot),
+         distant = light(1000, DynamicLightType_Point), sun = light(1000, DynamicLightType_Directional);
+    g_BSPDynamicLights    = {nearLight, next, sun};
+    g_EngineDynamicLights = {distant};
+    MetaWorldEditBox box{{32, 32, -8}, {64, 64, 8}};
+    auto             first = api->Begin(&scene.model, 9, 2, &box, 1);
+    assert(first && g_WorldSurfaceWorldModels[1] == scene.geometry);
+    assert(!api->Commit(first)); // No upload/publish before a completed Poll.
+    wait(first);
+    // A newly loaded inline model must participate before commit can succeed.
+    model_t brush       = scene.model;
+    auto    inlineModel = R_PrepareWorldSurfaceLeafModel(scene.geometry, &brush, 0);
+    Finish(inlineModel);
+    g_WorldSurfaceModels.push_back(inlineModel);
+    assert(!api->Commit(first));
+    wait(first);
+    const auto before  = uploads;
+    countedAllocations = 0;
+    countAllocations   = true;
+    assert(api->Commit(first));
+    countAllocations = false;
+    assert(uploads == before && countedAllocations == 0);
+    auto edited = g_WorldSurfaceWorldModels[1];
+    assert(edited != scene.geometry && g_WorldSurfaceModels[2]->m_pWorldModel.lock() == edited);
+    assert(g_WorldSurfaceModels[1]->GetLeafByIndex(0)->m_bIsReady);
+    assert(!nearLight->pStaticShadowTexture->IsReady() && next->pStaticShadowTexture->IsReady());
+    assert(!sun->pStaticShadowTexture->IsReady() && distant->pStaticShadowTexture->IsReady());
+    nearLight->pStaticShadowTexture->SetReady(true);
+    MetaWorldEditBox boxes[]{box, {{160, 32, -8}, {192, 64, 8}}};
+    const auto       second = api->Begin(&scene.model, 9, 3, boxes, 2);
+    assert(second);
+    wait(second);
+    assert(api->Commit(second));
+    assert(nearLight->pStaticShadowTexture->IsReady() && !next->pStaticShadowTexture->IsReady());
+    assert(distant->pStaticShadowTexture->IsReady());
+
+    // Production decal mesh clipping preserves interpolated UV/TBN and has no
+    // dependency on the legacy fixed-size per-decal vertex/index slots.
+    float               vertices[]{0, 0, 0, 0, 0, .5f, .5f, 128, 0, 0, 1, 0, .5f, .5f,
+                                   128, 128, 0, 1, 1, .5f, .5f, 0, 128, 0, 0, 1, .5f, .5f};
+    brushinstancedata_t instance{};
+    auto                decal = R_PrepareCarvedDecal(*edited, 0, vertices, instance);
+    assert(decal && decal->hVAO);
+    for (const auto& vertex : decal->m_pSurfaceMesh->vertices)
+    {
+        assert(std::abs(vertex.pos[0] / 128 - vertex.texcoord[0]) < 1e-6f);
+        assert(std::abs(vertex.pos[1] / 128 - vertex.texcoord[1]) < 1e-6f);
+        assert(vertex.lightmaptexcoord[0] == .5f && vertex.lightmaptexcoord[1] == .5f);
+    }
+    glViewport(0, 0, 64, 64);
+    glDisable(GL_DEPTH_TEST);
+    glDisable(GL_CULL_FACE);
+    glClearColor(0, 0, 0, 0);
+    glClear(GL_COLOR_BUFFER_BIT);
+    glUseProgram(shader);
+    glUniform3f(colorLocation, 1, 0, 0);
+    glBindVertexArray(decal->hVAO);
+    glDrawElementsInstancedBaseInstance(GL_TRIANGLES, static_cast<GLsizei>(decal->m_pSurfaceMesh->indices.size()), GL_UNSIGNED_INT, nullptr, 1, 0);
+    std::vector<byte> pixels(64 * 64 * 4);
+    glReadPixels(0, 0, 64, 64, GL_RGBA, GL_UNSIGNED_BYTE, pixels.data());
+    std::size_t kept = 0, removed = 0;
+    for (int y = 0; y < 64; ++y)
+        for (int x = 0; x < 64; ++x)
+        {
+            const bool hole = x >= 16 && x < 32 && y >= 16 && y < 32;
+            assert((pixels[(y * 64 + x) * 4] > 250) != hole);
+            if (hole) ++removed;
+            else
+                ++kept;
+        }
+    auto& cache       = g_WorldSurfaceRenderer.vCachedDecals[0];
+    cache.boundsValid = cache.geometryReady = true;
+    cache.surfaceIndex                      = 2;
+    cache.indiceCount                       = 6;
+    cache.mins[0]                           = 256;
+    cache.maxs[0]                           = 384;
+    cache.maxs[1]                           = 128;
+    cache.gltexturenum                      = scene.textures[0].gl_texturenum;
+    cache.gltexturewidth = cache.gltextureheight = 64;
+    cache.worldMesh                              = scene.geometry->m_pSurfaceMesh;
+    assert(!R_IsDecalCacheInvalidated(0, &scene.textures[0], {}, *edited));
+    const auto hotUploads = uploads;
+    countedAllocations    = 0;
+    countAllocations      = true;
+    for (int i = 0; i < 256; ++i) assert(!R_IsDecalCacheInvalidated(0, &scene.textures[0], {}, *edited));
+    countAllocations = false;
+    assert(uploads == hotUploads && countedAllocations == 0);
+    cache.carvedGeometry = decal;
+    assert(R_IsDecalCacheInvalidated(0, &scene.textures[0], {}, *scene.geometry));
+    CWorldSurfaceWorldModel crowded(&scene.model);
+    crowded.m_vFaceBuffer = edited->m_vFaceBuffer;
+    for (int y = 0; y < 4; ++y)
+        for (int x = 0; x < 4; ++x)
+            crowded.m_vDecalCuts.push_back({0, 1, {{8. + 24 * x, 8. + 24 * y, -8}, {16. + 24 * x, 16. + 24 * y, 8}}});
+    auto fragmented = R_PrepareCarvedDecal(crowded, 0, vertices, instance);
+    assert(fragmented && fragmented->m_pSurfaceMesh->indices.size() > MAX_DECALINDICES);
+    crowded.m_vDecalCuts = {{0, 1, {{-1, -1, -1}, {129, 129, 1}}}};
+    auto empty           = R_PrepareCarvedDecal(crowded, 0, vertices, instance);
+    assert(empty && empty->m_pSurfaceMesh->indices.empty());
+    failUpload = true;
+    Reject([&] { R_PrepareCarvedDecal(*edited, 0, vertices, instance); });
+    assert(glIsVertexArray(decal->hVAO));
+
+    // Restoration is a prepared transaction; cancellation and unload must not
+    // accidentally publish a later revision or leave background BSP readers.
+    const auto beforeFailure = g_WorldSurfaceWorldModels[1];
+    assert(!api->Begin(&scene.model, 9, 3, &box, 1)); // Same revision cannot replace different cuts.
+    failUpload = true;
+    assert(!api->Begin(&scene.model, 9, 4, &box, 1));
+    assert(g_WorldSurfaceWorldModels[1] == beforeFailure);
+    failCreate = true;
+    assert(!api->Begin(&scene.model, 9, 4, &box, 1));
+    failCreate = false;
+    assert(g_WorldSurfaceWorldModels[1] == beforeFailure);
+    const auto restore = api->Begin(&scene.model, 9, 4, nullptr, 0);
+    assert(restore);
+    wait(restore);
+    assert(api->Commit(restore));
+    assert(g_WorldSurfaceWorldModels[1] == scene.geometry && !nearLight->pStaticShadowTexture->IsReady());
+    const auto cancelled = api->Begin(&scene.model, 9, 5, &box, 1);
+    assert(cancelled);
+    api->Cancel(cancelled);
+    assert(api->Poll(cancelled) == MetaWorldEditStatus::Missing && !api->Commit(cancelled));
+    assert(g_WorldSurfaceWorldModels[1] == scene.geometry);
+    const auto unloading = api->Begin(&scene.model, 9, 6, &box, 1);
+    assert(unloading);
+    R_ForgetWorldEdits(&scene.model);
+    assert(api->Poll(unloading) == MetaWorldEditStatus::Missing);
+    R_DrainWorldLeafTasks(&scene.model);
+    R_ClearDecalCache();
+    g_WorldSurfaceModels.clear();
+    g_WorldSurfaceWorldModels.clear();
+    g_BSPDynamicLights.clear();
+    g_EngineDynamicLights.clear();
+    glBindVertexArray(0);
+    glUseProgram(0);
+    assert(!liveWork && glGetError() == GL_NO_ERROR);
+    std::printf("{\"worldEditGL\":true,\"publicInterface\":true,\"lateInlineModel\":true,\"commitAllocations\":0,\"commitUploads\":0,\"selectiveShadowInvalidation\":true,\"decalPixels\":%zu,\"removedDecalPixels\":%zu,\"decalIndices\":%zu,\"unchangedDecalAllocations\":0,\"unchangedDecalUploads\":0,\"restore\":true,\"cancel\":true,\"unload\":true,\"passed\":true}\n", kept, removed, fragmented->m_pSurfaceMesh->indices.size());
+}
