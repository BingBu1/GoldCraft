+            r_draw_hasoutline = flat;
+            source.header.flags = flat ? FMODEL_NOBLOOM : 0;
+            const auto state = program_state_t(textures[0].flags) | STUDIO_SHADOW_CASTER_ENABLED |
+                STUDIO_MULTIVIEW_ENABLED | (cube ? STUDIO_LINEAR_DEPTH_ENABLED : 0);
+            const auto draw = [&](bool batch) {
+                target.Layered(); glDepthMask(GL_TRUE); glStencilMask(0xff);
+                glClearBufferfi(GL_DEPTH_STENCIL, 0, 1.f, 93); Poison(0);
+                const auto calls = meshSubmissions;
+                if (batch)
+                {
+                    const auto consumed = R_StudioTryDrawShadowBatch(&model, &prepared, &textureHeader, textures, skins, 0);
+                    Check(consumed == prepared.vMesh.size(), "production batch consumes each adjacent mesh exactly once");
+                }
+                else for (auto& mesh : prepared.vMesh) LegacySharedDraw(&mesh, state);
+                Check(meshSubmissions - calls == (batch ? 1 : prepared.vMesh.size()), "many shadow submissions become exactly one draw");
+                return DepthResult{target.ReadDepth(), ReadStencil(target), State()};
+            };
+            const auto legacy = draw(false), batch = draw(true);
+            Equal(legacy.depth, batch.depth, "batched opaque index ranges preserve exact layered depth");
+            Check(legacy.stencil == batch.stencil && legacy.state == batch.state, "batch preserves stencil and all observed exit state");
+            Check(Written(batch.depth) > 20, "batched draw writes actual geometry");
+            // The real callback would already have updated pose/UBO above.
+            // Reuse one prepared plan through many light submissions.
+            const auto builds = g_StudioShadowPlanStats.builds;
+            shadowPlanVariable.value = 1;
+            for (int light = 0; light < 8; ++light)
+            {
+                target.Layered(); glDepthMask(GL_TRUE); glStencilMask(0xff);
