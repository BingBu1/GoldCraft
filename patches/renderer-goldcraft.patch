+void BrushEditIntegration()
+{
+    auto* api = static_cast<IMetaRendererWorldEdit2*>(CreateInterface(METARENDERER_WORLD_EDIT2_INTERFACE_VERSION, nullptr));
+    assert(api && static_cast<IMetaRendererWorldEdit*>(api) == CreateInterface(METARENDERER_WORLD_EDIT_INTERFACE_VERSION, nullptr));
+    api->Reset();
+    Scene scene;
+    worldModel = &scene.model;
+    scene.model.numsubmodels = 2;
+    dclipnode_t clip{0, {-1, -2}};
+    scene.model.hulls[0] = {&clip, &scene.plane, 0, 0};
+    model_t brush = scene.model;
+    std::strcpy(brush.name, "*1");
+    candidateInline = &brush;
+    gEngfuncs.CL_LoadModel = [](const char* name, int* index) -> model_t* {
+        if (std::strcmp(name, "*1")) return nullptr;
+        *index = 2;
+        return candidateInline;
+    };
+    gEngfuncs.hudGetModelByIndex = [](int index) -> model_t* { return index == 2 ? candidateInline : nullptr; };
+    auto original = R_PrepareWorldSurfaceLeafModel(scene.geometry, &scene.model, 0);
+    auto ordinary = R_PrepareWorldSurfaceLeafModel(scene.geometry, &brush, 0);
+    Finish(original); Finish(ordinary);
+    g_WorldSurfaceModels = {nullptr, original, ordinary};
+    g_WorldSurfaceWorldModels = {nullptr, scene.geometry};
+    auto light = std::make_shared<CDynamicLight>();
+    light->pStaticShadowTexture = std::make_shared<Shadow>();
+    g_BSPDynamicLights = {light};
+    cl_entity_t first{}, second{};
+    first.index = first.curstate.number = 10;
+    second.index = second.curstate.number = 11;
+    first.model = second.model = &brush;
+    first.curstate.modelindex = second.curstate.modelindex = 2;
+    first.curstate.solid = second.curstate.solid = 4;
+    first.curstate.messagenum = second.curstate.messagenum = 42;
+    MetaWorldEditTarget identities[]{{10, 123, 1}, {11, 456, 1}};
+    assert(api->UpdateBrushSnapshot(9, 2, 42, identities, 2));
+    MetaWorldEditCut cut{{10, 123, 1}, {{32, 32, -8}, {64, 64, 8}}};
+    const auto wait = [&](uint64_t ticket) {
+        const auto limit = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+        while (api->Poll(ticket) == MetaWorldEditStatus::Preparing)
+        {
+            assert(std::chrono::steady_clock::now() < limit);
+            std::this_thread::sleep_for(std::chrono::milliseconds(1));
+        }
+        assert(api->Poll(ticket) == MetaWorldEditStatus::Ready);
+    };
+    auto ticket = api->BeginTargeted(&scene.model, 9, 2, &cut, 1);
+    assert(ticket && !api->Commit(ticket));
+    wait(ticket);
+    auto beforeUploads = uploads;
