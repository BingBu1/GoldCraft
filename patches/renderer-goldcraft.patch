+// The prepared EBO contains independent triangle lists in mesh order. For an
+// ordinary opaque depth pass, compatible adjacent lists need only one shader,
+// stencil setup and indexed submission. No animation or model callback is
+// cached here; skin/view/material eligibility is checked for this invocation.
+static size_t R_StudioCollectShadowBatch(
+    CStudioModelRenderData* data, const CStudioModelRenderSubModel* submodel,
+    const mstudiomesh_t* meshes, int meshCount, studiohdr_t* textureHeader,
+    mstudiotexture_t* textures, short* skinref, size_t first,
+    CStudioModelRenderMesh& merged, program_state_t& state)
+{
+    if (!r_studio_shadow_depth_executor || r_studio_shadow_depth_executor->value != 1.0f ||
+        !submodel || !meshes || !textureHeader || !textures || !skinref ||
+        first >= submodel->vMesh.size())
+        return 0;
+
+    size_t count = 0;
+    for (size_t i = first; i < submodel->vMesh.size(); ++i)
+    {
+        const auto& mesh = submodel->vMesh[i];
+        if (mesh.iMeshIndex < 0 || mesh.iMeshIndex >= meshCount || mesh.iIndiceCount % 3)
+            break;
+        const auto* source = &meshes[mesh.iMeshIndex];
+        const auto textureIndex = StudioResolveTextureIndex(skinref, textureHeader->numskinref,
+            textureHeader->numtextures, source->skinref);
+        if (textureIndex < 0) break;
+        const auto candidate = static_cast<program_state_t>(static_cast<uint32_t>(textures[textureIndex].flags)) |
+            STUDIO_SHADOW_CASTER_ENABLED;
+        if (!R_StudioDepthExecutorEligible(data, &mesh, source, textureHeader, textures, skinref, candidate))
+            break;
+        if (count)
+        {
+            // A gap or a stencil-affecting flag is a submission barrier. Do
+            // arithmetic in 64 bits before narrowing the GL count parameter.
+            const int64_t end = int64_t(merged.iStartIndex) + merged.iIndiceCount;
+            const int64_t total = int64_t(merged.iIndiceCount) + mesh.iIndiceCount;
+            if (candidate != state || end != mesh.iStartIndex || total > INT_MAX)
+                break;
+            merged.iIndiceCount = static_cast<int>(total);
+        }
+        else
+        {
+            merged = mesh;
+            state = candidate;
+        }
+        ++count;
+    }
+    return count;
+}
+
+static size_t R_StudioTryDrawShadowBatch(
+    CStudioModelRenderData* data, CStudioModelRenderSubModel* submodel,
+    studiohdr_t* textureHeader, mstudiotexture_t* textures, short* skinref, size_t first)
+{
+    if (!r_studio_shadow_depth_executor || r_studio_shadow_depth_executor->value != 1.0f ||
+        r_draw_analyzingstudio || !R_IsRenderingShadowView() ||
+        !submodel || first >= submodel->vMesh.size() || submodel->vMesh.size() - first < 2 ||
+        !(*pstudiohdr) || !(*psubmodel))
+        return 0;
+    const auto* meshes = reinterpret_cast<const mstudiomesh_t*>(reinterpret_cast<const byte*>(*pstudiohdr) + (*psubmodel)->meshindex);
+    CStudioModelRenderMesh merged;
+    program_state_t state{};
+    const auto count = R_StudioCollectShadowBatch(data, submodel, meshes, (*psubmodel)->nummesh,
+        textureHeader, textures, skinref, first, merged, state);
+    if (count < 2) return 0;
+    RProfileScope profileScope(RProfileStage::StudioMesh);
+    R_StudioDrawOpaqueShadowMesh(&merged, state);
+    return count;
+}
+
+static const StudioShadowSkinPlan* R_StudioGetShadowSubmissionPlan(
+    CStudioModelRenderData* data, CStudioModelRenderSubModel* submodel,
+    studiohdr_t* textureHeader, mstudiotexture_t* textures, short* skinref)
+{
+    if (!r_studio_shadow_plan || r_studio_shadow_plan->value != 1.0f ||
+        !r_studio_shadow_depth_executor || r_studio_shadow_depth_executor->value != 1.0f ||
+        r_draw_analyzingstudio || !data || !submodel || !textureHeader || !textures || !skinref ||
+        !(*pstudiohdr) || !(*psubmodel) || !textureHeader->textureindex ||
+        submodel->vMesh.empty() || !R_StudioDepthHostEligible(R_StudioDepthHostContext(data)))
+        return nullptr;
+
+    // Bound retained memory even for unusual models; the original path remains
+    // available. No hashes: byte equality catches same-address host mutations.
+    const int meshCount = (*psubmodel)->nummesh;
+    const int textureCount = textureHeader->numtextures;
+    const int skinCount = textureHeader->numskinref;
+    if (meshCount <= 0 || meshCount > 4096 || textureCount <= 0 || textureCount > 4096 ||
+        skinCount <= 0 || skinCount > 4096 || submodel->vMesh.size() > 4096)
+        return nullptr;
+    const auto* meshes = reinterpret_cast<const mstudiomesh_t*>(
+        reinterpret_cast<const byte*>(*pstudiohdr) + (*psubmodel)->meshindex);
+    auto& cache = submodel->shadowPlan;
+    if (cache.header != textureHeader || cache.meshes != meshes || cache.textures != textures ||
+        cache.skinCount != skinCount || cache.preparedCount != submodel->vMesh.size() ||
+        cache.meshSnapshot.size() != size_t(meshCount) || cache.textureSnapshot.size() != size_t(textureCount) ||
+        std::memcmp(cache.meshSnapshot.data(), meshes, size_t(meshCount) * sizeof(*meshes)) ||
+        std::memcmp(cache.textureSnapshot.data(), textures, size_t(textureCount) * sizeof(*textures)))
+    {
+        if (!cache.skins.empty()) ++g_StudioShadowPlanStats.invalidations;
+        cache = {};
+        cache.header = textureHeader;
+        cache.meshes = meshes;
+        cache.textures = textures;
+        cache.skinCount = skinCount;
+        cache.preparedCount = submodel->vMesh.size();
+        cache.meshSnapshot.assign(meshes, meshes + meshCount);
+        cache.textureSnapshot.assign(textures, textures + textureCount);
+        cache.skins.reserve(8);
+    }
+    for (const auto& plan : cache.skins)
+    {
+        if (!std::memcmp(plan.skin.data(), skinref, size_t(skinCount) * sizeof(*skinref)))
+        {
+            ++g_StudioShadowPlanStats.reuses;
+            return &plan;
+        }
+    }
+
+    // At most eight skin variants per immutable submodel. Ordinary model/team
+    // alternation reuses plans; a new skin can evict one without changing draws.
+    size_t slot = cache.skins.size();
+    if (slot < 8) cache.skins.emplace_back();
+    else
+    {
+        slot = cache.nextEviction;
+        cache.nextEviction = (cache.nextEviction + 1) % cache.skins.size();
+    }
+    auto& plan = cache.skins[slot];
+    plan.skin.assign(skinref, skinref + skinCount);
+    plan.allOpaque = true;
+    plan.submissions.clear();
+    plan.submissions.reserve(submodel->vMesh.size());
+    for (size_t first = 0; first < submodel->vMesh.size();)
+    {
+        StudioShadowSubmission submission;
+        submission.first = first;
+        submission.count = R_StudioCollectShadowBatch(data, submodel, meshes, meshCount,
+            textureHeader, textures, skinref, first, submission.mesh, submission.state);
+        if (!submission.count) plan.allOpaque = false;
+        plan.submissions.push_back(submission);
+        first += submission.count ? submission.count : 1;
+    }
+    ++g_StudioShadowPlanStats.builds;
+    return &plan;
+}
+
+static bool R_StudioTryDrawShadowPlan(
+    CStudioModelRenderData* data, CStudioModelRenderSubModel* submodel,
+    studiohdr_t* textureHeader, mstudiotexture_t* textures, short* skinref)
+{
+    const auto* plan = R_StudioGetShadowSubmissionPlan(data, submodel, textureHeader, textures, skinref);
+    if (!plan) return false;
+    // A generic material draw may itself change skin metadata. Keep the whole
+    // original interleaved path for mixed submodels; never reuse commands after
+    // a side-effectful fallback inside the same plan.
+    if (!plan->allOpaque)
+    {
+        ++g_StudioShadowPlanStats.fallbackModels;
+        return false;
+    }
+    for (const auto& submission : plan->submissions)
+    {
+        RProfileScope profileScope(RProfileStage::StudioMesh);
+        R_StudioDrawOpaqueShadowMesh(&submission.mesh, submission.state);
+    }
+    return true;
+}
