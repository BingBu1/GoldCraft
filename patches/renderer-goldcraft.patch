+static void CountSubData(GLenum target, GLintptr offset, GLsizeiptr size, const void* data)
+{
+    if (target == GL_SHADER_STORAGE_BUFFER) { ++recordUploads; uploadedBytes += size; }
+    glBufferSubData(target, offset, size, data);
+}
+static void CountLimit(GLenum parameter, GLint64* value)
+{
+    if (parameter == GL_MAX_SHADER_STORAGE_BLOCK_SIZE) ++limitQueries;
+    glGetInteger64v(parameter, value);
+}
