+#include "../src/gl_scene_static_shadows.cpp"
+#include "../src/gl_shadow_cull.cpp"
+#include <cassert>
+#include <cstdio>
+#include <cstdlib>
+#include <limits>
+#include <new>
+#include <source_location>
+#include <unordered_map>
+
+namespace
+{
+unsigned checks{}, staticDraws{}, dynamicDraws{}, renderedClass{};
+size_t allocations{};
+bool shadowView{}, multiview{}, linearDepth{};
+cvar_t cullingCvar{};
+IMetaRendererScene* sceneApi{};
+IMetaRendererSceneStaticShadows* staticApi{};
+void Check(bool value, const std::source_location& where = std::source_location::current())
+{
+    ++checks;
+    if (!value) std::fprintf(stderr, "Failed check %u at %s:%u\n", checks, where.file_name(), where.line());
+    assert(value);
+}
+}
+
+void* operator new(size_t size)
+{
+    ++allocations;
+    if (auto* value = std::malloc(size ? size : 1)) return value;
+    throw std::bad_alloc();
+}
+void* operator new[](size_t size) { return ::operator new(size); }
+void operator delete(void* value) noexcept { std::free(value); }
+void operator delete[](void* value) noexcept { std::free(value); }
+void operator delete(void* value, size_t) noexcept { std::free(value); }
+void operator delete[](void* value, size_t) noexcept { std::free(value); }
+
+cl_enginefunc_t gEngfuncs{};
+int r_draw_classify = DRAW_CLASSIFY_ALL;
+bool r_draw_hide_entity{};
+int r_draw_hide_entity_index{};
+std::vector<std::shared_ptr<CDynamicLight>> g_BSPDynamicLights, g_EngineDynamicLights, g_ExternalDynamicLights;
+bool R_IsRenderingGBuffer() { return false; }
+bool R_IsRenderingShadowView() { return shadowView; }
+bool R_IsRenderingMultiView() { return multiview; }
+bool R_IsRenderingLinearDepth() { return linearDepth; }
+bool R_IsRenderingGammaBlending() { return false; }
+void R_SetGBufferMask(int mask) { Check(mask == GBUFFER_MASK_ALL); }
+void R_ProfileShadowCull(bool) {}
+void R_ClearExternalSceneLights(IMetaRendererSceneCallbacks*) noexcept {}
+void R_ClearExternalSceneVision(IMetaRendererSceneCallbacks*) noexcept {}
+
+#include "scene_culling_dispatch.inc"
+
+void R_RenderScene()
+{
+    renderedClass = r_draw_classify;
+    R_DrawExternalOpaqueScene();
+}
+
+#include "scene_static_shadows_dispatch.inc"
+
+namespace
+{
+struct Shadow final : IShadowTexture
+{
+    bool ready = true, cubemap = true, isStatic = true;
+    uint32_t size = 256;
+    mat4 matrix{};
+    float viewport[4]{};
+    bool IsReady() const override { return ready; }
+    void SetReady(bool value) override { ready = value; }
+    bool IsSingleLayer() const override { return !cubemap; }
+    bool IsCascaded() const override { return false; }
+    bool IsCubemap() const override { return cubemap; }
+    bool IsStatic() const override { return isStatic; }
+    GLuint GetDepthTexture() const override { return 0; }
+    uint32_t GetTextureSize() const override { return size; }
+    void SetViewport(float, float, float, float) override {}
+    const float* GetViewport() const override { return viewport; }
+    void SetWorldMatrix(int, const mat4*) override {}
+    void SetProjectionMatrix(int, const mat4*) override {}
+    void SetShadowMatrix(int, const mat4*) override {}
+    const mat4* GetWorldMatrix(int) const override { return &matrix; }
+    const mat4* GetProjectionMatrix(int) const override { return &matrix; }
+    const mat4* GetShadowMatrix(int) const override { return &matrix; }
+    void SetCSMDistance(int, float) override {}
+    float GetCSMDistance(int) const override { return 0; }
+};
+
+struct Owner final : IMetaRendererSceneCallbacks, IMetaRendererStaticSceneCallbacks
+{
+    bool success = true, expectedCoverage{}, invalidateDuringBake{}, recurseDuringBake{};
+    unsigned staticCalls{}, dynamicCalls{}, culledCalls{};
+    IMetaRendererSceneCallbacks* other{};
+    void DrawOpaqueScene(uint32_t) override
+    {
+        ++dynamicDraws;
+        ++dynamicCalls;
+        Check(staticApi->IsStaticSceneCovered(this) == expectedCoverage);
+        Check(!staticApi->IsStaticSceneCovered(other));
+        Check(!staticApi->RegisterStaticScene(this, this)); // Mutations are outside draw callbacks.
+    }
+    bool DrawStaticShadow(uint32_t flags) noexcept override
+    {
+        ++staticDraws;
+        ++staticCalls;
+        Check(flags == (META_SCENE_SHADOW | META_SCENE_MULTIVIEW | META_SCENE_LINEAR_DEPTH));
+        Check(!staticApi->IsStaticSceneCovered(this));
+        const float mins[]{1000, -1, -1}, maxs[]{1010, 1, 1};
+        if (R_CullExternalShadowBox(mins, maxs)) ++culledCalls;
+        Check(!staticApi->RegisterStaticScene(this, this));
+        if (invalidateDuringBake) staticApi->InvalidateStaticScene(this, nullptr, nullptr);
+        if (recurseDuringBake) R_DrawExternalOpaqueScene();
+        return success;
+    }
+};
+
+std::shared_ptr<CDynamicLight> Light(float x)
+{
+    auto light = std::make_shared<CDynamicLight>();
+    light->type = DynamicLightType_Point;
+    light->origin[0] = x;
+    light->size = 100;
+    light->pStaticShadowTexture = std::make_shared<Shadow>();
+    return light;
+}
+
+bool Bake(std::shared_ptr<IShadowTexture>& texture, bool worldComplete, bool worldPolys, bool dispatch = true)
+{
+    shadowView = multiview = linearDepth = true;
+    r_draw_classify = DRAW_CLASSIFY_WORLD;
+    const float origin[]{0, 0, 0};
+    RPointShadowCullScope volume(origin, 100);
+    RStaticScenePointLightScope lightScope(&texture, 256);
+    RStaticSceneBakeScope bake;
+    R_MarkExternalStaticWorldComplete(worldComplete);
+    if (dispatch) R_DrawExternalOpaqueScene();
+    TestProductionPointStaticReady(bake, texture, worldPolys);
+    return texture->IsReady();
+}
+
+void Dynamic(std::shared_ptr<IShadowTexture>* texture, unsigned size)
+{
+    shadowView = multiview = linearDepth = true;
+    r_draw_classify = DRAW_CLASSIFY_ALL;
+    RStaticScenePointLightScope point(texture, size);
+    PointLightCallbackArgs args{};
+    args.ppStaticShadowTexture = texture;
+    args.staticShadowSize = size;
+    args.sourceEntityIndex = 17;
+    TestProductionPointDynamicSelection(&args);
+    Check(r_draw_classify == DRAW_CLASSIFY_ALL && !r_draw_hide_entity);
+}
+}
+
+int main()
+{
+    int result{};
+    sceneApi = static_cast<IMetaRendererScene*>(CreateInterface(METARENDERER_SCENE_INTERFACE_VERSION, &result));
+    Check(sceneApi && result == IFACE_OK);
+    staticApi = static_cast<IMetaRendererSceneStaticShadows*>(CreateInterface(METARENDERER_SCENE_STATIC_SHADOWS_INTERFACE_VERSION, &result));
+    Check(staticApi && result == IFACE_OK);
+    Check(!CreateInterface("MetaRendererSceneStaticShadows_API_999", &result) && result == IFACE_FAILED);
+    gEngfuncs.pfnRegisterVariable = [](const char*, const char*, int) -> cvar_t* { cullingCvar.value = 1; return &cullingCvar; };
+    R_InitShadowCulling();
+    auto bsp = Light(0), engine = Light(500), external = Light(1000);
+    g_BSPDynamicLights = {bsp};
+    g_EngineDynamicLights = {engine};
+    g_ExternalDynamicLights = {external};
+    const auto setReady = [&] {
+        bsp->pStaticShadowTexture->SetReady(true);
+        engine->pStaticShadowTexture->SetReady(true);
+        external->pStaticShadowTexture->SetReady(true);
+    };
+    const auto allInvalid = [&] {
+        Check(!bsp->pStaticShadowTexture->IsReady() && !engine->pStaticShadowTexture->IsReady() && !external->pStaticShadowTexture->IsReady());
+    };
+    Owner first, second, unknown;
+    first.other = &second;
+    second.other = &first;
+    Check(!staticApi->RegisterStaticScene(&first, &first));
+    sceneApi->RegisterSceneCallbacks(&first);
+    sceneApi->RegisterSceneCallbacks(&second);
+    Check(!staticApi->RegisterStaticScene(nullptr, &first));
+    Check(!staticApi->RegisterStaticScene(&first, nullptr));
+    Check(staticApi->RegisterStaticScene(&first, &first));
+    allInvalid();
+    setReady();
+    Check(staticApi->RegisterStaticScene(&first, &first));
+    Check(bsp->pStaticShadowTexture->IsReady()); // Idempotent registration.
+    Check(staticApi->RegisterStaticScene(&second, &second));
+    allInvalid();
+    Check(!staticApi->IsStaticSceneCovered(&first));
+
+    auto& texture = bsp->pStaticShadowTexture;
+    Check(Bake(texture, true, false)); // Real ready empty world + empty scene is valid.
+    Check(first.staticCalls == 1 && second.staticCalls == 1 && dynamicDraws == 0);
+    Check(first.culledCalls == 1 && second.culledCalls == 1); // Actual conservative point volume scope.
+    first.expectedCoverage = second.expectedCoverage = true;
+    Dynamic(&texture, 256);
+    Check(renderedClass == DRAW_CLASSIFY_OPAQUE_ENTITIES);
+    Check(!staticApi->IsStaticSceneCovered(&first)); // Owner dispatch scope ended.
+    const auto beforeStable = allocations;
+    for (int i = 0; i < 100; ++i) Dynamic(&texture, 256);
+    Check(allocations == beforeStable && first.staticCalls == 1 && second.staticCalls == 1);
+
+    first.expectedCoverage = second.expectedCoverage = false;
+    second.success = false;
+    Check(!Bake(texture, true, true)); // MC failure cannot be hidden by BSP polys.
+    Check(first.staticCalls == 2 && second.staticCalls == 2);
+    Dynamic(&texture, 256);
+    Check(renderedClass == (DRAW_CLASSIFY_WORLD | DRAW_CLASSIFY_OPAQUE_ENTITIES));
+    second.success = true;
+    Check(!Bake(texture, false, false)); // Original BSP leaf still preparing.
+    Check(!Bake(texture, false, true)); // A previous PVS fallback is not complete either.
+    Dynamic(&texture, 256);
+    Check(renderedClass & DRAW_CLASSIFY_WORLD);
+    Check(Bake(texture, true, false)); // Retry once the actual leaf is ready, even if empty.
+    Check(!Bake(texture, true, true, false)); // Missing static dispatch never certifies success.
+    first.invalidateDuringBake = true;
+    Check(!Bake(texture, true, true));
+    first.invalidateDuringBake = false;
+    first.recurseDuringBake = true;
+    Check(!Bake(texture, true, true));
+    first.recurseDuringBake = false;
+    Check(Bake(texture, true, false));
+
+    // Only the current point-light scope may report covered. Other light
+    // classes revoke it, and nested scopes restore the caller's identity.
+    Dynamic(&texture, 0);
+    Check(renderedClass & DRAW_CLASSIFY_WORLD);
+    Dynamic(nullptr, 256);
+    Check(renderedClass & DRAW_CLASSIFY_WORLD);
+    {
+        RStaticScenePointLightScope point(&texture, 256);
+        first.expectedCoverage = second.expectedCoverage = true;
+        r_draw_classify = DRAW_CLASSIFY_OPAQUE_ENTITIES;
+        R_DrawExternalOpaqueScene();
+        {
+            RStaticScenePointLightScope spotOrDirectional(nullptr, 0);
+            first.expectedCoverage = second.expectedCoverage = false;
+            R_DrawExternalOpaqueScene();
+        }
+        first.expectedCoverage = second.expectedCoverage = true;
+        R_DrawExternalOpaqueScene();
+        shadowView = false;
+        first.expectedCoverage = second.expectedCoverage = false;
+        R_DrawExternalOpaqueScene();
+    }
+    auto concrete = std::static_pointer_cast<Shadow>(texture);
+    concrete->cubemap = false;
+    Dynamic(&texture, 256);
+    Check(renderedClass & DRAW_CLASSIFY_WORLD);
+    concrete->cubemap = true;
+    concrete->isStatic = false;
+    Dynamic(&texture, 256);
+    Check(renderedClass & DRAW_CLASSIFY_WORLD);
+    concrete->isStatic = true;
+    Dynamic(&texture, 128);
+    Check(renderedClass & DRAW_CLASSIFY_WORLD);
+
+    const float nearMin[]{-1, -1, -1}, nearMax[]{1, 1, 1};
+    setReady();
+    staticApi->InvalidateStaticScene(&first, nearMin, nearMax);
+    Check(!texture->IsReady() && engine->pStaticShadowTexture->IsReady() && external->pStaticShadowTexture->IsReady());
+    const float tangentMin[]{1100, -1, -1}, tangentMax[]{1101, 1, 1};
+    staticApi->InvalidateStaticScene(&first, tangentMin, tangentMax);
+    Check(!external->pStaticShadowTexture->IsReady() && engine->pStaticShadowTexture->IsReady());
+    setReady();
+    staticApi->InvalidateStaticScene(&unknown, nullptr, nullptr);
+    Check(texture->IsReady());
+    for (float bad : {std::numeric_limits<float>::quiet_NaN(), std::numeric_limits<float>::infinity()})
+    {
+        setReady();
+        float invalid[]{bad, 0, 0};
+        staticApi->InvalidateStaticScene(&first, invalid, nearMax);
+        allInvalid();
+    }
+    setReady();
+    staticApi->InvalidateStaticScene(&first, nearMax, nearMin);
+    allInvalid();
+    setReady();
+    staticApi->InvalidateStaticScene(&first, nullptr, nearMax);
+    allInvalid();
+    setReady();
+    staticApi->InvalidateStaticScene(&first, nearMin, nullptr);
+    allInvalid();
+
+    setReady();
+    R_ExternalStaticSceneNewMap();
+    allInvalid();
+    const auto drawsBeforeMap = staticDraws;
+    Check(Bake(texture, true, false) && staticDraws == drawsBeforeMap + 2); // Registration survives with Scene001.
+    setReady();
+    sceneApi->UnregisterSceneCallbacks(&first);
+    allInvalid();
+    Check(!staticApi->RegisterStaticScene(&first, &first));
+    Check(Bake(texture, true, false));
+    Check(staticDraws == drawsBeforeMap + 3);
+    setReady();
+    staticApi->UnregisterStaticScene(&second);
+    allInvalid();
+    Check(!Bake(texture, true, false)); // No opted-in scenes: ordinary old zero-poly semantics.
+    Check(Bake(texture, true, true));
+    sceneApi->RegisterSceneCallbacks(&first);
+    Check(staticApi->RegisterStaticScene(&first, &first));
+    setReady();
+    R_ShutdownExternalStaticScenes();
+    allInvalid();
+    Check(!Bake(texture, true, false));
+    sceneApi->UnregisterSceneCallbacks(&first);
+    sceneApi->UnregisterSceneCallbacks(&second);
+    std::printf("{\"staticSceneChecks\":%u,\"staticCallbacks\":%u,\"dynamicCallbacks\":%u,\"steadyAllocations\":0,\"emptyValid\":true,\"worldPendingRetry\":true,\"realGL\":false,\"passed\":true}\n", checks, staticDraws, dynamicDraws);
+}
diff --git a/src/dlight_storage.h b/src/dlight_storage.h
new file mode 100644
index 0000000..835e97c
--- /dev/null
+++ b/src/dlight_storage.h
@@ -0,0 +1,63 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+
+struct alignas(16) dlight_record_t
+{
+    float origin_radius[4]{};
+    float color_minlight[4]{};
+};
+struct alignas(16) dlight_ubo_t
+{
+    std::uint32_t active_dlights[4]{};
+};
+static_assert(sizeof(dlight_ubo_t) == 16);
+static_assert(sizeof(dlight_record_t) == 32 && offsetof(dlight_record_t, color_minlight) == 16);
+
+// CPU mirror of the last upload. Ordered comparison avoids hashes/collisions and
+// retains vector capacity across cameras and frames. Dirty survives failed gathers.
+class CDLightStorage
+{
+public:
+    void Reset() { std::vector<dlight_record_t>().swap(m_Records); m_Limit = m_Written = 0; m_Dirty = false; }
+    void Initialize(std::uint64_t maximumBytes)
+    {
+        Reset();
+        const auto addressLimit = static_cast<std::uint64_t>((std::numeric_limits<std::ptrdiff_t>::max)());
+        m_Limit = static_cast<std::size_t>((std::min)(maximumBytes, addressLimit) / sizeof(dlight_record_t));
+        m_Limit = (std::min)(m_Limit, static_cast<std::size_t>((std::numeric_limits<int>::max)()));
+        if (!m_Limit) throw std::length_error("No dynamic-light shader storage capacity");
+    }
+    void Begin() noexcept { m_Written = 0; }
+    void Append(const dlight_record_t& record)
+    {
+        if (m_Written >= m_Limit) throw std::length_error("Visible dynamic lights exceed shader storage capacity");
+        if (m_Written == m_Records.size()) { m_Records.push_back(record); m_Dirty = true; }
+        else if (std::memcmp(&m_Records[m_Written], &record, sizeof(record))) { m_Records[m_Written] = record; m_Dirty = true; }
+        ++m_Written;
+    }
+    void End()
+    {
+        if (m_Records.size() != m_Written) { m_Records.resize(m_Written); m_Dirty = true; }
+    }
+    std::size_t CapacityFor(std::size_t previous) const
+    {
+        auto capacity = (std::max)(previous, std::size_t{1});
+        if (capacity > m_Limit) throw std::length_error("Invalid dynamic-light buffer capacity");
+        while (capacity < m_Records.size()) capacity += (std::min)(capacity, m_Limit - capacity);
+        return capacity;
+    }
+    const std::vector<dlight_record_t>& Records() const noexcept { return m_Records; }
+    bool Dirty() const noexcept { return m_Dirty; }
+    void Uploaded() noexcept { m_Dirty = false; }
+private:
+    std::vector<dlight_record_t> m_Records;
+    std::size_t m_Limit{}, m_Written{};
+    bool m_Dirty{};
+};
diff --git a/tests/forward_light_buffer_tests.cpp b/tests/forward_light_buffer_tests.cpp
new file mode 100644
index 0000000..012d166
--- /dev/null
+++ b/tests/forward_light_buffer_tests.cpp
@@ -0,0 +1,57 @@
+#include "../src/dlight_storage.h"
+#include <cassert>
+#include <cstdio>
+
+static dlight_record_t Record(unsigned i)
+{
+    return {{float(i), float(i + 1), -float(i), 257.f}, {float(i % 17) / 17.f, .25f, .5f, 0.f}};
+}
+
+int main()
+{
+    CDLightStorage storage;
+    storage.Initialize(1024 * sizeof(dlight_record_t));
+    for (unsigned count : {0u, 1u, 255u, 256u, 257u, 287u, 1024u, 1u, 0u, 1024u})
+    {
+        storage.Begin();
+        for (unsigned i = 0; i < count; ++i) storage.Append(Record(i));
+        storage.End();
+        assert(storage.Records().size() == count);
+        for (unsigned i = 0; i < count; ++i)
+        {
+            const auto expected = Record(i);
+            assert(!std::memcmp(&storage.Records()[i], &expected, sizeof(expected)));
+        }
+        assert(storage.CapacityFor(1) >= count && storage.CapacityFor(1) <= 1024);
+        storage.Uploaded();
+        const auto* data = storage.Records().data();
+        const auto capacity = storage.Records().capacity();
+        storage.Begin();
+        for (unsigned i = 0; i < count; ++i) storage.Append(Record(i));
+        storage.End();
+        assert(!storage.Dirty() && storage.Records().data() == data && storage.Records().capacity() == capacity);
+    }
+    storage.Begin();
+    auto changed = Record(0); changed.color_minlight[2] = 7;
+    storage.Append(changed);
+    // An interrupted gather cannot mark partially changed CPU bytes uploaded.
+    storage.Begin();
+    storage.Append(changed); storage.End();
+    assert(storage.Dirty());
+    storage.Uploaded();
+    storage.Initialize(287 * sizeof(dlight_record_t));
+    storage.Begin();
+    for (unsigned i = 0; i < 287; ++i) storage.Append(Record(i));
+    bool rejected = false;
+    try { storage.Append(Record(287)); } catch (const std::length_error&) { rejected = true; }
+    assert(rejected && storage.Records().size() == 287 && storage.CapacityFor(256) == 287);
+    storage.Reset();
+    assert(storage.Records().empty() && storage.Records().capacity() == 0 && !storage.Dirty());
+    for (std::uint64_t bytes : {0ull, 31ull})
+    {
+        rejected = false;
+        try { storage.Initialize(bytes); } catch (const std::length_error&) { rejected = true; }
+        assert(rejected);
+    }
+    std::puts("{\"forwardLightStorage\":true,\"recordStride\":32,\"countBytes\":16,\"boundaryCounts\":[0,1,255,256,257,287,1024],\"limitRejected\":true,\"unchangedStorageReused\":true}");
+}
