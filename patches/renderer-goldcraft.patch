@@ -0,0 +1,347 @@
+#include "../src/post_scene.h"
+#include <array>
+#include <cassert>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <new>
+#include <type_traits>
+
+namespace
+{
+size_t allocations{};
+unsigned checks{};
+void Check(bool condition)
+{
+    ++checks;
+    assert(condition);
+}
+}
+
+void* operator new(size_t size)
+{
+    ++allocations;
+    if (void* p = std::malloc(size ? size : 1)) return p;
+    throw std::bad_alloc();
+}
+void* operator new[](size_t size) { return ::operator new(size); }
+void operator delete(void* p) noexcept { std::free(p); }
+void operator delete[](void* p) noexcept { std::free(p); }
+void operator delete(void* p, size_t) noexcept { std::free(p); }
+void operator delete[](void* p, size_t) noexcept { std::free(p); }
+
+// The no-argument wrapper is extracted from gl_rmain.cpp and executed without
+// alteration. Its shared-renderer callee is a CPU adapter, so this exercises the
+// real GoldSrc preincrement boundary without starting the engine or a GL view.
+void R_RenderView(void);
+int r_renderview_pass{};
+namespace
+{
+bool explicit_view_index{};
+int observed_engine_view_index{-1};
+uint32_t observed_public_view_index{~uint32_t{0}};
+uint32_t observed_dispatch_count{};
+MetaRendererPostSceneFrame Frame();
+RendererPostScene::Context EligibleContext();
+}
+void R_RenderView_SvEngine(int viewIdx)
+{
+    observed_engine_view_index = viewIdx;
+    r_renderview_pass = viewIdx; // Same assignment as the shared production body.
+    auto context = EligibleContext();
+    context.view_index = RendererPostScene::NormalizeViewIndex(viewIdx, explicit_view_index);
+    auto frame = Frame();
+    frame.view_index = context.view_index;
+    observed_public_view_index = context.view_index;
+    observed_dispatch_count = RendererPostScene::Dispatch(context, frame);
+}
+
+namespace
+{
+static_assert(std::is_standard_layout_v<MetaRendererPostSceneFrame>);
+static_assert(sizeof(MetaRendererPostSceneFrame) == 332);
+static_assert(offsetof(MetaRendererPostSceneFrame, viewport) == 40);
+static_assert(offsetof(MetaRendererPostSceneFrame, world_matrix) == 56);
+static_assert(offsetof(MetaRendererPostSceneFrame, frame_number) == 312);
+
+RendererPostScene::Context EligibleContext()
+{
+    RendererPostScene::Context context{};
+    context.rendering_view = true;
+    return context;
+}
+
+MetaRendererPostSceneFrame Frame()
+{
+    MetaRendererPostSceneFrame frame{};
+    frame.struct_size = sizeof(frame);
+    frame.flags = META_POST_SCENE_LINEAR | META_POST_SCENE_HDR;
+    frame.framebuffer = 21;
+    frame.color_texture = 27;
+    frame.depth_texture = 31;
+    frame.depth_sample_texture = 34;
+    frame.width = 1280;
+    frame.height = 720;
+    frame.color_format = 0x881A; // GL_RGBA16F
+    frame.depth_format = 0x88F0; // GL_DEPTH24_STENCIL8
+    frame.viewport[0] = 16;
+    frame.viewport[1] = 24;
+    frame.viewport[2] = 1200;
+    frame.viewport[3] = 672;
+    for (auto* matrix : {frame.world_matrix, frame.projection_matrix,
+                         frame.inverse_world_matrix, frame.inverse_projection_matrix})
+        for (unsigned i = 0; i != 4; ++i) matrix[i * 5] = 1.f;
+    frame.world_matrix[12] = 96.f;
+    frame.inverse_world_matrix[12] = -96.f;
+    frame.frame_number = 12345;
+    frame.view_index = 0;
+    frame.samples = 1;
+    frame.near_plane = 4.f;
+    frame.far_plane = 4096.f;
+    return frame;
+}
+
+struct Probe final : IMetaRendererPostSceneCallbacks
+{
+    unsigned calls{};
+    MetaRendererPostSceneFrame seen{};
+    IMetaRendererPostScene* api{};
+    Probe* target{};
+    void (*action)(Probe&, const MetaRendererPostSceneFrame&) noexcept{};
+    uint32_t nested_result{999};
+    bool operation_result{};
+
+    void DrawPostScene(const MetaRendererPostSceneFrame& frame) noexcept override
+    {
+        ++calls;
+        seen = frame;
+        if (action) action(*this, frame);
+    }
+};
+
+void TestEngineViewBoundary(IMetaRendererPostScene& api)
+{
+    Probe probe;
+    Check(api.RegisterPostSceneCallbacks(&probe));
+    explicit_view_index = false;
+    r_renderview_pass = 0; // GL_BeginRendering's per-frame reset.
+    R_RenderView();
+    Check(observed_engine_view_index == 1 && r_renderview_pass == 1);
+    Check(observed_public_view_index == 0 && observed_dispatch_count == 1 && probe.calls == 1);
+    Check(probe.seen.view_index == 0);
+    // Legacy pre-fix interpretation of this actual wrapper output is rejected.
+    auto unnormalized = EligibleContext();
+    unnormalized.view_index = static_cast<uint32_t>(observed_engine_view_index);
+    Check(!RendererPostScene::Eligible(unnormalized));
+    R_RenderView();
+    Check(observed_engine_view_index == 2 && r_renderview_pass == 2);
+    Check(observed_public_view_index == 1 && observed_dispatch_count == 0 && probe.calls == 1);
+    r_renderview_pass = 0;
+    R_RenderView();
+    Check(observed_public_view_index == 0 && observed_dispatch_count == 1 && probe.calls == 2);
+
+    explicit_view_index = true;
+    R_RenderView_SvEngine(0);
+    Check(observed_engine_view_index == 0 && observed_public_view_index == 0 && observed_dispatch_count == 1);
+    R_RenderView_SvEngine(1);
+    Check(observed_public_view_index == 1 && observed_dispatch_count == 0);
+    Check(probe.calls == 3);
+    for (const bool explicit_index : {false, true})
+    {
+        Check(RendererPostScene::NormalizeViewIndex(-1, explicit_index) == ~uint32_t{0});
+        Check(RendererPostScene::NormalizeViewIndex(std::numeric_limits<int>::min(), explicit_index) == ~uint32_t{0});
+        Check(RendererPostScene::NormalizeViewIndex(std::numeric_limits<int>::max(), explicit_index) != 0);
+    }
+    Check(RendererPostScene::NormalizeViewIndex(0, false) == ~uint32_t{0});
+    Check(api.UnregisterPostSceneCallbacks(&probe));
+}
+
+void TestEligibility(IMetaRendererPostScene& api)
+{
+    Probe probe;
+    const auto frame = Frame();
+    const auto context = EligibleContext();
+    Check(api.RegisterPostSceneCallbacks(&probe));
+    Check(RendererPostScene::Dispatch(context, frame) == 1);
+    Check(probe.calls == 1 && std::memcmp(&frame, &probe.seen, sizeof(frame)) == 0);
+    auto no_view = context;
+    no_view.rendering_view = false;
+    Check(RendererPostScene::Dispatch(no_view, frame) == 0);
+    const std::array invalid_stages{
+        &RendererPostScene::Context::nested_view,
+        &RendererPostScene::Context::shadow_view,
+        &RendererPostScene::Context::water_view,
+        &RendererPostScene::Context::portal_view,
+        &RendererPostScene::Context::overview,
+        &RendererPostScene::Context::only_client_draws,
+        &RendererPostScene::Context::multiview,
+        &RendererPostScene::Context::linear_depth,
+        &RendererPostScene::Context::gbuffer,
+        &RendererPostScene::Context::unresolved_oit};
+    for (auto stage : invalid_stages)
+    {
+        auto invalid = context;
+        invalid.*stage = true;
+        Check(!RendererPostScene::Eligible(invalid));
+        Check(RendererPostScene::Dispatch(invalid, frame) == 0);
+    }
+    auto inset = context;
+    inset.view_index = 1;
+    Check(RendererPostScene::Dispatch(inset, frame) == 0);
+    inset.view_index = ~uint32_t{0};
+    Check(RendererPostScene::Dispatch(inset, frame) == 0);
+    Check(probe.calls == 1);
+    Check(api.UnregisterPostSceneCallbacks(&probe));
+}
+
+void TestFrames(IMetaRendererPostScene& api)
+{
+    Probe probe;
+    Check(api.RegisterPostSceneCallbacks(&probe));
+    const auto context = EligibleContext();
+    const auto baseline = Frame();
+    const auto reject = [&](const MetaRendererPostSceneFrame& frame) {
+        Check(!RendererPostScene::ValidFrame(frame));
+        Check(RendererPostScene::Dispatch(context, frame) == 0);
+    };
+    auto frame = baseline;
+    frame.struct_size = sizeof(frame) - 4; reject(frame);
+    frame = baseline; frame.struct_size = sizeof(frame) + 4; reject(frame);
+    frame = baseline; frame.flags = META_POST_SCENE_HDR; reject(frame);
+    frame = baseline; frame.flags = META_POST_SCENE_GAMMA | META_POST_SCENE_LINEAR; reject(frame);
+    frame = baseline; frame.flags |= 1u << 31; reject(frame);
+    for (auto field : {&MetaRendererPostSceneFrame::framebuffer, &MetaRendererPostSceneFrame::color_texture,
+                       &MetaRendererPostSceneFrame::depth_texture, &MetaRendererPostSceneFrame::depth_sample_texture,
+                       &MetaRendererPostSceneFrame::width, &MetaRendererPostSceneFrame::height})
+    {
+        frame = baseline; frame.*field = 0; reject(frame);
+    }
+    frame = baseline; frame.depth_texture = frame.color_texture; reject(frame);
+    frame = baseline; frame.depth_sample_texture = frame.color_texture; reject(frame);
+    frame = baseline; frame.depth_sample_texture = frame.depth_texture; reject(frame);
+    frame = baseline; frame.width = ~uint32_t{0}; reject(frame);
+    frame = baseline; frame.height = ~uint32_t{0}; reject(frame);
+    frame = baseline; frame.color_format = 0x1908; reject(frame); // unsized GL_RGBA
+    frame = baseline; frame.depth_format = 0x8CAD; reject(frame); // unsupported D32FS8
+    frame = baseline; frame.samples = 4; reject(frame);
+    frame = baseline; frame.samples = 0; reject(frame);
+    frame = baseline; frame.view_index = 1; reject(frame);
+    frame = baseline; frame.viewport[0] = -1; reject(frame);
+    frame = baseline; frame.viewport[1] = -1; reject(frame);
+    frame = baseline; frame.viewport[2] = 0; reject(frame);
+    frame = baseline; frame.viewport[3] = 0; reject(frame);
+    frame = baseline; frame.viewport[2] = 1280; reject(frame);
+    frame = baseline; frame.viewport[3] = 720; reject(frame);
+    frame = baseline; frame.viewport[0] = 0x7fffffff; frame.viewport[2] = 0x7fffffff; reject(frame);
+    frame = baseline; frame.near_plane = 0; reject(frame);
+    frame = baseline; frame.far_plane = frame.near_plane; reject(frame);
+    frame = baseline; frame.near_plane = std::numeric_limits<float>::quiet_NaN(); reject(frame);
+    frame = baseline; frame.far_plane = std::numeric_limits<float>::infinity(); reject(frame);
+    for (auto field : {&MetaRendererPostSceneFrame::world_matrix, &MetaRendererPostSceneFrame::projection_matrix,
+                       &MetaRendererPostSceneFrame::inverse_world_matrix, &MetaRendererPostSceneFrame::inverse_projection_matrix})
+    {
+        frame = baseline;
+        (frame.*field)[13] = std::numeric_limits<float>::quiet_NaN();
+        reject(frame);
+    }
+    Check(probe.calls == 0);
+    Check(RendererPostScene::Dispatch(context, baseline) == 1);
+    frame = baseline;
+    frame.flags = META_POST_SCENE_GAMMA;
+    frame.color_format = 0x8058; // GL_RGBA8
+    frame.viewport[0] = frame.viewport[1] = 0;
+    frame.viewport[2] = frame.width;
+    frame.viewport[3] = frame.height;
+    Check(RendererPostScene::Dispatch(context, frame) == 1);
+    Check(std::memcmp(&frame, &probe.seen, sizeof(frame)) == 0);
+    frame.flags |= META_POST_SCENE_HDR;
+    Check(RendererPostScene::Dispatch(context, frame) == 1);
+    Check(api.UnregisterPostSceneCallbacks(&probe));
+}
+
+void TestRegistry(IMetaRendererPostScene& api)
+{
+    const auto frame = Frame();
+    const auto context = EligibleContext();
+    Check(!api.RegisterPostSceneCallbacks(nullptr));
+    Check(!api.UnregisterPostSceneCallbacks(nullptr));
+    Check(!RendererPostScene::HasCallbacks());
+    Check(RendererPostScene::Dispatch(context, frame) == 0);
+    std::array<Probe, 17> probes{};
+    for (unsigned i = 0; i != 16; ++i) Check(api.RegisterPostSceneCallbacks(&probes[i]));
+    Check(api.RegisterPostSceneCallbacks(&probes[7])); // No duplicate slot/call.
+    Check(!api.RegisterPostSceneCallbacks(&probes[16]));
+    const size_t before = allocations;
+    for (unsigned i = 0; i != 256; ++i) Check(RendererPostScene::Dispatch(context, frame) == 16);
+    Check(allocations == before);
+    for (unsigned i = 0; i != 16; ++i)
+    {
+        Check(probes[i].calls == 256);
+        Check(api.UnregisterPostSceneCallbacks(&probes[i]));
+        Check(!api.UnregisterPostSceneCallbacks(&probes[i]));
+    }
+    Check(!RendererPostScene::HasCallbacks());
+    Check(RendererPostScene::Dispatch(context, frame) == 0);
+}
+
+void TestMutationAndRecursion(IMetaRendererPostScene& api)
+{
+    const auto frame = Frame();
+    const auto context = EligibleContext();
+    Probe first, later, added;
+    first.api = &api;
+    first.target = &later;
+    first.action = [](Probe& p, const MetaRendererPostSceneFrame& input) noexcept {
+        p.nested_result = RendererPostScene::Dispatch(EligibleContext(), input);
+        p.operation_result = p.api->UnregisterPostSceneCallbacks(p.target);
+    };
+    Check(api.RegisterPostSceneCallbacks(&first));
+    Check(api.RegisterPostSceneCallbacks(&later));
+    Check(RendererPostScene::Dispatch(context, frame) == 1);
+    Check(first.nested_result == 0 && first.operation_result && later.calls == 0);
+
+    first.target = &added;
+    first.action = [](Probe& p, const MetaRendererPostSceneFrame&) noexcept {
+        p.operation_result = p.api->RegisterPostSceneCallbacks(p.target);
+    };
+    Check(RendererPostScene::Dispatch(context, frame) == 1);
+    Check(first.operation_result && added.calls == 0);
+    first.action = nullptr;
+    Check(RendererPostScene::Dispatch(context, frame) == 2);
+    Check(added.calls == 1);
+
+    // Unregister/re-register the same object into a not-yet-visited slot must
+    // also wait for the next frame, even though its pointer is unchanged.
+    first.action = [](Probe& p, const MetaRendererPostSceneFrame&) noexcept {
+        p.operation_result = p.api->UnregisterPostSceneCallbacks(p.target) &&
+                             p.api->RegisterPostSceneCallbacks(p.target);
+    };
+    Check(RendererPostScene::Dispatch(context, frame) == 1);
+    Check(first.operation_result && added.calls == 1);
+    first.action = [](Probe& p, const MetaRendererPostSceneFrame&) noexcept {
+        p.operation_result = p.api->UnregisterPostSceneCallbacks(&p);
+    };
+    Check(RendererPostScene::Dispatch(context, frame) == 2);
+    Check(first.operation_result && added.calls == 2);
+    Check(RendererPostScene::Dispatch(context, frame) == 1);
+    Check(added.calls == 3);
+    Check(api.UnregisterPostSceneCallbacks(&added));
+    Check(!RendererPostScene::HasCallbacks());
+}
+}
+
+int main()
+{
+    int status = -1;
+    auto* api = static_cast<IMetaRendererPostScene*>(CreateInterface(METARENDERER_POST_SCENE_INTERFACE_VERSION, &status));
+    Check(api && status == IFACE_OK);
+    Check(CreateInterface(METARENDERER_POST_SCENE_INTERFACE_VERSION, nullptr) == api);
+    Check(CreateInterface("MetaRendererPostScene_API_999", &status) == nullptr && status == IFACE_FAILED);
+    TestEngineViewBoundary(*api);
+    TestEligibility(*api);
+    TestFrames(*api);
+    TestRegistry(*api);
+    TestMutationAndRecursion(*api);
+    std::printf("post-scene production factory/dispatch: %u checks; 4096 warm callbacks allocate 0\n", checks);
+}
diff --git a/tests/extract_post_scene_dispatch.py b/tests/extract_post_scene_dispatch.py
new file mode 100644
index 0000000..29d3155
--- /dev/null
+++ b/tests/extract_post_scene_dispatch.py
@@ -0,0 +1,37 @@
+"""Compile the exact GoldSrc no-argument render wrapper into the CPU fixture."""
+from pathlib import Path
+import argparse
+import hashlib
+import json
+import re
+
+parser = argparse.ArgumentParser()
+parser.add_argument("--rmain", type=Path, required=True)
+parser.add_argument("--output", type=Path, required=True)
+parser.add_argument("--manifest", type=Path, required=True)
+args = parser.parse_args()
+source = args.rmain.read_text(encoding="utf-8")
+match = re.search(r"^void R_RenderView\(void\)\s*\{", source, re.M)
+if not match:
+    raise SystemExit("Missing exact GoldSrc R_RenderView(void) production wrapper")
+depth, end = 1, match.end()
+while depth and end < len(source):
+    if source[end] == "{":
+        depth += 1
+    elif source[end] == "}":
+        depth -= 1
+    end += 1
+if depth:
+    raise SystemExit("Unterminated R_RenderView production body")
+body = source[match.start():end]
+args.output.write_text(
+    "// Exact production body extracted by extract_post_scene_dispatch.py.\n"
+    "extern int r_renderview_pass;\n"
+    "void R_RenderView_SvEngine(int viewIdx);\n\n" + body + "\n",
+    encoding="utf-8",
+)
+args.manifest.write_text(json.dumps({
+    "source": str(args.rmain),
+    "function": "R_RenderView",
+    "sha256": hashlib.sha256(body.encode()).hexdigest(),
+}, indent=2) + "\n", encoding="utf-8")
diff --git a/include/Interface/IMetaRendererSceneLights.h b/include/Interface/IMetaRendererSceneLights.h
new file mode 100644
index 0000000..d9a7260
--- /dev/null
+++ b/include/Interface/IMetaRendererSceneLights.h
@@ -0,0 +1,29 @@
+#pragma once
+#include <IMetaRendererScene.h>
+
+// Optional, independent extension: MetaRendererScene_API_001 is unchanged.
+// All methods run on the render/game thread, outside scene draw callbacks.
+struct MetaRendererSceneLight
+{
+    float origin[3]; // GoldSrc world coordinates
+    float radius;    // finite, > 0 and <= 999999 GoldSrc units
+    uint32_t color;  // 0xAABBGGRR; alpha is ignored
+};
+static_assert(sizeof(MetaRendererSceneLight) == 20);
+inline constexpr uint32_t META_SCENE_LIGHTS_MAX_COUNT = 524288;
+
+class IMetaRendererSceneLights : public IBaseInterface
+{
+public:
+    // Replace this registered Scene001 callback owner's complete light snapshot.
+    // Copies the input. Invalid input, unregistered ownership or allocation
+    // failure returns false and preserves the previous snapshot. count == 0
+    // clears this owner's lights; a nonzero count requires a valid array.
+    // Each light uses cached world and dynamic entity shadows at 256 pixels.
+    // Caller must resubmit after map changes, which clear all light snapshots.
+    virtual bool UpdateLights(IMetaRendererSceneCallbacks* owner, const MetaRendererSceneLight* lights,
+                              uint32_t count) noexcept = 0;
+    virtual void ClearLights(IMetaRendererSceneCallbacks* owner) noexcept = 0;
+};
+
+#define METARENDERER_SCENE_LIGHTS_INTERFACE_VERSION "MetaRendererSceneLights_API_001"
diff --git a/src/gl_scene_lights.cpp b/src/gl_scene_lights.cpp
new file mode 100644
index 0000000..45b0510
--- /dev/null
+++ b/src/gl_scene_lights.cpp
@@ -0,0 +1,271 @@
+#include "gl_local.h"
+#include "gl_external_scene.h"
+#include <algorithm>
+#include <array>
+#include <cmath>
+
+std::vector<std::shared_ptr<CDynamicLight>> g_ExternalDynamicLights;
+
+namespace
+{
+struct SceneLightNode
+{
+    float mins[3]{}, maxs[3]{};
+    uint32_t begin{}, end{}, right{};
+};
+
+struct SceneLightOwner
+{
+    IMetaRendererSceneCallbacks* owner{};
+    std::vector<MetaRendererSceneLight> input;
+    std::vector<std::shared_ptr<CDynamicLight>> lights;
+    std::vector<SceneLightNode> nodes;
+};
+std::array<SceneLightOwner, 16> sceneLightOwners;
+// Only lights used by a view enter this list. End-of-frame cleanup therefore
+// scans the live shadow cache, not potentially hundreds of thousands of
+// resident light descriptions. Its capacity is reserved on snapshot updates.
+std::vector<std::shared_ptr<CDynamicLight>> sceneShadowCandidates;
+
+bool SameLight(const MetaRendererSceneLight& a, const MetaRendererSceneLight& b) noexcept
+{
+    return a.origin[0] == b.origin[0] && a.origin[1] == b.origin[1] && a.origin[2] == b.origin[2] &&
+           a.radius == b.radius && (a.color & 0xffffffu) == (b.color & 0xffffffu);
+}
+
+bool LightLess(const MetaRendererSceneLight& a, const MetaRendererSceneLight& b) noexcept
+{
+    for (int axis = 0; axis < 3; ++axis)
+        if (a.origin[axis] != b.origin[axis]) return a.origin[axis] < b.origin[axis];
+    if (a.radius != b.radius) return a.radius < b.radius;
+    return (a.color & 0xffffffu) < (b.color & 0xffffffu);
+}
+
+MetaRendererSceneLight LightValue(const CDynamicLight& light) noexcept
+{
+    return {{light.origin[0], light.origin[1], light.origin[2]}, light.size, light.external_scene_color};
+}
+
+uint32_t BuildLightNodes(SceneLightOwner& state, uint32_t begin, uint32_t end)
+{
+    const auto index = static_cast<uint32_t>(state.nodes.size());
+    state.nodes.emplace_back();
+    // nodes was reserved before recursion; references stay valid.
+    auto& node = state.nodes[index];
+    node.begin = begin;
+    node.end = end;
+    if (end - begin > 16)
+    {
+        const auto middle = begin + (end - begin) / 2;
+        const auto left = BuildLightNodes(state, begin, middle);
+        node.right = BuildLightNodes(state, middle, end);
+        for (int axis = 0; axis < 3; ++axis)
+        {
+            node.mins[axis] = (std::min)(state.nodes[left].mins[axis], state.nodes[node.right].mins[axis]);
+            node.maxs[axis] = (std::max)(state.nodes[left].maxs[axis], state.nodes[node.right].maxs[axis]);
+        }
+    }
+    else
+    {
+        for (uint32_t i = begin; i < end; ++i)
+        {
+            const auto& light = *state.lights[i];
+            // The ordinary point-light path bypasses PVS/frustum checks when
+            // the eye is within radius + 32. Include that entire region here.
+            const auto extent = light.size + 32.0f;
+            for (int axis = 0; axis < 3; ++axis)
+            {
+                const auto low = light.origin[axis] - extent;
+                const auto high = light.origin[axis] + extent;
+                node.mins[axis] = i == begin ? low : (std::min)(node.mins[axis], low);
+                node.maxs[axis] = i == begin ? high : (std::max)(node.maxs[axis], high);
+            }
+        }
+    }
+    return index;
+}
+
+void RemoveVisibleOwner(IMetaRendererSceneCallbacks* owner) noexcept
+{
+    std::erase_if(g_VisibleDynamicLights, [owner](const auto& entry) {
+        return entry.m_pDynamicLight && entry.m_pDynamicLight->external_scene_owner &&
+               (!owner || entry.m_pDynamicLight->external_scene_owner == owner);
+    });
+}
+
+void AddLightNode(const SceneLightOwner& state, uint32_t index, const std::array<float, 4>& coefficients)
+{
+    const auto& node = state.nodes[index];
+    bool eyeInside = true;
+    for (int axis = 0; axis < 3; ++axis)
+        eyeInside &= (*r_refdef.vieworg)[axis] >= node.mins[axis] && (*r_refdef.vieworg)[axis] <= node.maxs[axis];
+    if (!eyeInside)
+    {
+        // The legacy engine ABI takes mutable arrays. Keep stored bounds
+        // immutable even if an engine implementation writes to its arguments.
+        vec3_t mins{node.mins[0], node.mins[1], node.mins[2]};
+        vec3_t maxs{node.maxs[0], node.maxs[1], node.maxs[2]};
+        if (R_CullBox(mins, maxs) || !triapi_BoxInPVS(mins, maxs)) return;
+    }
+    if (node.right)
+    {
+        AddLightNode(state, index + 1, coefficients);
+        AddLightNode(state, node.right, coefficients);
+        return;
+    }
+    for (uint32_t i = node.begin; i < node.end; ++i)
+    {
+        const auto& light = state.lights[i];
+        const auto visibleBefore = g_VisibleDynamicLights.size();
+        R_AddVisibleDynamicLight(light);
+        if (g_VisibleDynamicLights.size() == visibleBefore) continue;
+        light->external_scene_visible_frame = static_cast<uint32_t>(*r_framecount);
+        if (!light->external_scene_cached)
+        {
+            sceneShadowCandidates.push_back(light);
+            light->external_scene_cached = true;
+        }
+        light->ambient = coefficients[0];
+        light->diffuse = coefficients[1];
+        light->specular = coefficients[2];
+        light->specularpow = coefficients[3];
+    }
+}
+} // namespace
+
+bool R_UpdateExternalSceneLights(IMetaRendererSceneCallbacks* owner, const MetaRendererSceneLight* lights,
+                                uint32_t count) noexcept
+{
+    if (!R_IsExternalSceneOwner(owner) || count > META_SCENE_LIGHTS_MAX_COUNT || (count && !lights)) return false;
+    if (!count)
+    {
+        R_ClearExternalSceneLights(owner);
+        return true;
+    }
+    for (uint32_t i = 0; i < count; ++i)
+    {
+        if (!std::isfinite(lights[i].radius) || lights[i].radius <= 0 || lights[i].radius > 999999) return false;
+        for (float coordinate : lights[i].origin)
+            if (!std::isfinite(coordinate) || !std::isfinite(coordinate - (lights[i].radius + 32.0f)) ||
+                !std::isfinite(coordinate + (lights[i].radius + 32.0f))) return false;
+    }
+    auto existing = std::find_if(sceneLightOwners.begin(), sceneLightOwners.end(),
+        [owner](const auto& state) { return state.owner == owner; });
+    if (existing != sceneLightOwners.end() && existing->input.size() == count &&
+        std::equal(existing->input.begin(), existing->input.end(), lights, SameLight)) return true;
+    auto destination = existing;
+    if (destination == sceneLightOwners.end())
+        destination = std::find_if(sceneLightOwners.begin(), sceneLightOwners.end(),
+            [](const auto& state) { return !state.owner; });
+    if (destination == sceneLightOwners.end()) return false;
+    try
+    {
+        SceneLightOwner candidate;
+        candidate.owner = owner;
+        candidate.input.assign(lights, lights + count);
+        auto sorted = candidate.input;
+        std::sort(sorted.begin(), sorted.end(), LightLess);
+        candidate.lights.reserve(count);
+        size_t oldIndex = 0;
+        for (const auto& value : sorted)
+        {
+            std::shared_ptr<CDynamicLight> light;
+            if (existing != sceneLightOwners.end())
+            {
+                while (oldIndex < existing->lights.size() && LightLess(LightValue(*existing->lights[oldIndex]), value)) ++oldIndex;
+                if (oldIndex < existing->lights.size() && SameLight(LightValue(*existing->lights[oldIndex]), value))
+                    light = existing->lights[oldIndex++];
+            }
+            if (!light)
+            {
+                light = std::make_shared<CDynamicLight>();
+                light->type = DynamicLightType_Point;
+                for (int axis = 0; axis < 3; ++axis)
+                {
+                    light->origin[axis] = value.origin[axis];
+                    light->color[axis] = float((value.color >> (axis * 8)) & 255u) / 255.0f;
+                }
+                light->size = value.radius;
+                light->static_shadow_size = light->dynamic_shadow_size = 256;
+                light->shadow = 1;
+                light->external_scene_owner = owner;
+                light->external_scene_color = value.color & 0xffffffu;
+            }
+            candidate.lights.push_back(std::move(light));
+        }
+        // Balanced leaves contain 8..16 lights (except the single root leaf).
+        candidate.nodes.reserve(2 * ((count + 7) / 8));
+        BuildLightNodes(candidate, 0, count);
+        std::vector<std::shared_ptr<CDynamicLight>> combined;
+        combined.reserve(g_ExternalDynamicLights.size() - destination->lights.size() + count);
+        for (const auto& state : sceneLightOwners)
+            if (state.owner != owner) combined.insert(combined.end(), state.lights.begin(), state.lights.end());
+        combined.insert(combined.end(), candidate.lights.begin(), candidate.lights.end());
+        // Preallocate the visible list on snapshot updates, not on every view.
+        g_VisibleDynamicLights.reserve(g_BSPDynamicLights.size() + g_EngineDynamicLights.size() + combined.size());
+        sceneShadowCandidates.reserve(combined.size());
+        RemoveVisibleOwner(owner);
+        for (const auto& light : destination->lights) light->external_scene_resident = false;
+        for (const auto& light : candidate.lights) light->external_scene_resident = true;
+        std::erase_if(sceneShadowCandidates, [](const auto& light) { return !light->external_scene_resident; });
+        *destination = std::move(candidate);
+        g_ExternalDynamicLights.swap(combined);
+        return true;
+    }
+    catch (...)
+    {
+        return false;
+    }
+}
+
+void R_ClearExternalSceneLights(IMetaRendererSceneCallbacks* owner) noexcept
+{
+    if (!owner) return;
+    RemoveVisibleOwner(owner);
+    std::erase_if(sceneShadowCandidates, [owner](const auto& light) { return light->external_scene_owner == owner; });
+    std::erase_if(g_ExternalDynamicLights, [owner](const auto& light) { return light->external_scene_owner == owner; });
+    for (auto& state : sceneLightOwners)
+        if (state.owner == owner) state = {};
+}
+
+void R_ResetExternalSceneLights() noexcept
+{
+    RemoveVisibleOwner(nullptr);
+    sceneShadowCandidates.clear();
+    g_ExternalDynamicLights.clear();
+    for (auto& state : sceneLightOwners) state = {};
+}
+
+void R_AddVisibleExternalSceneLights()
+{
+    if (g_ExternalDynamicLights.empty()) return;
+    const std::array<float, 4> coefficients{r_dynlight_ambient->GetValue(), r_dynlight_diffuse->GetValue(),
+        r_dynlight_specular->GetValue(), r_dynlight_specularpow->GetValue()};
+    for (const auto& state : sceneLightOwners)
+        if (!state.nodes.empty()) AddLightNode(state, 0, coefficients);
+}
+
+void R_EndExternalSceneLightsFrame() noexcept
+{
+    const auto frame = static_cast<uint32_t>(*r_framecount);
+    std::erase_if(sceneShadowCandidates, [frame](const auto& light) {
+        if (light->external_scene_visible_frame == frame) return false;
+        // Every view has finished. Keep the CPU descriptor and full 256-pixel
+        // shadow settings; revisiting the light creates its textures lazily.
+        light->pStaticShadowTexture.reset();
+        light->pDynamicShadowTexture.reset();
+        light->external_scene_cached = false;
+        return true;
+    });
+}
+
+class CMetaRendererSceneLights : public IMetaRendererSceneLights
+{
+public:
+    bool UpdateLights(IMetaRendererSceneCallbacks* owner, const MetaRendererSceneLight* lights, uint32_t count) noexcept override
+    {
+        return R_UpdateExternalSceneLights(owner, lights, count);
+    }
+    void ClearLights(IMetaRendererSceneCallbacks* owner) noexcept override { R_ClearExternalSceneLights(owner); }
+};
+EXPOSE_SINGLE_INTERFACE(CMetaRendererSceneLights, IMetaRendererSceneLights, METARENDERER_SCENE_LIGHTS_INTERFACE_VERSION);
diff --git a/tests/extract_scene_lights_dispatch.py b/tests/extract_scene_lights_dispatch.py
new file mode 100644
index 0000000..faee9b8
--- /dev/null
+++ b/tests/extract_scene_lights_dispatch.py
@@ -0,0 +1,62 @@
+"""Extract complete production visibility, view dispatch and shadow invalidation.
+
+The test substitutes host view/PVS queries and shadow-texture objects, not the
+light selection or snapshot implementation. Lifecycle wiring is checked here;
+actual engine map change and rendered pixels remain runtime validation.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument("--src", type=Path, required=True)
+parser.add_argument("--output", type=Path, required=True)
+parser.add_argument("--manifest", type=Path, required=True)
+args = parser.parse_args()
+
+
+def function(source, signature):
+    if source.count(signature) != 1:
+        raise SystemExit("Missing or ambiguous production function: " + signature)
+    start = source.index(signature)
+    opening = source.index("{", start)
+    depth = 1
+    position = opening + 1
+    while depth:
+        depth += (source[position] == "{") - (source[position] == "}")
+        position += 1
+    return source[start:position]
+
+
+sources = {name: (args.src / name).read_text(encoding="utf-8-sig")
+           for name in ("gl_light.cpp", "gl_rmain.cpp", "gl_wsurf.cpp", "world_edit_cache.cpp", "gl_cvar.cpp")}
+parts = [function(sources[filename], signature) for filename, signature in (
+    ("gl_light.cpp", "bool Util_IsOriginInCone("),
+    ("gl_light.cpp", "void R_AddVisibleDynamicLight("),
+    ("gl_rmain.cpp", "void R_RenderViewStart()"),
+    ("world_edit_cache.cpp", "void R_InvalidateWorldShadowCaches("),
+    ("gl_cvar.cpp", "MapConVar::MapConVar("),
+    ("gl_cvar.cpp", "MapConVar::~MapConVar("),
+    ("gl_cvar.cpp", "float* MapConVar::GetValues("),
+    ("gl_cvar.cpp", "float MapConVar::GetValue("),
+    ("gl_cvar.cpp", "float* MapConVar::GetRawCvarValues("),
+)]
+for filename, signature, call in (
+    ("gl_light.cpp", "void R_ShutdownLight(void)", "R_ResetExternalSceneLights();"),
+    ("gl_rmain.cpp", "void R_NewMap(void)", "R_FreeWorldResources();"),
+    ("gl_wsurf.cpp", "void R_FreeWorldResources(void)", "R_ResetExternalSceneLights();"),
+    ("gl_rmain.cpp", "void R_Shutdown(void)", "R_ShutdownLight();"),
+    ("gl_rmain.cpp", "void R_RenderEndFrame()", "R_EndExternalSceneLightsFrame();"),
+    ("gl_rmain.cpp", "void GL_EndRendering(void)", "R_RenderEndFrame();"),
+):
+    if function(sources[filename], signature).count(call) != 1:
+        raise SystemExit("Missing lifecycle hook: " + signature + " -> " + call)
+body = "\n\n".join(parts) + "\n"
+args.output.parent.mkdir(parents=True, exist_ok=True)
+args.output.write_text(body, encoding="utf-8")
+args.manifest.write_text(json.dumps({
+    "sourceSha256": {name: hashlib.sha256((args.src / name).read_bytes()).hexdigest() for name in sources},
+    "extractedSha256": hashlib.sha256(body.encode()).hexdigest(),
+    "boundary": "Complete production visibility/view/light invalidation; host PVS/frustum and texture objects adapted; lifecycle hooks checked, no rendered pixels.",
+}, indent=2) + "\n", encoding="utf-8")
