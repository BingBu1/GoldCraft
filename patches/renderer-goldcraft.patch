+// Keep actual GLEW pointers visible to the production capability checks.
+// Replacement functions forward to the original driver except sync injection.
+struct DriverProbe
+{
+    DriverProbe()
+    {
+        calls = {}; arenaBuffers.clear(); arenaFences.clear(); waitInjection = WaitInjection::None;
+#define PROBE(name) real##name = __glew##name; __glew##name = Count##name
+        PROBE(GenBuffers); PROBE(DeleteBuffers); PROBE(BufferStorage); PROBE(MapBufferRange);
+        PROBE(UnmapBuffer); PROBE(BufferData); PROBE(BufferSubData); PROBE(BindBufferRange);
+        PROBE(FenceSync); PROBE(ClientWaitSync); PROBE(DeleteSync);
+#undef PROBE
+        realNamedBufferSubData = __glewNamedBufferSubData;
+        if (realNamedBufferSubData) __glewNamedBufferSubData = CountNamedBufferSubData;
+    }
+    ~DriverProbe()
+    {
+#define RESTORE(name) __glew##name = real##name
+        RESTORE(GenBuffers); RESTORE(DeleteBuffers); RESTORE(BufferStorage); RESTORE(MapBufferRange);
+        RESTORE(UnmapBuffer); RESTORE(BufferData); RESTORE(BufferSubData); RESTORE(NamedBufferSubData);
+        RESTORE(BindBufferRange); RESTORE(FenceSync); RESTORE(ClientWaitSync); RESTORE(DeleteSync);
+#undef RESTORE
