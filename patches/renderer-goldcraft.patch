+    assert(staticWorldCompletionCalls == 0 && !staticWorldComplete);
+    noVis->m_bIsClosing.store(false);
+    holdWork = false;
+    SetEvent(resume);
+    Finish(model);
+    draw(model);
+    assert(staticWorldCompletionCalls == 1 && staticWorldComplete);
