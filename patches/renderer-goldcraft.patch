+// Observer effects operate on illumination, before material albedo. A small
+// light floor handles GoldSrc's genuinely black lightmaps like vanilla's floor.
+vec4 ApplyStatusLighting(vec4 light)
+{
+    float night = SceneUBO.statusVision.x;
+    if (night > 0.0) {
+        vec3 base = max(light.rgb, vec3(0.03));
+        float peak = max(base.r, max(base.g, base.b));
+        if (peak < 1.0) light.rgb = mix(light.rgb, base / peak, night);
+    }
+    light.rgb = max(vec3(0.0), light.rgb - vec3(SceneUBO.statusVision.w));
+    return light;
+}
+
+vec4 ApplyStatusFog(vec4 color, float fragmentDistance, bool sky)
+{
+    float blindness = SceneUBO.statusVision.y;
+    float darkness = SceneUBO.statusVision.z;
+    if (blindness <= 0.0 && darkness <= 0.0) return color;
+    float farPlane = max(1.0, GetCameraZFar(GetCameraViewIndex()));
+    // GoldCraft uses 32 GoldSrc units per Minecraft block. Blindness wins.
+    float end = mix(farPlane, min(farPlane, (blindness > 0.0 ? 5.0 : 15.0) * 32.0),
+                    blindness > 0.0 ? blindness : darkness);
+    float start = sky ? 0.0 : end * (blindness > 0.0 ? 0.25 : 0.75);
+    if (sky && blindness > 0.0) end *= 0.8;
+    color.rgb *= clamp((end - fragmentDistance) / max(end - start, 0.001), 0.0, 1.0);
+    return color;
+}
+
+vec4 CalcFog(vec4 color, float fragmentDistance)
+{
+    return ApplyStatusFog(CalcMapFog(color, fragmentDistance), fragmentDistance, false);
+}
