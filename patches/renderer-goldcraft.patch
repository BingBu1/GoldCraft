+        });
+        const auto  drainStart = std::chrono::steady_clock::now();
+        R_DrainWorldLeafTasks(&scene.model);
+        release.join();
+        holdWork           = false;
+        const auto drainMs = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - drainStart).count();
+        R_PumpWorldLeafTasks();
+        assert(retiredLeaf.expired() && liveWork == 0 && uploads == beforeUploads && drainMs >= 20);
+        std::printf("{\"worldLeafGL\":true,\"cavityCommands\":%zu,\"cavityBatches\":%zu,\"cavityPixels\":%zu,\"preservedPixels\":%zu,\"uploadsDuringDraw\":0,\"allocationsDuringDraw\":0,\"vaoBindsPerFrame\":4,\"indirectBindsPerFrame\":4,\"opaqueShadowSubmissions\":1,\"alphaShadowBatches\":6,\"submitUsPerFrame\":%.3f,\"emptyLeafReady\":true,\"removedFaceOmitted\":true,\"sealedCavityView\":true,\"crossGenerationRejected\":true,\"gpuFailureRecovered\":true,\"workerFailureRecovered\":true,\"retireNonblocking\":true,\"unloadWaitMs\":%.3f,\"lateUploadBlocked\":true,\"workerObjectsReleased\":%zu,\"passed\":true}\n",
+                    cavityCommands, cavityChains, red, green, submitUs, drainMs, deletedWork);
+        R_DrainWorldLeafTasks();
+    }
+    StaticWorldCompletionIntegration();
+    EditIntegration();
+    BrushEditIntegration();
+    joint_edit_test::run();
+    DecalDispatchIntegration();
+    glDeleteProgram(shader);
+    assert(liveWork == 0 && glGetError() == GL_NO_ERROR);
+    CloseHandle(entered);
+    CloseHandle(resume);
+    CloseHandle(draining);
+    glfwDestroyWindow(window);
+    glfwTerminate();
+}
diff --git a/src/world_material_batch.h b/src/world_material_batch.h
new file mode 100644
index 0000000..f3a992c
--- /dev/null
+++ b/src/world_material_batch.h
@@ -0,0 +1,50 @@
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <limits>
+#include <span>
+#include <vector>
+
+// Immutable submission ranges, prepared with each leaf's indirect commands.
+// Texture units 9..14 leave the original material/lightmap bindings intact.
+namespace world_batch
+{
+inline constexpr unsigned TextureCount = 6;
+inline constexpr unsigned TextureUnit = 9;
+inline constexpr unsigned CommandBytes = 20;
+
+struct Batch
+{
+    std::size_t firstChain{};
+    unsigned chainCount{}, offset{}, drawCount{}, polyCount{};
+    std::array<unsigned, TextureCount> drawEnds{};
+};
+
+template<class Chain>
+std::vector<Batch> Prepare(std::span<const Chain> chains)
+{
+    std::vector<Batch> result;
+    for (std::size_t first = 0; first < chains.size();)
+    {
+        Batch batch{};
+        batch.firstChain = first;
+        batch.offset = chains[first].startDrawOffset;
+        while (first + batch.chainCount < chains.size() && batch.chainCount < TextureCount)
+        {
+            const auto& chain = chains[first + batch.chainCount];
+            const auto expected = std::uint64_t(batch.offset) + std::uint64_t(batch.drawCount) * CommandBytes;
+            if (!chain.drawCount || chain.cavityLighting != chains[first].cavityLighting ||
+                chain.startDrawOffset != expected ||
+                std::uint64_t(batch.drawCount) + chain.drawCount > std::uint64_t((std::numeric_limits<int>::max)()) ||
+                std::uint64_t(batch.polyCount) + chain.polyCount > (std::numeric_limits<unsigned>::max)()) break;
+            batch.drawCount += chain.drawCount;
+            batch.polyCount += chain.polyCount;
+            batch.drawEnds[batch.chainCount++] = batch.drawCount;
+        }
+        if (batch.chainCount > 1) result.push_back(batch);
+        first += batch.chainCount ? batch.chainCount : 1;
+    }
+    return result;
+}
+} // namespace world_batch
