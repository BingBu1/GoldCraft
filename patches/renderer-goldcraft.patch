+                    for (int c = 0; c < 4; ++c)
+                        assert(std::abs(filled[attachment][pixel + c] - before[attachment][pixel + c]) < .00002f);
+        }
+    auto cavity_restored = R_PrepareCarvedWorldGeometry(cavity, {});
+    assert(cavity_restored->m_vCavityDraws.empty() && cavity_restored->m_pSurfaceMesh == original->m_pOriginalMesh);
+    assert(Draw(*cavity_restored, true) == before);
+    // The command buffer contains actual GPU-visible ranges and base instances.
+    glBindBuffer(GL_DRAW_INDIRECT_BUFFER, cavity->m_hCavityABO);
+    CDrawIndexAttrib command{};
+    glGetBufferSubData(GL_DRAW_INDIRECT_BUFFER, 0, sizeof(command), &command);
+    const auto& cavity_draw = cavity->m_vCavityDraws[0];
+    assert(command.NumIndices == cavity_draw.indices.count && command.NumInstances == cavity_draw.instances.count);
+    assert(command.FirstIndexLocation == cavity_draw.indices.first && command.BaseVertex == 0 &&
+        command.FirstInstanceLocation == cavity_draw.instances.first);
+    auto split = std::make_shared<CWorldSurfaceWorldModel>(&model);
+    split->m_pOriginalMesh = original->m_pOriginalMesh;
+    split->m_pSurfaceMesh = cavity->m_pSurfaceMesh;
+    split->m_vFaceBuffer = cavity->m_vFaceBuffer;
+    split->m_vCavityDraws = {cavity_draw, cavity_draw};
+    const uint32_t half = (cavity_draw.indices.count / 6) * 3;
+    split->m_vCavityDraws[0].indices.count = half;
+    split->m_vCavityDraws[1].indices.first += half;
+    split->m_vCavityDraws[1].indices.count -= half;
+    R_UploadWorldSurfaceGeometry(*split);
+    real_multi_draw = glMultiDrawElementsIndirect;
+    glMultiDrawElementsIndirect = MultiDraw;
+    submissions = 0;
+    assert(Draw(*split, true) == filled && submissions == 1);
+    // Replaying just the second command uses its nonzero indirect byte offset.
+    (void)Draw(*split);
+    R_DrawCavityGeometry(*split, 1, 1);
+    R_DrawCavityGeometry(*split, 0, 1);
+    assert(Readback() == filled);
+    bool invalid_range = false;
+    try { R_DrawCavityGeometry(*split, 1, 2); }
+    catch (const std::out_of_range&) { invalid_range = true; }
+    assert(invalid_range);
+    glMultiDrawElementsIndirect = real_multi_draw;
+    // Many same-material cuts collapse to one draw range. GPU/CPU timings are
+    // observations of this hidden fixture, never a claim about in-game FPS.
+    std::vector<goldcraft::carving::Box> many;
+    for (int y = 0; y < 8; ++y)
+        for (int x = 0; x < 8; ++x)
+            many.push_back({{double(x * 16 + 4), double(y * 16 + 4), -8},
+                            {double(x * 16 + 12), double(y * 16 + 12), 8}});
+    const goldcraft::cavity::Model many_cuts{0, 1, {planes, nodes, 0}, many};
+    const auto prepare_start = std::chrono::steady_clock::now();
+    auto many_cavities = R_PrepareCarvedWorldGeometry(original, {&many_cuts, 1});
+    const auto prepare_us = std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - prepare_start).count();
+    assert(many_cavities->m_vCavityDraws.size() == 1);
+    (void)Draw(*many_cavities, true);
+    glDepthFunc(GL_LEQUAL);
+    for (int warmup = 0; warmup < 32; ++warmup) R_DrawCavityGeometry(*many_cavities, 0, 1);
+    glFinish();
+    GLuint query{};
+    glGenQueries(1, &query);
+    real_storage = glBufferStorage;
+    glBufferStorage = Storage;
+    glMultiDrawElementsIndirect = MultiDraw;
+    uploads = submissions = 0;
+    constexpr int batches = 256;
+    glBeginQuery(GL_TIME_ELAPSED, query);
+    const auto submit_start = std::chrono::steady_clock::now();
+    for (int batch = 0; batch < batches; ++batch) R_DrawCavityGeometry(*many_cavities, 0, 1);
+    const auto submit_us = std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - submit_start).count();
+    glEndQuery(GL_TIME_ELAPSED);
+    GLuint64 gpu_ns{};
+    glGetQueryObjectui64v(query, GL_QUERY_RESULT, &gpu_ns); // Test-only fence after the complete batch.
+    assert(uploads == 0 && submissions == batches && gpu_ns > 0);
+    glBufferStorage = real_storage;
+    glMultiDrawElementsIndirect = real_multi_draw;
+    glDeleteQueries(1, &query);
+    glDepthFunc(GL_LESS);
+    std::printf("{\"cavityPerformance\":true,\"cuts\":64,\"drawsPerBatch\":1,\"batches\":%d,\"uploadsDuringDraw\":%zu,\"prepareCpuUs\":%.3f,\"submitCpuUsPerBatch\":%.3f,\"gpuUsPerBatch\":%.3f}\n",
+        batches, uploads, prepare_us, submit_us / batches, double(gpu_ns) / batches / 1000);
+    glBindVertexArray(sentinel);
+    glBindBuffer(GL_DRAW_INDIRECT_BUFFER, buffers[2]);
+    real_storage = glBufferStorage;
+    assert(real_storage);
+    glBufferStorage = Storage;
+    failure_after = 5;
+    bool rejected   = false;
+    try
+    {
+        (void)R_PrepareCarvedWorldGeometry(original, {&carve, 1});
+    }
+    catch (const std::runtime_error&)
+    {
+        rejected = true;
+    }
+    glBufferStorage = real_storage;
+    assert(rejected && failed_buffer && !glIsBuffer(failed_buffer));
+    assert(attempted_buffers.size() == 5);
+    for (const auto buffer : attempted_buffers) assert(!glIsBuffer(buffer));
+    Bindings(sentinel, buffers[0], buffers[1], buffers[2]);
+    assert(Draw(*original) == before);
+    assert(glGetError() == GL_NO_ERROR);
+    std::printf("{\"preservedPixels\":%zu,\"removedPixels\":%zu,\"cavityPixels\":%zu,\"unbakedLighting\":true,\"restored\":true,\"gpuFailureRecovered\":true,\"passed\":true}\n", preserved, removed, cavity_pixels);
+    cavity_restored.reset();
+    cavity.reset();
+    split.reset();
+    many_cavities.reset();
+    restored.reset();
+    edited.reset();
+    original.reset();
+    glDeleteProgram(shader);
+    glDeleteTextures(5, textures);
+    glDeleteFramebuffers(1, &fbo);
+    glDeleteVertexArrays(1, &sentinel);
+    glDeleteBuffers(3, buffers);
+    glfwDestroyWindow(window);
+    glfwTerminate();
+}
diff --git a/src/gl_cavity_light.cpp b/src/gl_cavity_light.cpp
new file mode 100644
index 0000000..185651f
--- /dev/null
+++ b/src/gl_cavity_light.cpp
@@ -0,0 +1,137 @@
+#include "gl_local.h"
+#include <cmath>
+#include <stdexcept>
+
+namespace
+{
+using Point = goldcraft::carving::Point;
+Point Sub(const Point& a, const Point& b) { return {a[0] - b[0], a[1] - b[1], a[2] - b[2]}; }
+Point Cross(const Point& a, const Point& b)
+{
+    return {a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]};
+}
+double Dot(const Point& a, const Point& b) { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; }
+Point Position(const goldcraft::surface::Vertex& v) { return {v.pos[0], v.pos[1], v.pos[2]}; }
+bool NearCuts(const goldcraft::carving::Box& bounds, std::span<const goldcraft::carving::Box> cuts, double radius)
+{
+    for (const auto& cut : cuts)
+    {
+        double squared = 0;
+        for (int axis = 0; axis < 3; ++axis)
+        {
+            const double gap = (std::max)(0.0, (std::max)(cut.min[axis] - bounds.max[axis], bounds.min[axis] - cut.max[axis]));
+            squared += gap * gap;
+        }
+        if (squared <= radius * radius) return true;
+    }
+    return false;
+}
+bool OnFace(const goldcraft::surface::Mesh& mesh, const goldcraft::surface::Face& face,
+    const Point& position, std::size_t& operations, std::size_t limit)
+{
+    for (std::size_t i = face.forward.first; i < std::size_t(face.forward.first) + face.forward.count; i += 3)
+    {
+        if (operations >= limit) throw std::length_error("Baked probe extraction budget");
+        ++operations;
+        const auto a = Position(mesh.vertices[mesh.indices[i]]), b = Position(mesh.vertices[mesh.indices[i + 1]]),
+                   c = Position(mesh.vertices[mesh.indices[i + 2]]);
+        const auto e1 = Sub(b, a), e2 = Sub(c, a), offset = Sub(position, a), n = Cross(e1, e2);
+        const auto squared = Dot(n, n);
+        if (squared == 0) continue;
+        const auto u = Dot(Cross(offset, e2), n) / squared, v = Dot(Cross(e1, offset), n) / squared;
+        if (u >= 0 && v >= 0 && u + v <= 1) return true;
+    }
+    return false;
+}
+} // namespace
+
+CWorldLightProbes R_CollectCavityLightProbes(const CWorldSurfaceWorldModel& original,
+    const goldcraft::cavity::Model& model, const goldcraft::lighting::Settings& settings)
+{
+    using namespace goldcraft;
+    if (!original.m_model || !original.m_model->surfaces || !original.m_pOriginalMesh ||
+        original.m_model->numsurfaces < 0 || model.first_face > std::size_t(original.m_model->numsurfaces) ||
+        model.face_count > std::size_t(original.m_model->numsurfaces) - model.first_face ||
+        model.first_face > original.m_pOriginalMesh->faces.size() ||
+        model.face_count > original.m_pOriginalMesh->faces.size() - model.first_face)
+        throw std::invalid_argument("Missing original BSP baked surfaces");
+    const auto& mesh = *original.m_pOriginalMesh;
+    if (!std::isfinite(settings.radius) || settings.radius <= 0 || settings.radius > 65536)
+        throw std::invalid_argument("BSP probe radius");
+    std::size_t operations = carving::validate_hull(model.hull, {settings.mesh.fragments, settings.mesh.operations});
+    CWorldLightProbes result;
+    for (std::size_t index = model.first_face; index < std::size_t(model.first_face) + model.face_count; ++index)
+    {
+        const auto& face = mesh.faces[index];
+        const auto& surface = *R_GetWorldSurfaceByIndex(original.m_model, static_cast<int>(index));
+        // Sky/water have no appropriate receiver luxels. Missing samples are
+        // unknown lighting, never the fullbright fallback of R_BuildLightMap.
+        if (!face.editable || !face.forward.count || !surface.samples) continue;
+        if (!surface.texinfo || !surface.plane || face.forward.count % 3 ||
+            face.forward.first > mesh.indices.size() || face.forward.count > mesh.indices.size() - face.forward.first)
+            throw std::invalid_argument("Invalid BSP probe surface");
+        for (std::size_t at = face.forward.first; at < std::size_t(face.forward.first) + face.forward.count; ++at)
+            if (mesh.indices[at] >= mesh.vertices.size()) throw std::invalid_argument("Invalid BSP probe vertex");
+        if (face.forward.count + model.boxes.size() > settings.mesh.operations - operations)
+            throw std::length_error("BSP probe bounds budget");
+        operations += face.forward.count + model.boxes.size();
+        carving::Box bounds{Position(mesh.vertices[mesh.indices[face.forward.first]]), Position(mesh.vertices[mesh.indices[face.forward.first]])};
+        for (std::size_t at = face.forward.first; at < std::size_t(face.forward.first) + face.forward.count; ++at)
+            for (int axis = 0; axis < 3; ++axis)
+            {
+                bounds.min[axis] = (std::min)(bounds.min[axis], double(mesh.vertices[mesh.indices[at]].pos[axis]));
+                bounds.max[axis] = (std::max)(bounds.max[axis], double(mesh.vertices[mesh.indices[at]].pos[axis]));
+            }
+        // Only probes within radius of some cavity can contribute. Cull whole
+        // original faces before luxel extraction and tree construction.
+        if (!NearCuts(bounds, model.boxes, settings.radius + .03125)) continue;
+        const Point s{surface.texinfo->vecs[0][0], surface.texinfo->vecs[0][1], surface.texinfo->vecs[0][2]},
+                    t{surface.texinfo->vecs[1][0], surface.texinfo->vecs[1][1], surface.texinfo->vecs[1][2]},
+                    n{surface.plane->normal[0], surface.plane->normal[1], surface.plane->normal[2]};
+        const auto tn = Cross(t, n), ns = Cross(n, s), st = Cross(s, t);
+        const double determinant = Dot(s, tn), direction = (surface.flags & SURF_PLANEBACK) ? -1 : 1;
+        if (!std::isfinite(determinant) || std::abs(determinant) < 1e-12)
+            throw std::invalid_argument("Singular BSP lightmap projection");
+        if (surface.extents[0] < 0 || surface.extents[1] < 0)
+            throw std::invalid_argument("Invalid BSP lightmap extents");
+        const auto width = (surface.extents[0] >> 4) + 1, height = (surface.extents[1] >> 4) + 1;
+        const auto size = std::size_t(width) * height;
+        if (size > settings.probes || size > settings.mesh.operations - operations)
+            throw std::length_error("BSP lightmap extraction capacity");
+        operations += size;
+        const auto* samples = reinterpret_cast<const color24*>(surface.samples);
+        for (int y = 0; y < height; ++y) for (int x = 0; x < width; ++x)
+        {
+            const double u = surface.texturemins[0] + x * 16.0 - surface.texinfo->vecs[0][3],
+                         v = surface.texturemins[1] + y * 16.0 - surface.texinfo->vecs[1][3];
+            Point position{}, probe{};
+            for (int axis = 0; axis < 3; ++axis)
+            {
+                position[axis] = (tn[axis] * u + ns[axis] * v + st[axis] * surface.plane->dist) / determinant;
+                probe[axis] = position[axis] + n[axis] * direction * .03125;
+            }
+            if (model.boxes.size() > settings.mesh.operations - operations)
+                throw std::length_error("BSP probe neighbourhood budget");
+            operations += model.boxes.size();
+            if (!NearCuts({probe, probe}, model.boxes, settings.radius)) continue;
+            // Reject atlas padding and offsets that cross thin solids. The
+            // probe is an original air-side irradiance sample, not an emitter.
+            if (!OnFace(mesh, face, position, operations, settings.mesh.operations) ||
+                !lighting::visible(model.hull, {}, position, probe, operations, settings.mesh.operations)) continue;
+            const auto first = static_cast<std::uint32_t>(result.values.size());
+            for (std::size_t style = 0; style < MAXLIGHTMAPS; ++style)
+            {
+                if (surface.styles[style] == 255) continue;
+                if (result.values.size() >= settings.values) throw std::length_error("BSP probe style capacity");
+                const auto& color = samples[style * size + std::size_t(y) * width + x];
+                result.values.push_back({{color.r / 255.f, color.g / 255.f, color.b / 255.f}, surface.styles[style]});
+            }
+            if (result.values.size() > first)
+            {
+                if (result.probes.size() >= settings.probes) throw std::length_error("BSP probe capacity");
+                result.probes.push_back({probe, {first, static_cast<std::uint32_t>(result.values.size()) - first}});
+            }
+        }
+    }
+    return result;
+}
diff --git a/src/world_surface_access.cpp b/src/world_surface_access.cpp
new file mode 100644
index 0000000..61ba839
--- /dev/null
+++ b/src/world_surface_access.cpp
@@ -0,0 +1,42 @@
+#include "gl_local.h"
+
+// Keep all BSP surface indexing on the same engine-specific stride. HL25
+// extends each record; the shared model_t still exposes an msurface_t pointer.
+msurface_t* R_GetWorldSurfaceByIndex(model_t* mod, int index)
+{
+    msurface_t* surf;
+
+    if (g_iEngineType == ENGINE_GOLDSRC_HL25)
+    {
+        surf = (((msurface_hl25_t*)mod->surfaces) + index);
+    }
+    else
+    {
+        surf = mod->surfaces + index;
+    }
+
+    return surf;
+}
+
+int R_GetWorldSurfaceIndex(model_t* mod, msurface_t* surf)
+{
+    if (g_iEngineType == ENGINE_GOLDSRC_HL25)
+    {
+        auto surf25   = (msurface_hl25_t*)surf;
+        auto surfbase = (msurface_hl25_t*)mod->surfaces;
+        auto surfend  = surfbase + mod->numsurfaces;
+
+        if (surf25 >= surfbase && surf25 < surfend)
+            return surf25 - surfbase;
+
+        return -1;
+    }
+
+    auto surfbase = mod->surfaces;
+    auto surfend  = surfbase + mod->numsurfaces;
+
+    if (surf >= surfbase && surf < surfend)
+        return surf - surfbase;
+
+    return -1;
+}
diff --git a/tests/cavity_lighting_gl_tests.cpp b/tests/cavity_lighting_gl_tests.cpp
new file mode 100644
index 0000000..63336c0
--- /dev/null
+++ b/tests/cavity_lighting_gl_tests.cpp
@@ -0,0 +1,303 @@
+// Actual world shaders, BSP luxel extraction and candidate resources on a
+// hidden driver-backed GL context. No desktop input or game process is used.
+#include "../src/gl_local.h"
+#include <GLFW/glfw3.h>
+#include <array>
+#include <cassert>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <fstream>
+#include <sstream>
+#include <source_location>
+#include <stdexcept>
+#include "cavity_map_fixture.h"
+
+int g_iEngineType = ENGINE_GOLDSRC;
+
+namespace
+{
+constexpr int Size = 64;
+using Pixels = std::vector<float>;
+PFNGLBUFFERSTORAGEPROC realStorage;
+PFNGLBUFFERDATAPROC realData;
+PFNGLBUFFERSUBDATAPROC realSubData;
+std::size_t uploads{};
+int failureAfter{};
+std::vector<GLuint> allocations;
+void APIENTRY Storage(GLenum target, GLsizeiptr size, const void* data, GLbitfield flags)
+{
+    ++uploads;
+    if (failureAfter)
+    {
+        GLint bound{};
+        glGetIntegerv(target == GL_ARRAY_BUFFER ? GL_ARRAY_BUFFER_BINDING :
+            (target == GL_DRAW_INDIRECT_BUFFER ? GL_DRAW_INDIRECT_BUFFER_BINDING : GL_ELEMENT_ARRAY_BUFFER_BINDING), &bound);
+        allocations.push_back(bound);
+        if (--failureAfter == 0) size = -1;
+    }
+    realStorage(target, size, data, flags);
+}
+void APIENTRY Data(GLenum target, GLsizeiptr size, const void* data, GLenum usage)
+{
+    ++uploads; realData(target, size, data, usage);
+}
+void APIENTRY SubData(GLenum target, GLintptr offset, GLsizeiptr size, const void* data)
+{
+    ++uploads; realSubData(target, offset, size, data);
+}
+std::string Read(const std::string& name)
+{
+    std::ifstream file(std::string(RENDERER_SHADER_DIRECTORY) + "/" + name);
+    assert(file.good());
+    std::ostringstream text; text << file.rdbuf(); return text.str();
+}
+GLuint Stage(GLenum type, const char* name, const std::string& definitions)
+{
+    auto source = Read(name);
+    const auto include = source.find("#include \"common.h\"");
+    assert(include != std::string::npos);
+    source.replace(include, std::strlen("#include \"common.h\""), Read("common.h"));
+    source.insert(source.find('\n') + 1, definitions + (type == GL_FRAGMENT_SHADER ? "#define IS_FRAGMENT_SHADER\n" : ""));
+    const auto shader = glCreateShader(type);
+    const auto* text = source.c_str();
+    glShaderSource(shader, 1, &text, nullptr); glCompileShader(shader);
+    GLint ok{}; glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+    if (!ok) { char log[8192]{}; glGetShaderInfoLog(shader, sizeof(log), nullptr, log); std::fprintf(stderr, "%s: %s\n", name, log); }
+    assert(ok); return shader;
+}
+GLuint Program(const std::string& definitions, bool geometry = false)
+{
+    const auto program = glCreateProgram();
+    const std::array stages{Stage(GL_VERTEX_SHADER, "wsurf_shader.vert.glsl", definitions),
+        Stage(GL_FRAGMENT_SHADER, "wsurf_shader.frag.glsl", definitions),
+        geometry ? Stage(GL_GEOMETRY_SHADER, "wsurf_shader.geom.glsl", definitions) : 0u};
+    for (auto shader : stages) if (shader) glAttachShader(program, shader);
+    glLinkProgram(program);
+    GLint ok{}; glGetProgramiv(program, GL_LINK_STATUS, &ok);
+    if (!ok) { char log[8192]{}; glGetProgramInfoLog(program, sizeof(log), nullptr, log); std::fprintf(stderr, "%s\n", log); }
+    assert(ok);
+    for (auto shader : stages) if (shader) glDeleteShader(shader);
+    return program;
+}
+Pixels Readback(unsigned attachment)
+{
+    Pixels pixels(Size*Size*4);
+    glReadBuffer(GL_COLOR_ATTACHMENT0+attachment);
+    glReadPixels(0,0,Size,Size,GL_RGBA,GL_FLOAT,pixels.data());
+    assert(glGetError() == GL_NO_ERROR); return pixels;
+}
+void Clear()
+{
+    const float zero[4]{}, depth = 1;
+    for (int i = 0; i < 4; ++i) glClearBufferfv(GL_COLOR,i,zero);
+    glClearBufferfv(GL_DEPTH,0,&depth);
+}
+void Remaining(const CWorldSurfaceWorldModel& model)
+{
+    glBindVertexArray(model.hVAO);
+    const auto& face = model.m_vFaceBuffer[0];
+    glDrawElementsInstancedBaseInstance(GL_TRIANGLES,face.index_count,GL_UNSIGNED_INT,
+        reinterpret_cast<void*>(std::size_t(face.start_index)*4),face.instance_count,face.instance_index);
+}
+void Near(float a, float b, std::source_location at=std::source_location::current())
+{
+    if (!std::isfinite(a) || std::abs(a-b)>=.00002f) std::fprintf(stderr,"line %u: %.9g != %.9g\n",at.line(),a,b);
+    assert(std::isfinite(a) && std::abs(a-b) < .00002f);
+}
+std::array<float,3> Expected(const CWorldSurfaceWorldModel& model, float style200, double x, double y)
+{
+    const auto& bake = *model.m_pCavityLighting;
+    const auto& mesh = *bake.mesh;
+    for (const auto& draw : bake.draws) for (std::size_t at = draw.indices.first; at < std::size_t(draw.indices.first)+draw.indices.count; at += 3)
+    {
+        const auto ai=mesh.indices[at], bi=mesh.indices[at+1], ci=mesh.indices[at+2];
+        const auto &a=mesh.vertices[ai], &b=mesh.vertices[bi], &c=mesh.vertices[ci];
+        if (mesh.frames[ai].normal[2] != 1) continue;
+        const double bx=b.pos[0]-a.pos[0], by=b.pos[1]-a.pos[1], cx=c.pos[0]-a.pos[0], cy=c.pos[1]-a.pos[1];
+        const double det=bx*cy-by*cx;
+        if (det == 0) continue;
+        const double u=((x-a.pos[0])*cy-(y-a.pos[1])*cx)/det, v=(bx*(y-a.pos[1])-by*(x-a.pos[0]))/det;
+        if (u < -1e-8 || v < -1e-8 || u+v > 1+1e-8) continue;
+        const std::array indices{ai,bi,ci}; const double weights[]{1-u-v,u,v};
+        std::array<float,3> result{};
+        for (int vertex=0;vertex<3;++vertex)
+        {
+            const auto range=bake.vertices[indices[vertex]];
+            for (std::size_t i=range.first;i<std::size_t(range.first)+range.count;++i)
+                for (int color=0;color<3;++color)
+                    result[color] += static_cast<float>(bake.values[i].rgb[color]*weights[vertex]*(bake.values[i].style==200?style200:1));
+        }
+        return result;
+    }
+    assert(false); return {};
+}
+} // namespace
+
+int main(int argc, char** argv)
+{
+    if (!glfwInit()) return 2;
+    glfwWindowHint(GLFW_VISIBLE,GLFW_FALSE);
+    glfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR,4); glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR,4);
+    glfwWindowHint(GLFW_OPENGL_PROFILE,GLFW_OPENGL_CORE_PROFILE);
+    auto* window=glfwCreateWindow(Size,Size,"cavity lighting regression",nullptr,nullptr);
