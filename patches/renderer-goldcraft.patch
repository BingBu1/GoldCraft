+static bool R_StudioDepthHostEligible(const StudioDepthExecutorContext& context)
+{
+    return context.enabled && context.shadowView && context.opaque && context.ordinaryMode &&
+        context.ordinaryFx && context.fullbrightAllowed && !context.externalMaterials && !context.excludedView;
+}
+
+bool R_StudioCanUseDepthExecutor(const StudioDepthExecutorContext& context)
+{
+    constexpr program_state_t allowedTextureFlags = STUDIO_NF_FLATSHADE | STUDIO_NF_FULLBRIGHT |
+        STUDIO_NF_NOMIPS | STUDIO_NF_NOOUTLINE;
+    constexpr program_state_t allowedDrawState = allowedTextureFlags | STUDIO_SHADOW_CASTER_ENABLED;
+    if (!R_StudioDepthHostEligible(context) || !context.validTexture ||
+        context.indexCount <= 0 || context.firstIndex < 0 ||
+        context.textureWidth <= 0 || context.textureHeight <= 0 ||
+        (context.textureFlags & ~allowedTextureFlags) != 0 ||
+        (context.drawState & ~allowedDrawState) != 0 || !(context.drawState & STUDIO_SHADOW_CASTER_ENABLED) ||
+        context.textureName.empty() || context.textureName.size() >= 64 ||
+        context.textureName.find('\0') != std::string_view::npos)
+        return false;
+
+    const auto beginsWith = [&](std::string_view prefix) {
+        if (context.textureName.size() < prefix.size()) return false;
+        for (size_t i = 0; i < prefix.size(); ++i)
+        {
+            const auto lower = [](char value) { return value >= 'A' && value <= 'Z' ? char(value + ('a' - 'A')) : value; };
+            if (lower(context.textureName[i]) != lower(prefix[i])) return false;
+        }
+        return true;
+    };
+    // These paths may upload remapped skins or select external/animated alpha.
+    return !beginsWith("Packed_") && !beginsWith("Remap") &&
+        !(context.textureName.size() == 11 && beginsWith("DM_Base.bmp"));
+}
+
+static StudioDepthExecutorContext R_StudioDepthHostContext(const CStudioModelRenderData* pRenderData)
+{
+    StudioDepthExecutorContext context{};
+    context.enabled = r_studio_shadow_depth_executor && r_studio_shadow_depth_executor->value == 1.0f;
+    context.shadowView = R_IsRenderingShadowView();
+    context.opaque = r_draw_opaque;
+    context.ordinaryMode = (*currententity)->curstate.rendermode == kRenderNormal;
+    context.ordinaryFx = (*currententity)->curstate.renderfx == kRenderFxNone;
+    context.externalMaterials = !pRenderData->mStudioMaterials.empty();
+    context.fullbrightAllowed = r_fullbright->value < 2;
+    // The later generic path adds these feature bits. Read the same host inputs
+    // here before that normalization rather than trusting the partial key.
+    context.excludedView = R_IsRenderingViewModel() || R_IsRenderingPreViewModel() ||
+        R_IsRenderingLowerBody() || R_IsRenderingClippedLowerBody() || R_IsRenderingFlippedViewModel() ||
+        R_IsRenderingWaterView() || R_IsRenderingPortal() || g_bPortalClipPlaneEnabled[0] ||
+        R_IsRenderingGBuffer() || R_IsRenderingGlowShellForStudioModel() ||
+        R_IsRenderingGlowColor() || R_IsRenderingGlowStencil() || R_IsRenderingGlowStencilEnableDepthTest() ||
+        R_ShouldDrawGlowStencil() || R_ShouldDrawGlowStencilEnableDepthTest() ||
+        R_ShouldDrawGlowStencilWallHack() || R_ShouldDrawGlowStencilWallHackBehindWallOnly() ||
+        R_ShouldDrawGlowColor() || R_ShouldDrawGlowColorWallHack() || R_ShouldDrawGlowColorWallHackBehindWallOnly();
+    return context;
+}
+
+static bool R_StudioDepthExecutorEligible(
+    const CStudioModelRenderData* pRenderData, const CStudioModelRenderMesh* pRenderMesh,
+    const mstudiomesh_t* pmesh, const studiohdr_t* ptexturehdr, const mstudiotexture_t* ptexture,
+    const short* pskinref, program_state_t state)
+{
+    // Off pays only the cvar check; no eligibility scans on the ordinary path.
+    if (!r_studio_shadow_depth_executor || r_studio_shadow_depth_executor->value != 1.0f)
+        return false;
+
+    auto context = R_StudioDepthHostContext(pRenderData);
+    context.indexCount = pRenderMesh->iIndiceCount;
+    context.firstIndex = pRenderMesh->iStartIndex;
+    context.drawState = state;
+
+    const int textureIndex = ptexturehdr && ptexture && pmesh ?
+        StudioResolveTextureIndex(pskinref, ptexturehdr->numskinref, ptexturehdr->numtextures, pmesh->skinref) : -1;
+    if (textureIndex >= 0 && ptexturehdr->textureindex)
+    {
+        const auto& texture = ptexture[textureIndex];
+        context.validTexture = true;
+        context.textureFlags = static_cast<program_state_t>(static_cast<uint32_t>(texture.flags));
+        context.textureWidth = texture.width;
+        context.textureHeight = texture.height;
+        const auto end = static_cast<const char*>(std::memchr(texture.name, 0, sizeof(texture.name)));
+        context.textureName = std::string_view(texture.name, end ? size_t(end - texture.name) : sizeof(texture.name));
+    }
+    return R_StudioCanUseDepthExecutor(context);
+}
+
+static void R_StudioBeginOpaqueStencil(program_state_t state)
+{
+    int stencilRef = 0;
+    if (r_draw_hasoutline) stencilRef |= STENCIL_MASK_HAS_OUTLINE;
+    if (state & (STUDIO_NF_FLATSHADE | STUDIO_NF_CELSHADE)) stencilRef |= STENCIL_MASK_HAS_FLATSHADE;
+    if (state & STUDIO_STENCIL_NO_GLOW_BLUR_ENABLED) stencilRef |= STENCIL_MASK_NO_GLOW_BLUR;
+    if (state & STUDIO_STENCIL_NO_GLOW_COLOR_ENABLED) stencilRef |= STENCIL_MASK_NO_GLOW_COLOR;
+    if ((*pstudiohdr)->flags & FMODEL_NOBLOOM) stencilRef |= STENCIL_MASK_NO_BLOOM;
+    GL_BeginStencilWrite(stencilRef, STENCIL_MASK_ALL);
+}
+
+static void R_StudioSetShadowDepthState()
+{
+    // The host StudioRenderFinal may have enabled blend before this callback.
+    glDisable(GL_CULL_FACE);
+    glDisable(GL_BLEND);
+    glDepthMask(GL_TRUE);
+}
+
+static void R_StudioSubmitMesh(const CStudioModelRenderMesh* mesh, bool usedExecutor)
+{
+    R_StudioDiagnosticsMesh();
+    {
+        RProfileScope profileScope(RProfileStage::StudioSubmit);
+        glDrawElements(GL_TRIANGLES, mesh->iIndiceCount, GL_UNSIGNED_INT, BUFFER_OFFSET(mesh->iStartIndex));
+    }
+    // Count actual valid shadow submissions; skipped/invalid meshes are not hits.
+    if (R_IsRenderingShadowView() && mesh->iIndiceCount > 0 && mesh->iStartIndex >= 0)
+        R_ProfileCountStudioDepthPath(usedExecutor);
+}
+
+static void R_StudioEndMeshDraw(program_state_t state)
+{
+    GL_UseProgram(0);
+    if (state & STUDIO_DEPTH_TEXTURE_ENABLED) GL_BindTextureUnit(STUDIO_BIND_TEXTURE_DEPTH, GL_TEXTURE_2D, 0);
+    if (state & STUDIO_MIX_DIFFUSE_TEXTURE_ENABLED) GL_BindTextureUnit(STUDIO_BIND_TEXTURE_MIX_DIFFUSE, GL_TEXTURE_2D, 0);
+    if (state & STUDIO_STENCIL_TEXTURE_ENABLED) GL_BindTextureUnit(STUDIO_BIND_TEXTURE_STENCIL, GL_TEXTURE_2D, 0);
+    if (state & STUDIO_ANIMATED_TEXTURE_ENABLED) GL_BindTextureUnit(STUDIO_BIND_TEXTURE_ANIMATED, GL_TEXTURE_2D_ARRAY, 0);
+    if (state & STUDIO_SPECULARTEXTURE_ENABLED) GL_BindTextureUnit(STUDIO_BIND_TEXTURE_SPECULAR, GL_TEXTURE_2D, 0);
+    if (state & STUDIO_PARALLAXTEXTURE_ENABLED) GL_BindTextureUnit(STUDIO_BIND_TEXTURE_PARALLAX, GL_TEXTURE_2D, 0);
+    if (state & STUDIO_NORMALTEXTURE_ENABLED) GL_BindTextureUnit(STUDIO_BIND_TEXTURE_NORMAL, GL_TEXTURE_2D, 0);
+    // Preserve engine currenttexture bookkeeping even when the executor bound none.
+    GL_BindTextureUnit(STUDIO_BIND_TEXTURE_DIFFUSE, GL_TEXTURE_2D, 0);
+    glDepthMask(GL_TRUE);
+    glDisable(GL_BLEND);
+    glEnable(GL_CULL_FACE);
+    glEnable(GL_DEPTH_TEST);
+    glDepthFunc(GL_LEQUAL);
+    GL_EndStencil();
+}
+
+static void R_StudioDrawOpaqueShadowMesh(const CStudioModelRenderMesh* mesh, program_state_t originalState)
+{
+    const auto started = R_ProfileBegin();
+    program_state_t depthState = STUDIO_SHADOW_CASTER_ENABLED;
+    if (R_IsRenderingMultiView()) depthState |= STUDIO_MULTIVIEW_ENABLED;
+    if (R_IsRenderingLinearDepth()) depthState |= STUDIO_LINEAR_DEPTH_ENABLED;
+
+    R_SetGBufferMask(GBUFFER_MASK_ALL);
+    R_StudioBeginOpaqueStencil(originalState);
+    glEnable(GL_CULL_FACE);
+    glCullFace(GL_FRONT);
+    R_StudioSetShadowDepthState();
+    // Same production VS/GS/FS, bones and UBO. Unmasked shadow output has no
+    // dependency on diffuse/normal/specular textures or lighting uniforms.
+    R_UseStudioProgram(depthState, nullptr);
+    R_StudioSubmitMesh(mesh, true);
+    R_StudioEndMeshDraw(depthState);
+    // CPU-only inclusive timing; do not spend another GPU query span here.
+    R_ProfileEnd(RProfileStage::StudioDepthExecute, started);
+}
