+    glGenBuffers(1, &dummy); glBindBuffer(GL_UNIFORM_BUFFER, dummy); glBufferData(GL_UNIFORM_BUFFER, 32, nullptr, GL_STATIC_DRAW);
+    for (unsigned count : {0u, 1u, 255u, 256u, 257u, 287u, 1024u, 0u, 287u})
+    {
+        visible.assign(count, {});
+        for (unsigned i = 0; i < count; ++i)
+        {
+            auto& light = visible[i]; light.origin[2] = 1; light.radius = 257;
+            light.color[0] = float(i % 17 + 1) / 8192.f; light.color[1] = .0003f;
+            light.color[2] = i + 1 == count ? .25f : 0.f;
+        }
+        const auto bytes = uploadedBytes;
+        R_UploadDLightUBO(); CheckBindings(); assert(ReadCount() == count && limitQueries == 1);
+        assert(uploadedBytes - bytes == count * sizeof(dlight_record_t));
+        if (count)
+        {
+            std::vector<dlight_record_t> actual(count);
+            glBindBuffer(GL_SHADER_STORAGE_BUFFER, g_WorldSurfaceRenderer.hDLightSSBO);
+            glGetBufferSubData(GL_SHADER_STORAGE_BUFFER, 0, actual.size() * sizeof(actual[0]), actual.data());
+            glBindBuffer(GL_SHADER_STORAGE_BUFFER, 0);
+            for (unsigned i = 0; i < count; ++i)
+                assert(actual[i].origin_radius[2] == 1 && actual[i].origin_radius[3] == 257 && actual[i].color_minlight[2] == visible[i].color[2] && actual[i].color_minlight[3] == 0);
+        }
+        CheckPixels(programs[0], 1); CheckPixels(programs[1], 256.f / 257.f); CheckPixels(programs[2], 256.f / 257.f * .8f);
+        if (count)
+        {
+            const auto changedUploads = recordUploads;
+            visible.back().color[2] += .125f;
+            R_UploadDLightUBO(); assert(recordUploads == changedUploads + 1);
+            CheckPixels(programs[0], 1); CheckPixels(programs[1], 256.f / 257.f);
+        }
+        const auto uploads = recordUploads;
+        R_UploadDLightUBO(); assert(recordUploads == uploads);
+        const auto calls = enumerations;
+        r_draw_shadowview = true; R_UploadDLightUBO(); assert(ReadCount() == 0 && enumerations == calls && recordUploads == uploads);
+        CheckPixels(programs[0], 1, true);
+        glBindBufferBase(GL_UNIFORM_BUFFER, BINDING_POINT_DLIGHT_UBO, dummy);
+        glBindBufferBase(GL_SHADER_STORAGE_BUFFER, BINDING_POINT_DLIGHT_SSBO, dummy);
+        r_draw_shadowview = false; R_UploadDLightUBO(); CheckBindings();
+        assert(ReadCount() == count && recordUploads == uploads); CheckPixels(programs[0], 1);
+        deferred = true; R_UploadDLightUBO(); assert(ReadCount() == 0 && recordUploads == uploads);
+        deferred = false; R_UploadDLightUBO(); assert(ReadCount() == count && recordUploads == uploads);
+    }
+    // A reduced advertised hardware budget fails before uploading any prefix.
+    g_WorldSurfaceRenderer.DLightStorage.Initialize(256 * sizeof(dlight_record_t));
+    const auto uploads = recordUploads; bool rejected = false;
+    try { R_UploadDLightUBO(); } catch (const std::runtime_error&) { rejected = true; }
+    assert(rejected && ReadCount() == 0 && recordUploads == uploads && limitQueries == 1);
+    const auto oldBuffer = g_WorldSurfaceRenderer.hDLightSSBO;
+    R_FreeDLightBuffers(); assert(!glIsBuffer(oldBuffer) && !g_WorldSurfaceRenderer.hDLightUBO && g_WorldSurfaceRenderer.DLightStorage.Records().capacity() == 0);
+    R_InitDLightBuffers(); assert(limitQueries == 2 && ReadCount() == 0); R_UploadDLightUBO(); assert(ReadCount() == visible.size());
+    R_FreeDLightBuffers();
+    for (auto program : programs) glDeleteProgram(program);
+    glDeleteProgram(world); glDeleteProgram(studio); glDeleteBuffers(1, &dummy);
+    glDeleteVertexArrays(1, &vao); glDeleteTextures(1, &color); glDeleteFramebuffers(1, &fbo);
+    assert(glGetError() == GL_NO_ERROR); glfwDestroyWindow(window); glfwTerminate();
+    std::puts("{\"forwardLightGL\":true,\"boundaryCounts\":[0,1,255,256,257,287,1024],\"worldAndStudioReadback\":true,\"shadowCountRestore\":true,\"bindingRestore\":true,\"unchangedRecordUploads\":0,\"resourceReset\":true}");
+}
diff --git a/tests/extract_forward_light_upload.py b/tests/extract_forward_light_upload.py
new file mode 100644
index 0000000..739cba6
--- /dev/null
+++ b/tests/extract_forward_light_upload.py
@@ -0,0 +1,52 @@
+"""Extract the actual forward-light upload and GL helpers for a driver fixture."""
+import argparse
+import hashlib
+import json
+import re
+from pathlib import Path
+
+
+def function(source, signature):
+    matches = list(re.finditer(re.escape(signature) + r"\s*\{", source))
+    if len(matches) != 1:
+        raise SystemExit("Missing or ambiguous function: " + signature)
+    start, position = matches[0].start(), matches[0].end()
+    depth = 1
+    while depth:
+        depth += (source[position] == "{") - (source[position] == "}")
+        position += 1
+    return source[start:position]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--src", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--manifest", type=Path, required=True)
+    args = parser.parse_args()
+    entries = {
+        "gl_draw.cpp": ("GLuint GL_GenBuffer(void)", "void GL_DeleteBuffer(GLuint buf)",
+                        "void GL_UploadDataToUBODynamicDraw(GLuint VBO, size_t size, const void* data)",
+                        "void GL_UploadSubDataToUBO(GLuint UBO, size_t offset, size_t size, const void* data)"),
+        "gl_rmain.cpp": ("bool R_IsRenderingShadowView()",),
+        "gl_wsurf.cpp": ("static void R_FreeDLightBuffers()", "static void R_InitDLightBuffers()",
+                         "static void R_SetDLightCount(unsigned count)", "void R_UploadDLightUBO(void)"),
+    }
+    parts, hashes = [], {}
+    for filename, signatures in entries.items():
+        path = args.src / filename
+        source = path.read_text(encoding="utf-8-sig")
+        hashes[filename] = hashlib.sha256(path.read_bytes()).hexdigest()
+        parts.extend(function(source, signature) for signature in signatures)
+    world = (args.src / "gl_wsurf.cpp").read_text(encoding="utf-8-sig")
+    if "R_UploadDLightUBO();" not in function(world, "void R_PrepareDrawWorld(void)"):
+        raise SystemExit("Production world preparation no longer calls upload")
+    body = "// Generated unchanged production function bodies.\n\n" + "\n\n".join(parts) + "\n"
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(body, encoding="utf-8")
+    args.manifest.write_text(json.dumps({"sourceSha256": hashes,
+        "extractedSha256": hashlib.sha256(body.encode()).hexdigest(), "functions": entries}, indent=2) + "\n", encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/src/studio_bone_palette.h b/src/studio_bone_palette.h
new file mode 100644
index 0000000..4953681
--- /dev/null
+++ b/src/studio_bone_palette.h
@@ -0,0 +1,70 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+// Content, not entity identity, determines reuse: attachments, Bullet and other
+// Studio callbacks may produce different matrices for one entity in one frame.
+template<std::size_t Capacity = 256>
+class CStudioBonePaletteCache
+{
+public:
+    static constexpr std::size_t PaletteBytes = 128 * 3 * 4 * sizeof(float);
+    static constexpr std::size_t MaxEntries = Capacity;
+    static constexpr std::size_t NoEntry = Capacity;
+    struct Selection
+    {
+        std::size_t index;
+        bool reused;
+    };
+
+    void Reset() noexcept
+    {
+        m_Buckets.fill(NoEntry);
+        m_Count = 0;
+        m_HasFrame = false;
+    }
+
+    Selection Select(const void* matrices, std::uint32_t hash, std::uint32_t frame) noexcept
+    {
+        if (!m_HasFrame || m_Frame != frame)
+        {
+            Reset();
+            m_Frame = frame;
+            m_HasFrame = true;
+        }
+        const auto bucket = hash % m_Buckets.size();
+        for (auto index = m_Buckets[bucket]; index != NoEntry; index = m_Entries[index].next)
+        {
+            const auto& entry = m_Entries[index];
+            if (entry.hash == hash && !std::memcmp(entry.matrices.data(), matrices, PaletteBytes))
+                return {index, true};
+        }
+        // Never evict an entry that later light/camera passes can reuse.
+        if (m_Count == Capacity) return {NoEntry, false};
+        const auto index = m_Count++;
+        auto& entry = m_Entries[index];
+        std::memcpy(entry.matrices.data(), matrices, PaletteBytes);
+        entry.hash = hash;
+        entry.next = m_Buckets[bucket];
+        m_Buckets[bucket] = index;
+        return {index, false};
+    }
+
+private:
+    static_assert(Capacity > 0);
+    struct Entry
+    {
+        std::array<std::byte, PaletteBytes> matrices;
+        std::uint32_t hash;
+        std::size_t next;
+    };
+    // Fixed CPU storage: no draw-time allocations or full-palette clears.
+    std::array<Entry, Capacity> m_Entries;
+    std::array<std::size_t, Capacity * 2> m_Buckets;
+    std::size_t m_Count{};
+    std::uint32_t m_Frame{};
+    bool m_HasFrame{};
+};
diff --git a/src/studio_bone_palette_gl.h b/src/studio_bone_palette_gl.h
new file mode 100644
index 0000000..8ca619d
--- /dev/null
+++ b/src/studio_bone_palette_gl.h
@@ -0,0 +1,67 @@
+#pragma once
+
+#include "gl_common.h"
+#include "MurmurHash2.h"
+#include "studio_bone_palette.h"
+
+struct StudioBonePaletteUpload
+{
+    bool reused{};
+    // Capacity fallback only; disabling the cache is an intentional baseline.
+    bool fallback{};
+    unsigned bytes{};
+};
+
+// One reusable buffer per unique pose avoids overwriting data needed by later
+// passes. The separate fallback never mutates a cached slot. Driver-managed
+// buffer updates retain ordinary GL ordering; no persistent-map/ring ABI.
+template<std::size_t Capacity = 256>
+class CStudioBonePaletteStorage
+{
+public:
+    void Reset()
+    {
+        glDeleteBuffers(static_cast<GLsizei>(m_Buffers.size()), m_Buffers.data());
+        glDeleteBuffers(1, &m_Fallback);
+        m_Buffers.fill(0);
+        m_Fallback = 0;
+        m_Cache.Reset();
+    }
+
+    StudioBonePaletteUpload UploadAndBind(const void* matrices, std::uint32_t frame, bool enabled)
+    {
+        StudioBonePaletteUpload result;
+        GLuint* buffer = &m_Fallback;
+        if (enabled)
+        {
+            const auto hash = MurmurHash2(matrices, static_cast<int>(Cache::PaletteBytes), 0x53545544u);
+            const auto selection = m_Cache.Select(matrices, hash, frame);
+            result.reused = selection.reused;
+            result.fallback = selection.index == Cache::NoEntry;
+            if (!result.fallback) buffer = &m_Buffers[selection.index];
+        }
+        if (!result.reused)
+        {
+            const bool allocate = !*buffer;
+            if (allocate) glGenBuffers(1, buffer);
+            glBindBuffer(GL_UNIFORM_BUFFER, *buffer);
+            if (allocate)
+                glBufferData(GL_UNIFORM_BUFFER, Cache::PaletteBytes, matrices, GL_DYNAMIC_DRAW);
+            else
+                glBufferSubData(GL_UNIFORM_BUFFER, 0, Cache::PaletteBytes, matrices);
+            result.bytes = static_cast<unsigned>(Cache::PaletteBytes);
+        }
+        // External scene callbacks and other passes can change indexed bindings.
+        // Rebind even on a hit; no synchronous state queries on the draw path.
+        glBindBufferBase(GL_UNIFORM_BUFFER, BINDING_POINT_STUDIO_BONES_UBO, *buffer);
+        glBindBuffer(GL_UNIFORM_BUFFER, 0);
+        return result;
+    }
+
+private:
+    using Cache = CStudioBonePaletteCache<Capacity>;
+    static_assert(Cache::PaletteBytes == sizeof(studio_bone_palette_t));
+    Cache m_Cache;
+    std::array<GLuint, Capacity> m_Buffers{};
+    GLuint m_Fallback{};
+};
diff --git a/src/draw_parameter_stream.h b/src/draw_parameter_stream.h
new file mode 100644
index 0000000..05fe4fd
--- /dev/null
+++ b/src/draw_parameter_stream.h
@@ -0,0 +1,260 @@
+#pragma once
+
+#include <GL/glew.h>
+
+#include <array>
+#include <cstdint>
+#include <cstring>
+
+struct DrawParameterStreamStats
+{
+    std::uint64_t streamedDraws{}; // Successful uploads, possibly consumed by multiple draws.
+    std::uint64_t streamedBytes{};
+    std::uint64_t fallbacks{};
+    std::uint64_t busyFallbacks{};
+    std::uint64_t pageRotations{};
+    std::uint64_t syncFailures{};
+};
+
+// Renderer-context-owned storage. Call Reset while that context is current;
+// destruction intentionally makes no GL calls. This object is render-thread-only.
+// BeginFrame must run once before all outer-frame passes; EndFrame runs after all
+// consumers and before presentation flushes their commands. Every successful slice
+// remains immutable for that entire frame, including across later uploads and
+// fallback draws. Saved indexed bindings may be restored within the frame, never
+// after EndFrame or in a subsequent frame.
+class CDrawParameterStream
+{
+public:
+    static constexpr unsigned   PAGE_COUNT = 3;
+    static constexpr GLsizeiptr PAGE_BYTES = 256 * 1024;
+
+    CDrawParameterStream() = default;
+    CDrawParameterStream(const CDrawParameterStream&) = delete;
+    CDrawParameterStream& operator=(const CDrawParameterStream&) = delete;
+
+    bool Init()
+    {
+        Reset();
+        if (!(GLEW_VERSION_4_4 || GLEW_ARB_buffer_storage) ||
+            !glGenBuffers || !glDeleteBuffers || !glBindBuffer ||
+            !glBufferStorage || !glMapBufferRange || !glUnmapBuffer ||
+            !glBindBufferRange || !glFenceSync || !glClientWaitSync || !glDeleteSync)
+            return false;
+
+        GLint alignment = 0;
+        GLint maxBlockBytes = 0;
+        GLint maxBindings = 0;
+        glGetIntegerv(GL_UNIFORM_BUFFER_OFFSET_ALIGNMENT, &alignment);
+        glGetIntegerv(GL_MAX_UNIFORM_BLOCK_SIZE, &maxBlockBytes);
+        glGetIntegerv(GL_MAX_UNIFORM_BUFFER_BINDINGS, &maxBindings);
+        if (alignment <= 0 || alignment > PAGE_BYTES || maxBlockBytes <= 0 || maxBindings <= 0)
+            return false;
+
+        m_Alignment = alignment;
+        m_MaxBlockBytes = maxBlockBytes;
+        m_MaxBindings = static_cast<GLuint>(maxBindings);
+        constexpr GLbitfield flags = GL_MAP_WRITE_BIT | GL_MAP_PERSISTENT_BIT | GL_MAP_COHERENT_BIT;
+        for (auto& page : m_Pages)
+        {
+            glGenBuffers(1, &page.buffer);
+            if (page.buffer)
+            {
+                glBindBuffer(GL_UNIFORM_BUFFER, page.buffer);
+                glBufferStorage(GL_UNIFORM_BUFFER, PAGE_BYTES, nullptr, flags);
+                page.mapped = static_cast<std::uint8_t*>(glMapBufferRange(GL_UNIFORM_BUFFER, 0, PAGE_BYTES, flags));
+            }
+            if (!page.mapped)
+            {
+                Reset();
+                return false;
+            }
+        }
+        glBindBuffer(GL_UNIFORM_BUFFER, 0);
+        m_Ready = true;
+        return true;
+    }
+
+    void Reset()
+    {
+        bool hadBuffers = false;
+        for (auto& page : m_Pages)
+        {
+            if (page.fence)
+                glDeleteSync(page.fence);
+            if (page.buffer)
+            {
+                hadBuffers = true;
+                if (page.mapped)
+                {
+                    glBindBuffer(GL_UNIFORM_BUFFER, page.buffer);
+                    glUnmapBuffer(GL_UNIFORM_BUFFER);
+                }
+                glDeleteBuffers(1, &page.buffer);
+            }
+            page = {};
+        }
+        if (hadBuffers)
+            glBindBuffer(GL_UNIFORM_BUFFER, 0);
+        m_Alignment = 0;
+        m_MaxBlockBytes = 0;
+        m_MaxBindings = 0;
+        m_CurrentPage = PAGE_COUNT;
+        m_NextPage = 0;
+        m_Ready = false;
+        m_InFrame = false;
+        m_Stats = {};
+    }
+
+    void BeginFrame()
+    {
+        if (!m_Ready)
+            return;
+        // Keep an omitted EndFrame safe; normal callers seal before presentation
+        // so the next frame's polls benefit from its existing command flush.
+        if (m_InFrame)
+            EndFrame();
+        if (!m_Ready)
+            return;
+        for (auto& page : m_Pages)
+        {
+            page.usedThisFrame = false;
+            page.polledThisFrame = false;
+        }
+        m_CurrentPage = PAGE_COUNT;
+        m_InFrame = true;
+    }
+
+    void EndFrame()
+    {
+        if (!m_Ready || !m_InFrame)
+            return;
+        m_InFrame = false;
+        for (auto& page : m_Pages)
+        {
+            if (page.usedThisFrame)
+            {
+                // This fence follows every consumer, including any restored
+                // indexed binding in later passes of the preceding frame.
+                page.fence = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+                if (!page.fence)
+                {
+                    ++m_Stats.syncFailures;
+                    m_Ready = false;
+                    return;
+                }
+            }
+        }
+    }
+
+    // Copies bytes immediately. On false, the caller must bind its separate
+    // fallback UBO. Success resets the generic UBO binding to zero; unrelated
+    // indexed bindings are untouched. No allocation, GL state query or wait
+    // with a nonzero timeout occurs here, even when the ring is exhausted.
+    bool UploadAndBind(GLuint binding, GLsizeiptr size, const void* bytes)
+    {
+        if (!m_Ready || !m_InFrame || !bytes || size <= 0 ||
+            size > PAGE_BYTES || size > m_MaxBlockBytes || binding >= m_MaxBindings)
+        {
+            ++m_Stats.fallbacks;
+            return false;
+        }
+
+        GLsizeiptr offset = 0;
+        if (m_CurrentPage == PAGE_COUNT || !FindOffset(m_Pages[m_CurrentPage], size, offset))
+        {
+            bool busy = false;
+            unsigned acquiredPage = PAGE_COUNT;
+            for (unsigned step = 0; step < PAGE_COUNT; ++step)
+            {
+                const unsigned index = (m_NextPage + step) % PAGE_COUNT;
+                auto& page = m_Pages[index];
+                if (page.usedThisFrame)
+                    continue;
+                if (page.polledThisFrame)
+                {
+                    busy = true;
+                    continue;
+                }
+                page.polledThisFrame = true;
+                if (page.fence)
+                {
+                    const GLenum result = glClientWaitSync(page.fence, 0, 0);
+                    if (result == GL_TIMEOUT_EXPIRED)
+                    {
+                        busy = true;
+                        continue;
+                    }
+                    if (result != GL_ALREADY_SIGNALED && result != GL_CONDITION_SATISFIED)
+                    {
+                        ++m_Stats.syncFailures;
+                        m_Ready = false;
+                        break;
+                    }
+                    glDeleteSync(page.fence);
+                    page.fence = nullptr;
+                }
+                page.used = 0;
+                page.usedThisFrame = true;
+                acquiredPage = index;
+                break;
+            }
+            if (acquiredPage == PAGE_COUNT)
+            {
+                ++m_Stats.fallbacks;
+                if (busy)
+                    ++m_Stats.busyFallbacks;
+                return false;
+            }
+            if (m_CurrentPage != PAGE_COUNT && m_CurrentPage != acquiredPage)
+                ++m_Stats.pageRotations;
+            m_CurrentPage = acquiredPage;
+            m_NextPage = (acquiredPage + 1) % PAGE_COUNT;
+            offset = 0;
+        }
+
+        auto& page = m_Pages[m_CurrentPage];
+        std::memcpy(page.mapped + offset, bytes, static_cast<std::size_t>(size));
+        page.used = offset + size;
+        glBindBufferRange(GL_UNIFORM_BUFFER, binding, page.buffer, offset, size);
+        glBindBuffer(GL_UNIFORM_BUFFER, 0);
+        ++m_Stats.streamedDraws;
+        m_Stats.streamedBytes += static_cast<std::uint64_t>(size);
+        return true;
+    }
+
+    const DrawParameterStreamStats& Stats() const { return m_Stats; }
+
+private:
+    struct Page
+    {
+        GLuint        buffer{};
+        std::uint8_t* mapped{};
+        GLsync        fence{};
+        GLsizeiptr    used{};
+        bool          usedThisFrame{};
+        bool          polledThisFrame{};
+    };
+
+    bool FindOffset(const Page& page, GLsizeiptr size, GLsizeiptr& offset) const
+    {
+        const GLsizeiptr remainder = page.used % m_Alignment;
+        const GLsizeiptr padding = remainder ? m_Alignment - remainder : 0;
+        // Subtract before adding so size/alignment cannot overflow the arena.
+        const GLsizeiptr remaining = PAGE_BYTES - page.used;
+        if (padding > remaining || size > remaining - padding)
+            return false;
+        offset = page.used + padding;
+        return true;
+    }
+
+    std::array<Page, PAGE_COUNT> m_Pages{};
+    GLsizeiptr                  m_Alignment{};
+    GLsizeiptr                  m_MaxBlockBytes{};
+    GLuint                      m_MaxBindings{};
+    unsigned                    m_CurrentPage{PAGE_COUNT};
+    unsigned                    m_NextPage{};
+    bool                        m_Ready{};
+    bool                        m_InFrame{};
+    DrawParameterStreamStats    m_Stats{};
+};
