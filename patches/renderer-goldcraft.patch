diff --git a/tests/draw_parameter_stream_gl_tests.cpp b/tests/draw_parameter_stream_gl_tests.cpp
new file mode 100644
index 0000000..e3930e5
--- /dev/null
+++ b/tests/draw_parameter_stream_gl_tests.cpp
@@ -0,0 +1,602 @@
+// Real driver tests of the production parameter arena and upload dispatcher.
+// The hidden GLFW context uses WGL on Windows. This is correctness evidence,
+// never a game FPS benchmark. Only the explicitly labelled busy/failure cases
+// inject a sync result; all allocations, shader draws and readbacks are real GL.
+#include <GL/glew.h>
+#include <GLFW/glfw3.h>
+#ifdef _WIN32
+#define GLFW_EXPOSE_NATIVE_WGL
+#include <GLFW/glfw3native.h>
+#endif
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <stdexcept>
+#include <vector>
+
+namespace
+{
+std::uint64_t checks{}, comparedPixels{}, comparedDepth{}, realDraws{};
+void Check(bool condition, const char* reason)
+{
+    ++checks;
+    if (!condition) throw std::runtime_error(reason);
+}
+
+struct DriverCalls
+{
+    std::uint64_t generated{}, deleted{}, storage{}, maps{}, unmaps{}, data{}, subData{}, namedSubData{};
+    std::uint64_t ranges{}, fences{}, waits{}, deletedFences{}, queries{}, finishes{}, injectedWaits{};
+    std::uint64_t nonzeroTimeouts{}, flushWaits{};
+} calls;
+std::vector<GLuint> arenaBuffers;
+std::vector<GLsync> arenaFences;
+enum class WaitInjection { None, Busy, Failed } waitInjection{};
+
+PFNGLGENBUFFERSPROC realGenBuffers{};
+PFNGLDELETEBUFFERSPROC realDeleteBuffers{};
+PFNGLBUFFERSTORAGEPROC realBufferStorage{};
+PFNGLMAPBUFFERRANGEPROC realMapBufferRange{};
+PFNGLUNMAPBUFFERPROC realUnmapBuffer{};
+PFNGLBUFFERDATAPROC realBufferData{};
+PFNGLBUFFERSUBDATAPROC realBufferSubData{};
+PFNGLNAMEDBUFFERSUBDATAPROC realNamedBufferSubData{};
+PFNGLBINDBUFFERRANGEPROC realBindBufferRange{};
+PFNGLFENCESYNCPROC realFenceSync{};
+PFNGLCLIENTWAITSYNCPROC realClientWaitSync{};
+PFNGLDELETESYNCPROC realDeleteSync{};
+
+void GLAPIENTRY CountGenBuffers(GLsizei n, GLuint* buffers)
+{
+    calls.generated += n; realGenBuffers(n, buffers);
+    arenaBuffers.insert(arenaBuffers.end(), buffers, buffers + n);
+}
+void GLAPIENTRY CountDeleteBuffers(GLsizei n, const GLuint* buffers)
+{
+    calls.deleted += n; realDeleteBuffers(n, buffers);
+    for (GLsizei i = 0; i < n; ++i) std::erase(arenaBuffers, buffers[i]);
+}
+void GLAPIENTRY CountBufferStorage(GLenum target, GLsizeiptr size, const void* data, GLbitfield flags)
+{
+    ++calls.storage; realBufferStorage(target, size, data, flags);
+}
+void* GLAPIENTRY CountMapBufferRange(GLenum target, GLintptr offset, GLsizeiptr size, GLbitfield flags)
+{
+    ++calls.maps; return realMapBufferRange(target, offset, size, flags);
+}
+GLboolean GLAPIENTRY CountUnmapBuffer(GLenum target)
+{
+    ++calls.unmaps; return realUnmapBuffer(target);
+}
+void GLAPIENTRY CountBufferData(GLenum target, GLsizeiptr size, const void* data, GLenum usage)
+{
+    ++calls.data; realBufferData(target, size, data, usage);
+}
+void GLAPIENTRY CountBufferSubData(GLenum target, GLintptr offset, GLsizeiptr size, const void* data)
+{
+    ++calls.subData; realBufferSubData(target, offset, size, data);
+}
+void GLAPIENTRY CountNamedBufferSubData(GLuint buffer, GLintptr offset, GLsizeiptr size, const void* data)
+{
+    ++calls.namedSubData; realNamedBufferSubData(buffer, offset, size, data);
+}
+void GLAPIENTRY CountBindBufferRange(GLenum target, GLuint binding, GLuint buffer, GLintptr offset, GLsizeiptr size)
+{
+    ++calls.ranges; realBindBufferRange(target, binding, buffer, offset, size);
+}
+GLsync GLAPIENTRY CountFenceSync(GLenum condition, GLbitfield flags)
+{
+    ++calls.fences;
+    auto fence = realFenceSync(condition, flags);
