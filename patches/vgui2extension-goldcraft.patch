+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <utility>
+// The pinned SDK's CUtlVector::Swap uses an unqualified swap.
+using std::swap;
+#include <metahook.h>
+#include <IFileSystem.h>
+#include <VGUI/ISurface.h>
+#include <VGUI/IResourceRefresh.h>
+#include <vgui_controls/Controls.h>
+#include "vgui_internal.h"
+#include "FontManager.h"
+#include "FontTextureCache.h"
+#include "Scheme2.h"
+#include <algorithm>
+#include <memory>
+#include <string>
+#include <vector>
+
+extern vgui::ISchemeManager2* g_pVGuiSchemeManager2;
+using vgui::ResourceRefreshResult;
+
+class CFontResourceUpdate final : public vgui::IResourceRefresh
+{
+    struct Plan { HFont handle; CFontManager::FontSpec spec; bool dormant{}; };
+    struct File
+    {
+        std::string relative, original, installed;
+        unsigned int count{}, removed{}, added{};
+        bool dormant{};
+    };
+    struct DeleteKeys { void operator()(KeyValues* p) const { if (p) p->deleteThis(); } };
+    using Keys = std::unique_ptr<KeyValues, DeleteKeys>;
+    std::vector<Plan> m_Plans;
+    std::vector<Plan> m_Staged;
+    std::vector<File> m_Files;
+    std::vector<File> m_DormantFiles;
+    vgui::CScheme* m_Scheme{};
+    std::string m_SchemeFile;
+    const char* m_Error = "";
+    unsigned long long m_Token{}, m_NextToken{};
+    DWORD m_Thread{};
+    bool m_FontsSuspended{}, m_Rollback{};
+
+    ResourceRefreshResult Fail(ResourceRefreshResult result, const char* error) noexcept
+    { m_Error = error; return result; }
+    static bool Same(const std::string& a, const char* b) { return !stricmp(a.c_str(), b); }
+    static bool HasChildren(KeyValues* parent, const char* name)
+    { auto* child = parent->FindKey(name, false); return child && child->GetFirstSubKey(); }
+    static bool Name(const char* value, std::size_t maximum)
+    { return value && *value && strnlen(value, maximum) < maximum; }
+    static bool Relative(const char* value)
+    {
+        if (!Name(value, MAX_PATH) || value[0] == '/' || value[0] == '\\') return false;
+        return !strstr(value, "..") && !strchr(value, ':');
+    }
+    static bool Pure(vgui::CScheme& scheme)
+    {
+        return scheme.m_pData && !scheme.m_BorderList.Count() && !scheme.m_pBaseBorder &&
+            !HasChildren(scheme.m_pData, "Borders");
+    }
+    static bool BaseFamilyAvailable(const CFontManager::FontSpec& spec, bool& available)
+    {
+        HDC dc = ::CreateCompatibleDC(nullptr);
+        if (!dc) return false;
+        HFONT font = ::CreateFontA(spec.tall, 0, 0, 0, spec.weight, false, false, false,
+            DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS, DEFAULT_QUALITY,
+            DEFAULT_PITCH | FF_DONTCARE, spec.name.c_str());
+        if (!font) { ::DeleteDC(dc); return false; }
+        const auto previous = ::SelectObject(dc, font);
+        char selected[LF_FACESIZE]{};
+        const bool read = previous && previous != HGDI_ERROR && ::GetTextFaceA(dc, sizeof(selected), selected);
+        available = read && !stricmp(selected, spec.name.c_str());
+        ::DeleteDC(dc); ::DeleteObject(font);
+        return read;
+    }
+    static bool UniqueChildren(KeyValues* keys)
+    {
+        for (auto* a = keys->GetFirstSubKey(); a; a = a->GetNextKey())
+            for (auto* b = a->GetNextKey(); b; b = b->GetNextKey())
+                if (!stricmp(a->GetName(), b->GetName())) return false;
+        return true;
+    }
+    bool Compatible(KeyValues* keys) const
+    {
+        if (!Pure(*m_Scheme) || HasChildren(keys, "Borders")) return false;
+        auto* oldBase = m_Scheme->m_pData->FindKey("BaseSettings", true);
+        auto* base = keys->FindKey("BaseSettings", true);
+        for (auto key : {"ProportionalBaseWidth", "ProportionalBaseHeight", "ProportionalBaseWidthHD", "ProportionalBaseHeightHD"})
+            if (strcmp(oldBase->GetString(key, ""), base->GetString(key, ""))) return false;
+        auto* oldFiles = m_Scheme->m_pData->FindKey("CustomFontFiles", true);
+        auto* files = keys->FindKey("CustomFontFiles", true);
+        auto* old = oldFiles->GetFirstSubKey(); auto* next = files->GetFirstSubKey();
+        for (; old && next; old = old->GetNextKey(), next = next->GetNextKey())
+            if (stricmp(old->GetName(), next->GetName()) || stricmp(old->GetString(), next->GetString())) return false;
+        if (old || next) return false;
+        auto* oldFonts = m_Scheme->m_pData->FindKey("Fonts", true);
+        auto* fonts = keys->FindKey("Fonts", true);
+        if (!UniqueChildren(oldFonts) || !UniqueChildren(fonts)) return false;
+        unsigned int count{};
+        for (auto* font = fonts->GetFirstSubKey(); font; font = font->GetNextKey())
+        {
+            if (!oldFonts->FindKey(font->GetName(), false)) return false;
+            ++count;
+        }
+        unsigned int previous{};
+        for (auto* font = oldFonts->GetFirstSubKey(); font; font = font->GetNextKey()) ++previous;
+        return count == previous && count * 3 == m_Scheme->m_FontAliases.Count();
+    }
+    void Clear() noexcept
+    {
+        auto& manager = FontManager();
+        manager.m_Refreshing = false;
+        manager.m_RefreshHandles.clear(); manager.m_RefreshFamilies.clear();
+        manager.m_RefreshFontPaths.clear();
+        m_Plans.clear(); m_Staged.clear(); m_Files.clear(); m_Scheme = nullptr; m_SchemeFile.clear();
+        m_Token = 0; m_Thread = 0; m_FontsSuspended = m_Rollback = false;
+    }
+    bool CollectFile(const char* relative)
+    {
+        if (!Relative(relative)) return false;
+        FontManager().m_RefreshFontPaths.emplace_back(relative);
+        for (const auto& file : m_Files) if (Same(file.relative, relative)) return true;
+        for (const auto& file : m_DormantFiles)
+            if (Same(file.relative, relative))
+            {
+                m_Files.push_back({file.relative, file.original, {}, file.count, file.count, 0, true});
+                FontManager().m_RefreshFontPaths.push_back(file.original);
+                return true;
+            }
+        char path[MAX_PATH]{};
+        if (!g_pFullFileSystem->GetLocalPath(relative, path, sizeof(path))) return true;
+        FontManager().m_RefreshFontPaths.emplace_back(path);
+        for (const auto& owned : FontManager().m_FontFiles)
+            if (owned.count && Same(owned.path, path))
+            {
+                // Different relative aliases may resolve to one registration.
+                for (const auto& file : m_Files) if (Same(file.original, path)) return true;
+                m_Files.push_back({relative, path, {}, owned.count});
+                break;
+            }
+        return true;
+    }
+    bool RemoveRegistration(const char* path)
+    {
+        auto& manager = FontManager();
+        for (auto& owned : manager.m_FontFiles)
+            if (Same(owned.path, path) && owned.count)
+            {
+                if (!::RemoveFontResourceA(path)) return false;
+                --owned.count; return true;
+            }
+        return false;
+    }
+    bool SuspendFiles()
+    {
+        for (auto& file : m_Files)
+            while (file.removed < file.count)
+            {
+                if (!RemoveRegistration(file.original.c_str())) return false;
+                ++file.removed;
+            }
+        return true;
+    }
+    bool RemoveInstalledFiles()
+    {
+        for (auto& file : m_Files)
+            while (file.added)
+            {
+                if (!RemoveRegistration(file.installed.c_str())) return false;
+                --file.added;
+            }
+        return true;
+    }
+    bool InstallFiles()
+    {
+        for (auto& file : m_Files)
+        {
+            char path[MAX_PATH]{};
+            if (!g_pFullFileSystem->GetLocalPath(file.relative.c_str(), path, sizeof(path))) return false;
+            file.installed = path;
+            while (file.added < file.count)
+            {
+                if (!FontManager().RegisterFontFile(path)) return false;
+                ++file.added;
+            }
+        }
+        return true;
+    }
+    bool RestoreFiles()
+    {
+        for (auto& file : m_Files)
+        {
+            if (file.dormant) continue;
+            while (file.removed)
+            {
+                if (!FontManager().RegisterFontFile(file.original.c_str())) return false;
+                --file.removed;
+            }
+        }
+        return true;
+    }
+    void SuspendFonts()
+    {
+        if (m_FontsSuspended) return;
+        auto& manager = FontManager();
+        vgui::surface()->DrawFlushText();
+        g_FontTextureCache.InvalidateFonts(manager.m_RefreshHandles);
+        for (auto handle : manager.m_RefreshHandles)
+        {
+            auto& font = manager.m_FontAmalgams[handle];
+            font.m_Fonts.RemoveAll(); font.m_iMaxWidth = font.m_iMaxHeight = 0;
+        }
+        manager.CollectUnusedFonts();
+        m_FontsSuspended = true;
+    }
+    ResourceRefreshResult Finish(unsigned long long token, bool rollback)
+    {
+        if (!token || token != m_Token) return Fail(ResourceRefreshResult::StaleToken, "Resource update token is not active");
+        if (GetCurrentThreadId() != m_Thread) return Fail(ResourceRefreshResult::WrongThread, "Resource update must finish on its UI thread");
+        if (m_Rollback && !rollback) return Fail(ResourceRefreshResult::InvalidRequest, "An aborted update can only retry Abort");
+        m_Rollback |= rollback;
+        auto& manager = FontManager();
+        std::vector<std::unique_ptr<CFontAmalgam>> candidates;
+        try
+        {
+            SuspendFonts();
+            if (!RemoveInstalledFiles()) return Fail(ResourceRefreshResult::FileUnavailable, "Previous custom-font registration cleanup failed; update remains suspended");
+            auto plans = m_Plans;
+            if (!rollback)
+                for (const auto& staged : m_Staged)
+                    for (auto& plan : plans) if (plan.handle == staged.handle) plan.spec = staged.spec;
+            Keys candidate;
+            KeyValues *base{}, *colors{}, *borders{};
+            if (!rollback && m_Scheme)
+            {
+                candidate.reset(new KeyValues("Scheme")); candidate->UsesEscapeSequences(true);
+                if (!candidate->LoadFromFile(g_pFullFileSystem, m_SchemeFile.c_str(), "SKIN") &&
+                    !candidate->LoadFromFile(g_pFullFileSystem, m_SchemeFile.c_str(), nullptr))
+                    return Fail(ResourceRefreshResult::FileUnavailable, "Updated scheme could not be read");
+                if (!Compatible(candidate.get()))
+                    return Fail(ResourceRefreshResult::UnsupportedScheme, "Resource refresh requires unchanged font aliases/files/base and no borders");
+                std::vector<CFontManager::FontSpec> definitions;
+                if (!m_Scheme->BuildFontGlyphs(candidate.get(), &definitions))
+                    return Fail(ResourceRefreshResult::UnsupportedScheme, "Updated scheme has no matching font definition at this resolution");
+                for (int i = 0; i < m_Scheme->m_FontAliases.Count(); ++i)
+                {
+                    auto handle = m_Scheme->m_FontAliases[i]._font;
+                    auto found = std::find_if(plans.begin(), plans.end(), [handle](const auto& p) { return p.handle == handle; });
+                    if (found == plans.end()) return Fail(ResourceRefreshResult::InvalidRequest, "Scheme font ownership changed during refresh");
+                    found->spec = std::move(definitions[i]);
+                }
+                m_Scheme->PrepareSettings(candidate.get(), m_Scheme->tag);
+                base = candidate->FindKey("BaseSettings", true);
+                colors = candidate->FindKey("Colors", true);
+                borders = candidate->FindKey("Borders", true);
+            }
+            for (const auto& plan : plans)
+                if (plan.spec.valid && (!Name(plan.spec.name.c_str(), 32) || plan.spec.tall < 1 || plan.spec.tall > 127))
+                    return Fail(ResourceRefreshResult::FontUnavailable, "Font definition is outside the supported GDI glyph range");
+            if (rollback ? !RestoreFiles() : (!SuspendFiles() || !InstallFiles()))
+            {
+                if (!rollback && !RemoveInstalledFiles())
+                    return Fail(ResourceRefreshResult::FileUnavailable, "Custom-font registration failed and cleanup needs retry");
+                return Fail(ResourceRefreshResult::FileUnavailable, "Custom-font registration failed; update remains suspended");
+            }
+            candidates.reserve(plans.size());
+            for (const auto& plan : plans)
+            {
+                auto amalgam = std::make_unique<CFontAmalgam>();
+                if (plan.spec.valid && !(rollback && plan.dormant) &&
+                    (!manager.ConfigureFont(*amalgam, plan.spec) || !amalgam->GetCount()))
+                {
+                    candidates.clear(); amalgam.reset(); manager.CollectUnusedFonts();
+                    if (!rollback && !RemoveInstalledFiles())
+                        return Fail(ResourceRefreshResult::FileUnavailable, "Replacement font failed and registration cleanup needs retry");
+                    return Fail(ResourceRefreshResult::FontUnavailable, "Replacement font could not be created; update remains suspended");
+                }
+                candidates.push_back(std::move(amalgam));
+            }
+            // All allocation/registration/font creation completed. Publication
+            // below only swaps owned ranges and moves existing strings.
+            for (std::size_t i = 0; i < plans.size(); ++i)
+            {
+                auto& destination = manager.m_FontAmalgams[plans[i].handle];
+                destination.m_Fonts.Swap(candidates[i]->m_Fonts);
+                destination.m_iMaxHeight = candidates[i]->m_iMaxHeight;
+                destination.m_iMaxWidth = candidates[i]->m_iMaxWidth;
+                manager.m_FontSpecs[plans[i].handle] = std::move(plans[i].spec);
+            }
+            if (candidate)
+            {
+                Keys previous(m_Scheme->m_pData);
+                m_Scheme->m_pData = candidate.release();
+                m_Scheme->m_pkvBaseSettings = base; m_Scheme->m_pkvColors = colors; m_Scheme->m_pkvBorders = borders;
+                m_Scheme->m_ResourceRetired = false;
+            }
+            manager.m_FontFiles.erase(std::remove_if(manager.m_FontFiles.begin(), manager.m_FontFiles.end(),
+                [](const auto& file) { return !file.count; }), manager.m_FontFiles.end());
+            if (!rollback)
+                m_DormantFiles.erase(std::remove_if(m_DormantFiles.begin(), m_DormantFiles.end(), [&](const auto& dormant)
+                {
+                    return std::any_of(m_Files.begin(), m_Files.end(), [&](const auto& active) { return Same(dormant.relative, active.relative.c_str()); });
+                }), m_DormantFiles.end());
+            Clear(); m_Error = "";
+            return ResourceRefreshResult::Success;
+        }
+        catch (...)
+        {
+            candidates.clear(); manager.CollectUnusedFonts();
+            if (!rollback && !RemoveInstalledFiles())
+                return Fail(ResourceRefreshResult::FileUnavailable, "Resource refresh allocation failed and registration cleanup needs retry");
+            return Fail(ResourceRefreshResult::FontUnavailable, "Resource refresh allocation failed; update remains suspended");
+        }
+    }
+
+public:
+    ResourceRefreshResult BeginUpdate(const vgui::ResourceRefreshRequest& request, unsigned long long& token) override
+    {
+        token = 0;
+        if (m_Token) return Fail(ResourceRefreshResult::Busy, "Another VGUI resource update is pending");
+        auto& manager = FontManager();
+        if (manager.m_OwnerThread && GetCurrentThreadId() != manager.m_OwnerThread)
+            return Fail(ResourceRefreshResult::WrongThread, "Resource update must begin on the font owner's UI thread");
+        if (request.size != sizeof(request) || request.fontFamilyCount > 64 || request.fontFileCount > 64 ||
+            (request.fontFamilyCount && !request.fontFamilies) || (request.fontFileCount && !request.fontFiles))
+            return Fail(ResourceRefreshResult::InvalidRequest, "Invalid VGUI resource update request");
+        if (!g_pFullFileSystem || !vgui::surface() || !g_pVGuiSchemeManager2)
+            return Fail(ResourceRefreshResult::InvalidRequest, "VGUI resource services are unavailable");
+        for (unsigned int i = 0; i < request.fontFamilyCount; ++i)
+            if (!Name(request.fontFamilies[i], 32)) return Fail(ResourceRefreshResult::InvalidRequest, "Invalid font family");
+        try
+        {
+            std::vector<std::string> families;
+            for (unsigned int i = 0; i < request.fontFamilyCount; ++i) families.emplace_back(request.fontFamilies[i]);
+            if (request.schemeFile)
+            {
+                if (!Relative(request.schemeFile)) return Fail(ResourceRefreshResult::InvalidRequest, "Invalid scheme filename");
+                auto* schemes = static_cast<vgui::CSchemeManager*>(g_pVGuiSchemeManager2);
+                auto handle = schemes->FindLoadedScheme(request.schemeFile);
+                if (handle)
+                {
+                    m_Scheme = schemes->m_Schemes[handle];
+                    if (!Pure(*m_Scheme)) { Clear(); return Fail(ResourceRefreshResult::UnsupportedScheme, "Only a loaded pure-font scheme can be refreshed in place"); }
+                    m_SchemeFile = request.schemeFile;
+                    for (int alias = 0; alias < m_Scheme->m_FontAliases.Count(); ++alias)
+                        families.push_back(manager.m_FontSpecs[m_Scheme->m_FontAliases[alias]._font].name);
+                    for (auto* file = m_Scheme->m_pData->FindKey("CustomFontFiles", true)->GetFirstSubKey(); file; file = file->GetNextKey())
+                        if (!CollectFile(file->GetString())) { Clear(); return Fail(ResourceRefreshResult::InvalidRequest, "Invalid scheme custom-font filename"); }
+                }
+                // An unloaded scheme owns no cache. Its normal first load will
+                // read the committed VFS; do not create it just for an update.
+            }
+            for (unsigned int i = 0; i < request.fontFileCount; ++i)
+                if (!CollectFile(request.fontFiles[i])) { Clear(); return Fail(ResourceRefreshResult::InvalidRequest, "Invalid custom-font filename"); }
+            std::vector<HFont> handles;
+            for (int handle = 1; handle < manager.m_FontAmalgams.Count(); ++handle)
+            {
+                bool selected = false;
+                for (const auto& family : families)
+                {
+                    selected |= Same(manager.m_FontSpecs[handle].name, family.c_str());
+                    for (int range = 0; range < manager.m_FontAmalgams[handle].GetCount(); ++range)
+                        selected |= !stricmp(manager.m_FontAmalgams[handle].GetFontName(range), family.c_str());
+                }
+                if (m_Scheme)
+                    for (int alias = 0; alias < m_Scheme->m_FontAliases.Count(); ++alias)
+                        selected |= m_Scheme->m_FontAliases[alias]._font == handle;
+                if (selected)
+                {
+                    m_Plans.push_back({static_cast<HFont>(handle), manager.m_FontSpecs[handle],
+                        !manager.m_FontAmalgams[handle].GetCount()});
+                    handles.push_back(handle);
+                }
+            }
+            manager.m_RefreshHandles = std::move(handles);
+            manager.m_RefreshFamilies = std::move(families);
+            manager.m_Refreshing = true;
+            m_Thread = GetCurrentThreadId();
+            if (!++m_NextToken) ++m_NextToken;
+            token = m_Token = m_NextToken;
+            SuspendFonts();
+            if (!SuspendFiles()) return Fail(ResourceRefreshResult::FileUnavailable, "Could not suspend owned font registrations; nonzero token requires Abort");
+            m_Error = "";
+            return ResourceRefreshResult::Success;
+        }
+        catch (...)
+        {
+            if (!m_Token) Clear();
+            return Fail(ResourceRefreshResult::FontUnavailable, "Resource refresh allocation failed; a nonzero token requires Abort");
+        }
+    }
+    ResourceRefreshResult CommitUpdate(unsigned long long token) override { return Finish(token, false); }
+    ResourceRefreshResult AbortUpdate(unsigned long long token) override { return Finish(token, true); }
+    const char* LastError() const override { return m_Error; }
+    ResourceRefreshResult StageFont(unsigned long long token, HFont font, const vgui::ResourceFontDefinition& definition) override
+    {
+        if (!token || token != m_Token) return Fail(ResourceRefreshResult::StaleToken, "Resource update token is not active");
+        if (GetCurrentThreadId() != m_Thread) return Fail(ResourceRefreshResult::WrongThread, "Font staging must use its UI thread");
+        if (m_Rollback || definition.size != sizeof(definition) || !Name(definition.name, 32) ||
+            definition.tall < 1 || definition.tall > 127 || definition.blur < 0 || definition.blur > 127)
+            return Fail(ResourceRefreshResult::InvalidRequest, "Invalid staged font definition");
+        if (std::none_of(m_Plans.begin(), m_Plans.end(), [font](const auto& plan) { return plan.handle == font; }))
+            return Fail(ResourceRefreshResult::InvalidRequest, "Font was not selected by Begin");
+        if (m_Scheme)
+            for (int alias = 0; alias < m_Scheme->m_FontAliases.Count(); ++alias)
+                if (m_Scheme->m_FontAliases[alias]._font == font)
+                    return Fail(ResourceRefreshResult::InvalidRequest, "Scheme aliases take their definition from the scheme file");
+        try
+        {
+            Plan staged{font, {definition.name, definition.tall, definition.weight, definition.blur,
+                definition.scanlines, definition.flags, definition.lowRange, definition.highRange, true}};
+            for (auto& plan : m_Staged)
+                if (plan.handle == font) { plan = std::move(staged); return ResourceRefreshResult::Success; }
+            m_Staged.push_back(std::move(staged));
+            return ResourceRefreshResult::Success;
+        }
+        catch (...) { return Fail(ResourceRefreshResult::FontUnavailable, "Could not store staged font definition"); }
+    }
+    ResourceRefreshResult CommitRemoval(unsigned long long token) override
+    {
+        if (!token || token != m_Token) return Fail(ResourceRefreshResult::StaleToken, "Resource update token is not active");
+        if (GetCurrentThreadId() != m_Thread) return Fail(ResourceRefreshResult::WrongThread, "Resource removal must use its UI thread");
+        if (m_Rollback) return Fail(ResourceRefreshResult::InvalidRequest, "An aborted update can only retry Abort");
+        auto& manager = FontManager();
+        std::vector<std::unique_ptr<CFontAmalgam>> candidates;
+        try
+        {
+            SuspendFonts();
+            if (!RemoveInstalledFiles() || !SuspendFiles())
+                return Fail(ResourceRefreshResult::FileUnavailable, "Font registration removal failed; update remains suspended");
+            candidates.reserve(m_Plans.size());
+            auto dormantFiles = m_DormantFiles;
+            for (const auto& file : m_Files)
+                if (std::none_of(dormantFiles.begin(), dormantFiles.end(), [&](const auto& dormant) { return Same(dormant.relative, file.relative.c_str()); }))
+                    dormantFiles.push_back({file.relative, file.original, {}, file.count, file.count, 0, true});
+            for (const auto& plan : m_Plans)
+            {
+                auto font = std::make_unique<CFontAmalgam>();
+                bool schemeAlias = false;
+                if (m_Scheme)
+                    for (int i = 0; i < m_Scheme->m_FontAliases.Count(); ++i)
+                        schemeAlias |= m_Scheme->m_FontAliases[i]._font == plan.handle;
+                // Ordinary/shared system families stay usable. Missing custom
+                // families and the retired CSOL aliases intentionally stay empty.
+                if (plan.spec.valid && !schemeAlias)
+                {
+                    bool available = false;
+                    if (!BaseFamilyAvailable(plan.spec, available))
+                    {
+                        candidates.clear(); font.reset(); manager.CollectUnusedFonts();
+                        return Fail(ResourceRefreshResult::FontUnavailable, "Cannot inspect base font availability; update remains suspended");
+                    }
+                    if (available && (!manager.ConfigureFont(*font, plan.spec) || !font->GetCount()))
+                    {
+                        candidates.clear(); font.reset(); manager.CollectUnusedFonts();
+                        return Fail(ResourceRefreshResult::FontUnavailable, "Available base font could not be restored; update remains suspended");
+                    }
+                }
+                candidates.push_back(std::move(font));
+            }
+            for (std::size_t i = 0; i < m_Plans.size(); ++i)
+            {
+                auto& destination = manager.m_FontAmalgams[m_Plans[i].handle];
+                destination.m_Fonts.Swap(candidates[i]->m_Fonts);
+                destination.m_iMaxHeight = candidates[i]->m_iMaxHeight;
+                destination.m_iMaxWidth = candidates[i]->m_iMaxWidth;
+            }
+            manager.CollectUnusedFonts();
+            if (m_Scheme) m_Scheme->m_ResourceRetired = true;
+            m_DormantFiles = std::move(dormantFiles);
+            Clear(); m_Error = "";
+            return ResourceRefreshResult::Success;
+        }
+        catch (...)
+        {
+            candidates.clear(); manager.CollectUnusedFonts();
+            return Fail(ResourceRefreshResult::FontUnavailable, "Resource removal allocation failed; update remains suspended");
+        }
+    }
+};
