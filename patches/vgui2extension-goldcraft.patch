+void CFontTextureCache::InvalidateFonts(const std::vector<HFont>& fonts)
+{
+    // All allocation precedes removal; an allocation failure cannot leave a
+    // partially invalidated cache with lost reusable rectangles.
+    m_FreeGlyphRects.reserve(m_FreeGlyphRects.size() + m_CharCache.Count());
+    for (auto index = m_CharCache.FirstInorder(); m_CharCache.IsValidIndex(index);)
+    {
+        const auto next = m_CharCache.NextInorder(index);
+        const auto& entry = m_CharCache[index];
+        if (index != m_LRUListHeadIndex &&
+            std::find(fonts.begin(), fonts.end(), entry.font) != fonts.end())
+        {
+            const auto& page = m_PageList[entry.page];
+            const int x = static_cast<int>(entry.texCoords[0] * page.wide + .5f);
+            const int y = static_cast<int>(entry.texCoords[1] * page.tall + .5f);
+            const int end = static_cast<int>(entry.texCoords[2] * page.wide + .5f);
+            m_FreeGlyphRects.push_back({entry.page, x, y, end - x + 1});
+            m_CharCache.RemoveAt(index);
+        }
+        index = next;
+    }
+    std::sort(m_FreeGlyphRects.begin(), m_FreeGlyphRects.end(), [](const auto& a, const auto& b)
+    {
+        if (a.page != b.page) return a.page < b.page;
+        return a.y != b.y ? a.y < b.y : a.x < b.x;
+    });
+    for (std::size_t i = 1; i < m_FreeGlyphRects.size();)
+    {
+        auto& previous = m_FreeGlyphRects[i - 1];
+        const auto& current = m_FreeGlyphRects[i];
+        if (previous.page == current.page && previous.y == current.y && previous.x + previous.wide == current.x)
+        {
+            previous.wide += current.wide;
+            m_FreeGlyphRects.erase(m_FreeGlyphRects.begin() + i);
+        }
+        else ++i;
+    }
+}
