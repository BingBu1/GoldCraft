+
+bool CFontManager::IsCustomFontFileSuspended(const char* path) const
+{
+    if (!m_Refreshing || !path) return false;
+    return std::any_of(m_RefreshFontPaths.begin(), m_RefreshFontPaths.end(), [path](const auto& value)
+    {
+        const char* a = value.c_str(); const char* b = path;
+        for (; *a && *b; ++a, ++b)
+        {
+            const auto left = *a == '\\' ? '/' : *a;
+            const auto right = *b == '\\' ? '/' : *b;
+            if (tolower(static_cast<unsigned char>(left)) != tolower(static_cast<unsigned char>(right))) return false;
+        }
+        return *a == *b;
+    });
+}
+
+void CFontManager::CollectUnusedFonts()
+{
+    for (int index = m_Win32Fonts.Count() - 1; index >= 0; --index)
+    {
+        auto* font = m_Win32Fonts[index];
+        bool used = false;
+        for (int handle = 1; handle < m_FontAmalgams.Count() && !used; ++handle)
+            for (int range = 0; range < m_FontAmalgams[handle].m_Fonts.Count(); ++range)
+                used |= m_FontAmalgams[handle].m_Fonts[range].font == font;
+        if (!used)
+        {
+            delete font;
+            m_Win32Fonts.Remove(index);
+        }
+    }
+}
