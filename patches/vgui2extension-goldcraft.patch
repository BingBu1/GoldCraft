diff --git a/src/TeamMenuMapPageHook.h b/src/TeamMenuMapPageHook.h
new file mode 100644
index 0000000..0c71e4c
--- /dev/null
+++ b/src/TeamMenuMapPageHook.h
@@ -0,0 +1,36 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+//The catalog's historical name is CTeamMenu::LoadMapPage(char const*), but the
+//verified CS 10210 binary passes four stack arguments and returns with ret 16.
+//Do not infer a calling convention from that name or apply this ABI to other
+//client builds. Keep the extra argument slots opaque and preserve EAX as well.
+struct TeamMenuMapPageHook
+{
+    using Function = std::uintptr_t(__fastcall*)(void*, std::uintptr_t, const char*, std::uintptr_t, std::uintptr_t, std::uintptr_t);
+
+    inline static Function Original  = nullptr;
+    inline static bool     InMapPage = false;
+
+    static bool Supports(std::uint64_t moduleCRC64, const unsigned char* code, std::size_t size)
+    {
+        return moduleCRC64 == 0x124D6034A6B28B40ULL && code && size >= 6 &&
+            code[size - 6] == 0x8B && code[size - 5] == 0xE5 &&
+            code[size - 4] == 0x5D && code[size - 3] == 0xC2 &&
+            code[size - 2] == 0x10 && code[size - 1] == 0x00;
+    }
+
+    static std::uintptr_t __fastcall Invoke(void* pthis, std::uintptr_t dummy, const char* mapname, std::uintptr_t arg2, std::uintptr_t arg3, std::uintptr_t arg4)
+    {
+        struct Scope
+        {
+            bool previous = InMapPage;
+            Scope() { InMapPage = true; }
+            ~Scope() { InMapPage = previous; }
+        } scope;
+
+        return Original(pthis, dummy, mapname, arg2, arg3, arg4);
+    }
+};
diff --git a/tests/team_menu_abi_tests.cpp b/tests/team_menu_abi_tests.cpp
new file mode 100644
index 0000000..6b14471
--- /dev/null
+++ b/tests/team_menu_abi_tests.cpp
@@ -0,0 +1,112 @@
+#include "../src/TeamMenuMapPageHook.h"
+
+#include <cassert>
+#include <cstdlib>
+#include <cstring>
+#include <cstdio>
+
+//This fixture intentionally crosses the x86 thiscall/fastcall detour boundary,
+//including the old incompatible signature as a subprocess negative control.
+#if defined(__clang__)
+#    pragma clang diagnostic push
+#    pragma clang diagnostic ignored "-Wcast-function-type-mismatch"
+#endif
+
+static_assert(sizeof(void*) == 4, "Exercise the actual x86 client ABI");
+//Invoke the emitted adapter as the real client does: ECX=this, four stack
+//arguments, callee cleanup. Inline assembly avoids C++ optimizer assumptions
+//about calls through incompatible function-pointer types. A stack mismatch
+//returns zero after restoring ESP so the test fails without corrupting main.
+static __declspec(naked) std::uintptr_t __cdecl NativeCall(void*, void*, const char*, std::uintptr_t, std::uintptr_t, std::uintptr_t)
+{
+    __asm
+    {
+		push ebp
+		mov ebp, esp
+		push dword ptr [ebp + 28]
+		push dword ptr [ebp + 24]
+		push dword ptr [ebp + 20]
+		push dword ptr [ebp + 16]
+		mov ecx, dword ptr [ebp + 12]
+		mov edx, 0x76543210
+		mov eax, dword ptr [ebp + 8]
+		call eax
+		cmp esp, ebp
+		je balanced
+		xor eax, eax
+	balanced:
+		mov esp, ebp
+		pop ebp
+		ret
+    }
+}
+
+static int        object;
+static const char mapName[] = "cs_assault";
+static unsigned   calls;
+static bool       nested;
+
+static __declspec(noinline) std::uintptr_t __fastcall Original(void* self, std::uintptr_t dummy, const char* map, std::uintptr_t second, std::uintptr_t third, std::uintptr_t fourth)
+{
+    //Distinct values catch missing, reordered or narrowed stack argument slots.
+    //Exit immediately on a mismatch, before an invalid caller can corrupt ESP.
+    if (self != &object || dummy != 0x76543210u || map != mapName || second != 0x12345678u ||
+        third != 0x89ABCDEFu || fourth != 0xFEDCBA98u || !TeamMenuMapPageHook::InMapPage)
+    {
+        std::fprintf(stderr, "ABI argument/scope mismatch: %p %08x %p %08x %08x %08x scope=%d\n",
+                     self, dummy, static_cast<const void*>(map), second, third, fourth, int(TeamMenuMapPageHook::InMapPage));
+        std::_Exit(86);
+    }
+    ++calls;
+    if (nested)
+    {
+        nested = false;
+        assert(NativeCall(reinterpret_cast<void*>(&TeamMenuMapPageHook::Invoke),
+                          self, map, second, third, fourth) == 0xF1234567u);
+        assert(TeamMenuMapPageHook::InMapPage);
+    }
+    return 0xF1234567u;
+}
+
+//Negative control reproduces the old production forwarding contract. It must
+//exit in Original's argument check, without returning through the broken stack.
+static void __fastcall OldOneArgumentHook(void* self, std::uintptr_t dummy, const char* map)
+{
+    const bool previous            = TeamMenuMapPageHook::InMapPage;
+    TeamMenuMapPageHook::InMapPage = true;
+    using OldFunction              = void(__fastcall*)(void*, std::uintptr_t, const char*);
+    volatile OldFunction old       = reinterpret_cast<OldFunction>(&Original);
+    old(self, dummy, map);
+    TeamMenuMapPageHook::InMapPage = previous;
+}
+
+int main(int argc, char** argv)
+{
+    TeamMenuMapPageHook::Original = Original;
+    void* callback                = reinterpret_cast<void*>(&TeamMenuMapPageHook::Invoke);
+    if (argc == 2 && std::strcmp(argv[1], "--legacy-negative-control") == 0)
+        callback = reinterpret_cast<void*>(&OldOneArgumentHook);
+
+    const auto result = NativeCall(callback, &object, mapName, 0x12345678u, 0x89ABCDEFu, 0xFEDCBA98u);
+    assert(result == 0xF1234567u && calls == 1 && !TeamMenuMapPageHook::InMapPage);
+
+    nested = true;
+    assert(NativeCall(callback, &object, mapName, 0x12345678u, 0x89ABCDEFu, 0xFEDCBA98u) == result);
+    assert(calls == 3 && !TeamMenuMapPageHook::InMapPage);
+    TeamMenuMapPageHook::InMapPage = true;
+    NativeCall(callback, &object, mapName, 0x12345678u, 0x89ABCDEFu, 0xFEDCBA98u);
+    assert(TeamMenuMapPageHook::InMapPage);
+    TeamMenuMapPageHook::InMapPage = false;
+
+    const unsigned char verifiedTail[] = {0x8B, 0xE5, 0x5D, 0xC2, 0x10, 0x00};
+    const unsigned char oldTail[]      = {0x8B, 0xE5, 0x5D, 0xC2, 0x04, 0x00};
+    assert(TeamMenuMapPageHook::Supports(0x124D6034A6B28B40ULL, verifiedTail, sizeof(verifiedTail)));
+    assert(!TeamMenuMapPageHook::Supports(0, verifiedTail, sizeof(verifiedTail)));
+    assert(!TeamMenuMapPageHook::Supports(0x124D6034A6B28B40ULL, oldTail, sizeof(oldTail)));
+    assert(!TeamMenuMapPageHook::Supports(0x124D6034A6B28B40ULL, nullptr, 6));
+    assert(!TeamMenuMapPageHook::Supports(0x124D6034A6B28B40ULL, verifiedTail, 2));
+}
+
+#if defined(__clang__)
+#    pragma clang diagnostic pop
+#endif
diff --git a/include/Interface/VGUI/IResourceRefresh.h b/include/Interface/VGUI/IResourceRefresh.h
new file mode 100644
index 0000000..36a7f0d
--- /dev/null
+++ b/include/Interface/VGUI/IResourceRefresh.h
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <interface.h>
+#include "VGUI.h"
+
+namespace vgui
+{
+enum class ResourceRefreshResult : unsigned int
+{
+    Success, InvalidRequest, Busy, WrongThread, FileUnavailable,
+    UnsupportedScheme, FontUnavailable, StaleToken
+};
+
+struct ResourceRefreshRequest
+{
+    unsigned int size;
+    const char* const* fontFamilies;
+    unsigned int fontFamilyCount;
+    const char* const* fontFiles;
+    unsigned int fontFileCount;
+    const char* schemeFile;
+};
+
+struct ResourceFontDefinition
+{
+    unsigned int size;
+    const char* name;
+    int tall, weight, blur, scanlines, flags, lowRange, highRange;
+};
+
+// UI-thread resource boundary only; never call from a paint callback.
+// Existing HFont/HScheme handles remain valid. The caller owns private font
+// registrations: remove them AFTER Begin; install replacements BEFORE Commit.
+// A failed Begin with token != 0 has already started suspension and also needs
+// Abort. An empty request is valid when no owner has loaded any font yet.
+// On Commit failure the token remains pending. Restore the old VFS and private
+// registrations before Abort. A failed Abort must not resume normal drawing.
+// Only pure-font schemes with the same aliases/files/base scales are supported.
+class IResourceRefresh : public IBaseInterface
+{
+public:
+    virtual ResourceRefreshResult BeginUpdate(const ResourceRefreshRequest& request, unsigned long long& token) = 0;
+    virtual ResourceRefreshResult CommitUpdate(unsigned long long token) = 0;
+    virtual ResourceRefreshResult AbortUpdate(unsigned long long token) = 0;
+    virtual const char* LastError() const = 0;
+    // Stage an owner's changed recipe without allocating another HFont.
+    // The handle must have been selected by Begin. Abort uses its old recipe.
+    virtual ResourceRefreshResult StageFont(unsigned long long token, HFont font, const ResourceFontDefinition& definition) = 0;
+    // After the caller restored base VFS and removed its private registrations,
+    // retire the selected scheme and rebuild available base fonts. Missing CSOL
+    // files are intentional here. Handles/recipes remain dormant for reentry;
+    // the next Begin must include this same scheme/families and Commit revives it.
+    virtual ResourceRefreshResult CommitRemoval(unsigned long long token) = 0;
+};
+
+#define VGUI_RESOURCE_REFRESH_INTERFACE_VERSION "VGUI_ResourceRefresh_001"
+}
