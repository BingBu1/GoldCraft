diff --git a/src/AutoRagdoll.cpp b/src/AutoRagdoll.cpp
new file mode 100644
index 0000000..b70a8ef
--- /dev/null
+++ b/src/AutoRagdoll.cpp
@@ -0,0 +1,200 @@
+#include <metahook.h>
+
+#include "AutoRagdoll.h"
+#include "ClientPhysicConfig.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstring>
+#include <numeric>
+#include <string_view>
+
+namespace
+{
+constexpr int MaxBodies = 12;
+
+template <class Record>
+const Record* StudioRecords(const studiohdr_t& studio, int offset, int count)
+{
+    if (offset < static_cast<int>(sizeof(studiohdr_t)) || offset > studio.length ||
+        offset % alignof(Record) || count <= 0 ||
+        static_cast<size_t>(count) > static_cast<size_t>(studio.length - offset) / sizeof(Record))
+        return nullptr;
+    return reinterpret_cast<const Record*>(reinterpret_cast<const byte*>(&studio) + offset);
+}
+
+struct HitBox
+{
+    std::array<float, 3> center{};
+    std::array<float, 3> halfSize{};
+    float volume{};
+};
+
+constexpr std::array<std::string_view, 10> HumanoidBones{
+    "bip01 pelvis", "bip01 head",
+    "bip01 l upperarm", "bip01 l forearm", "bip01 r upperarm", "bip01 r forearm",
+    "bip01 l thigh", "bip01 l calf", "bip01 r thigh", "bip01 r calf"};
+constexpr std::array<std::string_view, 5> ChestBones{
+    "bip01 spine3", "bip01 spine2", "bip01 spine02", "bip01 spine1", "bip01 spine"};
+
+bool IsBoneNamed(const mstudiobone_t& bone, std::string_view name)
+{
+    return bone.name[name.size()] == '\0' && _strnicmp(bone.name, name.data(), name.size()) == 0;
+}
+}
+
+std::shared_ptr<CClientRagdollObjectConfig> BuildAutoRagdoll(const studiohdr_t& studio)
+{
+    constexpr int GoldSrcStudioId = 'I' | ('D' << 8) | ('S' << 16) | ('T' << 24);
+    if (studio.id != GoldSrcStudioId || studio.version != 10 ||
+        studio.numbones > MAXSTUDIOBONES || studio.numhitboxes > 256)
+        return {};
+
+    const auto* bones = StudioRecords<mstudiobone_t>(studio, studio.boneindex, studio.numbones);
+    const auto* boxes = StudioRecords<mstudiobbox_t>(studio, studio.hitboxindex, studio.numhitboxes);
+    if (!bones || !boxes) return {};
+
+    std::array<int, MAXSTUDIOBONES> roots;
+    for (int i = 0; i < studio.numbones; ++i)
+    {
+        const int parent = bones[i].parent;
+        if (parent < -1 || parent >= i) return {};
+        roots[i] = parent < 0 ? i : roots[parent];
+    }
+
+    std::array<HitBox, MAXSTUDIOBONES> hitBoxes{};
+    for (int i = 0; i < studio.numhitboxes; ++i)
+    {
+        const auto& box = boxes[i];
+        if (box.bone < 0 || box.bone >= studio.numbones) return {};
+
+        HitBox candidate;
+        candidate.volume = 1.0f;
+        for (int axis = 0; axis < 3; ++axis)
+        {
+            const float lo = box.bbmin[axis];
+            const float hi = box.bbmax[axis];
+            if (!std::isfinite(lo) || !std::isfinite(hi) || lo < -1024.0f || hi > 1024.0f || hi <= lo)
+            {
+                candidate.volume = 0.0f;
+                break;
+            }
+            candidate.center[axis] = std::midpoint(lo, hi);
+            candidate.halfSize[axis] = (hi - lo) * 0.5f;
+            candidate.volume *= candidate.halfSize[axis];
+        }
+        if (candidate.volume > hitBoxes[box.bone].volume)
+            hitBoxes[box.bone] = candidate;
+    }
+
+    std::array<int, MaxBodies> selected;
+    int count = 0;
+    const auto findBody = [&](std::string_view name)
+    {
+        for (int i = 0; i < studio.numbones; ++i)
+            if (hitBoxes[i].volume > 0.0f && IsBoneNamed(bones[i], name))
+                return i;
+        return -1;
+    };
+
+    for (auto name : HumanoidBones)
+    {
+        const int bone = findBody(name);
+        if (bone < 0 || (count && roots[bone] != roots[selected[0]])) break;
+        selected[count++] = bone;
+    }
+    if (count == static_cast<int>(HumanoidBones.size()))
+    {
+        for (auto name : ChestBones)
+        {
+            const int bone = findBody(name);
+            if (bone < 0 || roots[bone] != roots[selected[0]]) continue;
+            selected[count++] = bone;
+            break;
+        }
+    }
+
+    if (count != static_cast<int>(HumanoidBones.size()) + 1)
+    {
+        // A quadruped or custom skeleton can still have an articulated body.
+        // Choose the connected skeleton with the largest collision volume.
+        std::array<float, MAXSTUDIOBONES> rootVolumes{};
+        for (int i = 0; i < studio.numbones; ++i)
+            rootVolumes[roots[i]] += hitBoxes[i].volume;
+        const int root = static_cast<int>(std::max_element(rootVolumes.begin(), rootVolumes.begin() + studio.numbones) - rootVolumes.begin());
+
+        std::array<int, MAXSTUDIOBONES> candidates;
+        int candidateCount = 0;
+        for (int i = 0; i < studio.numbones; ++i)
+            if (roots[i] == root && hitBoxes[i].volume > 0.0f)
+                candidates[candidateCount++] = i;
+
+        count = (std::min)(candidateCount, MaxBodies);
+        if (count < 3) return {};
+        std::partial_sort(candidates.begin(), candidates.begin() + count, candidates.begin() + candidateCount,
+            [&](int a, int b)
+            {
+                return hitBoxes[a].volume == hitBoxes[b].volume ? a < b : hitBoxes[a].volume > hitBoxes[b].volume;
+            });
+        std::copy_n(candidates.begin(), count, selected.begin());
+        std::sort(selected.begin(), selected.begin() + count);
+    }
+
+    auto config = std::make_shared<CClientRagdollObjectConfig>();
+    config->flags |= PhysicObjectFlag_AutoRagdoll | PhysicObjectFlag_OverrideStudioCheckBBox;
+    config->RigidBodyConfigs.reserve(count);
+    config->ConstraintConfigs.reserve(count - 1);
+
+    std::array<int, MAXSTUDIOBONES> bodyIndex;
+    bodyIndex.fill(-1);
+    for (int i = 0; i < count; ++i)
+    {
+        const int bone = selected[i];
+        const auto& box = hitBoxes[bone];
+        bodyIndex[bone] = i;
+
+        auto body = std::make_shared<CClientRigidBodyConfig>();
+        body->name = "bone" + std::to_string(bone);
+        body->boneindex = bone;
+        body->flags = PhysicRigidBodyFlag_AlwaysDynamic | PhysicRigidBodyFlag_NoCollisionToRagdollObject;
+        std::ranges::copy(box.center, body->origin);
+        // Clamp the mass ratio so a small hand or paw cannot destabilize the solver.
+        body->mass = std::clamp(std::cbrt(box.volume) * 3.0f, 4.0f, 45.0f);
+
+        auto shape = std::make_shared<CClientCollisionShapeConfig>();
+        shape->type = PhysicShape_Capsule;
+        const auto axis = std::max_element(box.halfSize.begin(), box.halfSize.end()) - box.halfSize.begin();
+        constexpr std::array directions{PhysicShapeDirection_X, PhysicShapeDirection_Y, PhysicShapeDirection_Z};
+        shape->direction = directions[axis];
+        shape->size[0] = (std::max)(0.25f, (std::min)({box.halfSize[0], box.halfSize[1], box.halfSize[2]}) * 0.9f);
+        shape->size[1] = (std::max)(0.0f, (box.halfSize[axis] * 0.9f - shape->size[0]) * 2.0f);
+        body->collisionShape = shape;
+        config->RigidBodyConfigs.push_back(std::move(body));
+    }
+
+    for (int i = 1; i < count; ++i)
+    {
+        const int bone = selected[i];
+        int parent = bones[bone].parent;
+        while (parent >= 0 && bodyIndex[parent] < 0)
+            parent = bones[parent].parent;
+
+        const auto& childBody = *config->RigidBodyConfigs[i];
+        auto joint = std::make_shared<CClientConstraintConfig>();
+        joint->name = childBody.name;
+        joint->type = PhysicConstraint_ConeTwist;
+        joint->flags = PhysicConstraintFlag_DontResetPoseOnErrorCorrection;
+        joint->rigidbodyA = config->RigidBodyConfigs[parent < 0 ? 0 : bodyIndex[parent]]->name;
+        joint->rigidbodyB = childBody.name;
+        // The child bone origin locates the joint in the sampled death pose.
+        joint->useGlobalJointFromA = false;
+        for (int axis = 0; axis < 3; ++axis)
+            joint->originB[axis] = -childBody.origin[axis];
+        joint->factors[PhysicConstraintFactorIdx_ConeTwistSwingSpanLimit1] = 0.25f;
+        joint->factors[PhysicConstraintFactorIdx_ConeTwistSwingSpanLimit2] = 0.25f;
+        joint->factors[PhysicConstraintFactorIdx_ConeTwistTwistSpanLimit] = 0.125f;
+        config->ConstraintConfigs.push_back(std::move(joint));
+    }
+    return config;
+}
