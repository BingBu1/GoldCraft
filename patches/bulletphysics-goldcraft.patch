diff --git a/tests/studio_lifecycle_tests.cpp b/tests/studio_lifecycle_tests.cpp
new file mode 100644
index 0000000..de129b2
--- /dev/null
+++ b/tests/studio_lifecycle_tests.cpp
@@ -0,0 +1,238 @@
+// Link the production draw wrappers, object manager and real Bullet backend.
+#include <cassert>
+#include <cstddef>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+#include <cvardef.h>
+#include "BulletPhysicManager.h"
+#include "ClientEntityManager.h"
+#include "enginedef.h"
+#include "exportfuncs.h"
+#include "privatehook.h"
+#include "test_support.h"
+
+extern int studiointerface_StudioDrawPlayer(int, entity_state_t*);
+extern void __fastcall GameStudioRenderer_StudioSetupBones(void*, int);
+extern int g_iRagdollRenderEntIndex;
+extern int g_iRagdollRenderFlags;
+extern cvar_t* bv_simrate;
+
+static cl_entity_t entities[33]{};
+static cl_entity_t* entityBase = entities;
+static cl_entity_t* current = &entities[1];
+static int maxEdicts = 33;
+static model_t models[2]{};
+static struct StudioData { studiohdr_t header{}; mstudiobone_t bone{}; } studio;
+static studiohdr_t* header = &studio.header;
+static float bones[MAXSTUDIOBONES][3][4]{};
+static float lights[MAXSTUDIOBONES][3][4]{};
+static r_studio_interface_t api{};
+static r_studio_interface_t* apiPointer = &api;
+static int nativeDrawFlags{};
+static int nativeSequence{};
+
+static void __fastcall NativeBones(void*, int)
+{
+	for (int i = 0; i < 3; ++i)
+	{
+		bones[0][i][i] = 1;
+		bones[0][i][3] = current->origin[i];
+	}
+}
+
+static int NativePlayer(int flags, entity_state_t* player)
+{
+	// The verified CS derived player entry invokes SetupBones directly; it
+	// never calls the old base StudioDrawPlayer wrapper (vtable slot 3).
+	nativeDrawFlags = flags;
+	nativeSequence = player->sequence;
+	GameStudioRenderer_StudioSetupBones(nullptr, 0);
+	return 1;
+}
+
+static int NativeModel(int flags)
+{
+	nativeDrawFlags = flags;
+	NativeBones(nullptr, 0);
+	return 1;
+}
+
+static void Init()
+{
+	TestInitPluginRuntime();
+	ClientPhysicManager()->Init();
+	cl_entities = &entityBase;
+	cl_max_edicts = &maxEdicts;
+	currententity = &current;
+	pstudiohdr = &header;
+	pbonetransform = &bones;
+	plighttransform = &lights;
+	gpStudioInterface = &apiPointer;
+	api.version = 1;
+	api.StudioDrawPlayer = studiointerface_StudioDrawPlayer;
+	api.StudioDrawModel = NativeModel;
+	gPrivateFuncs.studiointerface_StudioDrawPlayer = NativePlayer;
+	gPrivateFuncs.GameStudioRenderer_StudioSetupBones = NativeBones;
+	gEngfuncs.GetMaxClients = [] { return 32; };
+	gEngfuncs.GetClientTime = [] { return 42.0f; };
+	gEngfuncs.GetLocalPlayer = [] { return &entities[1]; };
+	IEngineStudio.SetupPlayerModel = [](int) { return current->model; };
+	IEngineStudio.GetPlayerState = [](int index) { return &entities[index + 1].curstate; };
+	IEngineStudio.Mod_Extradata = [](model_t*) -> void* { return header; };
+	studio.header.numbones = 1;
+	studio.header.boneindex = offsetof(StudioData, bone);
+	studio.bone.parent = -1;
+	for (int i = 0; i < 2; ++i) models[i].type = mod_studio;
+	current->index = current->curstate.number = 1;
+	current->player = 1;
+	current->model = &models[0];
+}
+
+static void TestSamplingRestoresState()
+{
+	auto& entity = entities[2];
+	entity.model = &models[0];
+	entity.curstate.weaponmodel = 70000;
+	entity.curstate.sequence = 4;
+	entity.curstate.gaitsequence = 3;
+	entity.curstate.frame = 19;
+	entity.curstate.animtime = 17;
+	entity.curstate.framerate = 0.75f;
+	const auto saved = entity.curstate;
+	ClientPhysicManager()->SetupBonesForRagdoll(&entity, &entity.curstate, entity.model, 2, 0);
+	assert(entity.curstate.weaponmodel == saved.weaponmodel);
+	assert(current == &entities[1]);
+	CClientAnimControlConfig pose;
+	pose.sequence = 1;
+	pose.gaitsequence = 2;
+	pose.animframe = 0;
+	ClientPhysicManager()->SetupBonesForRagdollEx(&entity, &entity.curstate, entity.model, 2, 0, &pose);
+	assert(entity.curstate.sequence == saved.sequence && entity.curstate.gaitsequence == saved.gaitsequence);
+	assert(entity.curstate.frame == saved.frame && entity.curstate.weaponmodel == saved.weaponmodel);
+	assert(entity.curstate.animtime == saved.animtime && entity.curstate.framerate == saved.framerate);
+	assert(current == &entities[1]);
+}
+
+static void TestCorpseIdentityUsesCandidate()
+{
+	std::vector<TEMPENTITY> temporary(EngineGetMaxTempEnts());
+	gTempEnts = temporary.data();
+	auto& corpse = temporary.front().entity;
+	corpse.curstate.iuser4 = PhyCorpseFlag;
+	corpse.curstate.owner = 1;
+	current->curstate.owner = 100;
+	assert(ClientEntityManager()->IsEntityClientCorpse(&corpse));
+	current->curstate.owner = 0;
+	corpse.curstate.owner = 33;
+	assert(!ClientEntityManager()->IsEntityClientCorpse(&corpse));
+	corpse.curstate.owner = 32;
+	assert(ClientEntityManager()->IsEntityClientCorpse(&corpse));
+	gTempEnts = nullptr;
+}
+
+static void TestPlayerBoundsFollowPublicCallback()
+{
+	cvar_t rate{};
+	rate.value = 64;
+	bv_simrate = &rate;
+	CClientRagdollObjectConfig config;
+	config.flags |= PhysicObjectFlag_OverrideStudioCheckBBox;
+	auto bodyConfig = std::make_shared<CClientRigidBodyConfig>();
+	bodyConfig->name = "root";
+	bodyConfig->boneindex = 0;
+	bodyConfig->flags = PhysicRigidBodyFlag_AlwaysKinematic;
+	bodyConfig->collisionShape = std::make_shared<CClientCollisionShapeConfig>();
+	bodyConfig->collisionShape->type = PhysicShape_Box;
+	bodyConfig->collisionShape->size[0] = 10;
+	bodyConfig->collisionShape->size[1] = 10;
+	bodyConfig->collisionShape->size[2] = 36;
+	config.RigidBodyConfigs.push_back(bodyConfig);
+	CPhysicObjectCreationParameter creation;
+	creation.m_entity = current;
+	creation.m_entstate = &current->curstate;
+	creation.m_entindex = creation.m_playerindex = 1;
+	creation.m_studiohdr = header;
+	creation.m_pPhysicObjectConfig = &config;
+	for (int model = 0; model < 2; ++model)
+	{
+		current->model = &models[model];
+		creation.m_model = current->model;
+		ClientPhysicManager()->RemovePhysicObject(1);
+		auto ragdoll = static_cast<CBulletPhysicManager*>(ClientPhysicManager())->CreateRagdollObject(creation);
+		assert(ragdoll && ragdoll->Build(creation));
+		ClientPhysicManager()->AddPhysicObject(1, ragdoll);
+		auto body = ragdoll->GetRigidBodyByName("root");
+		assert(body);
+		CPhysicObjectUpdateContext update;
+		CPhysicComponentUpdateContext component(&update);
+		component.bIsAddingPhysicComponent = true;
+		body->Update(&component);
+		ClientPhysicManager()->AddPhysicComponentsToWorld(ragdoll, {});
+		auto centerX = [&] {
+			vec3_t mins{}, maxs{};
+			assert(body->GetAABB(mins, maxs));
+			return (mins[0] + maxs[0]) * 0.5f;
+		};
+		const float initial = centerX();
+		current->origin[0] += 2409;
+		// Negative control: the old base hook is bypassed and the real Bullet
+		// collider remains at its initial position after the native bones move.
+		NativePlayer(0, &current->curstate);
+		ClientPhysicManager()->StepSimulation(1.0 / 32.0);
+		assert(IsNear(initial, centerX(), 0.01f));
+		// Production public callback/update path must now move that same collider.
+		ClientPhysicManager()->UpdateBonesForRagdoll(current, &current->curstate, current->model, 1, 1);
+		ClientPhysicManager()->StepSimulation(1.0 / 32.0);
+		assert(nativeDrawFlags == 0);
+		assert(IsNear(current->origin[0], centerX(), 0.01f));
+		assert(g_iRagdollRenderEntIndex == 0 && g_iRagdollRenderFlags == 0);
+	}
+	ClientPhysicManager()->RemovePhysicObject(1);
+	bv_simrate = nullptr;
+}
+
+static void TestRebuildDropsRemovedPose()
+{
+	CClientRagdollObjectConfig config;
+	auto idle = std::make_shared<CClientAnimControlConfig>();
+	idle->activityType = StudioAnimActivityType_Idle;
+	idle->sequence = 7;
+	config.AnimControlConfigs.push_back(idle);
+	auto debug = std::make_shared<CClientAnimControlConfig>();
+	debug->activityType = StudioAnimActivityType_Debug;
+	debug->sequence = 9;
+	config.AnimControlConfigs.push_back(debug);
+	std::weak_ptr<CClientAnimControlConfig> oldIdle = idle, oldDebug = debug;
+	CPhysicObjectCreationParameter creation;
+	creation.m_entity = current;
+	creation.m_entstate = &current->curstate;
+	creation.m_entindex = creation.m_playerindex = 1;
+	creation.m_studiohdr = header;
+	creation.m_model = current->model;
+	creation.m_pPhysicObjectConfig = &config;
+	current->curstate.sequence = 3;
+	auto ragdoll = static_cast<CBulletPhysicManager*>(ClientPhysicManager())->CreateRagdollObject(creation);
+	assert(ragdoll && ragdoll->Build(creation));
+	assert(nativeSequence == 7);
+	config.AnimControlConfigs.clear();
+	idle.reset();
+	debug.reset();
+	assert(ragdoll->Rebuild(creation));
+	assert(nativeSequence == 3);
+	assert(oldIdle.expired() && oldDebug.expired());
+}
+
+int main(int argc, char** argv)
+{
+	assert(argc == 2);
+	Init();
+	if (!strcmp(argv[1], "state")) TestSamplingRestoresState();
+	else if (!strcmp(argv[1], "corpse")) TestCorpseIdentityUsesCandidate();
+	else if (!strcmp(argv[1], "bounds")) TestPlayerBoundsFollowPublicCallback();
+	else if (!strcmp(argv[1], "rebuild")) TestRebuildDropsRemovedPose();
+	else return 2;
+	ClientPhysicManager()->Shutdown();
+	TestShutdownPluginRuntime();
+	puts("Studio lifecycle check passed.");
+}
