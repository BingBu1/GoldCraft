+static void InspectModels(int count, char** paths)
+{
+    for (int i = 0; i < count; ++i)
+    {
+        const auto path = std::filesystem::path(paths[i]);
+        std::ifstream stream(path, std::ios::binary);
+        studiohdr_t fileHeader{};
+        assert(stream.read(reinterpret_cast<char*>(&fileHeader), sizeof(fileHeader)));
+        const auto end = [](int offset, int count, size_t record) {
+            assert(offset > 0 && count >= 0);
+            return static_cast<size_t>(offset) + count * record;
+        };
+        const size_t prefix = (std::max)({end(fileHeader.boneindex, fileHeader.numbones, sizeof(mstudiobone_t)),
+            end(fileHeader.hitboxindex, fileHeader.numhitboxes, sizeof(mstudiobbox_t)),
+            end(fileHeader.seqindex, fileHeader.numseq, sizeof(mstudioseqdesc_t))});
+        assert(fileHeader.length > 0 && prefix <= static_cast<size_t>(fileHeader.length));
+        std::vector<int> bytes((prefix + sizeof(int) - 1) / sizeof(int));
+        assert(stream.seekg(0).read(reinterpret_cast<char*>(bytes.data()), prefix));
+        header = reinterpret_cast<studiohdr_t*>(bytes.data());
+        auto config = BuildAutoRagdoll(*header);
+        int deathSequences = 0;
+        for (int seq = 0; seq < header->numseq; ++seq)
+        {
+            entity_state_t state{};
+            state.sequence = seq;
+            StudioAnimActivityType activity{};
+            int flags{};
+            if (StudioGetActivityType(&models[0], &state, &activity, &flags) &&
+                activity == StudioAnimActivityType_Death)
+                ++deathSequences;
+        }
+        printf("%s|%zu|%d\n", paths[i], config ? config->RigidBodyConfigs.size() : 0, deathSequences);
+    }
+    header = &studio.header;
+}
+
+int main(int argc, char** argv)
+{
+    assert(argc >= 2);
+    Init();
+    if (!strcmp(argv[1], "state")) TestSamplingRestoresState();
+    else if (!strcmp(argv[1], "corpse"))
+        TestCorpseIdentityUsesCandidate();
+    else if (!strcmp(argv[1], "bounds"))
+        TestPlayerBoundsFollowPublicCallback();
+    else if (!strcmp(argv[1], "rebuild"))
+        TestRebuildDropsRemovedPose();
+    else if (!strcmp(argv[1], "auto-lifecycle"))
+        TestRagdollLifecycle();
+    else if (!strcmp(argv[1], "auto-bounds"))
+        TestRagdollLimitAndFallback();
+    else if (!strcmp(argv[1], "auto-collision"))
+        TestRagdollCollisionAndBones();
+    else if (!strcmp(argv[1], "models") && argc > 2)
+        InspectModels(argc - 2, argv + 2);
+    else
+        return 2;
+    ClientPhysicManager()->Shutdown();
+    TestShutdownPluginRuntime();
+    puts("Studio lifecycle check passed.");
+}
