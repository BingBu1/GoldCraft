+
+RagdollPoseSample* activeRagdollSample{};
+
+class ScopedRagdollBoneCache
+{
+public:
+    explicit ScopedRagdollBoneCache(bool ragdoll)
+    {
+        if (!ragdoll || !gEngfuncs.pfnGetCvarPointer)
+            return;
+
+        // Renderer may short-circuit StudioSetupBones with cached animation.
+        // Keep its cache enabled for unrelated models and drawing passes.
+        static auto* boneCache = gEngfuncs.pfnGetCvarPointer("r_studio_bone_caches");
+        cvar = boneCache;
+        if (cvar)
+        {
+            savedValue = cvar->value;
+            cvar->value = 0;
+        }
+    }
+
+    ~ScopedRagdollBoneCache()
+    {
+        if (cvar) cvar->value = savedValue;
+    }
+
+private:
+    cvar_t* cvar{};
+    float savedValue{};
+};
+}
+
+bool SampleAutoRagdollPose(cl_entity_t* entity, entity_state_t* state, model_t* model,
+    int entityIndex, int playerIndex, const studiohdr_t* expectedHeader)
+{
+    if (!expectedHeader || activeRagdollSample)
+        return false;
+
+    ScopedRagdollBoneCache boneCache{true};
+    RagdollPoseSample sample{entity};
+    activeRagdollSample = &sample;
+    ClientPhysicManager()->SetupBonesForRagdoll(entity, state, model, entityIndex, playerIndex);
+    activeRagdollSample = nullptr;
+    return sample.studio == expectedHeader;
+}
