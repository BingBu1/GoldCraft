+extern int             g_iRagdollRenderEntIndex;
+extern int             g_iRagdollRenderFlags;
+extern cvar_t*         bv_simrate;
+
+static cl_entity_t  entities[33]{};
+static cl_entity_t* entityBase = entities;
+static cl_entity_t* current    = &entities[1];
+static int          maxEdicts  = 33;
+static model_t      models[2]{};
+static int          modelCount = 2;
+static struct StudioData
+{
+    studiohdr_t   header{};
+    mstudiobone_t bone{};
+} studio;
+static studiohdr_t*          header = &studio.header;
+static float                 bones[MAXSTUDIOBONES][3][4]{};
+static float                 lights[MAXSTUDIOBONES][3][4]{};
+static r_studio_interface_t  api{};
+static r_studio_interface_t* apiPointer = &api;
+static int                   nativeDrawFlags{};
+static int                   nativeSequence{};
+static bool                  skipNativeBones{};
+static cvar_t                autoRagdoll{};
+static cvar_t                boneCache{};
+static cvar_t                simRate{};
+
+static void __fastcall NativeBones(void*, int)
+{
+    const auto* skeleton = reinterpret_cast<const mstudiobone_t*>(
+        reinterpret_cast<const byte*>(header) + header->boneindex);
+    for (int bone = 0; bone < header->numbones; ++bone)
+    {
+        memset(bones[bone], 0, sizeof(bones[bone]));
+        for (int axis = 0; axis < 3; ++axis)
+        {
+            bones[bone][axis][axis] = 1;
+            bones[bone][axis][3] = current->origin[axis] + skeleton[bone].value[axis];
+        }
+    }
+}
+
+static int NativePlayer(int flags, entity_state_t* player)
+{
+    // The verified CS derived player entry invokes SetupBones directly; it
+    // never calls the old base StudioDrawPlayer wrapper (vtable slot 3).
+    nativeDrawFlags = flags;
+    nativeSequence  = player->sequence;
+    if (!skipNativeBones) GameStudioRenderer_StudioSetupBones(nullptr, 0);
+    return 1;
+}
+
+static int NativeModel(int flags)
+{
+    nativeDrawFlags = flags;
+    if (!skipNativeBones) GameStudioRenderer_StudioSetupBones(nullptr, 0);
+    return 1;
+}
+
+static void Init()
+{
+    TestInitPluginRuntime();
+    ClientPhysicManager()->Init();
+    cl_entities                                       = &entityBase;
+    cl_max_edicts                                     = &maxEdicts;
+    currententity                                     = &current;
+    pstudiohdr                                        = &header;
+    pbonetransform                                    = &bones;
+    plighttransform                                   = &lights;
+    gpStudioInterface                                 = &apiPointer;
+    api.version                                       = 1;
+    api.StudioDrawPlayer                              = studiointerface_StudioDrawPlayer;
+    api.StudioDrawModel                               = R_StudioDrawModel;
+    gPrivateFuncs.R_StudioDrawModel                   = NativeModel;
+    mod_known                                        = models;
+    mod_numknown                                     = &modelCount;
+    gEngfuncs.GetEntityByIndex                        = [](int index) { return &entities[index]; };
+    gPrivateFuncs.studiointerface_StudioDrawPlayer    = NativePlayer;
+    gPrivateFuncs.GameStudioRenderer_StudioSetupBones = NativeBones;
+    gEngfuncs.GetMaxClients                           = [] {
+        return 32;
+    };
+    gEngfuncs.GetClientTime = [] {
+        return 42.0f;
+    };
+    gEngfuncs.GetLocalPlayer = [] {
+        return &entities[1];
+    };
+    IEngineStudio.SetupPlayerModel = [](int) {
+        return current->model;
+    };
+    IEngineStudio.GetPlayerState = [](int index) {
+        return &entities[index + 1].curstate;
+    };
+    IEngineStudio.Mod_Extradata = [](model_t*) -> void* {
+        return header;
+    };
+    studio.header.numbones  = 1;
+    studio.header.boneindex = offsetof(StudioData, bone);
+    studio.bone.parent      = -1;
+    for (int i = 0; i < 2; ++i) models[i].type = mod_studio;
+    current->index = current->curstate.number = 1;
+    current->player                           = 1;
+    current->model                            = &models[0];
+}
+
+static void TestSamplingRestoresState()
+{
+    auto& entity                 = entities[2];
+    entity.model                 = &models[0];
+    entity.curstate.weaponmodel  = 70000;
+    entity.curstate.sequence     = 4;
+    entity.curstate.gaitsequence = 3;
+    entity.curstate.frame        = 19;
+    entity.curstate.animtime     = 17;
+    entity.curstate.framerate    = 0.75f;
+    const auto saved             = entity.curstate;
+    ClientPhysicManager()->SetupBonesForRagdoll(&entity, &entity.curstate, entity.model, 2, 0);
+    assert(entity.curstate.weaponmodel == saved.weaponmodel);
+    assert(current == &entities[1]);
+    CClientAnimControlConfig pose;
+    pose.sequence     = 1;
+    pose.gaitsequence = 2;
+    pose.animframe    = 0;
+    ClientPhysicManager()->SetupBonesForRagdollEx(&entity, &entity.curstate, entity.model, 2, 0, &pose);
+    assert(entity.curstate.sequence == saved.sequence && entity.curstate.gaitsequence == saved.gaitsequence);
+    assert(entity.curstate.frame == saved.frame && entity.curstate.weaponmodel == saved.weaponmodel);
+    assert(entity.curstate.animtime == saved.animtime && entity.curstate.framerate == saved.framerate);
+    assert(current == &entities[1]);
+}
+
+static void TestCorpseIdentityUsesCandidate()
+{
+    std::vector<TEMPENTITY> temporary(EngineGetMaxTempEnts());
+    gTempEnts               = temporary.data();
+    auto& corpse            = temporary.front().entity;
+    corpse.curstate.iuser4  = PhyCorpseFlag;
+    corpse.curstate.owner   = 1;
+    current->curstate.owner = 100;
+    assert(ClientEntityManager()->IsEntityClientCorpse(&corpse));
+    current->curstate.owner = 0;
+    corpse.curstate.owner   = 33;
+    assert(!ClientEntityManager()->IsEntityClientCorpse(&corpse));
+    corpse.curstate.owner = 32;
+    assert(ClientEntityManager()->IsEntityClientCorpse(&corpse));
+    gTempEnts = nullptr;
+}
+
+static void TestPlayerBoundsFollowPublicCallback()
+{
+    cvar_t rate{};
+    rate.value = 64;
+    bv_simrate = &rate;
+    CClientRagdollObjectConfig config;
+    config.flags |= PhysicObjectFlag_OverrideStudioCheckBBox;
+    auto bodyConfig                     = std::make_shared<CClientRigidBodyConfig>();
+    bodyConfig->name                    = "root";
+    bodyConfig->boneindex               = 0;
+    bodyConfig->flags                   = PhysicRigidBodyFlag_AlwaysKinematic;
+    bodyConfig->collisionShape          = std::make_shared<CClientCollisionShapeConfig>();
+    bodyConfig->collisionShape->type    = PhysicShape_Box;
+    bodyConfig->collisionShape->size[0] = 10;
+    bodyConfig->collisionShape->size[1] = 10;
+    bodyConfig->collisionShape->size[2] = 36;
+    config.RigidBodyConfigs.push_back(bodyConfig);
+    CPhysicObjectCreationParameter creation;
+    creation.m_entity   = current;
+    creation.m_entstate = &current->curstate;
+    creation.m_entindex = creation.m_playerindex = 1;
+    creation.m_studiohdr                         = header;
+    creation.m_pPhysicObjectConfig               = &config;
+    for (int model = 0; model < 2; ++model)
+    {
+        current->model   = &models[model];
+        creation.m_model = current->model;
+        ClientPhysicManager()->RemovePhysicObject(1);
+        auto ragdoll = static_cast<CBulletPhysicManager*>(ClientPhysicManager())->CreateRagdollObject(creation);
+        assert(ragdoll && ragdoll->Build(creation));
+        ClientPhysicManager()->AddPhysicObject(1, ragdoll);
+        auto body = ragdoll->GetRigidBodyByName("root");
+        assert(body);
+        CPhysicObjectUpdateContext    update;
+        CPhysicComponentUpdateContext component(&update);
+        component.bIsAddingPhysicComponent = true;
+        body->Update(&component);
+        ClientPhysicManager()->AddPhysicComponentsToWorld(ragdoll, {});
+        auto centerX = [&] {
+            vec3_t mins{}, maxs{};
+            assert(body->GetAABB(mins, maxs));
+            return (mins[0] + maxs[0]) * 0.5f;
+        };
+        const float initial = centerX();
+        current->origin[0] += 2409;
+        // Negative control: the old base hook is bypassed and the real Bullet
+        // collider remains at its initial position after the native bones move.
+        NativePlayer(0, &current->curstate);
+        ClientPhysicManager()->StepSimulation(1.0 / 32.0);
+        assert(IsNear(initial, centerX(), 0.01f));
+        // Production public callback/update path must now move that same collider.
+        ClientPhysicManager()->UpdateBonesForRagdoll(current, &current->curstate, current->model, 1, 1);
+        ClientPhysicManager()->StepSimulation(1.0 / 32.0);
+        assert(nativeDrawFlags == 0);
+        assert(IsNear(current->origin[0], centerX(), 0.01f));
+        assert(g_iRagdollRenderEntIndex == 0 && g_iRagdollRenderFlags == 0);
+    }
+    ClientPhysicManager()->RemovePhysicObject(1);
+    bv_simrate = nullptr;
+}
+
+static void TestRebuildDropsRemovedPose()
+{
+    CClientRagdollObjectConfig config;
+    auto                       idle = std::make_shared<CClientAnimControlConfig>();
+    idle->activityType              = StudioAnimActivityType_Idle;
+    idle->sequence                  = 7;
+    config.AnimControlConfigs.push_back(idle);
+    auto debug          = std::make_shared<CClientAnimControlConfig>();
+    debug->activityType = StudioAnimActivityType_Debug;
+    debug->sequence     = 9;
+    config.AnimControlConfigs.push_back(debug);
+    std::weak_ptr<CClientAnimControlConfig> oldIdle = idle, oldDebug = debug;
+    CPhysicObjectCreationParameter          creation;
+    creation.m_entity   = current;
+    creation.m_entstate = &current->curstate;
+    creation.m_entindex = creation.m_playerindex = 1;
+    creation.m_studiohdr                         = header;
+    creation.m_model                             = current->model;
+    creation.m_pPhysicObjectConfig               = &config;
+    current->curstate.sequence                   = 3;
+    auto ragdoll                                 = static_cast<CBulletPhysicManager*>(ClientPhysicManager())->CreateRagdollObject(creation);
+    assert(ragdoll && ragdoll->Build(creation));
+    assert(nativeSequence == 7);
+    config.AnimControlConfigs.clear();
+    idle.reset();
+    debug.reset();
+    assert(ragdoll->Rebuild(creation));
+    assert(nativeSequence == 3);
+    assert(oldIdle.expired() && oldDebug.expired());
+}
+
+struct RagdollStudio
+{
+    studiohdr_t header{};
+    mstudiobone_t bones[5]{};
+    mstudiobbox_t hitBoxes[4]{};
+    mstudioseqdesc_t sequences[2]{};
+};
+
+static RagdollStudio articulatedModel;
+
+static void InitAutoRagdoll()
+{
+    auto& model = articulatedModel;
+    model.header.id = 'I' | ('D' << 8) | ('S' << 16) | ('T' << 24);
+    model.header.version = 10;
+    model.header.length = sizeof(model);
+    model.header.numbones = std::size(model.bones);
+    model.header.boneindex = offsetof(RagdollStudio, bones);
+    model.header.numhitboxes = std::size(model.hitBoxes);
+    model.header.hitboxindex = offsetof(RagdollStudio, hitBoxes);
+    model.header.numseq = std::size(model.sequences);
+    model.header.seqindex = offsetof(RagdollStudio, sequences);
+    model.sequences[1].activity = ACT_DIESIMPLE;
+    model.bones[0].parent = -1; // The undriven root must move with the simulated skeleton.
+    for (int i = 1; i < model.header.numbones; ++i)
+    {
+        model.bones[i].parent = i - 1;
+        model.bones[i].value[0] = i * 3.0f;
+        model.bones[i].value[2] = i * 6.0f;
+        model.hitBoxes[i - 1] = {i, 0, {-3.0f, -3.0f, -4.0f}, {3.0f, 3.0f, 4.0f}};
+    }
+
+    header = &model.header;
+    g_bIsCounterStrike = true;
+    autoRagdoll.value = 1;
+    bv_auto_ragdoll = &autoRagdoll;
+    simRate.value = 64;
+    bv_simrate = &simRate;
+    boneCache.value = 1;
+    gEngfuncs.pfnGetCvarPointer = [](const char* name) -> cvar_t* {
+        return strcmp(name, "r_studio_bone_caches") == 0 ? &boneCache : nullptr;
+    };
+    gEngfuncs.GetMaxClients = [] { return 2; };
+}
+
+static void Present(cl_entity_t& entity, int index, int movement, int solidity, int sequence)
+{
+    entity.index = entity.curstate.number = index;
+    entity.model = &models[0];
+    entity.curstate.movetype = movement;
+    entity.curstate.solid = solidity;
+    entity.curstate.sequence = sequence;
+    ClientPhysicManager()->CreatePhysicObjectForEntity(&entity, &entity.curstate, entity.model);
+}
+
+static void TestRagdollLifecycle()
+{
+    InitAutoRagdoll();
+    auto* manager = ClientPhysicManager();
+    auto& player = entities[1];
+    auto& zombie = entities[3];
+
+    Present(player, 1, MOVETYPE_WALK, SOLID_SLIDEBOX, 1);
+    Present(zombie, 3, MOVETYPE_STEP, SOLID_SLIDEBOX, 1);
+    assert(!manager->GetPhysicObject(1) && !manager->GetPhysicObject(3));
+    Present(zombie, 3, MOVETYPE_TOSS, SOLID_NOT, 0); // A thrown model has no death activity.
+    assert(!manager->GetPhysicObject(3));
+
+    skipNativeBones = true; // Stale but matching pstudiohdr is insufficient.
+    Present(zombie, 3, MOVETYPE_TOSS, SOLID_NOT, 1);
+    assert(!manager->GetPhysicObject(3) && boneCache.value == 1);
+    skipNativeBones = false;
+    zombie.curstate.scale = 1.5f;
+    Present(zombie, 3, MOVETYPE_TOSS, SOLID_NOT, 1);
+    assert(!manager->GetPhysicObject(3));
+    zombie.curstate.scale = 0;
+
+    Present(player, 1, MOVETYPE_TOSS, SOLID_NOT, 1);
+    auto* death = manager->GetPhysicObject(1);
+    assert(death && death->IsRagdollObject() && death->GetPlayerIndex() == 1);
+    Present(player, 1, MOVETYPE_NONE, SOLID_NOT, 1);
+    assert(manager->GetPhysicObject(1) == death);
+    Present(zombie, 3, MOVETYPE_TOSS, SOLID_NOT, 1);
+    assert(manager->GetPhysicObject(3));
+    Present(zombie, 3, MOVETYPE_STEP, SOLID_SLIDEBOX, 0);
+    assert(!manager->GetPhysicObject(3));
+
+    std::vector<TEMPENTITY> temps(EngineGetMaxTempEnts());
+    gTempEnts = temps.data();
+    auto& corpse = gTempEnts->entity;
+    gPrivateFuncs.efxapi_R_TempModel = [](float*, float*, float*, float, int, int) { return gTempEnts; };
+    auto allocateCorpse = [&] {
+        g_bIsCreatingClCorpse = true;
+        g_iCreatingClCorpsePlayerIndex = 1;
+        efxapi_R_TempModel(nullptr, nullptr, nullptr, 0, 0, 0);
+        g_bIsCreatingClCorpse = false;
+        g_iCreatingClCorpsePlayerIndex = 0;
+    };
+    auto emitCorpse = [&] {
+        Present(corpse, 0, MOVETYPE_NONE, SOLID_NOT, 1);
+    };
+
+    allocateCorpse();
+    emitCorpse();
+    const int index = ClientEntityManager()->GetEntityIndex(&corpse);
+    assert(!manager->GetPhysicObject(1) && manager->GetPhysicObject(index) == death);
+    Present(player, 1, MOVETYPE_NONE, SOLID_NOT, 1);
+    assert(!manager->GetPhysicObject(1)); // No duplicate while the original slot is still drawn.
+    Present(player, 1, MOVETYPE_WALK, SOLID_SLIDEBOX, 0);
+    assert(manager->GetPhysicObject(index) == death);
+    allocateCorpse();
+    assert(!manager->GetPhysicObject(index));
+    corpse.origin[0] = 400;
+    emitCorpse();
+    vec3_t origin{};
+    auto* newCorpse = manager->GetPhysicObject(index);
+    assert(newCorpse && newCorpse->GetGoldSrcOriginAngles(origin, nullptr) && origin[0] > 400);
+    corpse.curstate.iuser4 = 0;
+    emitCorpse();
+    assert(!manager->GetPhysicObject(index));
+    gTempEnts = nullptr;
+
+    // A dead player object still in the manager must not transfer after the state revives.
+    Present(player, 1, MOVETYPE_TOSS, SOLID_NOT, 1);
+    death = manager->GetPhysicObject(1);
+    assert(death);
+    player.curstate.movetype = MOVETYPE_WALK;
+    player.curstate.solid = SOLID_SLIDEBOX;
+    gTempEnts = temps.data();
+    allocateCorpse();
+    emitCorpse();
+    assert(manager->GetPhysicObject(1) == death && manager->GetPhysicObject(index) != death);
+    Present(player, 1, MOVETYPE_WALK, SOLID_SLIDEBOX, 0);
+    assert(!manager->GetPhysicObject(1));
+
+    autoRagdoll.value = 0;
+    ClientEntityManager()->SetEntityEmitted(index);
+    manager->UpdateAllPhysicObjects(nullptr, nullptr, 1.0 / 64, 0, 800);
+    assert(!manager->GetPhysicObject(index));
+    assert(boneCache.value == 1 && current == &entities[1]);
+    gTempEnts = nullptr;
+}
+
+static void TestRagdollLimitAndFallback()
+{
+    InitAutoRagdoll();
+    auto* manager = ClientPhysicManager();
+    for (int index = 3; index <= 19; ++index)
+    {
+        Present(entities[index], index, MOVETYPE_TOSS, SOLID_NOT, 1);
+        assert((manager->GetPhysicObject(index) != nullptr) == (index < 19));
+    }
+    manager->RemovePhysicObject(3);
+    Present(entities[19], 19, MOVETYPE_TOSS, SOLID_NOT, 1);
+    assert(manager->GetPhysicObject(19));
+    ClientEntityManager()->ClearEntityEmitStates();
+    manager->UpdateAllPhysicObjects(nullptr, nullptr, 1.0 / 64, 0, 800);
+    for (int index = 3; index <= 19; ++index)
+        assert(!manager->GetPhysicObject(index));
+
+    auto invalidModel = articulatedModel;
+    invalidModel.bones[1].parent = 1;
+    assert(!BuildAutoRagdoll(invalidModel.header));
+    invalidModel = articulatedModel;
+    invalidModel.header.hitboxindex = invalidModel.header.length;
+    assert(!BuildAutoRagdoll(invalidModel.header));
+    invalidModel = articulatedModel;
+    invalidModel.header.seqindex = invalidModel.header.length;
+    header = &invalidModel.header;
+    Present(entities[20], 20, MOVETYPE_TOSS, SOLID_NOT, 1);
+    assert(!manager->GetPhysicObject(20));
+    header = &articulatedModel.header;
+}
+
+static void TestRagdollCollisionAndBones()
+{
+    InitAutoRagdoll();
+    auto* manager = ClientPhysicManager();
+    CClientStaticObjectConfig floorConfig;
+    auto floorBody = std::make_shared<CClientRigidBodyConfig>();
+    floorBody->mass = 0;
+    floorBody->collisionShape = std::make_shared<CClientCollisionShapeConfig>();
+    floorBody->collisionShape->type = PhysicShape_Box;
+    floorBody->collisionShape->size[0] = floorBody->collisionShape->size[1] = 256;
+    floorBody->collisionShape->size[2] = 4;
+    floorConfig.RigidBodyConfigs.push_back(floorBody);
+    model_t brush{};
+    brush.type = mod_brush;
+    entities[0].origin[2] = -4;
+    CPhysicObjectCreationParameter floorParams;
+    floorParams.m_model = &brush;
+    floorParams.m_entity = &entities[0];
+    floorParams.m_entstate = &entities[0].curstate;
+    floorParams.m_pPhysicObjectConfig = &floorConfig;
+    auto* floor = static_cast<CBulletPhysicManager*>(manager)->CreateStaticObject(floorParams);
+    assert(floor && floor->Build(floorParams));
+    manager->AddPhysicObject(0, floor);
+
+    auto& zombie = entities[3];
+    zombie.origin[2] = 96;
+    Present(zombie, 3, MOVETYPE_TOSS, SOLID_NOT, 1);
+    auto* ragdoll = static_cast<IRagdollObject*>(manager->GetPhysicObject(3));
+    assert(ragdoll && ragdoll->GetActivityType() == StudioAnimActivityType_Death);
+
+    manager->SetGravity(800);
+    for (int tick = 0; tick < 192; ++tick)
+        manager->StepSimulation(1.0 / 64);
+
+    int bodies = 0, joints = 0;
+    ragdoll->EnumPhysicComponents([&](IPhysicComponent* component) {
+        if (component->IsRigidBody())
+        {
+            ++bodies;
+            auto* body = static_cast<IPhysicRigidBody*>(component);
+            vec3_t mins{}, maxs{};
+            assert(body->GetAABB(mins, maxs));
+            assert(mins[2] > -3 && maxs[2] < 50); // Falls and rests on the Bullet floor.
+        }
+        if (component->IsConstraint())
+        {
+            ++joints;
+            auto* joint = static_cast<IPhysicConstraint*>(component);
+            float error = BulletGetConstraintLinearErrorMagnitude(
+                static_cast<btTypedConstraint*>(joint->GetInternalConstraint()));
+            FloatBulletToGoldSrc(&error);
+            assert(error < 2);
+        }
+        return false;
+    });
+    assert(bodies == 4 && joints == 3);
+    current = &zombie;
+    assert(R_StudioDrawModel(STUDIO_RENDER) == 1);
+    assert(boneCache.value == 1);
+    assert(bones[0][2][3] < 20);
+    assert(memcmp(bones, lights, sizeof(float) * 5 * 3 * 4) == 0);
+    assert(zombie.origin[2] == 96); // The physics pose does not overwrite network origin.
+    current = &entities[1];
+    manager->RemovePhysicObject(3);
+    manager->RemovePhysicObject(0);
+}
