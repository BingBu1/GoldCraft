+// Register in the requesting plugin's AMX, so its Ham callbacks remain owned
+// by that plugin. RegisterHam(..., specialbot=true) would also add a second
+// normal-player hook and does not preserve this CZ-only compatibility API.
+register_ham_czbots(id)
+{
+    if (!is_user_connected(id) || !is_user_bot(id) || !cvar_bot_quota || !get_pcvar_num(cvar_bot_quota)) return;
+    g_CZBotPlayerID = id
+    g_CZBotUserID = get_user_userid(id)
+    for (new index = 0; index < ArraySize(g_BotHooks); index++)
+    {
+        new record[BotHook]
+        ArrayGetArray(g_BotHooks, index, record)
+        if (record[HookHandle] != HamHook:INVALID_BOT_HOOK) continue;
+        new plugin_id = record[HookPlugin]
+        new function = get_func_id(REGISTERHAM_CALLBACK, plugin_id)
+        if (function < 0) continue;
+        new result = callfunc_begin_i(function, plugin_id)
+        new bool:was_paused = result == -2
+        new filename[64]
+        if (was_paused)
+        {
+            get_plugin(plugin_id, filename, charsmax(filename))
+            // AMXX 1.9 pauses whole plugins; per-function pause is deprecated.
+            if (!unpause("ac", filename)) continue;
+            result = callfunc_begin_i(function, plugin_id)
+        }
+        if (result != 1)
+        {
+            if (was_paused) pause("ac", filename)
+            log_amx("[HAM] Unable to register bot callback in plugin %d (status %d).", plugin_id, result)
+            continue;
+        }
+        callfunc_push_int(_:record[HookFunction])
+        callfunc_push_int(id)
+        callfunc_push_str(record[HookCallback])
+        callfunc_push_int(_:record[HookPost])
+        record[HookHandle] = HamHook:callfunc_end()
+        if (was_paused) pause("ac", filename)
+        ArraySetArray(g_BotHooks, index, record)
+        if (!record[HookEnabled]) DisableHamForward(record[HookHandle])
+        else if (record[HookFunction] == Ham_Spawn && is_user_alive(id) && !was_paused)
+        {
+            function = get_func_id(record[HookCallback], plugin_id)
+            if (function >= 0 && callfunc_begin_i(function, plugin_id) == 1)
+            {
+                callfunc_push_int(id)
+                callfunc_end()
+            }
+        }
+    }
+}
