+
+// Fixed 1-7 weapon slots, 8 auto, 9 next/back, 0 exit. The menu resource
+// carries a bounded lifetime; MENU_TIMEOUT never becomes a weapon index.
+show_weapon_menu(id, Array:weapons, page_field, const title_key[], const handler[])
+{
+	new seconds = floatround(g_BuyTimeStart[id] + get_pcvar_float(cvar_buy_custom_time) - get_gametime())
+	if (seconds <= 0)
+	{
+		zp_colored_print(id, "%L", id, "BUY_MENU_TIME_EXPIRED")
+		return;
+	}
+	new count = ArraySize(weapons), first = g_MenuData[id][page_field]
+	if (first >= count) first = g_MenuData[id][page_field] = 0
+	new last = min(first + 7, count), title[128], label[128], weapon[32]
+	formatex(title, charsmax(title), "%L \r[%d-%d]", id, title_key, first + 1, last)
+	formatex(label, charsmax(label), "%L", id, "MENU_EXIT")
+	new menu = gc_menu_fixed(id, title, handler, label)
+	for (new index = first; index < last; index++)
+	{
+		ArrayGetString(weapons, index, weapon, charsmax(weapon))
+		localized_weapon_name(id, weapon, label, charsmax(label))
+		gc_menu_item(menu, label, index - first)
+	}
+	while (menu_items(menu) < 7) menu_addblank2(menu)
+	formatex(label, charsmax(label), "%L \y[%L]", id, "MENU_AUTOSELECT", id, WPN_AUTO_ON ? "MOTD_ENABLED" : "MOTD_DISABLED")
+	gc_menu_item(menu, label, MENU_KEY_AUTOSELECT)
+	if (count > 7)
+	{
+		formatex(label, charsmax(label), "%L/%L", id, "MENU_NEXT", id, "MENU_BACK")
+		gc_menu_item(menu, label, MENU_KEY_NEXT)
+	}
+	gc_menu_display_fixed(id, menu, seconds)
+}
+
+public client_disconnected(id)
+{
+	gc_menu_close(id)
+	remove_task(id)
+	arrayset(g_MenuData[id], 0, BuyMenuState)
+	flag_unset(g_CanBuyPrimary, id)
+	flag_unset(g_CanBuySecondary, id)
+	flag_unset(g_CanBuyGrenades, id)
+	g_BuyTimeStart[id] = 0.0
+}
