--- /dev/null
+++ b/include/zp50_reapi.inc
@@ -0,0 +1,17 @@
+// GoldCraft's ReAPI adaptation of ZP 5.0.8a. See ZP_ReadMe.txt for its GPL terms.
+#if defined _zp50_reapi_included
+	#endinput
+#endif
+#define _zp50_reapi_included
+
+#include <reapi>
+
+// Use only in a PRE RG_CBasePlayer_TakeDamage callback. Preserve later hook
+// notifications, but propagate zero damage so infection/reward handlers cannot
+// treat a cancelled hit as damage. ReAPI requires an explicit int return value.
+stock zp_reapi_block_damage()
+{
+	SetHookChainArg(4, ATYPE_FLOAT, 0.0)
+	SetHookChainReturn(ATYPE_INTEGER, 0)
+	return HC_SUPERCEDE;
+}
