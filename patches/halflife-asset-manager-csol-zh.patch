diff --git a/src/hlam/formats/csol/CSOLModelJSON.cpp b/src/hlam/formats/csol/CSOLModelJSON.cpp
new file mode 100644
index 0000000..001274c
--- /dev/null
+++ b/src/hlam/formats/csol/CSOLModelJSON.cpp
@@ -0,0 +1,128 @@
+#include "formats/csol/CSOLModelJSON.hpp"
+#include "formats/csol/CSOLFormats.hpp"
+#include <QDir>
+#include <QFileInfo>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <algorithm>
+#include <cmath>
+#include <stdexcept>
+
+namespace csol
+{
+namespace
+{
+double Number(const QJsonObject& object, const char* key, double fallback, double low, double high, bool integer = false)
+{
+	const auto value = object.value(key);
+	if (value.isUndefined()) return fallback;
+	const double n = value.toDouble();
+	if (!value.isDouble() || !std::isfinite(n) || n < low || n > high || (integer && std::floor(n) != n))
+		throw std::runtime_error(QString("模型 JSON 的 %1 数值无效").arg(key).toStdString());
+	return n;
+}
+bool Boolean(const QJsonObject& object, const char* key)
+{
+	const auto value = object.value(key);
+	if (!value.isUndefined() && !value.isBool()) throw std::runtime_error("模型 JSON 的布尔值无效");
+	return value.toBool(false);
+}
+}
+
+ModelJSON ParseModelJSON(const QByteArray& data, int textures, int sequences)
+{
+	if (textures < 0 || textures > 4096 || sequences < 0 || sequences > 4096) throw std::runtime_error("模型 JSON 索引表过大");
+	if (data.size() > 4 * 1024 * 1024) throw std::runtime_error("模型 JSON 超过 4 MiB");
+	QJsonParseError error;
+	const auto doc = QJsonDocument::fromJson(data, &error);
+	if (error.error != QJsonParseError::NoError || !doc.isObject())
+		throw std::runtime_error(("模型 JSON 解析失败：" + error.errorString()).toStdString());
+	ModelJSON result;
+	const auto object = doc.object();
+	for (const auto* key : {"fadeTex", "bindTex", "colorTex"})
+		if (object.contains(key)) result.Notices.append(QString("此模型还包含 %1；该通道尚未实现。").arg(key));
+	const auto value = object.value("bindSpr");
+	if (value.isUndefined()) return result;
+	if (!value.isArray() || value.toArray().size() > 256) throw std::runtime_error("bindSpr 必须是最多 256 项的数组");
+	for (const auto item : value.toArray())
+	{
+		if (!item.isObject()) throw std::runtime_error("bindSpr 项必须是对象");
+		const auto entry = item.toObject();
+		SpriteBinding binding;
+		binding.Texture = int(Number(entry, "texIndex", -1, -1, 1000000, true));
+		if (binding.Texture < 0 || binding.Texture >= textures)
+		{
+			result.Notices.append(QString("忽略不存在的贴图槽 %1。").arg(binding.Texture));
+			continue;
+		}
+		binding.Sprite = entry.value("sprName").toString().replace('\\', '/');
+		if (binding.Texture < 0 || binding.Sprite.isEmpty() || binding.Sprite.size() > 256
+			|| binding.Sprite.startsWith('/') || binding.Sprite.contains(':') || binding.Sprite.contains(QChar(0))
+			|| binding.Sprite.split('/').contains("..") || !binding.Sprite.endsWith(".spr", Qt::CaseInsensitive))
+			throw std::runtime_error("bindSpr 的贴图索引或 SPR 相对路径无效");
+		binding.FPS = Number(entry, "sprFPS", 30, 0, 1000);
+		const auto rules = entry.value("sequence");
+		if (!rules.isArray() || rules.toArray().size() > 4096) throw std::runtime_error("bindSpr 的 sequence 数组无效");
+		binding.Rules.resize(sequences);
+		for (const auto ruleValue : rules.toArray())
+		{
+			if (!ruleValue.isObject()) throw std::runtime_error("bindSpr 动作规则必须是对象");
+			const auto ruleObject = ruleValue.toObject();
+			SpriteRule rule;
+			rule.Sequence = int(Number(ruleObject, "index", -1, -1, 1000000, true));
+			if (rule.Sequence < 0 || rule.Sequence >= sequences)
+			{
+				result.Notices.append(QString("贴图槽 %1：忽略不存在的动作 %2。").arg(binding.Texture).arg(rule.Sequence));
+				continue;
+			}
+			rule.Loop = Boolean(ruleObject, "isLoop"); rule.Sync = Boolean(ruleObject, "isSyncFrame");
+			rule.Offset = int(Number(ruleObject, "offsetFrame", 0, -1000000, 1000000, true));
+			rule.Start = int(Number(ruleObject, "startFrame", 0, -1000000, 1000000, true));
+			rule.End = int(Number(ruleObject, "endFrame", 0, -1000000, 1000000, true));
+			rule.Rate = Number(ruleObject, "frameRate", 1, 0, 1000);
+			if (ruleObject.contains("isloop") || ruleObject.contains("offsetframe"))
+				result.Notices.append("JSON 中小写 isloop/offsetframe 按引擎行为忽略；字段区分大小写。");
+			// The engine inserts into a map: the first duplicate wins.
+			if (binding.Rules[rule.Sequence].Sequence < 0) binding.Rules[rule.Sequence] = rule;
+		}
+		if (std::none_of(result.Sprites.begin(), result.Sprites.end(), [&](const auto& b) { return b.Texture == binding.Texture; }))
+			result.Sprites.push_back(std::move(binding));
+	}
+	result.Notices.removeDuplicates();
+	return result;
+}
+
+QString LocateModelJSON(const QString& modelFile, const QString& root)
+{
+	const QFileInfo model(modelFile);
+	const auto name = model.completeBaseName() + ".json";
+	const auto adjacent = model.dir().filePath(name);
+	if (QFileInfo(adjacent).isFile()) return adjacent;
+	// Preserve nested models/player/... paths for archive fallback.
+	const auto normalized = QDir::fromNativeSeparators(model.absoluteFilePath());
+	const int pos = normalized.toLower().lastIndexOf("/models/");
+	const auto relative = pos >= 0 ? normalized.mid(pos + 1, normalized.size() - pos - 1 - model.fileName().size()) + name
+		: "models/" + name;
+	return LocateResource(root, relative);
+}
+
+double AdvanceSpriteFrame(const SpriteRule& rule, double fps, int frames,
+	double previous, double seconds, double modelFrame)
+{
+	if (frames <= 1 || !std::isfinite(previous) || !std::isfinite(seconds) || !std::isfinite(modelFrame)) return 0;
+	const double start = std::max(0, rule.Start);
+	const double end = rule.End > 0 ? rule.End : frames - 1;
+	double frame = rule.Sync ? start + std::max(0.0, modelFrame - rule.Offset)
+		: std::max(start, previous + std::max(0.0, seconds) * fps * rule.Rate);
+	if (frame >= end)
+		frame = rule.Sync && !rule.Loop ? end : std::fmod(std::trunc(frame), end) + start;
+	return frame;
+}
+
+int SpriteFrameIndex(double frame, int frames)
+{
+	// R_GetSpriteFrame falls back to frame zero for an out-of-range result.
+	return std::isfinite(frame) && frame >= 0 && frame < frames ? int(frame) : 0;
+}
+}
diff --git a/src/hlam/formats/csol/CSOLModelJSON.hpp b/src/hlam/formats/csol/CSOLModelJSON.hpp
new file mode 100644
index 0000000..e11e336
--- /dev/null
+++ b/src/hlam/formats/csol/CSOLModelJSON.hpp
@@ -0,0 +1,35 @@
+#pragma once
+#include <QByteArray>
+#include <QString>
+#include <QStringList>
+#include <vector>
+
+namespace csol
+{
+struct SpriteRule
+{
+	int Sequence = -1;
+	bool Loop = false, Sync = false;
+	int Offset = 0, Start = 0, End = 0;
+	double Rate = 1;
+};
+struct SpriteBinding
+{
+	int Texture = -1;
+	QString Sprite;
+	double FPS = 30;
+	std::vector<SpriteRule> Rules;
+};
+struct ModelJSON
+{
+	std::vector<SpriteBinding> Sprites;
+	QStringList Notices;
+};
+ModelJSON ParseModelJSON(const QByteArray& data, int textures, int sequences);
+QString LocateModelJSON(const QString& modelFile, const QString& root);
+// Engine semantics: non-sync always cycles; sync ignores sprFPS/frameRate.
+// End defaults to the last frame index, and wrapping uses int(frame) % end + start.
+double AdvanceSpriteFrame(const SpriteRule& rule, double fps, int frames,
+	double previous, double seconds, double modelFrame);
+int SpriteFrameIndex(double frame, int frames);
+}
diff --git a/src/hlam/formats/csol/CSOLParts.cpp b/src/hlam/formats/csol/CSOLParts.cpp
new file mode 100644
index 0000000..4d0edd4
--- /dev/null
+++ b/src/hlam/formats/csol/CSOLParts.cpp
@@ -0,0 +1,112 @@
+#include "formats/csol/CSOLParts.hpp"
+#include "formats/csol/CSOLPreview.hpp"
+#include "formats/studiomodel/StudioModelUtils.hpp"
+#include <QDir>
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <stdexcept>
+
+namespace csol
+{
+namespace
+{
+std::unique_ptr<studiomdl::EditableStudioModel> ReadParts(const QString& file)
+{
+	const auto bytes = ReadResource(file);
+	using namespace studiomdl;
+	if (bytes.size() < int(sizeof(studiohdr_t)) || bytes.size() > 32 * 1024 * 1024)
+		throw std::runtime_error("附属模型文件大小无效");
+	studiohdr_t h; std::memcpy(&h, bytes.constData(), sizeof(h));
+	if (std::memcmp(&h.id, "IDST", 4) || h.version != 10 || h.length != bytes.size()
+		|| h.numseqgroups != 1 || h.numtextures <= 0)
+		throw std::runtime_error("附属模型需要自包含的 GoldSrc v10 MDL");
+	auto table = [&](int count, int offset, std::size_t size, int limit)
+	{
+		if (count < 0 || count > limit || offset < 0 || std::size_t(offset) > std::size_t(bytes.size())
+			|| std::size_t(count) * size > std::size_t(bytes.size()) - offset)
+			throw std::runtime_error("附属模型索引表无效");
+	};
+	table(h.numbones, h.boneindex, sizeof(mstudiobone_t), MAXSTUDIOBONES);
+	table(h.numbonecontrollers, h.bonecontrollerindex, sizeof(mstudiobonecontroller_t), MAXSTUDIOCONTROLLERS);
+	table(h.numhitboxes, h.hitboxindex, sizeof(mstudiobbox_t), 1024);
+	table(h.numseq, h.seqindex, sizeof(mstudioseqdesc_t), 4096);
+	table(h.numseqgroups, h.seqgroupindex, sizeof(mstudioseqgroup_t), 1);
+	table(h.numtextures, h.textureindex, sizeof(mstudiotexture_t), 4096);
+	table(h.numbodyparts, h.bodypartindex, sizeof(mstudiobodyparts_t), 256);
+	table(h.numattachments, h.attachmentindex, sizeof(mstudioattachment_t), 1024);
+	if (h.numbones == 0 || h.numseq != 4) throw std::runtime_error("附属模型骨骼或动作与客户端定义不符");
+	for (int i = 0; i < h.numbones; ++i)
+	{
+		mstudiobone_t b; std::memcpy(&b, bytes.constData() + h.boneindex + i * sizeof(b), sizeof(b));
+		if (b.parent < -1 || b.parent >= i) throw std::runtime_error("附属模型骨骼层级无效");
+		for (const int c : b.bonecontroller)
+			if (c < -1 || c >= h.numbonecontrollers) throw std::runtime_error("附属模型骨骼控制器无效");
+	}
+	for (int i = 0; i < h.numseq; ++i)
+	{
+		mstudioseqdesc_t s; std::memcpy(&s, bytes.constData() + h.seqindex + i * sizeof(s), sizeof(s));
+		if (s.seqgroup != 0) throw std::runtime_error("附属模型包含外部序列组");
+	}
+	// Use the same converter as the primary model; no temp files or source writes.
+	auto memory = std::make_unique<std::byte[]>(bytes.size());
+	std::memcpy(memory.get(), bytes.constData(), bytes.size());
+	StudioPtr<studiohdr_t> header(reinterpret_cast<studiohdr_t*>(memory.release()), bytes.size());
+	StudioModel binary(std::move(header), {}, {}, false);
+	return std::make_unique<EditableStudioModel>(ConvertToEditable(binary));
+}
+}
+
+void Preview::LoadParts(const studiomdl::EditableStudioModel& model)
+{
+	Parts.reset(); PartsFile.clear(); PartsBoneMap.clear(); PartsTime = PartsFrame = 0;
+	const auto relative = CompanionModel(SourceFile);
+	if (relative.isEmpty()) return;
+	try
+	{
+		const char* mainActions[]{"idle", "shoot1", "shoot2", "draw", "reload"};
+		if (model.Sequences.size() != std::size(mainActions)) throw std::runtime_error("主体动作与客户端定义不符");
+		for (std::size_t i = 0; i < std::size(mainActions); ++i)
+			if (model.Sequences[i]->Label != mainActions[i]) throw std::runtime_error("主体动作与客户端定义不符");
+		const auto adjacent = QFileInfo(SourceFile).dir().filePath(QFileInfo(relative).fileName());
+		const auto file = QFileInfo(adjacent).isFile() ? adjacent : LocateResource(Root, relative);
+		if (file.isEmpty()) throw std::runtime_error(("缺少配套模型：" + relative).toStdString());
+		auto part = ReadParts(file);
+		const char* actions[]{"idle", "change_start", "change", "change_end"};
+		for (std::size_t i = 0; i < std::size(actions); ++i)
+			if (part->Sequences[i]->Label != actions[i]) throw std::runtime_error("附属件动作与客户端定义不符");
+		std::vector<int> map(part->Bones.size(), -1);
+		for (std::size_t i = 0; i < part->Bones.size(); ++i)
+			for (std::size_t j = 0; j < model.Bones.size(); ++j)
+				if (QString::fromStdString(part->Bones[i]->Name).compare(QString::fromStdString(model.Bones[j]->Name), Qt::CaseInsensitive) == 0)
+				{ map[i] = int(j); break; }
+		if (map[0] < 0 || part->Bones[0]->Parent || model.Bones[map[0]]->Parent)
+			throw std::runtime_error("缺少可合并的同名根骨骼");
+		part->CSOL.SourceFile = file; part->CSOL.Root = Root; part->CSOL.Enabled = true;
+		part->CSOL.Load(*part);
+		PartsFile = file; PartsBoneMap = std::move(map); Parts = std::move(part);
+		SetPartsSequence(PartsSequence);
+		Status += "\n\n已自动组合附属模型：" + PartsFile
+			+ "\n同名骨骼跟随主体，附属件动作独立播放；可在“组合模型”中预览展开、持续和收回。\n附属件资源：\n" + Parts->CSOL.Status;
+	}
+	catch (const std::exception& e) { Status += "\n组合模型未加载：" + QString::fromUtf8(e.what()); }
+}
+
+void Preview::SetPartsSequence(int sequence)
+{
+	PartsSequence = Parts ? std::clamp(sequence, 0, int(Parts->Sequences.size()) - 1) : 0;
+	UpdateParts(0, true);
+}
+
+void Preview::UpdateParts(double seconds, bool seek)
+{
+	if (!Parts || !std::isfinite(seconds) || seconds < 0) return;
+	const auto& sequence = *Parts->Sequences[PartsSequence];
+	PartsTime = seek ? seconds : PartsTime + seconds;
+	const double end = std::max(0, sequence.NumFrames - 1);
+	PartsFrame = PartsTime * sequence.FPS;
+	if ((sequence.Flags & STUDIO_LOOPING) && end > 0) PartsFrame = std::fmod(PartsFrame, end);
+	else PartsFrame = std::min(PartsFrame, end);
+	Parts->CSOL.UpdateBindings(PartsSequence, PartsFrame, seconds, seek);
+}
+}
