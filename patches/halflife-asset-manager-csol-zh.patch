+#include "formats/csol/CSOLPreview.hpp"
+#include "formats/studiomodel/EditableStudioModel.hpp"
+#include "graphics/TextureLoader.hpp"
+#include <cmath>
+#include <algorithm>
+#include <QOpenGLContext>
+#include <QOpenGLFunctions>
+#include <QRegularExpression>
+#include <QFileInfo>
+#include <QDir>
