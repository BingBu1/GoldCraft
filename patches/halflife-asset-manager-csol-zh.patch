index 0000000..d9b2536
--- /dev/null
+++ b/src/hlam/formats/csol/CSOLArchive.cpp
@@ -0,0 +1,204 @@
+#include "formats/csol/CSOLArchive.hpp"
+#include "formats/csol/CSOLFormats.hpp"
+#include <bzlib.h>
+#include <QCache>
+#include <QDateTime>
