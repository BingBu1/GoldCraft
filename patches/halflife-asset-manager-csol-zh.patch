diff --git a/src/hlam/formats/csol/CSOLFormats.cpp b/src/hlam/formats/csol/CSOLFormats.cpp
new file mode 100644
index 0000000..3307217
--- /dev/null
+++ b/src/hlam/formats/csol/CSOLFormats.cpp
@@ -0,0 +1,475 @@
+#include "formats/csol/CSOLFormats.hpp"
+#include "formats/csol/CSOLArchive.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <cmath>
+#include <stdexcept>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QRegularExpression>
+#include <QTextCodec>
+
+namespace csol
+{
+namespace
+{
+QString gameDirectory;
+[[noreturn]] void Invalid(const char* reason) { throw std::runtime_error(reason); }
+
+struct Reader
+{
+	const QByteArray& Data;
+	int Offset = 0;
+	const unsigned char* Take(int count)
+	{
+		if (count < 0 || count > Data.size() - Offset) Invalid("资源数据不完整");
+		const auto* p = reinterpret_cast<const unsigned char*>(Data.constData() + Offset);
+		Offset += count;
+		return p;
+	}
+};
+unsigned U16(const unsigned char* p) { return p[0] | (unsigned(p[1]) << 8); }
+unsigned U32(const unsigned char* p) { return U16(p) | (U16(p + 2) << 16); }
+void Dimensions(unsigned w, unsigned h)
+{
+	if (!w || !h || w > 4096 || h > 4096) Invalid("贴图尺寸超出范围（1–4096）");
+}
+using Color = std::array<unsigned char, 4>;
+Color RGB565(unsigned v)
+{
+	const unsigned r = v >> 11, g = (v >> 5) & 63, b = v & 31;
+	return {static_cast<unsigned char>((r << 3) | (r >> 2)),
+		static_cast<unsigned char>((g << 2) | (g >> 4)),
+		static_cast<unsigned char>((b << 3) | (b >> 2)), 255};
+}
+
+QImage DDS(Reader& reader, unsigned expectedW, unsigned expectedH)
+{
+	const auto* h = reader.Take(128);
+	if (std::memcmp(h, "DDS ", 4) || U32(h + 4) != 124 || U32(h + 76) != 32)
+		Invalid("SPR v3 帧缺少有效的 DDS 头");
+	const unsigned w = U32(h + 16), height = U32(h + 12);
+	Dimensions(w, height);
+	if (w != expectedW || height != expectedH) Invalid("SPR 与 DDS 帧尺寸不一致");
+	if ((U32(h + 80) & 4) == 0 || U32(h + 112) != 0 || U32(h + 24) > 1)
+		Invalid("暂不支持此 DDS 像素格式、立方体或体积贴图");
+	const bool dxt1 = std::memcmp(h + 84, "DXT1", 4) == 0;
+	const bool dxt3 = std::memcmp(h + 84, "DXT3", 4) == 0;
+	const bool dxt5 = std::memcmp(h + 84, "DXT5", 4) == 0;
+	if (!dxt1 && !dxt3 && !dxt5) Invalid("SPR v3 目前支持 DXT1、DXT3、DXT5");
+	const unsigned blockSize = dxt1 ? 8 : 16;
+	const auto* blocks = reader.Take(((w + 3) / 4) * ((height + 3) / 4) * blockSize);
+	QImage image(w, height, QImage::Format_RGBA8888);
+	if (image.isNull()) Invalid("无法分配贴图内存");
+	for (unsigned by = 0; by < height; by += 4)
+		for (unsigned bx = 0; bx < w; bx += 4, blocks += blockSize)
+		{
+			const auto* color = blocks + (dxt1 ? 0 : 8);
+			const unsigned c0 = U16(color), c1 = U16(color + 2);
+			Color colors[4]{RGB565(c0), RGB565(c1), {}, {}};
+			for (int c = 0; c < 3; ++c)
+			{
+				colors[2][c] = dxt1 && c0 <= c1 ? (colors[0][c] + colors[1][c]) / 2 : (2 * colors[0][c] + colors[1][c]) / 3;
+				colors[3][c] = (colors[0][c] + 2 * colors[1][c]) / 3;
+			}
+			colors[2][3] = 255;
+			colors[3][3] = 255;
+			if (dxt1 && c0 <= c1) colors[3] = {0, 0, 0, 0};
+			unsigned char alpha[8]{blocks[0], blocks[1]};
+			std::uint64_t indices = 0;
+			if (dxt5)
+			{
+				const int end = alpha[0] > alpha[1] ? 8 : 6;
+				for (int i = 2; i < end; ++i) alpha[i] = ((end - i) * alpha[0] + (i - 1) * alpha[1]) / (end - 1);
+				if (end == 6) { alpha[6] = 0; alpha[7] = 255; }
+				for (int i = 0; i < 6; ++i) indices |= std::uint64_t(blocks[i + 2]) << (8 * i);
+			}
+			const unsigned ci = U32(color + 4);
+			for (unsigned p = 0; p < 16; ++p)
+			{
+				if (bx + p % 4 >= w || by + p / 4 >= height) continue;
+				auto pixel = colors[(ci >> (p * 2)) & 3];
+				if (dxt3) pixel[3] = ((blocks[p / 2] >> ((p % 2) * 4)) & 15) * 17;
+				if (dxt5) pixel[3] = alpha[(indices >> (p * 3)) & 7];
+				std::memcpy(image.scanLine(by + p / 4) + (bx + p % 4) * 4, pixel.data(), 4);
+			}
+		}
+	// Complete DDS images include their lower mip levels. They are skipped, not mistaken for the next frame.
+	unsigned mw = w, mh = height;
+	const unsigned mips = std::max(1u, U32(h + 28));
+	if (mips > 13) Invalid("DDS mip 层数超出范围");
+	for (unsigned level = 1; level < mips; ++level)
+	{
+		if (mw == 1 && mh == 1) Invalid("DDS mip 层数与尺寸不符");
+		mw = std::max(1u, mw / 2); mh = std::max(1u, mh / 2);
+		reader.Take(((mw + 3) / 4) * ((mh + 3) / 4) * blockSize);
+	}
+	return image;
+}
+}
+
+Material ParseMaterial(const QString& name)
+{
+	Material result;
+	result.Name = name;
+	static const QRegularExpression dimensions("^#([0-9]{3})([0-9]{3})(.+)$");
+	const auto match = dimensions.match(name);
+	if (match.hasMatch() && match.captured(1).toInt() && match.captured(2).toInt())
+	{
+		result.Width = match.captured(1).toInt();
+		result.Height = match.captured(2).toInt();
+		result.Name = match.captured(3);
+	}
+	// Two independent characters, NOT a hexadecimal bit field.
+	if (name.size() >= 3 && name[0] == '$' && name[1] >= '0' && name[1] <= '3'
+		&& (name[2] == '0' || name[2] == 'a' || name[2] == 'b'))
+	{
+		result.Special = true;
+		const int state = name[1].unicode() - '0';
+		result.Cull = (state & 1) != 0;
+		result.DepthWrite = (state & 2) != 0;
+		result.Blending = name[2] == 'a' ? Blend::Alpha : name[2] == '0' ? Blend::Opaque
+			: name.size() > 3 && name[3] == 'a' ? Blend::AddAlpha : Blend::Add;
+	}
+	const int at = name.startsWith('@') ? 0 : name.size() >= 7 && name[3] == '@' ? 3 : -1;
+	if (at >= 0 && name.size() >= at + 4)
+	{
+		result.Descriptor = name.mid(at, 4);
+		if (result.Descriptor == "@00a") result.Descriptor = "@000";
+	}
+	const auto lower = result.Name.toLower();
+	if (lower == "cso_highq_hand__long_512.bmp") result.HandSuffix = "MaleLong.tga";
+	else if (lower == "cso_highq_hand_512.bmp") result.HandSuffix = "MaleShort.tga";
+	else if (lower == "cso_girl_hand_long.bmp") result.HandSuffix = "FemaleLong.tga";
+	else if (lower == "cso_girl_hand.bmp") result.HandSuffix = "FemaleShort.tga";
+	else if (lower == "hand.bmp") result.HandSuffix = "MaleOrg.tga";
+	return result;
+}
+
+QByteArray ReadResource(const QString& path)
+{
+	if (path.startsWith("csol-nar:")) return ReadArchiveResource(path);
+	QFile file(path);
+	if (!file.open(QIODevice::ReadOnly)) throw std::runtime_error(QString("无法读取资源：%1").arg(path).toStdString());
+	if (file.size() > 128 * 1024 * 1024) Invalid("单个资源超过 128 MiB 限制");
+	auto bytes = file.readAll();
+	if (bytes.size() != file.size()) Invalid("资源读取不完整");
+	return bytes;
+}
+
+std::vector<QImage> DecodeSpriteV3(const QByteArray& bytes)
+{
+	Reader reader{bytes};
+	const auto* h = reader.Take(40);
+	if (std::memcmp(h, "IDSP", 4) || U32(h + 4) != 3) Invalid("请选择 CSOL SPR v3 动画");
+	const unsigned w = U32(h + 20), height = U32(h + 24), count = U32(h + 28);
+	Dimensions(w, height);
+	if (!count || count > 2048 || std::uint64_t(w) * height * count * 4 > 256 * 1024 * 1024)
+		Invalid("动画帧数或解码内存超出限制（256 MiB）");
+	std::vector<QImage> frames;
+	frames.reserve(count);
+	for (unsigned i = 0; i < count; ++i) frames.push_back(DDS(reader, w, height));
+	if (reader.Offset != bytes.size()) Invalid("SPR 帧末尾有未识别的数据");
+	return frames;
+}
+
+std::vector<QImage> DecodeSprite(const QByteArray& bytes)
+{
+	Reader reader{bytes};
+	const auto* h = reader.Take(40);
+	if (std::memcmp(h, "IDSP", 4)) Invalid("无效 SPR 标识");
+	if (U32(h + 4) == 3) return DecodeSpriteV3(bytes);
+	if (U32(h + 4) != 2) Invalid("仅支持 SPR v2/v3");
+	const auto count = U32(h + 28), format = U32(h + 12);
+	Dimensions(U32(h + 20), U32(h + 24));
+	if (!count || count > 2048 || format > 3) Invalid("SPR v2 帧数或颜色格式无效");
+	const auto colors = U16(reader.Take(2));
+	if (!colors || colors > 256 || (format >= 2 && colors != 256)) Invalid("SPR v2 调色板无效");
+	const auto* palette = reader.Take(colors * 3);
+	std::vector<QImage> frames;
+	std::uint64_t totalBytes = 0;
+	for (unsigned i = 0; i < count; ++i)
+	{
+		if (U32(reader.Take(4)) != 0) Invalid("暂不支持 SPR v2 分组帧");
+		const auto* frame = reader.Take(16);
+		const auto w = U32(frame + 8), height = U32(frame + 12);
+		Dimensions(w, height);
+		totalBytes += std::uint64_t(w) * height * 4;
+		if (totalBytes > 256 * 1024 * 1024) Invalid("动画解码内存超过 256 MiB");
+		const auto* indices = reader.Take(w * height);
+		QImage image(w, height, QImage::Format_RGBA8888);
+		for (unsigned pixel = 0; pixel < w * height; ++pixel)
+		{
+			const auto index = indices[pixel];
+			if (index >= colors) Invalid("SPR v2 颜色索引越界");
+			const auto* rgb = palette + (format == 2 ? 255 : index) * 3;
+			auto* out = image.bits() + pixel * 4;
+			std::copy_n(rgb, 3, out);
+			out[3] = format == 2 ? index : format == 3 && index == 255 ? 0 : 255;
+		}
+		frames.push_back(std::move(image));
+	}
+	if (reader.Offset != bytes.size()) Invalid("SPR v2 帧末尾有未识别的数据");
+	return frames;
+}
+
+QImage DecodeTGA(const QByteArray& bytes)
+{
+	Reader reader{bytes};
+	const auto* h = reader.Take(18);
+	const unsigned w = U16(h + 12), height = U16(h + 14);
+	Dimensions(w, height);
+	const int type = h[2] & 7;
+	const bool rle = (h[2] & 8) != 0;
+	if ((h[2] != 1 && h[2] != 2 && h[2] != 3 && h[2] != 9 && h[2] != 10 && h[2] != 11)
+		|| (h[17] & 0xC0) || (type == 1 && (h[1] != 1 || h[16] != 8))
+		|| (type == 2 && h[16] != 24 && h[16] != 32) || (type == 3 && h[16] != 8))
+		Invalid("不支持此 TGA 编码");
+	reader.Take(h[0]);
+	std::vector<Color> palette(256, {0, 0, 0, 255});
+	const unsigned first = U16(h + 3), length = U16(h + 5);
+	if (h[1])
+	{
+		if (first > 255 || length > 256 - first || (h[7] != 24 && h[7] != 32)) Invalid("无效 TGA 调色板");
+		for (unsigned i = first; i < first + length; ++i)
+		{
+			const auto* p = reader.Take(h[7] / 8);
+			palette[i] = {p[2], p[1], p[0], static_cast<unsigned char>(h[7] == 32 ? p[3] : 255)};
+		}
+	}
+	auto pixel = [&]() -> Color
+	{
+		const auto* p = reader.Take(h[16] / 8);
+		if (type == 1)
+		{
+			if (p[0] < first || p[0] >= first + length) Invalid("TGA 调色板索引越界");
+			return palette[p[0]];
+		}
+		if (type == 3) return {p[0], p[0], p[0], 255};
+		return {p[2], p[1], p[0], static_cast<unsigned char>(h[16] == 32 && (h[17] & 15) ? p[3] : 255)};
+	};
+	QImage image(w, height, QImage::Format_RGBA8888);
+	if (image.isNull()) Invalid("无法分配贴图内存");
+	unsigned index = 0;
+	while (index < w * height)
+	{
+		const unsigned packet = rle ? *reader.Take(1) : 0;
+		const unsigned run = rle ? (packet & 127) + 1 : 1;
+		if (run > w * height - index) Invalid("TGA RLE 数据越界");
+		Color repeated{};
+		if (packet & 128) repeated = pixel();
+		for (unsigned i = 0; i < run; ++i, ++index)
+		{
+			const auto p = (packet & 128) ? repeated : pixel();
+			const auto x = h[17] & 16 ? w - 1 - index % w : index % w;
+			const auto y = h[17] & 32 ? index / w : height - 1 - index / w;
+			std::memcpy(image.scanLine(y) + x * 4, p.data(), 4);
+		}
+	}
+	return image;
+}
+
+void SetGameDirectory(const QString& root) { gameDirectory = root; ClearArchiveCache(); }
+QString GameDirectory() { return gameDirectory; }
+
+QStringList ResourceDirectories(const QString& root)
+{
+	if (root.isEmpty()) return {};
+	QStringList result;
+	auto add = [&](const QString& path)
+	{
+		const QFileInfo info(path);
+		if (info.isDir() && !result.contains(info.absoluteFilePath(), Qt::CaseInsensitive))
+			result.append(info.absoluteFilePath());
+	};
+	QDir base(root);
+	add(base.path());
+	// Preserve the loaded model's resource tree first, then search sibling packs.
+	if (base.dirName().compare("common", Qt::CaseInsensitive) == 0
+		|| base.dirName().startsWith("locale_", Qt::CaseInsensitive)) base.cdUp();
+	add(base.filePath("common"));
+	for (const auto& name : base.entryList({"locale_*"}, QDir::Dirs | QDir::NoDotAndDotDot, QDir::Name))
+		add(base.filePath(name));
+	QDir parent(base); parent.cdUp();
+	for (const auto& mount : {"fstrike", "estrike", "dstrike", "cstrike", "valve"})
+	{
+		add(base.filePath(mount)); add(parent.filePath(mount));
+	}
+	for (int i = 0; i < 8; ++i)
+	{
+		add(base.filePath("Data"));
+		if (!base.cdUp()) break;
+	}
+	if (!gameDirectory.isEmpty())
+	{
+		const QDir game(gameDirectory);
+		add(game.path());
+		add(game.filePath("Data"));
+		// CSO commonly keeps Bin beside Data. The selected game path may be Bin,
+		// while the NAR archives live one directory above it.
+		QDir install(game);
+		if (game.dirName().compare("bin", Qt::CaseInsensitive) == 0
+			|| game.dirName().compare("hl", Qt::CaseInsensitive) == 0)
+			install.cdUp();
+		if (install.absolutePath() != game.absolutePath())
+		{
+			add(install.path());
+			add(install.filePath("Data"));
+		}
+		for (const auto& mount : {"lstrike/common", "fstrike", "estrike", "dstrike", "cstrike", "valve"})
+		{
+			add(game.filePath(mount));
+			if (install.absolutePath() != game.absolutePath()) add(install.filePath(mount));
+		}
+	}
+	return result;
+}
+
+QString DiscoverResourceRoot(const QString& modelFile)
+{
+	if (modelFile.isEmpty()) return {};
+	QDir dir(QFileInfo(modelFile).absolutePath());
+	// Only inspect ancestors, never recursively scan drives or unrelated games.
+	for (int level = 0; level < 16; ++level)
+	{
+		if (dir.dirName().compare("models", Qt::CaseInsensitive) == 0)
+		{
+			dir.cdUp(); return dir.absolutePath();
+		}
+		if (QFileInfo(dir.filePath("sprites")).isDir() || QFileInfo(dir.filePath("gfx/tattoo")).isDir()
+			|| QFileInfo(dir.filePath("common/models")).isDir()) return dir.absolutePath();
+		if (!dir.cdUp()) break;
+	}
+	return {};
+}
+
+QStringList ResourceNameVariants(const QString& name)
+{
+	QStringList result{name};
+	// Old MDL names are byte strings, represented as Latin-1 in the model editor.
+	// NAR contains Korean CP949 names; extraction tools may instead expose Unicode.
+	auto* codec = QTextCodec::codecForName("CP949");
+	if (!codec) codec = QTextCodec::codecForName("EUC-KR");
+	if (!codec) return result;
+	const auto bytes = name.toLatin1();
+	if (QString::fromLatin1(bytes) == name)
+	{
+		QTextCodec::ConverterState state;
+		const auto decoded = codec->toUnicode(bytes.constData(), bytes.size(), &state);
+		if (!state.invalidChars && codec->fromUnicode(decoded) == bytes && decoded != name)
+			result.append(decoded);
+	}
+	QTextCodec::ConverterState state;
+	const auto encoded = codec->fromUnicode(name.constData(), name.size(), &state);
+	const auto raw = QString::fromLatin1(encoded);
+	if (!state.invalidChars && codec->toUnicode(encoded) == name && !result.contains(raw))
+		result.append(raw);
+	return result;
+}
+
+QString LocateResource(const QString& root, const QString& relative)
+{
+	if (root.isEmpty() || QDir::isAbsolutePath(relative)) return {};
+	const auto clean = QDir::cleanPath(QString(relative).replace('\\', '/'));
+	if (clean == ".." || clean.startsWith("../")) return {};
+	const auto variants = ResourceNameVariants(clean);
+	for (const auto& directory : ResourceDirectories(root))
+	for (const auto& name : variants)
+	{
+		const auto exact = QDir(directory).filePath(name);
+		if (QFileInfo(exact).isFile()) return exact;
+		QDir dir(directory);
+		QString found;
+		for (const auto& part : name.split('/'))
+		{
+			found.clear();
+			for (const auto& name : dir.entryList(QDir::AllEntries | QDir::NoDotAndDotDot))
+				if (name.compare(part, Qt::CaseInsensitive) == 0) { found = dir.filePath(name); break; }
+			if (found.isEmpty()) break;
+			dir.setPath(found);
+		}
+		if (!found.isEmpty() && QFileInfo(found).isFile()) return found;
+	}
+	return FindArchiveResource(ResourceDirectories(root), clean);
+}
+
+QStringList FindAppearances(const QString& root)
+{
+	QStringList result{QString()};
+	static const QRegularExpression suffix("_(male|female)(long|short|org)\\.tga$", QRegularExpression::CaseInsensitiveOption);
+	for (const auto& directory : ResourceDirectories(root))
+	{
+		const QDir dir(QDir(directory).filePath("gfx/tattoo"));
+		for (const auto& name : dir.entryList(QDir::Files))
+		{
+			const auto match = suffix.match(name);
+			if (match.hasMatch()) result.append(name.left(match.capturedStart()));
+		}
+	}
+	result.append(ArchiveAppearances(ResourceDirectories(root)));
+	result.removeDuplicates();
+	result.sort(Qt::CaseInsensitive);
+	return result;
+}
+
+QString ResolveHand(const QString& root, const QString& appearance, const QString& suffix)
+{
+	if (suffix.isEmpty() || appearance.contains('/') || appearance.contains('\\') || appearance.contains("..")) return {};
+	if (!appearance.isEmpty())
+	{
+		const auto exact = LocateResource(root, "gfx/tattoo/" + appearance + "_" + suffix);
+		if (!exact.isEmpty()) return exact;
+	}
+	return LocateResource(root, "gfx/tattoo/" + suffix);
+}
+
+Environment ParseEnvironment(const QByteArray& bytes)
+{
+	if (bytes.size() > 65536) Invalid("材质描述文件过大");
+	const auto lines = QString::fromUtf8(bytes).split(QRegularExpression("[\\r\\n]+"), Qt::SkipEmptyParts);
+	if (lines.isEmpty()) Invalid("空材质描述文件");
+	const auto header = lines[0].simplified().split(' ');
+	bool ok = false;
+	if (header.size() != 2 || header[0] != "type" || header[1].toFloat(&ok) != 0 || !ok)
+		Invalid("目前只支持 type 0 环境反射材质");
+	Environment env;
+	for (int i = 1; i < lines.size(); ++i)
+	{
+		if (lines[i].trimmed().isEmpty()) continue;
+		const auto parts = lines[i].simplified().split(' ');
+		if (parts.size() != 3) Invalid("材质描述行格式错误");
+		const int index = parts[0].toInt(&ok);
+		if (!ok || index < 0 || index > 2) Invalid("未知的环境材质参数");
+		const float value = parts[2].toFloat(&ok);
+		if (!ok || !std::isfinite(value) || std::abs(value) > 1024) Invalid("无效的环境材质参数");
+		if (index == 0) { if (value < 0 || value != std::floor(value)) Invalid("无效环境贴图编号"); env.Index = int(value); }
+		if (index == 1) env.Multiply = value;
+		if (index == 2) env.Add = value;
+	}
+	return env;
+}
+
+QImage OrientCubeFace(const QImage& image, int face)
+{
+	// hw.dll cubemap uploader: rt, bk, lf, ft, up, dn; nearest samples at 128x128.
+	if (image.width() != image.height() || image.width() < 128 || image.width() % 128 || face < 0 || face > 5)
+		Invalid("环境贴图必须是边长为 128 倍数的正方形");
+	QImage out(128, 128, QImage::Format_RGBA8888);
+	const auto src = image.convertToFormat(QImage::Format_RGBA8888);
+	const int step = image.width() / 128;
+	for (int y = 0; y < 128; ++y)
+		for (int x = 0; x < 128; ++x)
+		{
+			int dx = y, dy = x;
+			if (face == 1) { dx = x; dy = 127 - y; }
+			if (face == 2) { dx = 127 - y; dy = 127 - x; }
+			if (face == 3) { dx = 127 - x; dy = y; }
+			std::memcpy(out.scanLine(dy) + dx * 4, src.constScanLine(y * step) + x * step * 4, 4);
+		}
+	return out;
+}
+}
