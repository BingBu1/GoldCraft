+void StudioModelRenderer::DrawCSOLEffect()
+{
+	const auto& preview = _studioModel->CSOL;
+	if (!preview.Enabled) return;
+	auto draw = [&](const csol::EffectView& effect, int attachmentIndex, glm::vec3 offset,
+		bool billboard, bool depth, csol::Blend blend, float brightness, float angle, bool flip,
+		const csol::EventSprite* fixed)
+	{
+		if (!effect.Handle) return;
+		glm::vec3 center = offset;
+		glm::vec3 right{1, 0, 0}, up{0, 0, 1};
+		if (attachmentIndex >= 0 && attachmentIndex < _studioModel->Attachments.size())
+		{
+			const auto& attachment = *_studioModel->Attachments[attachmentIndex];
+			const auto& bone = _bonetransform[attachment.Bone->ArrayIndex];
+			center = bone * glm::vec4(attachment.Origin + offset, 1);
+			right = glm::normalize(glm::vec3(bone * glm::vec4(right, 0)));
+			up = glm::normalize(glm::vec3(bone * glm::vec4(up, 0)));
+		}
+		if (fixed)
+		{
+			if (!fixed->Positioned) { fixed->Position = center; fixed->Positioned = true; }
+			center = fixed->Position;
+		}
+		if (billboard)
+		{
+			glm::mat4 rotation(1);
+			rotation = glm::rotate(rotation, glm::radians(_renderInfo->Angles.y), glm::vec3(0, 0, 1));
+			rotation = glm::rotate(rotation, glm::radians(_renderInfo->Angles.x), glm::vec3(0, 1, 0));
+			rotation = glm::rotate(rotation, glm::radians(_renderInfo->Angles.z), glm::vec3(1, 0, 0));
+			const auto inverse = glm::transpose(glm::mat3(rotation));
+			// Camera's stored Y axis is left of lookAt's +X view direction.
+			right = inverse * -_viewerRight;
+			// SPR_VP_PARALLEL uses the camera basis, not a per-sprite look-at.
+			up = inverse * _viewerUp;
+		}
+		if (angle != 0)
+		{
+			const float c = std::cos(glm::radians(angle)), s = std::sin(glm::radians(angle));
+			const auto rotated = c * right + s * up; up = c * up - s * right; right = rotated;
+		}
+		right *= effect.Width * 0.5f;
+		up *= effect.Height * 0.5f;
+		const glm::vec3 vertices[]{center - right + up, center + right + up, center + right - up, center - right - up};
+		const float u0 = flip ? 1.f : 0.f, u1 = 1.f - u0;
+		const float uv[4][2]{{u0, 0}, {u1, 0}, {u1, 1}, {u0, 1}};
+		_openglFunctions->glPushAttrib(GL_ENABLE_BIT | GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT | GL_CURRENT_BIT | GL_TEXTURE_BIT);
+		_openglFunctions->glEnable(GL_TEXTURE_2D);
+		if (depth) _openglFunctions->glEnable(GL_DEPTH_TEST);
+		else _openglFunctions->glDisable(GL_DEPTH_TEST);
+		_openglFunctions->glDisable(GL_ALPHA_TEST);
+		_openglFunctions->glDisable(GL_CULL_FACE);
+		_openglFunctions->glDisable(GL_LIGHTING);
+		_openglFunctions->glEnable(GL_BLEND);
+		_openglFunctions->glDepthMask(GL_FALSE);
+		_openglFunctions->glBlendFunc(blend == csol::Blend::Add ? GL_ONE : GL_SRC_ALPHA,
+			blend == csol::Blend::Alpha ? GL_ONE_MINUS_SRC_ALPHA : GL_ONE);
+		_openglFunctions->glColor4f(brightness, brightness, brightness, _renderInfo->Transparency);
+		_openglFunctions->glBindTexture(GL_TEXTURE_2D, effect.Handle);
+		_openglFunctions->glBegin(GL_QUADS);
+		for (int i = 0; i < 4; ++i)
+		{
+			_openglFunctions->glTexCoord2fv(uv[i]);
+			_openglFunctions->glVertex3fv(glm::value_ptr(vertices[i]));
+		}
+		_openglFunctions->glEnd();
+		_openglFunctions->glPopAttrib();
+	};
+	draw(preview.CurrentEffect(*_studioModel, _renderInfo->Sequence), preview.Attachment, preview.Offset,
+		preview.Billboard, preview.DepthTest, preview.SpriteBlend, preview.Brightness, 0, false, nullptr);
+	// Match the normal queue before the first-person overlay queue.
+	for (bool overlay : {false, true})
+		for (const auto& sprite : preview.EventSprites)
+		{
+			const auto& e = preview.EventDefinitions[sprite.Definition].Parameters;
+			if (e.Overlay != overlay) continue;
+			draw(preview.EventEffect(sprite), e.Follow >= 0 ? e.Follow : e.Attachment, glm::vec3(0),
+				true, !e.Overlay, e.Alpha ? csol::Blend::Alpha : csol::Blend::Add, 1, sprite.Angle,
+				e.HandFlip && !preview.RightHand, e.Follow < 0 ? &sprite : nullptr);
+		}
+}
