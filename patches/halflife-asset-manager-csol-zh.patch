+			const auto& data = binary.GetStudioHeaderPtr();
+			return QCryptographicHash::hash(QByteArray(reinterpret_cast<const char*>(data.get()), data.SizeInBytes), QCryptographicHash::Sha256);
+		};
+		const auto baseline = serialized(); const int undo = asset->GetUndoStack()->index();
+		auto* clock = application.GetWorldTime();
