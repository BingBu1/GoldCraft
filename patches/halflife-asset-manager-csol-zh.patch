+
+void CSOLPanel::SetAsset(StudioModelAsset* asset)
+{
+	_loading = true; _asset = asset;
+	auto model = asset->GetEditableStudioModel();
+	auto& p = model->CSOL;
+	_showParts->setChecked(p.ShowParts); _showParts->setEnabled(bool(p.Parts));
+	_partsSequence->setEnabled(bool(p.Parts)); _partsSequence->setCurrentIndex(p.PartsSequence);
+	_partsFrame->setEnabled(bool(p.Parts)); _partsFrame->setRange(0, p.Parts ? p.Parts->Sequences[p.PartsSequence]->NumFrames - 1 : 0);
+	_partsFrame->setValue(int(p.PartsFrame));
+	_partsFile->setText(p.Parts ? "已组合：" + p.PartsFile : "此模型没有已核实的自动组合规则，或缺少配套文件；详见资源状态。");
+	const auto primary = csol::PrimaryModel(asset->GetFileName());
+	auto primaryFile = primary.isEmpty() ? QString() : QFileInfo(asset->GetFileName()).dir().filePath(QFileInfo(primary).fileName());
+	if (!primary.isEmpty() && !QFileInfo(primaryFile).isFile()) primaryFile = csol::LocateResource(p.Root, primary);
+	_openComplete->setVisible(!primary.isEmpty()); _openComplete->setEnabled(QFileInfo(primaryFile).isFile());
+	_openComplete->setProperty("modelFile", primaryFile);
+	if (!primary.isEmpty()) _partsFile->setText("当前是独立附属件。预览完整武器请打开 " + QFileInfo(primary).fileName() + "。");
+	setEnabled(!model->Textures.empty());
+	_root->setText(p.Root); ScanHands();
+	_appearance->setCurrentIndex(0);
+	if (!p.Appearance.isEmpty()) _appearance->setCurrentText(p.Appearance);
+	_sprite->setText(p.SpriteFile);
+	_enabled->setChecked(p.Enabled); _play->setChecked(p.Playing); _billboard->setChecked(p.Billboard); _loop->setChecked(p.Loop);
+	_automatic->setChecked(p.FollowWeapon); _automatic->setEnabled(p.RecognizedWeapon);
+	_rightHand->setChecked(p.RightHand); _rightHand->setEnabled(p.Parts || (p.RecognizedWeapon && p.FollowWeapon) || !p.EventDefinitions.empty());
+	for (QWidget* control : std::initializer_list<QWidget*>{_sprite, _preset, _attachment, _width, _height, _fps,
+		_brightness, _blend, _billboard, _depth, _loop, _frame, _offset[0], _offset[1], _offset[2]})
+		control->setEnabled(!p.FollowWeapon);
+	_summary->setText(p.Status.isEmpty() ? "普通模型预览" : p.Status.section('\n', 0, 0)
+		+ (p.Status.contains("缺少") || p.Root.isEmpty() ? "\n部分资源缺失，详见“资源状态”。" : ""));
+	_preset->setChecked(p.WeaponPreset); _depth->setChecked(p.DepthTest); _brightness->setValue(p.Brightness);
+	_attachment->clear(); _attachment->addItem("模型原点");
+	for (int i = 0; i < model->Attachments.size(); ++i)
+	{
+		const auto& attachment = *model->Attachments[i];
+		const auto name = attachment.Name.empty() && attachment.Bone ? attachment.Bone->Name : attachment.Name;
+		_attachment->addItem(QString("%1：%2").arg(i).arg(QString::fromStdString(name)));
+	}
+	_attachment->setCurrentIndex(p.Attachment + 1);
+	_hands->setCurrentIndex(p.Hands);
+	_fps->setValue(p.FPS); _width->setValue(p.Width); _height->setValue(p.Height);
+	_blend->setCurrentIndex(p.SpriteBlend == csol::Blend::Alpha ? 0 : p.SpriteBlend == csol::Blend::Add ? 1 : 2);
+	for (int i = 0; i < 3; ++i) _offset[i]->setValue(p.Offset[i]);
+	_frame->setRange(0, std::max(0, int(p.Frames.size()) - 1)); _frame->setValue(int(p.FrameIndex()));
+	_status->setPlainText(p.Status.isEmpty() ? "未识别到 CSOL 扩展。普通模型保持标准预览。" : p.Status);
+	_loading = false;
+}
+
+void CSOLPanel::ScanHands()
+{
+	const auto previous = _appearance->currentText();
+	_appearance->clear(); _appearance->addItem("默认手部", QString());
+	try
+	{
+		for (const auto& name : csol::FindAppearances(_root->text())) if (!name.isEmpty()) _appearance->addItem(name, name);
+	}
+	catch (const std::exception& e) { _summary->setText(QString::fromUtf8(e.what())); }
+	const auto index = _appearance->findText(previous);
+	_appearance->setCurrentIndex(index < 0 ? 0 : index);
+}
+
+bool CSOLPanel::Apply()
+{
+	if (!_asset) return false;
+	try
+	{
+		auto model = _asset->GetEditableStudioModel();
+		// Decode before releasing the previous resources, so invalid files keep the existing preview intact.
+		csol::Preview next;
+		if (_game->text() != csol::GameDirectory())
+		{
+			csol::SetGameDirectory(_game->text());
+			_asset->GetEntity()->GetContext()->AppSettings->GetSettings()->setValue("CSOL/GameDirectory", _game->text());
+		}
+		ReadParameters(next); next.Enabled = true;
+		next.PartsSequence = _partsSequence->currentIndex();
+		next.SourceFile = _asset->GetFileName();
+		next.Root = _root->text(); next.SpriteFile = _sprite->text();
+		next.Appearance = _appearance->currentText() == "默认手部" ? QString() : _appearance->currentText();
+		next.Load(*model);
+		next.SetAction(_asset->GetEntity()->GetSequence());
+		const int sequence = _asset->GetEntity()->GetSequence();
+		const double frame = _asset->GetEntity()->GetFrame();
+		const double fps = sequence >= 0 && sequence < int(model->Sequences.size()) ? model->Sequences[sequence]->FPS : 0;
+		next.UpdateBindings(sequence, frame, fps > 0 ? frame / fps : 0, true);
+		next.SeekEvents(sequence, frame, fps);
+		auto context = _asset->GetGraphicsContext(); context->Begin();
+		try { next.Upload(*_asset->GetTextureLoader()); }
+		catch (...) { next.Release(*_asset->GetTextureLoader()); context->End(); throw; }
+		model->CSOL.Release(*_asset->GetTextureLoader());
+		model->CSOL = std::move(next);
+		context->End();
+		_asset->UpdateSettingsState();
+		SetAsset(_asset);
+		return true;
+	}
+	catch (const std::exception& e) { QMessageBox::warning(this, "CSOL 资源加载失败", QString::fromUtf8(e.what())); }
+	return false;
+}
+
+void CSOLPanel::Parameters()
+{
+	if (_loading || !_asset) return;
+	ReadParameters(_asset->GetEditableStudioModel()->CSOL);
+}
+
+void CSOLPanel::ReadParameters(csol::Preview& p) const
+{
+	p.ShowParts = _showParts->isChecked();
+	p.WeaponPreset = _preset->isChecked(); p.DepthTest = _depth->isChecked(); p.Brightness = _brightness->value();
+	p.FollowWeapon = _automatic->isChecked(); p.RightHand = _rightHand->isChecked();
+	p.Enabled = _enabled->isChecked(); p.Playing = _play->isChecked(); p.Billboard = _billboard->isChecked(); p.Loop = _loop->isChecked();
+	p.FPS = _fps->value(); p.Width = _width->value(); p.Height = _height->value(); p.Attachment = _attachment->currentIndex() - 1;
+	p.Hands = _hands->currentIndex();
+	p.SpriteBlend = _blend->currentIndex() == 0 ? csol::Blend::Alpha : _blend->currentIndex() == 1 ? csol::Blend::Add : csol::Blend::AddAlpha;
+	for (int i = 0; i < 3; ++i) p.Offset[i] = _offset[i]->value();
+}
+
+void CSOLPanel::Profile(bool save)
+{
+	const auto file = save ? QFileDialog::getSaveFileName(this, "保存独立预览配置", {}, "CSOL 预览配置 (*.json)")
+		: QFileDialog::getOpenFileName(this, "载入独立预览配置", {}, "CSOL 预览配置 (*.json)");
+	if (file.isEmpty()) return;
+	try
+	{
+		if (save) SaveProfile(file);
+		else LoadProfile(file);
+	}
+	catch (const std::exception& e) { QMessageBox::warning(this, "预览配置", QString::fromUtf8(e.what())); }
+}
+
+void CSOLPanel::SaveProfile(const QString& file) const
+{
+	QJsonObject o{{"version", 1}, {"resourceRoot", _root->text()}, {"appearance", _appearance->currentText()},
+		{"sprite", _sprite->text()}, {"attachment", _attachment->currentIndex()}, {"hands", _hands->currentIndex()},
+		{"width", _width->value()}, {"height", _height->value()}, {"fps", _fps->value()}, {"blend", _blend->currentIndex()},
+		{"billboard", _billboard->isChecked()}, {"loop", _loop->isChecked()}};
+	o.insert("weaponPreset", _preset->isChecked()); o.insert("depthTest", _depth->isChecked()); o.insert("brightness", _brightness->value());
+	o.insert("followWeapon", _automatic->isChecked()); o.insert("rightHand", _rightHand->isChecked());
+	o.insert("showParts", _showParts->isChecked()); o.insert("partsSequence", _partsSequence->currentIndex());
+	for (int i = 0; i < 3; ++i) o.insert(QString("offset%1").arg(i), _offset[i]->value());
+	QSaveFile out(file);
+	if (!out.open(QIODevice::WriteOnly)) throw std::runtime_error("无法保存配置");
+	const auto bytes = QJsonDocument(o).toJson();
+	if (out.write(bytes) != bytes.size() || !out.commit()) throw std::runtime_error("配置写入失败");
+}
+
+bool CSOLPanel::LoadProfile(const QString& file)
+{
+	QJsonParseError error;
+	const auto doc = QJsonDocument::fromJson(csol::ReadResource(file), &error);
+	if (error.error || !doc.isObject() || doc.object().value("version").toInt() != 1) throw std::runtime_error("无效的预览配置");
+	const auto o = doc.object();
+	_loading = true;
+	_showParts->setChecked(o.value("showParts").toBool(true)); _partsSequence->setCurrentIndex(std::clamp(o.value("partsSequence").toInt(0), 0, 3));
+	_root->setText(o.value("resourceRoot").toString()); ScanHands(); _appearance->setCurrentText(o.value("appearance").toString());
+	_sprite->setText(o.value("sprite").toString());
+	// Older profiles keep their explicit settings until the user enables presets.
+	_preset->setChecked(o.value("weaponPreset").toBool(false));
+	_automatic->setChecked(o.value("followWeapon").toBool(false)); _rightHand->setChecked(o.value("rightHand").toBool(true));
+	_depth->setChecked(o.value("depthTest").toBool(true)); _brightness->setValue(o.value("brightness").toDouble(1));
+	_attachment->setCurrentIndex(o.value("attachment").toInt()); _hands->setCurrentIndex(o.value("hands").toInt());
+	_width->setValue(o.value("width").toDouble(8)); _height->setValue(o.value("height").toDouble(8)); _fps->setValue(o.value("fps").toDouble(20));
+	_blend->setCurrentIndex(o.value("blend").toInt(2)); _billboard->setChecked(o.value("billboard").toBool(true)); _loop->setChecked(o.value("loop").toBool(true));
+	for (int i = 0; i < 3; ++i) _offset[i]->setValue(o.value(QString("offset%1").arg(i)).toDouble());
+	_loading = false;
+	const bool loaded = Apply();
+	if (!loaded) SetAsset(_asset);
+	return loaded;
+}
+
+}
