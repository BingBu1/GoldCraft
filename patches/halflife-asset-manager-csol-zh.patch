+			const auto second = draw("auto-tick10"); require(first != second, "Automatic playback did not change image");
+			asset->PlaySequence = false; const double paused = p.BoundSprites[0].Frame; const auto pose = entity->GetFrame(); tick(10);
+			require(p.BoundSprites[0].Frame == paused && entity->GetFrame() == pose && draw("paused") == second, "Pause did not freeze model and SPR");
+			asset->PlaySequence = true; p.Playing = false; tick(2);
+			require(p.BoundSprites[0].Frame == paused, "Preview animation toggle ignored"); p.Playing = true;
+			asset->PlaySequence = false; entity->SetSequence(soul ? 8 : 4); entity->SetFrame(soul ? 30 : 35);
