diff --git a/src/hlam/qt/ChineseStandardTranslator.hpp b/src/hlam/qt/ChineseStandardTranslator.hpp
new file mode 100644
index 0000000..a51a63a
--- /dev/null
+++ b/src/hlam/qt/ChineseStandardTranslator.hpp
@@ -0,0 +1,34 @@
+#pragma once
+#include <QHash>
+#include <QTranslator>
+
+// Hand-authored translations for Qt's built-in controls. Numeric parsing remains C/English.
+class ChineseStandardTranslator final : public QTranslator
+{
+public:
+	bool isEmpty() const override { return false; }
+	QString translate(const char* context, const char* source, const char* = nullptr, int = -1) const override
+	{
+		const QByteArray name(context);
+		if (!name.startsWith('Q')) return {};
+		static const QHash<QString, QString> text{
+			{"OK", "确定"}, {"&OK", "确定(&O)"}, {"Cancel", "取消"}, {"&Cancel", "取消(&C)"},
+			{"Yes", "是"}, {"&Yes", "是(&Y)"}, {"No", "否"}, {"&No", "否(&N)"},
+			{"Save", "保存"}, {"&Save", "保存(&S)"}, {"Save All", "全部保存"}, {"Open", "打开"},
+			{"&Open", "打开(&O)"}, {"Close", "关闭"}, {"&Close", "关闭(&C)"}, {"Discard", "放弃修改"},
+			{"Apply", "应用"}, {"Reset", "重置"}, {"Restore Defaults", "恢复默认"}, {"Help", "帮助"},
+			{"Abort", "中止"}, {"Retry", "重试"}, {"Ignore", "忽略"}, {"Yes to All", "全部选是"}, {"No to All", "全部选否"},
+			{"Undo", "撤销"}, {"&Undo", "撤销(&U)"}, {"Undo %1", "撤销 %1"},
+			{"Redo", "重做"}, {"&Redo", "重做(&R)"}, {"Redo %1", "重做 %1"},
+			{"Cut", "剪切"}, {"Cu&t", "剪切(&T)"}, {"Copy", "复制"}, {"&Copy", "复制(&C)"},
+			{"Paste", "粘贴"}, {"&Paste", "粘贴(&P)"}, {"Delete", "删除"}, {"Delete Selection", "删除所选内容"},
+			{"Select All", "全选"}, {"Select &All", "全选(&A)"}, {"&Delete", "删除(&D)"},
+			{"Select Color", "选择颜色"}, {"&Basic colors", "基本颜色(&B)"}, {"&Custom colors", "自定义颜色(&C)"},
+			{"&Add to Custom Colors", "添加到自定义颜色(&A)"}, {"Pick Screen Color", "拾取屏幕颜色"},
+			{"Hu&e:", "色相(&E)："}, {"&Sat:", "饱和度(&S)："}, {"&Val:", "明度(&V)："},
+			{"&Red:", "红(&R)："}, {"&Green:", "绿(&G)："}, {"Bl&ue:", "蓝(&U)："},
+			{"A&lpha channel:", "透明通道(&L)："}, {"&HTML:", "HTML 颜色(&H)："}
+		};
+		return text.value(QString::fromUtf8(source));
+	}
+};
diff --git a/src/hlam/qt/Qt5STLCompatibility.hpp b/src/hlam/qt/Qt5STLCompatibility.hpp
new file mode 100644
