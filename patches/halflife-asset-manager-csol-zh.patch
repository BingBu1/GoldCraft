+
+namespace csol
+{
+namespace
+{
+constexpr int MaxIndex = 32 * 1024 * 1024;
+constexpr int MaxResource = 128 * 1024 * 1024;
+[[noreturn]] void Invalid() { throw std::runtime_error("NAR 资源包损坏或格式不受支持"); }
+std::uint32_t U32(const QByteArray& data, int at)
+{
+	if (at < 0 || data.size() - at < 4) Invalid();
+	const auto p = reinterpret_cast<const unsigned char*>(data.constData() + at);
+	return p[0] | (std::uint32_t(p[1]) << 8) | (std::uint32_t(p[2]) << 16) | (std::uint32_t(p[3]) << 24);
+}
+QByteArray ReadAt(QFile& file, qint64 at, qint64 size, int limit)
+{
+	if (at < 0 || size < 0 || size > limit || at > file.size() || size > file.size() - at || !file.seek(at)) Invalid();
+	auto data = file.read(size);
+	if (data.size() != size) Invalid();
+	return data;
+}
+struct Entry { QByteArray Name; std::uint32_t Type, Offset, Stored, Size, CRC; };
+struct Index
+{
+	qint64 Bytes = 0, Modified = 0;
+	QHash<QString, Entry> Entries;
+};
+// GUI-thread resource loading only; bounded cache never holds open archive handles.
+QCache<QString, Index> cache(16);
+const Index& OpenIndex(const QString& path)
+{
+	const QFileInfo info(path);
+	if (const auto* old = cache.object(path); old && old->Bytes == info.size()
+		&& old->Modified == info.lastModified().toMSecsSinceEpoch()) return *old;
+	QFile file(path);
+	if (!file.open(QIODevice::ReadOnly)) Invalid();
+	const auto magic = ReadAt(file, 0, 8, 8);
+	if (U32(magic, 0) != 0x0052414e || U32(magic, 4) != 0x01000000) Invalid();
+	const auto tail = ReadAt(file, file.size() - 8, 8, 8);
+	if (U32(tail, 4) != 0x0052414e) Invalid();
+	const auto stored = U32(tail, 0) ^ 0x4076551fu;
+	const qint64 indexStart = file.size() - 8 - stored;
+	if (indexStart < 8) Invalid();
+	auto compressed = ReadAt(file, indexStart, stored, MaxIndex);
+	constexpr unsigned char key[]{0x19,0x5b,0x7b,0x2c,0x65,0x5e,0x79,0x25,0x6e,0x4b,0x07,0x21,0x62,0x7f,0x00,0x29};
+	for (int i = 0; i < compressed.size(); ++i) compressed[i] = char(static_cast<unsigned char>(compressed[i]) ^ key[i % 16]);
+	QByteArray data(MaxIndex, Qt::Uninitialized); unsigned size = data.size();
+	if (BZ2_bzBuffToBuffDecompress(data.data(), &size, compressed.data(), compressed.size(), 0, 0) != BZ_OK) Invalid();
+	data.resize(size);
+	if (data.size() < 20 || U32(data, 0) != 1) Invalid();
+	const auto count = U32(data, 16);
+	if (count > 200000 || count > unsigned(data.size() - 20) / 27) Invalid();
+	auto index = std::make_unique<Index>(); index->Bytes = info.size(); index->Modified = info.lastModified().toMSecsSinceEpoch();
+	int offset = 20;
+	for (unsigned i = 0; i < count; ++i)
+	{
+		if (data.size() - offset < 2) Invalid();
+		const unsigned length = static_cast<unsigned char>(data[offset]) | (unsigned(static_cast<unsigned char>(data[offset + 1])) << 8);
+		offset += 2;
+		if (!length || length > 4096 || data.size() - offset < int(length) + 24) Invalid();
+		Entry e; e.Name = data.mid(offset, length); offset += length;
+		e.Type = U32(data, offset); e.Offset = U32(data, offset + 4); e.Stored = U32(data, offset + 8);
+		e.Size = U32(data, offset + 12); e.CRC = U32(data, offset + 20); offset += 24;
+		if (e.Type > 2 || e.Offset < 8 || qint64(e.Offset) + e.Stored > indexStart) Invalid();
+		const auto name = QString::fromLatin1(e.Name).replace('\\', '/');
+		if (!name.startsWith('/') || name.contains("/../") || name.contains(QChar(0))) Invalid();
+		index->Entries.insert(name.toLower(), std::move(e));
+	}
+	if (offset != data.size()) Invalid();
+	auto* result = index.release(); cache.insert(path, result); return *result;
+}
+QStringList Archives(const QStringList& directories)
+{
+	QStringList files;
+	for (const auto& path : directories)
+	{
+		const QDir dir(path);
+		// Deterministic viewer fallback order; game-version mount precedence can differ.
+		for (const auto& name : {"fstrike.nar", "estrike.nar", "dstrike.nar", "cstrike_chn.nar", "cstrike.nar", "valve.nar"})
+		{
+			const auto file = dir.filePath(name);
+			if (QFileInfo::exists(file) && !files.contains(file, Qt::CaseInsensitive)) files.append(file);
+		}
+	}
+	return files;
+}
+std::uint32_t CRC32(const QByteArray& bytes)
+{
+	std::uint32_t crc = ~0u;
+	for (unsigned char c : bytes)
+	{
+		crc ^= c;
+		for (int bit = 0; bit < 8; ++bit) crc = (crc >> 1) ^ (0xedb88320u & (0u - (crc & 1)));
+	}
+	return ~crc;
+}
+}
+
+void ClearArchiveCache() { cache.clear(); }
+
+QStringList ArchiveResourceNames(const QStringList& directories)
+{
+	QStringList result;
+	for (const auto& archive : Archives(directories))
+	{
+		const auto& index = OpenIndex(archive);
+		const auto prefix = "/" + QFileInfo(archive).completeBaseName().toLower() + "/";
+		for (auto it = index.Entries.cbegin(); it != index.Entries.cend(); ++it)
+			if (it.key().startsWith(prefix)) result.append(it.key().mid(prefix.size()));
+	}
+	result.removeDuplicates(); result.sort(Qt::CaseInsensitive); return result;
+}
+
+QString FindArchiveResource(const QStringList& directories, const QString& relative)
+{
+	const auto variants = ResourceNameVariants(relative);
+	for (const auto& archive : Archives(directories))
+	{
+		const auto& index = OpenIndex(archive);
+		const auto mount = QFileInfo(archive).completeBaseName();
+		for (const auto& name : variants)
+		{
+			const QString key = "/" + mount + "/" + name.toLower();
+			if (!index.Entries.contains(key)) continue;
+			auto url = QUrl::fromLocalFile(archive); url.setScheme("csol-nar"); url.setFragment(key, QUrl::DecodedMode);
+			return url.toString(QUrl::FullyEncoded);
+		}
+	}
+	return {};
+}
+
+QByteArray ReadArchiveResource(const QString& resource)
+{
+	QUrl url(resource); const auto key = url.fragment(QUrl::FullyDecoded).toLower(); url.setFragment({}); url.setScheme("file");
+	const auto archive = url.toLocalFile();
+	const auto& index = OpenIndex(archive);
+	const auto it = index.Entries.constFind(key);
+	if (it == index.Entries.cend()) Invalid();
+	const auto e = *it;
+	if (e.Size > MaxResource || e.Stored > MaxResource) Invalid();
+	QFile file(archive); if (!file.open(QIODevice::ReadOnly)) Invalid();
+	auto data = ReadAt(file, e.Offset, e.Stored, MaxResource);
+	if (CRC32(data) != e.CRC) Invalid();
+	if (e.Type)
+	{
+		std::uint32_t hash = 0;
+		for (unsigned char c : e.Name) hash = hash * 1000003u ^ c;
+		hash ^= e.Name.size();
+		std::array<unsigned char, 16> key;
+		for (auto& byte : key) { hash = hash * 1103515245u + 12345u; byte = hash & 255; }
+		for (int i = 0; i < data.size(); ++i) data[i] = char(static_cast<unsigned char>(data[i]) ^ key[i % 16]);
+	}
+	if (e.Type < 2) { if (data.size() != e.Size) Invalid(); return data; }
+	QByteArray out; out.reserve(e.Size); int at = 0;
+	auto byte = [&]() -> unsigned { if (at >= data.size()) Invalid(); return static_cast<unsigned char>(data[at++]); };
+	while (out.size() < e.Size)
+	{
+		const unsigned control = byte(); unsigned length = control >> 5;
+		if (!length)
+		{
+			length = (control & 31) + 1;
+			if (length > e.Size - out.size() || length > unsigned(data.size() - at)) Invalid();
+			out.append(data.constData() + at, length); at += length;
+		}
+		else
+		{
+			if (length == 7) length += byte();
+			length += 2; const unsigned distance = ((control & 31) << 8 | byte()) + 1;
+			if (distance > unsigned(out.size()) || length > e.Size - out.size()) Invalid();
+			for (unsigned i = 0; i < length; ++i) out.append(out[out.size() - distance]);
+		}
+	}
+	if (at != data.size()) Invalid();
+	return out;
+}
+
+QStringList ArchiveAppearances(const QStringList& directories)
+{
+	QStringList result;
+	static const QRegularExpression pattern("/gfx/tattoo/([^/]+)_(?:male|female)(?:long|short|org)\\.tga$");
+	for (const auto& file : Archives(directories))
+		for (auto it = OpenIndex(file).Entries.cbegin(), end = OpenIndex(file).Entries.cend(); it != end; ++it)
+		{
+			const auto match = pattern.match(it.key());
+			if (match.hasMatch()) result.append(match.captured(1));
+		}
+	result.removeDuplicates(); return result;
+}
+}
