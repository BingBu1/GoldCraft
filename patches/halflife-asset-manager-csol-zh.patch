+			Check(csol::ReadResource(csol::LocateResource(root.path(), QString::fromLatin1(name))) == "hello", "NAR reserved filename characters");
+		}
+		saveArchive(archive(8, 5, "/dstrike/" + rawKorean + ".bmp"));
+		Check(csol::ReadResource(csol::LocateResource(root.path(), korean + ".bmp")) == "hello", "Unicode lookup preserves raw NAR key");
+		auto damaged = validArchive; damaged[8] = 'H'; saveArchive(damaged);
+		Reject([&] { csol::ReadResource(archiveURL); });
+		saveArchive(archive(0xfffffff0, 64)); Reject([&] { csol::ReadResource(archiveURL); });
+		for (int cut : {0, 7, 12, validArchive.size() - 1})
+		{
+			saveArchive(validArchive.left(cut)); Reject([&] { csol::ReadResource(archiveURL); });
+		}
+		csol::ClearArchiveCache();
+		QJsonObject report{{"syntheticChecks", checks}};
+		if (qEnvironmentVariableIsSet("HLAM_CSOL_JSON_MODELS"))
+		{
+			QJsonArray models;
+			QDirIterator files(qEnvironmentVariable("HLAM_CSOL_JSON_MODELS"), {"*.json"}, QDir::Files, QDirIterator::Subdirectories);
+			while (files.hasNext())
+			{
+				const auto path = files.next(); QFile mdl(path.left(path.size() - 5) + ".mdl");
+				if (!mdl.open(QIODevice::ReadOnly)) continue;
+				const auto header = mdl.read(244); if (header.size() < 244) continue;
+				auto field = [&](int at) { unsigned n = 0; for (int i = 0; i < 4; ++i) n |= unsigned(static_cast<unsigned char>(header[at + i])) << (i * 8); return int(n); };
+				const auto bytes = csol::ReadResource(path); const auto object = QJsonDocument::fromJson(bytes).object();
+				if (!object.contains("bindSpr")) continue;
+				const auto config = csol::ParseModelJSON(bytes, field(180), field(164));
+				models.append(QJsonObject{{"file", QFileInfo(path).fileName()}, {"bindings", int(config.Sprites.size())}, {"notices", QJsonArray::fromStringList(config.Notices)}});
+			}
+			report.insert("nativeModelJSON", models);
+		}
+		if (argc == 5 && (QString::fromLocal8Bit(argv[1]) == "--nar" || QString::fromLocal8Bit(argv[1]) == "--resources"))
+		{
+			const bool archiveOnly = QString::fromLocal8Bit(argv[1]) == "--nar";
+			const auto expected = QJsonDocument::fromJson(csol::ReadResource(QString::fromLocal8Bit(argv[3]))).array();
+			QJsonArray results;
+			for (const auto& value : expected)
+			{
+				const auto row = value.toObject();
+				const auto path = csol::LocateResource(QString::fromLocal8Bit(argv[2]), row.value("relative").toString());
+				if (path.isEmpty() || (archiveOnly && !path.startsWith("csol-nar:"))) throw std::runtime_error(("Resource not found: " + row.value("relative").toString() + " -> " + path).toStdString());
+				const auto hash = QString::fromLatin1(QCryptographicHash::hash(csol::ReadResource(path), QCryptographicHash::Sha256).toHex());
+				Check(hash == row.value("sha256").toString(), "NAR decoder differs from independent extractor");
+				results.append(QJsonObject{{"path", path}, {"sha256", hash}});
+			}
+			report.insert("archiveComparisons", results);
+			QFile out(QString::fromLocal8Bit(argv[4])); Check(out.open(QIODevice::WriteOnly), "Write archive evidence");
+			out.write(QJsonDocument(report).toJson());
+		}
+		else if (argc >= 3)
+		{
+			const QDir root(QString::fromLocal8Bit(argv[1]));
+			QJsonArray images;
+			for (const auto& name : QDir(root.filePath("sprites")).entryList({"*.spr"}, QDir::Files))
+			{
+				const auto frames = csol::DecodeSprite(csol::ReadResource(root.filePath("sprites/" + name)));
+				QJsonArray hashes; for (const auto& frame : frames) hashes.append(Hash(frame));
+				images.append(QJsonObject{{"file", name}, {"frames", int(frames.size())}, {"rgbaSha256", hashes}});
+			}
+			QJsonArray hands;
+			const QDir handDir(root.filePath("resources/common/gfx/tattoo"));
+			for (const auto& name : handDir.entryList({"*.tga"}, QDir::Files))
+			{
+				const auto image = csol::DecodeTGA(csol::ReadResource(handDir.filePath(name)));
+				hands.append(QJsonObject{{"file", name}, {"width", image.width()}, {"height", image.height()}, {"rgbaSha256", Hash(image)}});
+			}
+			report.insert("sprites", images); report.insert("hands", hands);
+			QFile out(QString::fromLocal8Bit(argv[2]));
+			if (!out.open(QIODevice::WriteOnly)) throw std::runtime_error("Cannot write evidence");
+			out.write(QJsonDocument(report).toJson());
+		}
+		std::cout << QJsonDocument(report).toJson(QJsonDocument::Compact).constData() << '\n';
+		return 0;
+	}
+	catch (const std::exception& e) { std::cerr << e.what() << '\n'; return 1; }
+}
