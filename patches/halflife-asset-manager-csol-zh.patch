diff --git a/tests/CSOLEventSmokeTest.cpp b/tests/CSOLEventSmokeTest.cpp
new file mode 100644
index 0000000..c151a1a
--- /dev/null
+++ b/tests/CSOLEventSmokeTest.cpp
@@ -0,0 +1,147 @@
+#include "application/AssetManager.hpp"
+#include "application/AssetList.hpp"
+#include "plugins/halflife/studiomodel/StudioModelAsset.hpp"
+#include "entity/HLMVStudioModelEntity.hpp"
+#include "formats/studiomodel/StudioModelUtils.hpp"
+#include "formats/csol/CSOLExport.hpp"
+#include "graphics/IGraphicsContext.hpp"
+#include "graphics/Scene.hpp"
+#include "graphics/SceneContext.hpp"
+#include "utility/WorldTime.hpp"
+#include "ui/MainWindow.hpp"
+#include <QApplication>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QJsonArray>
+#include <QOpenGLFramebufferObject>
+#include <QOpenGLFunctions_1_1>
+#include <QCryptographicHash>
+#include <QUndoStack>
+#include <QPushButton>
+#include <QComboBox>
+#include <QLabel>
+#include <QDockWidget>
+#include <QTabWidget>
+#include <stdexcept>
+
+int RunCSOLEventSmokeTest(AssetManager& application, const QString& evidence)
+{
+	QDir out(evidence); out.mkpath("."); QJsonObject report;
+	auto require = [](bool b, const char* why) { if (!b) throw std::runtime_error(why); };
+	auto hash = [](const QByteArray& b) { return QCryptographicHash::hash(b, QCryptographicHash::Sha256); };
+	auto* asset = dynamic_cast<studiomodel::StudioModelAsset*>(application.GetAssets()->GetCurrent());
+	bool current = false;
+	try
+	{
+		require(asset, "No asset"); auto* model = asset->GetEditableStudioModel(); auto* entity = asset->GetEntity(); auto& p = model->CSOL;
+		report.insert("status", p.Status);
+		require(p.Enabled && p.EventDefinitions.size() == 9 && p.EventClips.size() == 7, "Soulreaper numeric events not discovered");
+		require(p.BoundSprites.size() == 7, "Soulreaper native JSON lost");
+		const auto original = hash(csol::ReadResource(asset->GetFileName())); const auto undo = asset->GetUndoStack()->index();
+		auto serialized = [&]()
+		{
+			auto binary = studiomdl::ConvertFromEditable("invariant.mdl", *model); const auto& bytes = binary.GetStudioHeaderPtr();
+			return hash(QByteArray(reinterpret_cast<const char*>(bytes.get()), bytes.SizeInBytes));
+		};
+		const auto before = serialized();
+		auto* clock = application.GetWorldTime();
+		auto tick = [&](int count)
+		{
+			for (int i = 0; i < count; ++i)
+			{
+				clock->SetPreviousTime(clock->GetTime()); clock->SetTime(clock->GetTime() + .05f); clock->SetFrameTime(.05f); asset->Tick();
+			}
+		};
+		asset->PlaySequence = false; entity->SetLoopingMode(StudioLoopingMode::NeverLoop); entity->SetSequence(3);
+		entity->SetFrame(4); require(p.EventSprites.empty(), "Draw event fired before frame 5");
+		entity->SetFrame(5); require(p.EventSprites.size() == 1, "Draw event not fired at frame 5");
+		const auto def = p.EventDefinitions[p.EventSprites[0].Definition];
+		require(def.Parameters.Resource == 362 && def.Parameters.Follow == 6 && p.EventEffect(p.EventSprites[0]).Frame == 0, "Wrong Draw resource/attachment/frame");
+		asset->GetGraphicsContext()->Begin(); current = true;
+		QByteArray expectedImage;
+		{
+			auto* gl = application.GetOpenGLFunctions(); graphics::SceneContext sc(gl, asset->GetTextureLoader());
+			sc.WindowWidth = 960; sc.WindowHeight = 640;
+			auto* scene = asset->GetScene(); scene->UpdateWindowSize(960, 640);
+			scene->GetCurrentCamera()->GetCamera()->SetProperties(glm::vec3(0), 0, 0, 0);
+			QOpenGLFramebufferObjectFormat format; format.setAttachment(QOpenGLFramebufferObject::CombinedDepthStencil);
+			QOpenGLFramebufferObject fbo(960, 640, format); require(fbo.isValid(), "No FBO");
+			auto draw = [&](const QString& name)
+			{
+				require(fbo.bind(), "FBO bind failed"); scene->Draw(sc, glm::vec4(.12f, .13f, .15f, 1));
+				const auto image = fbo.toImage(); require(gl->glGetError() == GL_NO_ERROR, "OpenGL error");
+				require(image.save(out.filePath(name + ".png")), "Image save failed");
+				return hash(QByteArray(reinterpret_cast<const char*>(image.constBits()), image.sizeInBytes()));
+			};
+			draw("draw-trigger-frame5"); entity->SetFrame(10);
+			auto saved = p.EventSprites; p.EventSprites.clear(); const auto absent = draw("draw-without-event"); p.EventSprites = saved;
+			expectedImage = draw("draw-frame10"); require(absent != expectedImage, "Draw sprite has no rendered effect");
+			const auto age = p.EventSprites[0].Age; tick(8);
+			require(p.EventSprites[0].Age == age && draw("draw-paused") == expectedImage, "Pause changed sprite or model");
+			p.RightHand = false; require(draw("draw-left-uv") != expectedImage, "H mirror flag ignored"); p.RightHand = true;
+			entity->SetFrame(0); require(p.EventSprites.empty(), "Seek left stale effect");
+			asset->PlaySequence = true; tick(8); require(p.EventSprites.size() == 1 && p.EventSprites[0].Age > 0, "Actual asset Tick did not trigger and animate event");
+			draw("draw-live-tick"); const auto pausedAge = p.EventSprites[0].Age; p.Playing = false; tick(2);
+			require(p.EventSprites[0].Age == pausedAge, "Effect playback toggle ignored"); p.Playing = true;
+			tick(35); require(p.EventSprites.empty(), "Nonloop effect did not expire after sequence end"); draw("draw-expired");
+			entity->SetLoopingMode(StudioLoopingMode::AlwaysLoop); entity->SetSequence(3); entity->SetFrame(27); tick(6);
+			require(!p.EventSprites.empty(), "Loop lost Draw event"); tick(4);
+			require(p.EventSprites.size() >= 1 && p.EventSprites.back().Age < .5, "Loop did not retrigger Draw"); draw("draw-loop");
+			asset->PlaySequence = false; entity->SetSequence(4); require(p.EventSprites.size() == 2, "Simultaneous attachments dropped"); draw("shoot-two-attachments");
+			entity->SetSequence(0); require(p.EventSprites.empty(), "Sequence change retained stale effect");
+			entity->SetSequence(3); entity->SetFrame(10);
+			const auto old = p.EventClips[0].Handles[0]; p.Release(*asset->GetTextureLoader()); require(!gl->glIsTexture(old), "Event texture leak");
+			p.Upload(*asset->GetTextureLoader()); p.UpdateFilters(*asset->GetTextureLoader());
+			require(gl->glIsTexture(p.EventClips[0].Handles[0]) && draw("draw-recreated") == expectedImage, "Event resource recreation changed output");
+			report.insert("gpu", QString::fromLatin1(reinterpret_cast<const char*>(gl->glGetString(GL_RENDERER)))); fbo.release();
+		}
+		asset->GetGraphicsContext()->End(); current = false;
+		require(serialized() == before && asset->GetUndoStack()->index() == undo, "Preview modified MDL/undo");
+		const auto exported = csol::ExportResources(asset->GetFileName(), p.Root, out.filePath("exported"));
+		report.insert("exportFiles", exported.Files); report.insert("exportBytes", double(exported.Bytes));
+		report.insert("missing", QJsonArray::fromStringList(exported.Missing));
+		require(hash(csol::ReadResource(exported.Directory + "/" + exported.Model)) == original, "Export modified model");
+		for (int i = 356; i <= 362; ++i) require(QFileInfo::exists(exported.Directory + QString("/common/sprites/muzzleflash%1.spr").arg(i)), "Export omitted numbered event");
+		auto* panel = application.GetMainWindow()->findChild<QWidget*>("CSOLPanel"); require(panel, "No CSOL panel");
+		require(panel->findChild<QPushButton*>("CSOLExportResources"), "No Chinese export button");
+		application.GetMainWindow()->resize(1280, 900);
+		if (auto* dock = qobject_cast<QDockWidget*>(panel->parentWidget())) { dock->show(); dock->raise(); }
+		application.GetMainWindow()->show(); panel->findChild<QTabWidget*>("CSOLTabs")->setCurrentIndex(0); QApplication::processEvents();
+		require(panel->grab().save(out.filePath("ui-export.png")), "UI capture failed");
+		auto* sequences = application.GetMainWindow()->findChild<QComboBox*>("Sequences"); require(sequences, "No sequence selector");
+		sequences->setCurrentIndex(3);
+		auto* events = application.GetMainWindow()->findChild<QComboBox*>("Events"); require(events, "No event selector");
+		for (int i = 0; i < int(model->Sequences[3]->Events.size()); ++i)
+			if (model->Sequences[3]->Events[i]->EventId == 5061) events->setCurrentIndex(i);
+		auto* explanation = application.GetMainWindow()->findChild<QLabel*>("CSOLEventExplanation");
+		require(explanation && explanation->toolTip().contains("muzzleflash362.spr") && explanation->text().contains("挂点 6"), "Chinese event explanation missing");
+		QWidget* eventDock = explanation; while (eventDock && !qobject_cast<QDockWidget*>(eventDock)) eventDock = eventDock->parentWidget();
+		if (eventDock) { eventDock->show(); eventDock->raise(); QApplication::processEvents(); require(eventDock->grab().save(out.filePath("ui-event-explanation.png")), "Event explanation capture failed"); }
+		csol::SetGameDirectory({}); application.LoadFile(exported.Directory + "/" + exported.Model);
+		auto* offline = dynamic_cast<studiomodel::StudioModelAsset*>(application.GetAssets()->GetCurrent());
+		require(offline && offline != asset, "Cannot open exported model"); const auto& op = offline->GetEditableStudioModel()->CSOL;
+		require(op.EventDefinitions.size() == 9 && op.BoundSprites.size() == 7, "Offline export lost effects");
