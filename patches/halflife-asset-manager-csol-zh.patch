diff --git a/src/hlam/formats/csol/CSOLExport.cpp b/src/hlam/formats/csol/CSOLExport.cpp
new file mode 100644
index 0000000..fcb1e7f
--- /dev/null
+++ b/src/hlam/formats/csol/CSOLExport.cpp
@@ -0,0 +1,248 @@
+#include "formats/csol/CSOLExport.hpp"
+#include "formats/csol/CSOLFormats.hpp"
+#include "formats/csol/CSOLArchive.hpp"
+#include "formats/csol/CSOLModelJSON.hpp"
+#include "formats/csol/CSOLEvents.hpp"
+#include "formats/csol/CSOLParts.hpp"
+#include "formats/studiomodel/StudioModelFileFormat.hpp"
+#include <QCryptographicHash>
+#include <QDirIterator>
+#include <QFileInfo>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QMap>
+#include <QRegularExpression>
+#include <QSaveFile>
+#include <QSet>
+#include <QUrl>
+#include <cstring>
+#include <algorithm>
+#include <functional>
+#include <stdexcept>
+
+namespace csol
+{
+namespace
+{
+QString SafeRelative(QString name)
+{
+	name.replace('\\', '/');
+	if (QDir::isAbsolutePath(name)) throw std::runtime_error("资源引用不是相对路径");
+	for (const auto& part : name.split('/'))
+		if (part.isEmpty() || part == "." || part == ".." || part.endsWith('.') || part.endsWith(' ')
+			|| part.contains(QRegularExpression("^(?:CON|PRN|AUX|NUL|COM[0-9]|LPT[0-9])(?:\\.|$)", QRegularExpression::CaseInsensitiveOption))
+			|| part.contains(QRegularExpression("[<>:\"|?*\\x00-\\x1f]")))
+			throw std::runtime_error("资源包含不安全的导出路径");
+	return name;
+}
+QString ResourceName(const QString& path, const QString& root)
+{
+	if (path.startsWith("csol-nar:")) return SafeRelative(QUrl(path).fragment(QUrl::FullyDecoded).section('/', 2));
+	for (const auto& directory : ResourceDirectories(root))
+	{
+		const auto relative = QDir(directory).relativeFilePath(path);
+		if (!relative.startsWith("../") && !QDir::isAbsolutePath(relative)) return SafeRelative(relative);
+	}
+	return {};
+}
+template<class T> T Record(const QByteArray& bytes, qint64 offset)
+{
+	if (offset < 0 || offset > bytes.size() || sizeof(T) > std::size_t(bytes.size() - offset))
+		throw std::runtime_error("关联模型的记录越界");
+	T result; std::memcpy(&result, bytes.constData() + offset, sizeof(T)); return result;
+}
+template<std::size_t N> QString String(const char (&value)[N])
+{
+	return QString::fromLatin1(value, int(std::find(value, value + N, '\0') - value));
+}
+}
+
+ExportResult ExportResources(const QString& sourceModel, const QString& root, const QString& destination, const QString& extraSprite)
+{
+	ExportResult result; result.Directory = QFileInfo(destination).absoluteFilePath();
+	if (QFileInfo::exists(result.Directory) || QFileInfo(result.Directory).isSymLink())
+		throw std::runtime_error("导出目录已存在；请选择新的子文件夹，避免覆盖文件");
+	struct Resource { QString Name, Source, Reason; };
+	QMap<QString, Resource> resources;
+	QSet<QString> visited;
+	QStringList modelQueue;
+	auto add = [&](QString name, const QString& reason, bool required = true, QString source = {}) -> QString
+	{
+		name = SafeRelative(name); const auto key = name.toLower();
+		if (resources.contains(key))
+		{
+			if (!source.isEmpty()) resources[key] = {name, source, reason};
+			return resources[key].Source;
+		}
+		if (source.isEmpty()) source = LocateResource(root, name);
+		if (source.isEmpty()) { if (required) result.Missing.append(name + "（" + reason + "）"); return {}; }
+		resources.insert(key, {name, source, reason});
+		if (name.endsWith(".mdl", Qt::CaseInsensitive)) modelQueue.append(key);
+		return source;
+	};
+	QString main = ResourceName(sourceModel, root);
+	if (!main.startsWith("models/", Qt::CaseInsensitive)) main = "models/" + QFileInfo(sourceModel).fileName();
+	add(main, "当前模型（磁盘版本）", true, sourceModel); result.Model = "common/" + main;
+	if (const auto companion = CompanionModel(sourceModel); !companion.isEmpty())
+	{
+		const auto adjacent = QFileInfo(sourceModel).dir().filePath(QFileInfo(companion).fileName());
+		add(companion, "客户端组合模型", true, QFileInfo(adjacent).isFile() ? adjacent : QString());
+	}
+	const auto primary = PrimaryModel(sourceModel);
+	if (!primary.isEmpty())
+	{
+		const auto adjacent = QFileInfo(sourceModel).dir().filePath(QFileInfo(primary).fileName());
+		add(primary, "附属件对应的主体模型", true, QFileInfo(adjacent).isFile() ? adjacent : QString());
+	}
+	if (!extraSprite.isEmpty())
+	{
+		auto name = ResourceName(extraSprite, root); if (name.isEmpty()) name = "sprites/" + QFileInfo(extraSprite).fileName();
+		add(name, "手动附加动画", true, extraSprite);
+	}
+	QString stem = QFileInfo(primary.isEmpty() ? sourceModel : primary).completeBaseName();
+	if (stem.startsWith("v_") || stem.startsWith("w_") || stem.startsWith("p_")) stem = stem.mid(2);
+	const QRegularExpression family("(?:^|_)" + QRegularExpression::escape(stem) + "(?:$|[_\\.0-9])", QRegularExpression::CaseInsensitiveOption);
+	QStringList names = ArchiveResourceNames(ResourceDirectories(root));
+	for (const auto& directory : ResourceDirectories(root))
+		for (const auto* folder : {"models", "sprites", "sound/weapons", "gfx/tattoo", "resource"})
+		{
+			QDirIterator it(QDir(directory).filePath(folder), QDir::Files | QDir::NoSymLinks, QDirIterator::Subdirectories);
+			while (it.hasNext()) names.append(QDir(directory).relativeFilePath(it.next()));
+		}
+	names.removeDuplicates(); names.sort(Qt::CaseInsensitive);
+	for (const auto& name : names)
+		if (!stem.isEmpty() && family.match(QFileInfo(name).fileName()).hasMatch()) add(name, "同武器命名资源", false);
+	QSet<QString> handSuffixes;
+	auto inspect = [&](const QString& name, const auto& work)
+	{
+		try { work(); }
+		catch (const std::exception& e) { result.Missing.append(name + "：" + QString::fromUtf8(e.what())); }
+	};
+	std::function<void(const QJsonValue&)> jsonRefs = [&](const QJsonValue& value)
+	{
+		if (value.isObject()) for (const auto& v : value.toObject()) jsonRefs(v);
+		else if (value.isArray()) for (const auto& v : value.toArray()) jsonRefs(v);
+		else if (value.isString())
+		{
+			const auto name = value.toString().replace('\\', '/');
+			if (name.contains(QRegularExpression("^(models|sprites|gfx|shader|sound|resource)/", QRegularExpression::CaseInsensitiveOption)))
+				add(name, "模型 JSON 引用");
+		}
+	};
+	while (!modelQueue.isEmpty())
+	{
+		const auto key = modelQueue.takeFirst(); if (visited.contains(key)) continue; visited.insert(key);
+		const auto resource = resources[key];
+		try
+		{
+			const auto bytes = ReadResource(resource.Source);
+			if (bytes.left(4) == "IDSQ") continue;
+			const auto h = Record<studiohdr_t>(bytes, 0);
+			if (bytes.left(4) != "IDST" || h.version != 10 || h.numseq < 0 || h.numseq > 4096
+				|| h.numtextures < 0 || h.numtextures > 4096 || h.numseqgroups < 0 || h.numseqgroups > 100)
+				throw std::runtime_error("关联模型不是受支持的 v10 MDL");
+			const auto base = resource.Name.left(resource.Name.size() - 4);
+			if (!h.textureindex) add(base + "T.mdl", "外部模型贴图");
+			for (int i = 1; i < h.numseqgroups; ++i) add(base + QString("%1.mdl").arg(i, 2, 10, QChar('0')), "外部序列组");
+			const auto json = resource.Source.startsWith("csol-nar:") ? LocateResource(root, base + ".json") : LocateModelJSON(resource.Source, root);
+			if (!json.isEmpty()) inspect(base + ".json", [&]
+			{
+				add(base + ".json", "旁置模型 JSON", true, json);
+				QJsonParseError error; const auto doc = QJsonDocument::fromJson(ReadResource(json), &error);
+				if (error.error || !doc.isObject()) throw std::runtime_error("无法解析模型 JSON 的资源依赖");
+				jsonRefs(doc.object());
+			});
+			for (int i = 0; i < h.numtextures; ++i)
+			{
+				const auto t = Record<mstudiotexture_t>(bytes, qint64(h.textureindex) + i * sizeof(mstudiotexture_t));
+				const auto name = String(t.name); const auto m = ParseMaterial(name);
+				if (m.Width > 0) add("models/texture/" + name, "外部模型贴图");
+				if (!m.HandSuffix.isEmpty()) handSuffixes.insert(m.HandSuffix);
+				if (!m.Descriptor.isEmpty())
+				{
+					inspect(m.Descriptor, [&]
+					{
+						const auto descriptor = add("shader/" + m.Descriptor + ".txt", "模型材质");
+						const auto mapping = add("shader/env.txt", "环境贴图映射");
+						if (!descriptor.isEmpty() && !mapping.isEmpty())
+						{
+							const auto env = ParseEnvironment(ReadResource(descriptor));
+							for (const auto& line : QString::fromUtf8(ReadResource(mapping)).split(QRegularExpression("[\\r\\n]+")))
+							{
+								const auto parts = line.simplified().split(' '); bool ok; const int index = parts.value(0).toInt(&ok);
+								if (parts.size() == 2 && ok && index == env.Index)
+									for (const auto* face : {"rt", "bk", "lf", "ft", "up", "dn"}) add("gfx/env/" + parts[1] + face + ".tga", "环境反射六面图");
+							}
+						}
+					});
+				}
+			}
+			for (int i = 0; i < h.numseq; ++i)
+			{
+				const auto seq = Record<mstudioseqdesc_t>(bytes, qint64(h.seqindex) + i * sizeof(mstudioseqdesc_t));
+				if (seq.numevents < 0 || seq.numevents > 4096) throw std::runtime_error("模型事件数量越界");
+				for (int j = 0; j < seq.numevents; ++j)
+				{
+					const auto event = Record<mstudioevent_t>(bytes, qint64(seq.eventindex) + j * sizeof(mstudioevent_t));
+					const auto options = String(event.options);
+					inspect(resource.Name + QString(" 事件 %1").arg(event.event), [&]
+					{
+						if (auto parsed = ParseSpriteEvent(event.event, options))
+						{
+							add(parsed->ResourceName(), "模型 # 扩展事件");
+							if (parsed->Alternate) add(QString("sprites/muzzleflash%1.spr").arg(parsed->Alternate), "模型 E 备用特效");
+						}
+						else if (options.endsWith(".wav", Qt::CaseInsensitive)) add("sound/" + options, "模型声音事件");
+					});
+				}
+			}
+		}
+		catch (const std::exception& e) { result.Missing.append(resource.Name + "：" + QString::fromUtf8(e.what())); }
+	}
+	for (const auto& suffix : handSuffixes)
+	{
+		add("gfx/tattoo/" + suffix, "默认手部贴图");
+		for (const auto& name : names)
+			if (name.startsWith("gfx/tattoo/", Qt::CaseInsensitive) && name.endsWith("_" + suffix, Qt::CaseInsensitive))
+				add(name, "可切换角色手部贴图");
+	}
+	// GoldSrc HUD lists: label resolution spriteName x y w h.
+	const auto inventory = resources.values();
+	for (const auto& resource : inventory)
+		if (resource.Name.startsWith("sprites/", Qt::CaseInsensitive) && resource.Name.endsWith(".txt", Qt::CaseInsensitive))
+			for (const auto& line : QString::fromLatin1(ReadResource(resource.Source)).split(QRegularExpression("[\\r\\n]+")))
+			{
+				const auto parts = line.simplified().split(' ');
+				if (parts.size() >= 7) add("sprites/" + parts[2] + ".spr", "HUD 列表引用");
+			}
+	if (!QDir().mkpath(result.Directory)) throw std::runtime_error("无法创建导出目录");
+	auto write = [&](const QString& relative, const QByteArray& bytes)
+	{
+		const auto path = QDir(result.Directory).filePath(SafeRelative(relative));
+		if (!QDir().mkpath(QFileInfo(path).absolutePath())) throw std::runtime_error("无法创建资源子目录");
+		QSaveFile file(path);
+		if (!file.open(QIODevice::WriteOnly) || file.write(bytes) != bytes.size() || !file.commit()) throw std::runtime_error("导出文件写入失败");
+	};
+	QJsonArray manifest;
+	for (const auto& resource : resources)
+	{
+		try
+		{
+			const auto bytes = ReadResource(resource.Source); const auto relative = "common/" + resource.Name;
+			write(relative, bytes); ++result.Files; result.Bytes += bytes.size();
+			manifest.append(QJsonObject{{"path", relative}, {"source", resource.Source}, {"reason", resource.Reason},
+				{"sha256", QString::fromLatin1(QCryptographicHash::hash(bytes, QCryptographicHash::Sha256).toHex())}, {"bytes", bytes.size()}});
+		}
+		catch (const std::exception& e) { result.Missing.append(resource.Name + "：" + QString::fromUtf8(e.what())); }
+	}
+	result.Missing.removeDuplicates();
+	write("resources.json", QJsonDocument(QJsonObject{{"version", 1}, {"model", result.Model}, {"files", manifest},
+		{"missing", QJsonArray::fromStringList(result.Missing)}, {"searchOrder", QJsonArray::fromStringList(ResourceDirectories(root))}}).toJson());
+	write("读取说明.txt", QString("在 HLAM 中打开 %1。common 下保留 models、sprites、gfx、shader、sound 等相对路径。\n"
+		"同名资源按本次预览的搜索顺序选取；NAR 资源已解出。resources.json 记录来源、校验值与缺失项。\n"
+		"导出的是磁盘文件，包含同武器命名资源与可识别的静态依赖；DLL 在运行时动态生成的引用无法保证穷尽。\n"
+		"未保存的模型修改和手动预览参数不会写入此导出。\n缺失/未解析：%2\n").arg(result.Model).arg(result.Missing.join("\n")).toUtf8());
+	return result;
+}
+}
