+++ b/src/hlam/qt/Qt5STLCompatibility.hpp
@@ -0,0 +1,12 @@
+#pragma once
+
+#include <QtCore/qglobal.h>
+
+// Qt 5.15.2 refers to stdext iterators removed by recent MSVC STL releases.
+// Use Qt's portable pointer form; this does not change Qt container layouts.
+#if defined(Q_CC_MSVC) && QT_VERSION < QT_VERSION_CHECK(5, 15, 3)
+#undef QT_MAKE_CHECKED_ARRAY_ITERATOR
+#undef QT_MAKE_UNCHECKED_ARRAY_ITERATOR
+#define QT_MAKE_CHECKED_ARRAY_ITERATOR(x, N) (x)
+#define QT_MAKE_UNCHECKED_ARRAY_ITERATOR(x) (x)
+#endif
