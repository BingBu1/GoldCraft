diff --git a/src/hlam/formats/csol/CSOLEvents.cpp b/src/hlam/formats/csol/CSOLEvents.cpp
new file mode 100644
index 0000000..77a81f4
--- /dev/null
+++ b/src/hlam/formats/csol/CSOLEvents.cpp
@@ -0,0 +1,71 @@
+#include "formats/csol/CSOLEvents.hpp"
+#include <QRegularExpression>
+#include <cmath>
+#include <stdexcept>
+
+namespace csol
+{
+QString SpriteEvent::ResourceName() const { return QString("sprites/muzzleflash%1.spr").arg(Resource); }
+double SpriteEvent::Duration(int frames) const
+{
+	return Animate && !Loop && Life >= 998 ? frames / FPS : Life;
+}
+std::optional<SpriteEvent> ParseSpriteEvent(int id, const QString& options)
+{
+	if (!options.startsWith('#')) return {};
+	if (id < 5000 || id >= 5640) throw std::runtime_error("CSOL 特效事件的初始挂点超出范围");
+	SpriteEvent event; event.Attachment = (id - 5000) / 10;
+	static const QRegularExpression token("([A-Z])([+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+))?");
+	int at = 1;
+	while (at < options.size())
+	{
+		if (options[at].isSpace()) { ++at; continue; }
+		const auto match = token.match(options, at, QRegularExpression::NormalMatch, QRegularExpression::AnchoredMatchOption);
+		if (!match.hasMatch()) throw std::runtime_error("无效的 CSOL # 特效参数");
+		at = match.capturedEnd();
+		const auto key = match.captured(1)[0].toLatin1();
+		if (key == 'U') { event.Overlay = true; continue; } // Presence, including U0, enables queue 3.
+		bool ok = false; const float n = match.captured(2).toFloat(&ok);
+		if (!ok || !std::isfinite(n) || std::abs(n) > 1000000) throw std::runtime_error("无效的 CSOL 特效数值");
+		switch (key)
+		{
+		case 'I': event.Resource = int(n); break;
+		case 'E': event.Alternate = int(n); break;
+		case 'S': event.Scale = n; break;
+		case 'R': event.Rotation = int(n); break;
+		case 'F': event.RandomFrame = int(n) != 0; break;
+		case 'P': event.FPS = int(n); break;
+		case 'T': event.Life = n; break;
+		case 'A': event.Animate = int(n) != 0; break;
+		case 'L': event.Loop = int(n) != 0; break;
+		case 'X': event.Follow = int(n); break;
+		case 'D': event.Alpha = int(n) != 0; break;
+		case 'H': event.HandFlip = int(n) != 0; break;
+		case 'Q': event.SequenceOnly = int(n) != 0; break;
+		case 'O': break; // Parsed but not consumed by this engine build.
+		default: event.Notices += QString("未支持参数 %1；").arg(QChar(key)); break;
+		}
+	}
+	if (event.Resource < 1 || event.Resource > 65535 || event.Alternate < 0 || event.Alternate > 65535
+		|| event.Follow < -1 || event.Follow > 63 || event.Scale <= 0 || event.Scale > 1024
+		|| event.FPS <= 0 || event.FPS > 10000 || event.Life < 0 || event.Life > 86400)
+		throw std::runtime_error("CSOL 特效参数超出可预览范围");
+	if (event.Alternate) event.Notices += "E 依赖游戏角色状态，独立预览采用 I；";
+	return event;
+}
+QString DescribeSpriteEvent(int id, const QString& options)
+{
+	try
+	{
+		const auto parsed = ParseSpriteEvent(id, options);
+		if (!parsed) return {};
+		const auto& e = *parsed;
+		return QString("CSOL 扩展挂点特效：%1\n初始挂点 %2；%3；缩放 %4；%5 帧/秒；%6；%7。%8")
+			.arg(e.ResourceName()).arg(e.Attachment)
+			.arg(e.Follow >= 0 ? QString("持续跟随挂点 %1").arg(e.Follow) : QString("停留在触发位置"))
+			.arg(e.Scale).arg(e.FPS).arg(e.Loop ? "循环" : "播放一次")
+			.arg(e.Overlay ? "第一人称覆盖绘制" : "参与深度测试").arg(e.Notices);
+	}
+	catch (const std::exception& e) { return QString::fromUtf8(e.what()); }
+}
+}
