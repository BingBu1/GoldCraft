+#include <stdexcept>
+
+namespace csol
+{
+Preview::Preview() = default;
+Preview::~Preview() = default;
+Preview::Preview(Preview&&) noexcept = default;
+Preview& Preview::operator=(Preview&&) noexcept = default;
+
+Preview Preview::SettingsOnly() const
+{
+	Preview p;
+	p.Enabled = Enabled; p.Playing = Playing; p.Root = Root; p.Appearance = Appearance; p.SpriteFile = SpriteFile;
+	p.FPS = FPS; p.Attachment = Attachment; p.Hands = Hands; p.Offset = Offset; p.Width = Width; p.Height = Height;
+	p.SpriteBlend = SpriteBlend; p.Billboard = Billboard; p.Loop = Loop;
+	p.WeaponPreset = WeaponPreset; p.DepthTest = DepthTest; p.Brightness = Brightness;
+	p.FollowWeapon = FollowWeapon; p.RightHand = RightHand; p.SourceFile = SourceFile;
+	p.ShowParts = ShowParts; p.PartsSequence = PartsSequence;
+	return p;
+}
+
+namespace
+{
+bool IsRevivegun(const studiomdl::EditableStudioModel& model)
+{
+	static const char* names[]{"idle", "reload", "draw", "shootA", "shootB_start", "shootB",
+		"revive_idle", "revive_reload", "revive_draw", "revive_shootA", "revive_shootB_start", "revive_shootB", "revive"};
+	if (model.Bones.empty() || model.Bones[0]->Name != "revivegun_root" || model.Attachments.size() <= 5
+		|| !model.Attachments[5]->Bone || model.Attachments[5]->Bone->Name != "sprite_attach01"
+		|| model.Sequences.size() != std::size(names)) return false;
+	for (std::size_t i = 0; i < std::size(names); ++i)
+		if (model.Sequences[i]->Label != names[i]) return false;
+	return true;
+}
+}
+
+void Preview::Discover(const QString& file, const studiomdl::EditableStudioModel& model)
+{
+	SourceFile = file;
+	Root = DiscoverResourceRoot(file);
+	if (Root.isEmpty()) Root = GameDirectory();
+	ModelJSONFile = LocateModelJSON(file, Root);
+	bool special = IsRevivegun(model);
+	for (const auto& sequence : model.Sequences)
+		for (const auto& event : sequence->Events) special |= event->Options.starts_with('#');
+	for (const auto& texture : model.Textures)
+	{
+		const auto info = ParseMaterial(QString::fromStdString(texture->Name));
+		special |= info.Special || info.Width > 0 || !info.Descriptor.isEmpty()
+			|| (!info.HandSuffix.isEmpty() && info.Name.compare("hand.bmp", Qt::CaseInsensitive) != 0);
+	}
+	if (!special && ModelJSONFile.isEmpty()) return;
+	Enabled = true;
+	FollowWeapon = IsRevivegun(model);
+	Load(model);
+}
+
+void Preview::Load(const studiomdl::EditableStudioModel& model)
+{
+	Textures.clear(); Frames.clear(); FrameHandles.clear(); Effects = {}; RelatedResources.clear(); Time = ActionTime = 0;
+	BoundSprites.clear(); BoundClips.clear();
+	EventClips.clear(); EventDefinitions.clear(); EventSprites.clear(); EventsStarted = false;
+	EventSprites.reserve(256);
+	ModelJSONFile = LocateModelJSON(SourceFile, Root);
+	ActionSequence = -1;
+	RecognizedWeapon = IsRevivegun(model);
+	HandModels.assign(model.Bodyparts.size(), {-1, -1});
+	for (std::size_t group = 0; group < model.Bodyparts.size(); ++group)
+		for (std::size_t sub = 0; sub < model.Bodyparts[group]->Models.size(); ++sub)
+		{
+			const auto name = QString::fromStdString(model.Bodyparts[group]->Models[sub].Name).toLower();
+			if (name.contains("cso_hand_male")) HandModels[group][0] = int(sub);
+			if (name.contains("cso_hand_female")) HandModels[group][1] = int(sub);
+		}
+	QStringList messages;
+	std::size_t eventBytes = 0;
+	for (int sequence = 0; sequence < int(model.Sequences.size()); ++sequence)
+		for (const auto& event : model.Sequences[sequence]->Events)
+		{
+			try
+			{
+				auto parsed = ParseSpriteEvent(event->EventId, QString::fromStdString(event->Options));
+				if (!parsed) continue;
+				if (parsed->Attachment >= int(model.Attachments.size()) || parsed->Follow >= int(model.Attachments.size()))
+					throw std::runtime_error("事件引用了不存在的模型挂点");
+				const auto file = LocateResource(Root, parsed->ResourceName());
+				if (file.isEmpty()) throw std::runtime_error(("缺少事件特效：" + parsed->ResourceName()).toStdString());
+				auto it = std::find_if(EventClips.begin(), EventClips.end(), [&](const auto& clip) { return clip.File == file; });
+				const auto index = std::size_t(it - EventClips.begin());
+				if (it == EventClips.end())
+				{
+					const auto bytes = ReadResource(file);
+					if (bytes.size() < 12 || bytes[8] != 2 || bytes[9] || bytes[10] || bytes[11])
+						throw std::runtime_error("事件 SPR 目前仅支持 type 2 面向相机的朝向");
+					EffectClip clip; clip.File = file; clip.Frames = DecodeSprite(bytes);
+					std::size_t size = 0; for (const auto& frame : clip.Frames) size += frame.sizeInBytes();
+					if (size > 256 * 1024 * 1024 - eventBytes) throw std::runtime_error("事件特效缓存超过 256 MiB");
+					eventBytes += size; EventClips.push_back(std::move(clip));
+				}
+				EventDefinitions.push_back({*parsed, sequence, event->Frame, index});
+				messages.append(QString("%1 第 %2 帧：%3").arg(QString::fromStdString(model.Sequences[sequence]->Label))
+					.arg(event->Frame).arg(DescribeSpriteEvent(event->EventId, QString::fromStdString(event->Options))));
+			}
+			catch (const std::exception& e) { messages.append(QString::fromUtf8(e.what())); }
+		}
+	if (Root.isEmpty()) messages.append("未找到模型旁的资源目录；特殊效果所需的外部文件可能不完整。");
+	else messages.append("自动搜索目录：\n" + ResourceDirectories(Root).join("\n"));
+	if (!ModelJSONFile.isEmpty())
+	{
+		messages.append("自动加载模型 JSON：" + ModelJSONFile);
+		try
+		{
+			auto config = ParseModelJSON(ReadResource(ModelJSONFile), int(model.Textures.size()), int(model.Sequences.size()));
+			messages.append(config.Notices);
+			std::size_t decodedBytes = 0;
+			for (auto& binding : config.Sprites)
+			{
+				try
+				{
+					const auto file = LocateResource(Root, binding.Sprite);
+					if (file.isEmpty()) throw std::runtime_error("未找到 SPR 资源");
+					auto it = std::find_if(BoundClips.begin(), BoundClips.end(), [&](const auto& clip) { return clip.File == file; });
+					std::size_t index = std::size_t(it - BoundClips.begin());
+					if (it == BoundClips.end())
+					{
+						EffectClip clip; clip.File = file; clip.Frames = DecodeSprite(ReadResource(file));
+						std::size_t bytes = 0;
+						for (const auto& frame : clip.Frames) bytes += frame.sizeInBytes();
+						if (bytes > 256 * 1024 * 1024 - decodedBytes) throw std::runtime_error("动态贴图缓存超过 256 MiB");
+						decodedBytes += bytes;
+						BoundClips.push_back(std::move(clip));
+					}
+					messages.append(QString("贴图槽 %1 ← %2（%3 帧）").arg(binding.Texture).arg(binding.Sprite).arg(BoundClips[index].Frames.size()));
+					BoundSprites.push_back({std::move(binding), index});
+				}
+				catch (const std::exception& e) { messages.append(binding.Sprite + "：" + QString::fromUtf8(e.what())); }
+			}
+		}
+		catch (const std::exception& e) { messages.append(QString::fromUtf8(e.what())); }
+	}
+	int hands = 0;
+	for (const auto& texture : model.Textures)
+	{
+		PreviewTexture preview;
+		preview.Info = ParseMaterial(QString::fromStdString(texture->Name));
+		try
+		{
+		if (preview.Info.Width > 0)
+		{
+			const auto path = LocateResource(Root, "models/texture/" + QString::fromStdString(texture->Name));
+			if (!path.isEmpty())
+			{
+				preview.Image = QImage::fromData(ReadResource(path)).convertToFormat(QImage::Format_RGBA8888);
+				if (preview.Image.isNull()) throw std::runtime_error("无法解码外部模型贴图");
+			}
+		}
+		if (!preview.Info.HandSuffix.isEmpty())
+		{
+			const auto path = ResolveHand(Root, Appearance, preview.Info.HandSuffix);
+			if (!path.isEmpty()) { preview.Image = DecodeTGA(ReadResource(path)); ++hands; }
+			else messages.append(QString("缺少手部贴图：%1").arg(preview.Info.HandSuffix));
+		}
+		}
+		catch (const std::exception& e) { messages.append(QString::fromUtf8(e.what())); }
+		if (!preview.Info.Descriptor.isEmpty())
+		{
+			const auto path = LocateResource(Root, "shader/" + preview.Info.Descriptor + ".txt");
+			if (path.isEmpty()) messages.append(QString("缺少材质描述：%1.txt").arg(preview.Info.Descriptor));
+			else try
+			{
+				preview.Env = ParseEnvironment(ReadResource(path));
+				const auto mapping = QString::fromUtf8(ReadResource(LocateResource(Root, "shader/env.txt")));
+				QString envName;
+				for (const auto& line : mapping.split(QRegularExpression("[\\r\\n]+")))
+				{
+					const auto parts = line.simplified().split(' ');
+					bool ok; const int index = parts.value(0).toInt(&ok);
+					if (parts.size() == 2 && ok && index == preview.Env.Index) envName = parts[1];
+				}
+				if (envName.isEmpty() || envName.contains('/') || envName.contains('\\') || envName.contains(".."))
+					throw std::runtime_error("env.txt 中缺少有效的环境贴图名称");
+				const char* faces[]{"rt", "bk", "lf", "ft", "up", "dn"};
+				for (int i = 0; i < 6; ++i)
+					preview.CubeFaces[i] = OrientCubeFace(DecodeTGA(ReadResource(LocateResource(Root, "gfx/env/" + envName + faces[i] + ".tga"))), i);
+				messages.append(QString("%1：已加载 type 0 环境反射").arg(preview.Info.Descriptor));
+				if (preview.Env.Multiply != 1) messages.append("mulBright 已读取；参考 CSO_ENV 着色器未使用此参数。");
+			}
+			catch (const std::exception& e)
+			{
+				preview.CubeFaces = {};
+				messages.append(preview.Info.Descriptor + "：" + QString::fromUtf8(e.what()));
+			}
+		}
+		Textures.push_back(std::move(preview));
+	}
+	if (FollowWeapon && RecognizedWeapon)
+	{
+		Attachment = 5; Offset = glm::vec3(0); SpriteBlend = Blend::Add; Billboard = true; Loop = true;
+		DepthTest = false; Brightness = 250.f / 255.f;
+		std::size_t decodedBytes = 0;
+		for (int i = 0; i < int(Effects.size()); ++i)
+		{
+			const auto relative = QString("sprites/ef_revivegun_%1%2%3.spr")
+				.arg((i % 4) >= 2 ? "draw" : "idle").arg((i % 2) + 1).arg(i >= 4 ? "_left" : "");
+			auto& clip = Effects[i]; clip.File = LocateResource(Root, relative);
+			if (clip.File.isEmpty()) { messages.append("缺少动作特效：" + relative); continue; }
+			try
+			{
+				auto frames = DecodeSpriteV3(ReadResource(clip.File));
+				std::size_t bytes = 0;
+				for (const auto& frame : frames) bytes += frame.sizeInBytes();
+				if (bytes > 256 * 1024 * 1024 - decodedBytes) throw std::runtime_error("动作特效总缓存超过 256 MiB");
+				decodedBytes += bytes; clip.Frames = std::move(frames);
+			}
+			catch (const std::exception& e) { messages.append(relative + "：" + QString::fromUtf8(e.what())); }
+		}
+		messages.append("复活枪：已自动绑定左右手、普通/复活状态与拔枪→待机（1 秒）。换弹时隐藏圆环；场景光束/爆炸仍需独立事件支持。");
+	}
+	// Inventory associated resources without loading arbitrary similarly named effects.
+	QString stem = QFileInfo(SourceFile).completeBaseName();
+	if (stem.startsWith("v_") || stem.startsWith("w_") || stem.startsWith("p_")) stem = stem.mid(2);
+	if (!stem.isEmpty())
+		for (const auto& directory : ResourceDirectories(Root))
+			for (const auto& sub : {"sprites", "sound/weapons", "models", "shader"})
+			{
+				const QDir dir(QDir(directory).filePath(sub));
+				const auto filter = QString(sub) == "shader" ? QStringList{"*.txt", "mdlrender.*"} : QStringList{"*" + stem + "*"};
+				for (const auto& name : dir.entryList(filter, QDir::Files, QDir::Name)) RelatedResources.append(dir.filePath(name));
+			}
+	if (!FollowWeapon && !SpriteFile.isEmpty()) Frames = DecodeSpriteV3(ReadResource(SpriteFile));
+	// Verified client calls and engine registration: attachment is zero-based,
+	// scale is per mille of the SPR pixel dimensions, flags 9 select the
+	// viewmodel overlay queue. This recipe does not infer weapon event timing.
+	if (WeaponPreset && !Frames.empty() && !model.Bones.empty()
+		&& model.Bones[0]->Name == "revivegun_root" && model.Attachments.size() > 5
+		&& model.Attachments[5]->Bone && model.Attachments[5]->Bone->Name == "sprite_attach01")
+	{
+		const auto name = QFileInfo(SpriteFile).fileName().toLower().replace("_left.spr", ".spr");
+		const bool first = name == "ef_revivegun_idle1.spr" || name == "ef_revivegun_draw1.spr";
+		const bool second = name == "ef_revivegun_idle2.spr" || name == "ef_revivegun_draw2.spr";
+		if (first || second)
+		{
+			Attachment = 5; Offset = glm::vec3(0);
+			const float scale = (first ? 28.f : 40.f) / 1000.f;
+			Width = Frames.front().width() * scale; Height = Frames.front().height() * scale;
+			FPS = name == "ef_revivegun_idle1.spr" ? 20 : 30;
+			SpriteBlend = Blend::Add; Billboard = true; Loop = true;
+			DepthTest = false; Brightness = 250.f / 255.f;
+			messages.append("已套用复活枪参数：挂点 5（sprite_attach01）、零偏移、原始缩放/帧率、加色、第一人称覆盖绘制。动作触发时序仍需游戏对照。");
+		}
+	}
+	messages.removeDuplicates();
+	int clips = 0; std::size_t frameCount = Frames.size();
+	for (const auto& clip : Effects) if (!clip.Frames.empty()) { ++clips; frameCount += clip.Frames.size(); }
+	UpdateBindings(0, 0, 0);
+	Status = QString("已加载 %1 张手部贴图、%2 处 JSON 动态贴图、%3 组专用特效、%4 个扩展事件。\n")
+		.arg(hands).arg(BoundSprites.size()).arg(clips).arg(EventDefinitions.size()) + messages.join("\n");
+	if (!RelatedResources.empty()) Status += "\n\n关联资源（发现不代表已绑定全部游戏事件）：\n" + RelatedResources.join("\n");
+	LoadParts(model);
+}
+
+void Preview::SetAction(int sequence, double seconds)
+{
+	EventSprites.clear(); EventsStarted = false;
+	if (sequence == ActionSequence || sequence / 6 != ActionSequence / 6 || sequence % 6 == 2 || ActionSequence < 0)
+		Time = seconds;
+	else if (ActionSequence % 6 == 1 || ActionSequence >= 12) Time = seconds;
+	else if (ActionSequence % 6 == 2) Time = std::max(0.0, ActionTime - 1.0) + seconds;
+	ActionSequence = sequence; ActionTime = seconds;
+}
+
+void Preview::AdvanceEvents(int sequence, double start, double advance, double duration, double seconds, bool loop)
+{
+	if (!Enabled || !Playing || !std::isfinite(seconds) || seconds < 0 || !std::isfinite(advance) || advance < 0) return;
+	for (auto& sprite : EventSprites) sprite.Age += seconds;
+	for (std::size_t i = 0; i < EventDefinitions.size(); ++i)
+	{
+		const auto& def = EventDefinitions[i]; if (def.Sequence != sequence) continue;
+		const double end = start + advance;
+		double when = def.Frame;
+		if (loop && duration > 0 && when < start) when += std::ceil((start - when) / duration) * duration;
+		for (int repeats = 0; repeats < 256 && when <= end + 1e-6; ++repeats)
+		{
+			if (when > start + 1e-6 || (!EventsStarted && when >= start - 1e-6))
+			{
+				EventSprite sprite; sprite.Definition = i;
+				sprite.Age = advance > 0 ? std::max(0.0, (end - when) / advance * seconds) : 0;
+				const auto& e = def.Parameters;
+				if (e.RandomFrame) sprite.FirstFrame = QRandomGenerator::global()->bounded(int(EventClips[def.Clip].Frames.size()));
+				if (e.Rotation == 1 || e.Rotation == 2) sprite.Angle = QRandomGenerator::global()->bounded(e.Rotation == 1 ? 21 : 360);
+				if (EventSprites.size() < 256) EventSprites.push_back(sprite);
+			}
+			if (!loop || duration <= 0) break;
+			when += duration;
+		}
+	}
+	EventsStarted = true;
+	std::erase_if(EventSprites, [&](const auto& sprite)
+	{
+		const auto& def = EventDefinitions[sprite.Definition]; const auto& e = def.Parameters;
+		const auto frames = EventClips[def.Clip].Frames.size();
+		return sprite.Age >= e.Duration(int(frames)) || (e.SequenceOnly && def.Sequence != sequence)
+			|| (e.Animate && !e.Loop && sprite.FirstFrame + sprite.Age * e.FPS >= frames);
+	});
+}
+
+void Preview::SeekEvents(int sequence, double frame, double fps)
+{
+	EventSprites.clear(); EventsStarted = false;
+	// Seeking remains available while either playback toggle is paused.
+	const bool playing = Playing; Playing = true;
+	AdvanceEvents(sequence, 0, frame, 0, fps > 0 ? frame / fps : 0, false);
+	Playing = playing;
+}
+
+EffectView Preview::EventEffect(const EventSprite& sprite) const
+{
+	EffectView view;
+	const auto& def = EventDefinitions[sprite.Definition]; const auto& e = def.Parameters;
+	const auto& clip = EventClips[def.Clip];
+	if (clip.Frames.empty()) return view;
+	view.Frame = std::size_t(std::fmod(sprite.FirstFrame + (e.Animate ? std::floor(sprite.Age * e.FPS + 1e-6) : 0), double(clip.Frames.size())));
+	view.Width = clip.Frames[view.Frame].width() * e.Scale; view.Height = clip.Frames[view.Frame].height() * e.Scale;
+	if (view.Frame < clip.Handles.size()) view.Handle = clip.Handles[view.Frame];
+	return view;
+}
+
+void Preview::UpdateBindings(int sequence, double modelFrame, double seconds, bool seek)
+{
+	UpdateParts(seconds, seek);
+	for (auto& sprite : BoundSprites)
+	{
+		const auto& binding = sprite.Binding;
+		sprite.Active = sequence >= 0 && sequence < int(binding.Rules.size()) && binding.Rules[sequence].Sequence >= 0;
+		if (!sprite.Active) continue;
+		const auto& rule = binding.Rules[sequence];
+		if (seek) sprite.Frame = std::max(0, rule.Start);
+		sprite.Frame = AdvanceSpriteFrame(rule, binding.FPS, int(BoundClips[sprite.Clip].Frames.size()),
+			sprite.Frame, seconds, modelFrame);
+	}
+}
+
+GLuint Preview::BoundTexture(int texture) const
+{
+	for (const auto& sprite : BoundSprites)
+		if (sprite.Active && sprite.Binding.Texture == texture)
+		{
+			const auto& clip = BoundClips[sprite.Clip];
+			const auto index = SpriteFrameIndex(sprite.Frame, int(clip.Frames.size()));
+			return index < int(clip.Handles.size()) ? clip.Handles[index] : 0;
+		}
+	return 0;
+}
+
+EffectView Preview::CurrentEffect(const studiomdl::EditableStudioModel& model, int sequence) const
+{
+	EffectView view;
+	if (!FollowWeapon || !RecognizedWeapon)
+	{
+		view.Frame = FrameIndex(); view.Width = Width; view.Height = Height;
+		if (view.Frame < FrameHandles.size()) view.Handle = FrameHandles[view.Frame];
+		return view;
+	}
+	// client weapon +0x174 is the reload latch (base post-frame transfers clip/ammo).
+	if (sequence < 0 || sequence >= 12 || sequence % 6 == 1) return view;
+	const bool variant2 = sequence >= 6;
+	const bool draw = sequence % 6 == 2 && ActionTime < 1.0;
+	view.Clip = (RightHand ? 0 : 4) + (draw ? 2 : 0) + (variant2 ? 1 : 0);
+	const auto& clip = Effects[view.Clip];
+	if (clip.Frames.empty()) return view;
+	const double fps = draw || variant2 ? 30 : 20;
+	const double time = sequence % 6 == 2 ? (draw ? ActionTime : ActionTime - 1.0) : Time;
+	if (!std::isfinite(time)) return view;
+	view.Frame = std::size_t(std::fmod(std::floor(std::max(0.0, time) * fps), double(clip.Frames.size())));
+	const float scale = (variant2 ? 40.f : 28.f) / 1000.f;
+	view.Width = clip.Frames.front().width() * scale; view.Height = clip.Frames.front().height() * scale;
+	if (view.Frame < clip.Handles.size()) view.Handle = clip.Handles[view.Frame];
+	return view;
+}
+
+void Preview::Upload(graphics::TextureLoader& loader)
+{
+	Release(loader);
+	if (Parts) Parts->CreateTextures(loader);
+	auto upload = [&](const QImage& image)
+	{
+		const auto handle = loader.CreateTexture();
+		loader.UploadRGBA8888(handle, image.width(), image.height(),
+			reinterpret_cast<const std::byte*>(image.constBits()), false, true);
+		return handle;
+	};
+	for (auto& texture : Textures) if (!texture.Image.isNull()) texture.Handle = upload(texture.Image);
+	FrameHandles.reserve(Frames.size());
+	for (const auto& frame : Frames) FrameHandles.push_back(upload(frame));
+	for (auto& clip : Effects)
+	{
+		clip.Handles.reserve(clip.Frames.size());
+		for (const auto& frame : clip.Frames) clip.Handles.push_back(upload(frame));
+	}
+	for (auto& clip : BoundClips)
+	{
+		clip.Handles.reserve(clip.Frames.size());
+		for (const auto& frame : clip.Frames) clip.Handles.push_back(upload(frame));
+	}
+	for (auto& clip : EventClips)
+		for (const auto& frame : clip.Frames) clip.Handles.push_back(upload(frame));
+	auto gl = QOpenGLContext::currentContext()->functions();
+	const unsigned targets[]{GL_TEXTURE_CUBE_MAP_POSITIVE_X, GL_TEXTURE_CUBE_MAP_POSITIVE_Y,
+		GL_TEXTURE_CUBE_MAP_NEGATIVE_X, GL_TEXTURE_CUBE_MAP_NEGATIVE_Y, GL_TEXTURE_CUBE_MAP_POSITIVE_Z, GL_TEXTURE_CUBE_MAP_NEGATIVE_Z};
+	bool hasCube = false;
+	for (auto& texture : Textures)
+	{
+		if (texture.CubeFaces[0].isNull()) continue;
+		hasCube = true;
+		gl->glGenTextures(1, &texture.Cube); gl->glBindTexture(GL_TEXTURE_CUBE_MAP, texture.Cube);
+		for (int i = 0; i < 6; ++i)
+			gl->glTexImage2D(targets[i], 0, GL_RGBA, 128, 128, 0, GL_RGBA, GL_UNSIGNED_BYTE, texture.CubeFaces[i].constBits());
+		gl->glTexParameteri(GL_TEXTURE_CUBE_MAP, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+		gl->glTexParameteri(GL_TEXTURE_CUBE_MAP, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+		gl->glTexParameteri(GL_TEXTURE_CUBE_MAP, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+		gl->glTexParameteri(GL_TEXTURE_CUBE_MAP, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+		gl->glTexParameteri(GL_TEXTURE_CUBE_MAP, GL_TEXTURE_WRAP_R, GL_CLAMP_TO_EDGE);
+	}
+	gl->glBindTexture(GL_TEXTURE_CUBE_MAP, 0);
+	if (hasCube)
+	{
+		EnvShader = std::make_unique<QOpenGLShaderProgram>();
+		const char* vertex = R"(#version 120
+uniform vec3 eye;
+varying vec3 cubeDirection;
+void main() {
+ gl_Position = ftransform();
+ gl_TexCoord[0] = gl_MultiTexCoord0;
+ gl_FrontColor = gl_Color; gl_BackColor = gl_Color;
+ cubeDirection = reflect(gl_Vertex.xyz - eye, gl_Normal);
+ cubeDirection.z = -cubeDirection.z;
+})";
+		const char* fragment = R"(#version 120
+uniform sampler2D diffuseMap;
+uniform samplerCube envMap;
+uniform float addBright;
+varying vec3 cubeDirection;
+void main() {
+ vec4 base = texture2D(diffuseMap, gl_TexCoord[0].xy) * gl_Color;
+ base.rgb = (base.rgb + vec3(addBright)) * textureCube(envMap, cubeDirection).rgb;
+ gl_FragColor = base;
+})";
+		if (!EnvShader->addShaderFromSourceCode(QOpenGLShader::Vertex, vertex)
+			|| !EnvShader->addShaderFromSourceCode(QOpenGLShader::Fragment, fragment) || !EnvShader->link())
+		{
+			Status += "\n环境着色器不可用：" + EnvShader->log(); EnvShader.reset();
+		}
+		else
+		{
+			EyeUniform = EnvShader->uniformLocation("eye"); AddUniform = EnvShader->uniformLocation("addBright");
+			EnvShader->bind(); EnvShader->setUniformValue("diffuseMap", 0); EnvShader->setUniformValue("envMap", 1); EnvShader->release();
+		}
+	}
+}
+
+void Preview::Release(graphics::TextureLoader& loader)
+{
+	if (Parts) Parts->DeleteTextures(loader);
+	for (auto& clip : EventClips)
+	{
+		for (auto handle : clip.Handles) loader.DeleteTexture(handle);
+		clip.Handles.clear();
+	}
+	EnvShader.reset();
+	for (auto& texture : Textures) if (texture.Cube) { loader.DeleteTexture(texture.Cube); texture.Cube = 0; }
+	for (auto& texture : Textures) if (texture.Handle) { loader.DeleteTexture(texture.Handle); texture.Handle = 0; }
+	for (auto handle : FrameHandles) loader.DeleteTexture(handle);
+	FrameHandles.clear();
+	for (auto& clip : BoundClips)
+	{
+		for (auto handle : clip.Handles) loader.DeleteTexture(handle);
+		clip.Handles.clear();
+	}
+	for (auto& clip : Effects)
+	{
+		for (auto handle : clip.Handles) loader.DeleteTexture(handle);
+		clip.Handles.clear();
+	}
+}
+
+void Preview::UpdateFilters(graphics::TextureLoader& loader)
+{
+	if (Parts) Parts->UpdateFilters(loader);
+	for (const auto& clip : EventClips) for (auto handle : clip.Handles) loader.SetFilters(handle, false);
+	for (const auto& texture : Textures) if (texture.Handle) loader.SetFilters(texture.Handle, false);
+	for (auto handle : FrameHandles) loader.SetFilters(handle, false);
+	for (const auto& clip : BoundClips) for (auto handle : clip.Handles) loader.SetFilters(handle, false);
+	for (const auto& clip : Effects) for (auto handle : clip.Handles) loader.SetFilters(handle, false);
+}
+
+std::size_t Preview::FrameIndex() const
+{
+	if (Frames.empty() || !std::isfinite(Time) || !std::isfinite(FPS) || FPS <= 0) return 0;
+	const double frame = std::max(0.0, std::floor(Time * FPS));
+	return Loop ? static_cast<std::size_t>(std::fmod(frame, double(Frames.size())))
+		: static_cast<std::size_t>(std::min(frame, double(Frames.size() - 1)));
+}
+}
