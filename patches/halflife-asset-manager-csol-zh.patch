+			report.insert("gpu", QString::fromLatin1(reinterpret_cast<const char*>(gl->glGetString(GL_RENDERER)))); fbo.release();
+		}
+		asset->GetGraphicsContext()->End(); current = false;
+		require(serialized() == before && asset->GetUndoStack()->index() == undo, "Preview changed MDL or undo");
+		auto* panel = dynamic_cast<studiomodel::CSOLPanel*>(application.GetMainWindow()->findChild<QWidget*>("CSOLPanel")); require(panel, "No CSOL panel");
+		auto* choices = panel->findChild<QComboBox*>("CSOLPartsSequence"); require(choices && choices->isEnabled(), "No companion controls");
+		choices->setCurrentIndex(3); require(p.PartsSequence == 3 && p.PartsFrame == 0, "Action UI not connected");
+		auto* position = panel->findChild<QSpinBox*>("CSOLPartsFrame"); position->setValue(18); require(std::abs(p.PartsFrame - 18) < .001 && !p.Playing, "Companion seek UI failed");
+		panel->SaveProfile(out.filePath("profile.json")); choices->setCurrentIndex(0);
+		require(panel->LoadProfile(out.filePath("profile.json")) && p.PartsSequence == 3, "Profile lost companion action");
+		panel->findChild<QPushButton*>("CSOLPartsReplay")->click(); require(p.Playing && asset->PlaySequence && p.PartsFrame == 0, "Companion replay failed");
+		asset->PlaySequence = false;
+		application.GetMainWindow()->resize(1280, 900);
+		if (auto* dock = qobject_cast<QDockWidget*>(panel->parentWidget())) { dock->show(); dock->raise(); }
+		application.GetMainWindow()->show(); panel->findChild<QTabWidget*>("CSOLTabs")->setCurrentIndex(1); QApplication::processEvents();
+		require(panel->grab().save(out.filePath("ui-combined.png")), "UI capture failed");
+		const auto exported = csol::ExportResources(asset->GetFileName(), p.Root, out.filePath("exported"));
+		report.insert("exportFiles", exported.Files); report.insert("exportBytes", double(exported.Bytes)); report.insert("missing", QJsonArray::fromStringList(exported.Missing));
+		require(exported.Missing.empty(), "Missing dependencies in export");
+		require(hash(csol::ReadResource(exported.Directory + "/common/" + csol::CompanionModel(asset->GetFileName()))) == partsHash, "Export omitted companion");
+		csol::SetGameDirectory({}); application.LoadFile(exported.Directory + "/" + exported.Model);
+		auto* offline = dynamic_cast<studiomodel::StudioModelAsset*>(application.GetAssets()->GetCurrent());
+		require(offline && offline != asset, "Offline open failed"); auto& op = offline->GetEditableStudioModel()->CSOL;
+		require(op.Parts && op.PartsFile.startsWith(exported.Directory) && op.Parts->CSOL.BoundSprites.size() == 2, "Offline companion/JSON missing");
+		for (const auto& clip : op.Parts->CSOL.BoundClips) require(clip.File.startsWith(exported.Directory), "Offline dependency escaped export");
+		offline->PlaySequence = false; offline->GetEntity()->SetSequence(0); offline->GetEntity()->SetFrame(12); op.SetPartsSequence(2); op.UpdateParts(.4, true);
+		offline->GetGraphicsContext()->Begin();
+		{
+			auto* gl = application.GetOpenGLFunctions(); graphics::SceneContext sc(gl, offline->GetTextureLoader()); sc.WindowWidth = 960; sc.WindowHeight = 640;
+			auto* scene = offline->GetScene(); scene->UpdateWindowSize(960, 640); scene->GetCurrentCamera()->GetCamera()->SetProperties(glm::vec3(0), 0, 0, 0);
+			QOpenGLFramebufferObjectFormat format; format.setAttachment(QOpenGLFramebufferObject::CombinedDepthStencil); QOpenGLFramebufferObject fbo(960, 640, format);
+			require(fbo.bind(), "Offline FBO failed"); scene->Draw(sc, glm::vec4(.12f, .13f, .15f, 1)); const auto image = fbo.toImage();
+			require(image.save(out.filePath("combined-offline.png")) && hash(QByteArray(reinterpret_cast<const char*>(image.constBits()), image.sizeInBytes())) == expectedImage, "Offline image differs");
+			require(gl->glGetError() == GL_NO_ERROR, "Offline GL error"); fbo.release();
+		}
+		offline->GetGraphicsContext()->End();
+		require(hash(csol::ReadResource(asset->GetFileName())) == sourceHash && hash(csol::ReadResource(p.PartsFile)) == partsHash, "Source files changed");
+		application.LoadFile(op.PartsFile);
+		auto* standalone = dynamic_cast<studiomodel::StudioModelAsset*>(application.GetAssets()->GetCurrent());
+		require(standalone && !standalone->GetEditableStudioModel()->CSOL.Parts, "Parts-only open recursively combined");
+		if (qEnvironmentVariableIsSet("HLAM_CSOL_PARTS_EXPORT_CHECK"))
+		{
+			const auto reverse = csol::ExportResources(op.PartsFile, op.Root, out.filePath("parts-export"));
+			require(reverse.Missing.empty(), "Parts-only export dependencies missing");
+			require(hash(csol::ReadResource(reverse.Directory + "/common/" + csol::PrimaryModel(op.PartsFile))) == sourceHash, "Parts-only export lost primary");
+			report.insert("partsOnlyExportFiles", reverse.Files);
+		}
+		auto* openComplete = panel->findChild<QPushButton*>("CSOLOpenComplete");
+		require(openComplete && openComplete->isEnabled(), "No complete weapon shortcut on parts model");
+		openComplete->click();
+		require(application.GetAssets()->GetCurrent() == offline, "Complete weapon shortcut did not reopen primary");
+		// Missing/corrupt companions must leave a usable primary model, without guessing another family.
+		const auto isolated = out.filePath("missing/common"); QDir().mkpath(isolated + "/models");
+		csol::Preview missing; missing.SourceFile = isolated + "/models/" + QFileInfo(asset->GetFileName()).fileName(); missing.Root = isolated;
+		missing.Load(*model); require(!missing.Parts && missing.Status.contains("缺少配套模型"), "Missing companion was hidden or guessed");
+		const auto corruptFile = isolated + "/" + csol::CompanionModel(missing.SourceFile);
+		QFile corrupt(corruptFile); require(corrupt.open(QIODevice::WriteOnly), "Cannot create malformed fixture"); corrupt.write("IDST"); corrupt.close();
+		missing.Load(*model); require(!missing.Parts && missing.Status.contains("组合模型未加载"), "Truncated companion accepted");
+		require(serialized() == before, "Failure path mutated primary model");
+		report.insert("offlineRenderIdentical", true); report.insert("mdlAndUndoUnchanged", true); report.insert("glErrors", 0); report.insert("result", "passed");
+	}
+	catch (const std::exception& e) { report.insert("result", "failed"); report.insert("error", QString::fromUtf8(e.what())); }
+	if (current) asset->GetGraphicsContext()->End();
+	QFile output(out.filePath("result.json")); if (!output.open(QIODevice::WriteOnly)) return 2;
+	output.write(QJsonDocument(report).toJson()); return report.value("result").toString() == "passed" ? 0 : 1;
+}
diff --git a/tests/CSOLSmokeTest.cpp b/tests/CSOLSmokeTest.cpp
new file mode 100644
index 0000000..d98dc38
--- /dev/null
+++ b/tests/CSOLSmokeTest.cpp
@@ -0,0 +1,262 @@
+#include "application/AssetManager.hpp"
+#include "application/AssetList.hpp"
+#include "plugins/halflife/studiomodel/StudioModelAsset.hpp"
+#include "entity/HLMVStudioModelEntity.hpp"
+#include "formats/studiomodel/StudioModelUtils.hpp"
+#include "formats/studiomodel/BoneTransformer.hpp"
+#include "plugins/halflife/studiomodel/ui/dockpanels/CSOLPanel.hpp"
+#include "ui/MainWindow.hpp"
+#include <QApplication>
+#include <QDockWidget>
+#include <QTabWidget>
+#include <QLineEdit>
+#include <QComboBox>
+#include <QSpinBox>
+#include <QCheckBox>
+#include <QPushButton>
+#include "graphics/IGraphicsContext.hpp"
+#include "graphics/Scene.hpp"
+#include "graphics/SceneContext.hpp"
+#include <QDir>
+#include <QFile>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QJsonArray>
+#include <QOpenGLFramebufferObject>
+#include <QOpenGLFunctions_1_1>
+#include <QCryptographicHash>
+#include <QUndoStack>
+#include <stdexcept>
+
+int RunCSOLSmokeTest(AssetManager& application, const QString& resources, const QString& evidence)
+{
+	QDir out(evidence); out.mkpath(".");
+	QJsonObject report;
+	auto require = [](bool value, const char* message) { if (!value) throw std::runtime_error(message); };
+	auto asset = dynamic_cast<studiomodel::StudioModelAsset*>(application.GetAssets()->GetCurrent());
+	bool current = false;
+	try
+	{
+		require(asset != nullptr, "No model loaded");
+		auto model = asset->GetEditableStudioModel();
+		auto serialized = [&]()
+		{
+			auto binary = studiomdl::ConvertFromEditable("preview-invariant.mdl", *model);
+			const auto& data = binary.GetStudioHeaderPtr();
+			return QCryptographicHash::hash(QByteArray(reinterpret_cast<const char*>(data.get()), data.SizeInBytes), QCryptographicHash::Sha256);
+		};
+		const auto baseline = serialized();
+		const int undoIndex = asset->GetUndoStack()->index();
+		asset->PlaySequence = false;
+		auto& p = model->CSOL;
+		require(p.Enabled && p.FollowWeapon && p.RecognizedWeapon && !p.Root.isEmpty(), "Opening model did not automatically enable CSOL resources");
+		require(p.EnvShader && p.Textures[0].Cube && p.Textures[0].Env.Index == 4, "Original @004/wm environment did not load from the base archive");
+		report.insert("originalEnvironment004", true);
+		for (const auto& clip : p.Effects) require(!clip.Handles.empty(), "Automatic effect cache missing a left/right variant");
+		report.insert("automaticRoot", p.Root); report.insert("automaticEffectClips", 8);
+		{
+			studiomdl::EditableStudioModel ordinaryModel;
+			auto texture = std::make_unique<studiomdl::StudioTexture>(); texture->Name = "hand.bmp";
+			ordinaryModel.Textures.push_back(std::move(texture));
+			ordinaryModel.CSOL.Discover(asset->GetFileName(), ordinaryModel);
+			require(!ordinaryModel.CSOL.Enabled && ordinaryModel.CSOL.Textures.empty(), "Ordinary CS hand texture incorrectly enabled CSOL");
+		}
+		{
+		asset->GetGraphicsContext()->Begin(); current = true;
+		auto gl = application.GetOpenGLFunctions();
+		graphics::SceneContext sc(gl, asset->GetTextureLoader()); sc.WindowWidth = 960; sc.WindowHeight = 640;
+		auto scene = asset->GetScene(); scene->UpdateWindowSize(960, 640);
+		scene->GetCurrentCamera()->GetCamera()->SetProperties(glm::vec3(0), 0, 0, 0);
+		QOpenGLFramebufferObjectFormat format; format.setAttachment(QOpenGLFramebufferObject::CombinedDepthStencil);
+		QOpenGLFramebufferObject fbo(960, 640, format);
+		require(fbo.isValid(), "FBO unavailable");
+		auto draw = [&](const QString& name)
+		{
+			require(fbo.bind(), "FBO bind failed");
+			scene->Draw(sc, glm::vec4(0.12f, 0.13f, 0.15f, 1));
+			const auto image = fbo.toImage();
+			require(gl->glGetError() == GL_NO_ERROR, "OpenGL error");
+			require(image.save(out.filePath(name + ".png")), "Cannot save screenshot");
+			return QCryptographicHash::hash(QByteArray(reinterpret_cast<const char*>(image.constBits()), image.sizeInBytes()), QCryptographicHash::Sha256);
+		};
+		QJsonArray autoSamples;
+		for (bool right : {true, false})
+		{
+			p.RightHand = right;
+			for (int seq : {0, 2, 6, 8})
+			{
+				asset->GetEntity()->SetSequence(seq); asset->GetEntity()->SetFrame(12);
+				const auto effect = p.CurrentEffect(*model, seq);
+				const int expected = (right ? 0 : 4) + (seq % 6 == 2 ? 2 : 0) + (seq >= 6 ? 1 : 0);
+				require(effect.Clip == expected && effect.Handle, "Wrong automatic action/hand selection");
+				draw(QString("auto-%1-%2").arg(right ? "right" : "left").arg(seq));
+				autoSamples.append(QJsonObject{{"sequence", seq}, {"rightHand", right}, {"clip", effect.Clip}, {"frame", int(effect.Frame)}});
+			}
+		}
+		asset->GetEntity()->SetSequence(2); p.SetAction(2, 1.1);
+		require(p.CurrentEffect(*model, 2).Clip == 4, "Draw effect did not switch to idle after one second");
+		for (int seq : {1, 7, 12}) require(!p.CurrentEffect(*model, seq).Handle, "Inactive ring effect remained visible");
+		report.insert("automaticActionSamples", autoSamples);
+		report.insert("drawToIdleSeconds", 1);
+		const auto retainedHandle = p.Effects[0].Handles[0];
+		p.Release(*asset->GetTextureLoader()); require(!gl->glIsTexture(retainedHandle), "Leaked automatic sprite texture");
+		p.Upload(*asset->GetTextureLoader()); require(gl->glIsTexture(p.Effects[0].Handles[0]), "Automatic sprite cache not recreated");
+		asset->GetEntity()->SetSequence(0); p.Enabled = false;
+		const auto ordinary = draw("ordinary");
+		p.Release(*asset->GetTextureLoader()); p.FollowWeapon = false;
+		p.Root = QDir(resources).filePath("resources/common");
+		p.Appearance = "buffclasschoijiyoon";
+		p.SpriteFile = QDir(resources).filePath("sprites/ef_revivegun_idle1.spr");
+		p.Load(*model); p.Enabled = true; p.Upload(*asset->GetTextureLoader());
+		report.insert("manualResourceStatus", p.Status);
+		require(p.Frames.size() == 45, "Real sprite frame count");
+		require(p.Textures.size() == 8 && p.Textures[6].Handle != 0, "Hand texture not loaded");
+		p.Hands = 2;
+		require(p.Attachment == 5 && p.Offset == glm::vec3(0) && std::abs(p.Width - 7.168f) < 0.0001f
+			&& p.FPS == 20 && p.SpriteBlend == csol::Blend::Add && !p.DepthTest, "Revivegun preset not applied");
+		p.Time = 0;
+		const auto first = draw("preview-frame0");
+		p.Time = 0.6;
+		const auto second = draw("preview-frame12");
+		require(first != second, "Sprite frames did not change pixels");
+		report.insert("spriteChangesPixels", true);
+		QJsonArray attachmentSamples;
+		studiomdl::BoneTransformer transformer;
+		glm::vec3 previousCenter(0); bool moved = false;
+		for (int sequence = 0; sequence < model->Sequences.size(); ++sequence)
+		{
+			const auto& seq = *model->Sequences[sequence];
+			if (seq.Label != "idle" && seq.Label != "draw") continue;
+			p.Release(*asset->GetTextureLoader());
+			p.SpriteFile = QDir(resources).filePath(seq.Label == "idle" ? "sprites/ef_revivegun_idle1.spr" : "sprites/ef_revivegun_draw1.spr");
+			p.Load(*model); p.Upload(*asset->GetTextureLoader()); p.Time = 0.6;
+			asset->GetEntity()->SetSequence(sequence);
+			for (float fraction : {0.f, 0.35f, 0.7f})
+			{
+				asset->GetEntity()->SetFrame((seq.NumFrames - 1) * fraction);
+				const auto info = asset->GetEntity()->GetRenderInfo();
+				const auto& transforms = transformer.SetUpBones(*model,
+					{info.Sequence, info.Frame, info.Scale, info.Blender, info.Controller, info.Mouth});
+				const auto& attach = *model->Attachments[5];
+				const glm::vec3 center = transforms[attach.Bone->ArrayIndex] * glm::vec4(attach.Origin, 1);
+				const auto label = QString::fromStdString(seq.Label) + QString("-%1").arg(info.Frame);
+				const auto attached = draw("attached-" + label);
+				p.Attachment = -1; p.Offset = center;
+				require(draw("reference-" + label) == attached, "SPR did not follow animated attachment");
+				p.Attachment = 5; p.Offset = glm::vec3(0);
+				if (!attachmentSamples.empty() && glm::length(center - previousCenter) > 0.01f) moved = true;
+				previousCenter = center;
+				attachmentSamples.append(QJsonObject{{"sequence", QString::fromStdString(seq.Label)}, {"frame", info.Frame},
+					{"x", center.x}, {"y", center.y}, {"z", center.z}, {"renderMatchesAttachment", true}});
+			}
+		}
+		require(attachmentSamples.size() == 6 && moved, "No animated attachment coverage");
+		report.insert("animatedAttachment", attachmentSamples);
+		asset->GetEntity()->SetSequence(0); asset->GetEntity()->SetFrame(0);
+		for (const auto& name : {"idle2", "draw2", "idle1"})
+		{
+			p.Release(*asset->GetTextureLoader());
+			p.SpriteFile = QDir(resources).filePath(QString("sprites/ef_revivegun_%1.spr").arg(name));
+			p.Load(*model); p.Upload(*asset->GetTextureLoader()); p.Time = 0.6;
+			const bool firstVariant = QString(name) == "idle1";
+			require(std::abs(p.Width - (firstVariant ? 7.168f : 10.24f)) < 0.0001f
+				&& p.FPS == (firstVariant ? 20 : 30) && p.Attachment == 5, "Variant preset mismatch");
+			draw(QString("preset-%1").arg(name));
+		}
+		report.insert("revivegunPresets", 4);
+		// Exercise a different environment as an explicitly synthetic test material,
+		// then restore the original @004 identifier already checked above.
+		p.Release(*asset->GetTextureLoader());
+		const auto originalName = model->Textures[0]->Name;
+		model->Textures[0]->Name = "$20@008_test.bmp";
+		try { p.Load(*model); } catch (...) { model->Textures[0]->Name = originalName; throw; }
+		model->Textures[0]->Name = originalName;
+		p.Upload(*asset->GetTextureLoader());
+		require(p.EnvShader && p.Textures[0].Cube, "Environment shader/cubemap failed");
+		p.Time = 0.6;
+		require(draw("synthetic-env008") != second, "Environment shader did not change pixels");
+		report.insert("syntheticEnvironment008", true);
+		for (int iteration = 0; iteration < 3; ++iteration)
+		{
+			const auto old = p.FrameHandles[0];
+			p.Release(*asset->GetTextureLoader());
+			require(!gl->glIsTexture(old), "Leaked sprite texture");
+			p.Upload(*asset->GetTextureLoader());
+			require(gl->glIsTexture(p.FrameHandles[0]), "Sprite resource not recreated");
+			draw(QString("recreated%1").arg(iteration));
+		}
+		p.Enabled = false;
+		require(draw("disabled") == ordinary, "Disabling CSOL changed ordinary rendering");
+		require(serialized() == baseline, "Preview changed serialized MDL bytes");
+		require(asset->GetUndoStack()->index() == undoIndex, "Preview changed undo history");
+		report.insert("serializedMDLUnchanged", true); report.insert("ordinaryRenderUnchanged", true);
+		report.insert("undoUnchanged", true); report.insert("resourceRecreations", 3); report.insert("glErrors", 0);
+		report.insert("baselineSerializationSha256", QString::fromLatin1(baseline.toHex()));
+		report.insert("gpu", QString::fromLatin1(reinterpret_cast<const char*>(gl->glGetString(GL_RENDERER))));
+		report.insert("result", "passed");
+		fbo.release();
+		} // Destroy FBO while its context is still current.
+		asset->GetGraphicsContext()->End(); current = false;
+		// Exercise real Qt controls and profile IO in the application. These are
+		// integration fixtures, not evidence of manual desktop interaction.
+		auto panel = dynamic_cast<studiomodel::CSOLPanel*>(application.GetMainWindow()->findChild<QWidget*>("CSOLPanel"));
+		require(panel != nullptr, "CSOL panel unavailable");
+		panel->findChild<QLineEdit*>("CSOLRoot")->setText(p.Root);
+		panel->findChild<QLineEdit*>("CSOLSprite")->setText(p.SpriteFile);
+		panel->findChild<QComboBox*>("CSOLAppearance")->setCurrentText("buffclasschoijiyoon");
+		panel->findChild<QComboBox*>("CSOLHands")->setCurrentIndex(2);
+		panel->findChild<QCheckBox*>("CSOLAutomatic")->setChecked(false);
+		panel->SaveProfile(out.filePath("profile.json"));
+		require(panel->LoadProfile(out.filePath("profile.json")), "Profile load failed");
+		require(p.Enabled && p.Appearance == "buffclasschoijiyoon" && p.Hands == 2 && p.Frames.size() == 45, "Profile did not restore settings");
+		panel->findChild<QSpinBox*>("CSOLFrame")->setValue(12);
+		require(p.FrameIndex() == 12 && !p.Playing, "Frame scrub failed");
+		panel->findChild<QComboBox*>("CSOLAppearance")->setCurrentText("buffclass26s1tr");
+		for (auto* button : panel->findChildren<QPushButton*>()) if (button->text() == "应用资源") button->click();
+		require(p.Appearance == "buffclass26s1tr" && p.Textures[6].Handle, "Appearance switch failed");
+		require(panel->LoadProfile(out.filePath("profile.json")), "Profile restore failed");
+		p.Time = 0;
+		auto* main = application.GetMainWindow(); main->resize(1280, 900);
+		auto* dock = dynamic_cast<QDockWidget*>(panel->parentWidget());
+		if (dock) { dock->show(); dock->raise(); }
+		main->show(); QApplication::processEvents();
+		require(main->grab().save(out.filePath("ui-main.png")), "Cannot capture Qt window");
+		auto* tabs = panel->findChild<QTabWidget*>("CSOLTabs");
+		for (int tab = 0; tab < tabs->count(); ++tab)
+		{
+			tabs->setCurrentIndex(tab); QApplication::processEvents();
+			require(panel->grab().save(out.filePath(QString("ui-panel%1.png").arg(tab))), "Cannot capture Qt panel");
+		}
+		require(serialized() == baseline && asset->GetUndoStack()->index() == undoIndex, "UI preview mutated model data");
+		report.insert("qtProfileRoundtrip", true); report.insert("qtAppearanceSwitch", true); report.insert("qtFrameScrub", true);
+		const auto secondModel = out.filePath("asset-isolation.mdl");
+		require(QFile::copy(asset->GetFileName(), secondModel), "Cannot create isolated second asset");
+		application.LoadFile(secondModel);
+		auto* other = dynamic_cast<studiomodel::StudioModelAsset*>(application.GetAssets()->GetCurrent());
+		require(other && other != asset && other->GetEditableStudioModel()->CSOL.Appearance.isEmpty()
+			&& other->GetEditableStudioModel()->CSOL.Effects[0].Handles.empty(), "Preview leaked into another asset");
+		application.GetAssets()->SetCurrent(asset);
+		require(panel->findChild<QComboBox*>("CSOLHands")->currentIndex() == 2
+			&& panel->findChild<QComboBox*>("CSOLAppearance")->currentText() == "buffclasschoijiyoon", "Asset switch lost panel settings");
+		require(application.GetAssets()->RefreshCurrent(), "Model refresh failed");
+		const auto& refreshed = asset->GetEditableStudioModel()->CSOL;
+		require(refreshed.Enabled && refreshed.Hands == 2 && refreshed.Appearance == "buffclasschoijiyoon"
+			&& refreshed.FrameHandles.size() == 45 && refreshed.Textures[6].Handle, "Refresh did not recreate preview");
+		report.insert("qtAssetIsolation", true); report.insert("qtReloadResources", true);
+		// End on the actual zero-configuration workflow, and capture its simplified UI.
+		for (auto* button : panel->findChildren<QPushButton*>()) if (button->text() == "重新扫描模型目录") button->click();
+		auto& automatic = asset->GetEditableStudioModel()->CSOL;
+		require(automatic.Enabled && automatic.FollowWeapon && !automatic.Effects[7].Handles.empty(), "Rescan did not restore automatic mode");
+		require(automatic.EnvShader && automatic.Textures[0].Env.Index == 4, "Rescan lost original material");
+		panel->findChild<QTabWidget*>("CSOLTabs")->setCurrentIndex(0);
+		QApplication::processEvents();
+		require(main->grab().save(out.filePath("ui-automatic-main.png")), "Automatic UI capture failed");
+		require(panel->grab().save(out.filePath("ui-automatic-panel.png")), "Automatic panel capture failed");
+	}
+	catch (const std::exception& e) { report.insert("result", "failed"); report.insert("error", QString::fromUtf8(e.what())); }
+	if (current) asset->GetGraphicsContext()->End();
+	QFile file(out.filePath("result.json"));
+	if (!file.open(QIODevice::WriteOnly)) return 2;
+	file.write(QJsonDocument(report).toJson());
+	return report.value("result").toString() == "passed" ? 0 : 1;
+}
diff --git a/tools/Build-CSOLPreview.ps1 b/tools/Build-CSOLPreview.ps1
new file mode 100644
index 0000000..b2f384c
--- /dev/null
+++ b/tools/Build-CSOLPreview.ps1
@@ -0,0 +1,82 @@
+#requires -Version 7.0
+param(
+    [Parameter(Mandatory)][string]$LLVMRoot,
+    [Parameter(Mandatory)][string]$QtRoot,
+    [Parameter(Mandatory)][string]$PkgConfig,
+    [string]$BuildRoot = (Join-Path $PSScriptRoot '../build-csol'),
+    [string]$SdkVersion = '10.0.26100.0',
+    [switch]$SmokeTest
+)
+$ErrorActionPreference = 'Stop'
+$source = (Resolve-Path (Join-Path $PSScriptRoot '..')).Path.Replace('\','/')
+$LLVMRoot = (Resolve-Path -LiteralPath $LLVMRoot).Path.Replace('\','/')
+$QtRoot = (Resolve-Path -LiteralPath $QtRoot).Path.Replace('\','/')
+$env:PKG_CONFIG = (Resolve-Path -LiteralPath $PkgConfig).Path
+$BuildRoot = [IO.Path]::GetFullPath($BuildRoot).Replace('\','/')
+$deps = "$BuildRoot/dependencies"
+if (-not [System.Runtime.Intrinsics.X86.Avx2]::IsSupported) { throw 'This build requires AVX2.' }
+$vswhere = Join-Path ${env:ProgramFiles(x86)} 'Microsoft Visual Studio/Installer/vswhere.exe'
+$vs = & $vswhere -latest -products '*' -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath
+if (-not $vs) { throw 'Visual Studio C++ tools and Windows SDK are required.' }
+Import-Module (Join-Path $vs 'Common7/Tools/Microsoft.VisualStudio.DevShell.dll')
+Enter-VsDevShell -VsInstallPath $vs -SkipAutomaticLocation -DevCmdArguments "-arch=x86 -host_arch=x64 -winsdk=$SdkVersion" | Out-Null
+$env:PATH = "$LLVMRoot/bin;" + $env:PATH
+$ninja = Join-Path $vs 'Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe'
+$sdkBin = (Join-Path $env:WindowsSdkDir "bin/$SdkVersion/x64").Replace('\','/')
+$pinned = '0c20b2a97c390e106150837042d921b0939e7ecb'
+$actual = & git -C "$source/vcpkg" rev-parse HEAD
+if ($LASTEXITCODE -ne 0 -or $actual -ne $pinned) { throw "Initialize vcpkg at $pinned before building." }
+if (-not (Test-Path "$source/vcpkg/vcpkg.exe")) {
+    & "$source/vcpkg/bootstrap-vcpkg.bat" -disableMetrics
+    if ($LASTEXITCODE -ne 0) { throw 'vcpkg bootstrap failed' }
+}
+New-Item -ItemType Directory -Force -Path "$deps/triplets","$deps/ports","$deps/cache" | Out-Null
+@"
+set(HLAM_LLVM_ROOT "$LLVMRoot")
+include("$source/cmake/CSOLClang.cmake")
+set(CMAKE_RC_COMPILER "$sdkBin/rc.exe" CACHE FILEPATH "Resource compiler" FORCE)
+set(CMAKE_MT "$sdkBin/mt.exe" CACHE FILEPATH "Manifest tool" FORCE)
+"@ | Set-Content "$deps/chain.cmake" -Encoding utf8
+@"
+set(VCPKG_TARGET_ARCHITECTURE x86)
+set(VCPKG_CRT_LINKAGE dynamic)
+set(VCPKG_LIBRARY_LINKAGE static)
+set(VCPKG_BUILD_TYPE release)
+set(VCPKG_ENV_PASSTHROUGH PKG_CONFIG INCLUDE LIB LIBPATH)
+set(VCPKG_CMAKE_CONFIGURE_OPTIONS -DCMAKE_POLICY_VERSION_MINIMUM=3.5)
+set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE "$deps/chain.cmake")
+if(PORT MATCHES "openal-soft")
+  set(VCPKG_LIBRARY_LINKAGE dynamic)
+endif()
+"@ | Set-Content "$deps/triplets/x86-hlam.cmake" -Encoding utf8
+# Extract exact historical port recipes before the first configure, including
+# fresh trees where vcpkg has not created its versioning_ directory yet.
+foreach ($port in @(
+    @{Name='fmt'; Tree='dfe9aa860f5a8317f341a21d317be1cf44e89f18'; Patch='fmt-clang22.patch'},
+    @{Name='openal-soft'; Tree='d23d6573247830bd439e418fe0e31321de778d85'; Patch='openal-cxx20.patch'}
+)) {
+    $destination = "$deps/ports/$($port.Name)"
+    New-Item -ItemType Directory -Force -Path $destination | Out-Null
+    & git -C "$source/vcpkg" archive --format=tar "--output=$deps/$($port.Name).tar" $port.Tree
+    if ($LASTEXITCODE -ne 0) { throw "Cannot extract $($port.Name) port" }
+    & tar -xf "$deps/$($port.Name).tar" -C $destination
+    if ($LASTEXITCODE -ne 0) { throw 'Port extraction failed' }
+    Copy-Item -LiteralPath "$source/patches/$($port.Patch)" -Destination $destination
+    $recipe = Get-Content -LiteralPath "$destination/portfile.cmake" -Raw
+    $recipe.Replace('PATCHES', "PATCHES`n        $($port.Patch)") | Set-Content "$destination/portfile.cmake" -Encoding utf8
+}
+$env:VCPKG_MAX_CONCURRENCY = '2'
+$env:CMAKE_BUILD_PARALLEL_LEVEL = '2'
+$env:VCPKG_DISABLE_METRICS = '1'
+$env:VCPKG_BINARY_SOURCES = "clear;files,$deps/cache,readwrite"
+& cmake -S $source -B $BuildRoot -G Ninja "-DCMAKE_MAKE_PROGRAM=$ninja" '-DCMAKE_BUILD_TYPE=Release' `
+    "-DCMAKE_TOOLCHAIN_FILE=$source/vcpkg/scripts/buildsystems/vcpkg.cmake" `
+    "-DVCPKG_CHAINLOAD_TOOLCHAIN_FILE=$deps/chain.cmake" "-DVCPKG_OVERLAY_TRIPLETS=$deps/triplets" `
+    '-DVCPKG_TARGET_TRIPLET=x86-hlam' "-DVCPKG_INSTALLED_DIR=$deps/installed" "-DVCPKG_OVERLAY_PORTS=$deps/ports" `
+    "-DCMAKE_PREFIX_PATH=$QtRoot" '-DCMAKE_POLICY_VERSION_MINIMUM=3.5' '-DCMAKE_EXPORT_COMPILE_COMMANDS=ON' `
+    "-DHLAM_ENABLE_CSOL_SMOKE_TEST=$($SmokeTest.IsPresent.ToString().ToUpperInvariant())"
+if ($LASTEXITCODE -ne 0) { throw 'Configure failed' }
+& cmake --build $BuildRoot --parallel 2
+if ($LASTEXITCODE -ne 0) { throw 'Build failed' }
+& ctest --test-dir $BuildRoot --output-on-failure
+if ($LASTEXITCODE -ne 0) { throw 'Parser tests failed' }
