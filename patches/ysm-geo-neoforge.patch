-modLoader="javafml"
-loaderVersion="[47,)"
-license="MIT"
-[[mods]]
-modId="ysm_geo_compat"
-version="1.0.3"
-displayName="YSM GEO Compat"
-description = '''
-Bridges Touhou Little Maid model-pack GEO models into the Epic Fight combat animation system.
-
-Converts TLM GEO models (from tlm_custom_pack and jar-builtin maid_model.json entries) into Epic Fight SkinnedMesh at runtime, enabling custom maid models to use Epic Fight combat animations seamlessly.
-
-Gameplay:
-- Combat mode: Epic Fight renders the model using combat animations
-- Idle mode: the original renderer draws the model as normal
-
-YSM model support (players and maids using YSM models) is provided by the YSM_EpicFight_Compat mod; this mod yields YSM-model maids to it when both are installed.
-'''
-[[dependencies.ysm_geo_compat]]
-modId="forge"
-mandatory=true
-versionRange="[47,)"
-ordering="NONE"
-side="BOTH"
-[[dependencies.ysm_geo_compat]]
-modId="minecraft"
-mandatory=true
-versionRange="[1.20.1,1.21)"
-ordering="NONE"
-side="BOTH"
-[[dependencies.ysm_geo_compat]]
-# Deliberately the same range as EpicFight_TouhouLittleMaid's own dependency:
-# this mod ships jarJar-embedded inside EFTLM (libs/YSM_GEO_Compat.jar), so a
-# narrower range here would fail the mandatory-dependency check for players who
-# can load EFTLM itself - a nested mod error that is hard to diagnose. Anything
-# newer than the validated 20.14.17 therefore has to degrade at runtime instead:
-# the mixin targets, the reflected SkinnedMesh field and the ComputeShaderSetup
-# API are all reached behind failure-tolerant lookups that fall back to Epic
-# Fight's own render path. Re-validate those against 20.15 before widening EF's
-# own range in EFTLM.
-modId="epicfight"
-mandatory=true
-versionRange="[20.14,)"
-ordering="AFTER"
-side="BOTH"
-[[dependencies.ysm_geo_compat]]
-modId="touhou_little_maid"
-mandatory=false
-versionRange="[1.5,)"
-ordering="AFTER"
-side="BOTH"
-[[dependencies.ysm_geo_compat]]
-modId="ef_tlm"
-mandatory=false
-versionRange="[1.1,)"
-ordering="AFTER"
-side="BOTH"
