diff --git a/src/main/java/com/ysmef/geomodel/model/runtime/BoneRotationState.java b/src/main/java/com/ysmef/geomodel/model/runtime/BoneRotationState.java
new file mode 100644
index 0000000..a2f1ea8
--- /dev/null
+++ b/src/main/java/com/ysmef/geomodel/model/runtime/BoneRotationState.java
@@ -0,0 +1,53 @@
+package com.ysmef.geomodel.model.runtime;
+
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.Consumer;
+
+/** Per-animator committed local rotations, in the same radians used to compose its bones. */
+final class BoneRotationState {
+    private final Map<String, Integer> index;
+    private float[] committed;
+    private float[] pending;
+    private final Consumer<String> missingReporter;
+    private final Set<String> reportedMissing = new HashSet<>();
+
+    BoneRotationState(Map<String, Integer> index, float[] bindRadians, Consumer<String> missingReporter) {
+        this.index = Map.copyOf(index);
+        this.committed = bindRadians.clone();
+        this.pending = bindRadians.clone();
+        this.missingReporter = missingReporter;
+    }
+
+    void stage(int bone, float x, float y, float z) {
+        int offset = bone * 3;
+        pending[offset] = x;
+        pending[offset + 1] = y;
+        pending[offset + 2] = z;
+    }
+
+    /** Called only after every bone was composed; a failed frame keeps the previous values. */
+    void commit() {
+        float[] old = committed;
+        committed = pending;
+        pending = old;
+    }
+
+    double component(String function, String[] args, int axis) {
+        if (!function.equals("ysm.bone_rot") || args.length != 1 || args[0] == null || axis < 0 || axis > 2) {
+            throw new IllegalArgumentException("Expected ysm.bone_rot('bone').x, .y or .z");
+        }
+        Integer bone = index.get(args[0]);
+        if (bone == null) {
+            // Pinned TLM returns null for a missing bone, which its numeric
+            // evaluator converts to zero. Report the actual missing name once.
+            if (reportedMissing.add(args[0])) {
+                missingReporter.accept(args[0]);
+            }
+            return 0;
+        }
+        float degrees = (float) Math.toDegrees(committed[bone * 3 + axis]);
+        return axis == 2 ? degrees : -degrees;
+    }
+}
