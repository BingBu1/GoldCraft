<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ReHLDS'">
    <ClCompile Include="$(GoldCraftRoot)\native\engine\precache.cpp;$(GoldCraftRoot)\native\engine\map_physics.cpp;$(GoldCraftRoot)\native\engine\map_visibility.cpp;$(GoldCraftRoot)\native\common\world_carving.cpp;$(GoldCraftRoot)\native\common\world_volume.cpp;$(GoldCraftRoot)\native\common\edited_hull.cpp;$(GoldCraftRoot)\native\common\carved_visibility.cpp;$(GoldCraftRoot)\native\common\entity_visibility.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ReHLDS' and '$(GoldCraftMapDeliveryFixture)' == 'true'">
    <ClCompile Include="$(GoldCraftRoot)\native\engine\map_delivery_test.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>
  <ItemDefinitionGroup Condition="'$(MSBuildProjectName)' == 'ReHLDS' and '$(GoldCraftMapDeliveryFixture)' == 'true'">
    <ClCompile>
      <PreprocessorDefinitions>GOLDCRAFT_MAP_DELIVERY_FIXTURE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ReHLDS' and '$(GoldCraftPacketEntitiesFixture)' == 'true'">
    <ClCompile Include="$(GoldCraftRoot)\native\engine\packet_entities_test.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="$(GoldCraftRoot)\native\common\wire.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <PreprocessorDefinitions>NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemGroup>
  <ItemDefinitionGroup Condition="'$(MSBuildProjectName)' == 'ReHLDS' and '$(GoldCraftPacketEntitiesFixture)' == 'true'">
    <ClCompile>
      <PreprocessorDefinitions>GOLDCRAFT_PACKET_ENTITIES_FIXTURE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>bcrypt.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(MSBuildProjectName)' == 'ReHLDS'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(GoldCraftRoot)\native\engine;$(GoldCraftRoot)\native\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
