<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>冰桑启动器</AssemblyName>
    <Product>冰桑启动器</Product>
    <Title>冰桑启动器</Title>
    <Description>冰桑游戏启动与组件更新</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>$(LauncherIcon)</ApplicationIcon>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>none</DebugType>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <EmbeddedResource Include="$(LauncherAssets)/bundle.json" LogicalName="bundle.json" />
    <EmbeddedResource Include="$(LauncherAssets)/payload.zip" LogicalName="payload.zip" />
    <EmbeddedResource Include="$(LauncherIcon)" LogicalName="launcher.ico" />
  </ItemGroup>
  <Target Name="CheckBundle" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(LauncherAssets)/bundle.json')" Text="Run package.py and supply LauncherAssets." />
    <Error Condition="!Exists('$(LauncherIcon)')" Text="Run icon.py and supply LauncherIcon." />
  </Target>
</Project>
